{
  "schema_version": 1,
  "doc": {
    "purpose": "Global bezel manifest: central selection policy, generic fallbacks, and deterministic bezel-art recipes.",
    "provenance": "Semu-owned originals carry exact output metadata. Remaining upstream assets are explicitly pinned for handheld and dual-screen presentations only.",
    "shared_pins": "Upstreams named in both this file and shaders.json must carry identical rev/nar_hash pins; NixPackageContract enforces agreement.",
    "scenes": "scene recipes flatten pinned upstream layers, multiply an ambient lighting plate over them (the late-night room), and downscale; bezel packages under config/bezels measure their screens on the upstream canvas."
  },
