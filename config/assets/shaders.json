          "sha256": "ef74a7c7a9519fd4301ea55ad09ecbd8e958f6f03657c83a7a45fcfb429b15b3",
          "filter_linear": false,
          "scale_type": "source",
          "scale": 1
        },
        {
          "tree": "shaders_slang",
          "path": "misc/shaders/image-adjustment.slang",
          "sha256": "e608b1dd71d660d2ce8a77ee3e3a62ad5047d50a75adc8db7b4a1b7c1be83e2d",
          "filter_linear": false,
          "scale_type": "source",
          "scale": 1
        },
        {
          "tree": "shaders_slang",
          "path": "handheld/shaders/lcd-cgwg/lcd-grid-v2.slang",
          "sha256": "dc77b29530e5b771f12a5a2dd68c390805139bc25d84a30dead021fd38e581c5",
          "filter_linear": false,
          "scale_type": "viewport",
          "scale": 1
        }
      ],
      "requires": [
        "shaders_slang"
      ],
      "params": {
        "ia_black_level": 0.03,
        "ia_bright_boost": 0,
        "ia_luminance": 1.0,
        "ia_saturation": 3.0,
        "ia_target_gamma": 0.85,
        "lighten_screen": 0.15,
        "mode": 1,
        "response_time": 0.222,
        "gain": 1.33,
        "gamma": 2.2,
        "blacklevel": 0,
        "ambient": 0,
        "RSUBPIX_R": 0.96,
        "RSUBPIX_G": 0.5,
        "RSUBPIX_B": 0.5,
        "GSUBPIX_R": 0.5,
        "GSUBPIX_G": 0.96,
        "GSUBPIX_B": 0.5,
        "BSUBPIX_R": 0.5,
        "BSUBPIX_G": 0.5,
        "BSUBPIX_B": 0.85,
        "BGR": 0
      },
      "doc": {
        "why": "GBC response and color, luminance, then the cgwg subpixel grid so the panel reads as a GBC LCD",
        "passes": "Colour passes stay at the native 160x144, unfiltered, and only the grid renders at the viewport: lcd-grid-v2 takes its LCD cell from its source size, so a viewport-sized source turns one cell into one screen pixel (no grid, flat lifted blacks, 1-px subpixel streaks). This is the upstream nds/3ds-lcd-grid-v2 structure.",
        "params": "Tuned on settled frames: response-time mixes seven frames of history, and a single rendered frame reads it black, 27% dark. Luminance 1.0 keeps the image-adjustment pass from clipping HSV value (1.35 flattened every grey from 204 up to one colour in a running game); gamma 0.85 with black level 0.03 gives the tone curve round two tuned on one frame (level 1 of 31 stays above black). Each lcd-grid-v2 channel lights its own third of a cell, so a bright white needs either clipped subpixel peaks or light from the neighbours: the subpixels leak 0.5 and gain 1.33 brings white to about 229, with under half of any channel at 255 (gain 1.8 put 72/60/52% there) and the row gaps and colour stripes still drawn. Red and green subpixels at 0.96 and blue at 0.85 keep the white warm. Saturation 3.0 pays back what the leak and the GBC colour matrix take. blacklevel and ambient 0 keep black black."
      },
      "output": {
        "sha256": "7bbc54e5615a486e82cc6dcfbbe63c6c42fe63fd0d16e349e05b763636fa3e12"
      }
    },
