    "assets/shaders/n3ds/top.slangp": {
      "type": "slang_pipeline",
      "passes": [
        {
          "tree": "shaders_slang",
          "path": "handheld/shaders/lcd1x.slang",
          "sha256": "63c8dd3726c853feb12c8593cd192dfa3fb881449fd5dc672852f8024d511c82",
