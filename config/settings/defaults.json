{
  "schema_version": 2,
  "paths": {
    "root": "${home}/Games/Emulation",
    "state_root": "${home}/.cache/semu"
  },
  "visual": {
    "crt_shaders": true,
    "bezels": true,
    "dual_screen_gap": 0.015625,
    "frame_width": 0.03,
    "display": {
      "width": 3840,
      "height": 2160
    },
    "placement": "bezel",
    "performance_overlay": false
  },
  "ui": {
    "theme": "horizon-es-de",
    "display_index": 0
  },
  "input": {
    "systems": {
      "switch": {
        "play_mode": "docked"
      }
    }
  }
}
