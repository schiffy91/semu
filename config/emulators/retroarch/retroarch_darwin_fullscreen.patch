+/* Semu: fullscreen is a borderless window covering the chosen screen on the
+ * current Space, like the frontend's own window, instead of a native
+ * fullscreen Space: no slide to a black Space, no small window growing. */
+static bool     semu_borderless;
+static NSRect   semu_windowed_frame;
+static NSUInteger semu_windowed_style;
 
+- (void)setBorderlessFullscreen:(bool)on
+{
+   if (on == semu_borderless)
+      return;
+   if (on)
+   {
+      NSScreen *screen    = (BRIDGE NSScreen*)cocoa_screen_get_chosen();
+      if (!screen)
+         screen           = self.window.screen ? self.window.screen : [NSScreen mainScreen];
+      semu_windowed_frame = self.window.frame;
+      semu_windowed_style = self.window.styleMask;
+      [NSApp setPresentationOptions:NSApplicationPresentationHideDock
+         | NSApplicationPresentationHideMenuBar];
+      self.window.styleMask = NSWindowStyleMaskBorderless;
+      [self.window setFrame:screen.frame display:YES];
+      [self.window makeKeyAndOrderFront:nil];
+   }
+   else
+   {
+      [NSApp setPresentationOptions:NSApplicationPresentationDefault];
+      self.window.styleMask = semu_windowed_style;
+      [self.window setFrame:semu_windowed_frame display:YES];
+   }
+   semu_borderless = on;
+}
