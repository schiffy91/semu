+/* Semu: the nib window stays transparent until the first frame is presented,
+ * so a launch never shows an empty small window. A borderless fullscreen
+ * window must still take keyboard focus. */
+- (void)awakeFromNib
+{
+   [super awakeFromNib];
+   self.alphaValue = 0;
+}
