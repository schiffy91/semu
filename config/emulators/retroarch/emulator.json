{
  "schema_version": 1,
  "name": "RetroArch",
  "input": {
    "actions": [
      "ui.pause",
      "ui.screenshot",
      "ui.fullscreen",
      "ui.escape",
      "app.quit",
      "state.prev",
      "state.next",
      "state.load",
      "state.save",
      "speed.rewind",
      "speed.fast"
    ]
  },
  "content": {
    "archives": [
      ".7z",
      ".zip"
    ],
    "cores": {
      "azahar": {
        "extensions": [
          ".3ds",
          ".3dsx",
          ".app",
          ".axf",
          ".cci",
          ".cxi",
          ".elf",
          ".z3dsx",
          ".zcci",
          ".zcxi"
        ],
        "doc": "azahar fbd3fb02 src/citra_libretro/environment.cpp:272"
      },
      "citra": {
        "extensions": [
          ".3ds",
          ".3dsx",
          ".cia",
          ".elf"
        ],
        "doc": "libretro/citra e4cbe379 src/citra_libretro/environment.cpp:183"
      },
      "desmume": {
        "extensions": [
          ".bin",
          ".ids",
          ".nds"
        ],
        "doc": "libretro/desmume 8f6b32cb desmume/src/frontend/libretro/libretro.cpp:523"
      },
      "flycast": {
        "extensions": [
          ".7z",
          ".bin",
          ".cdi",
          ".chd",
          ".cue",
          ".dat",
          ".elf",
          ".gdi",
          ".lst",
          ".m3u",
          ".zip"
        ],
        "block_extract": true,
        "doc": "flycast d8a76809 shell/libretro/libretro.cpp:2565-2567: reads .m3u itself (read_m3u) and takes archives whole as NAOMI or Atomiswave carts (block_extract)"
      },
      "gambatte": {
        "extensions": [
          ".dmg",
          ".gb",
          ".gbc"
        ],
        "doc": "gambatte-libretro d9d6cd06 libgambatte/libretro/libretro.cpp:1666"
      },
      "genesis_plus_gx": {
        "extensions": [
          ".68k",
          ".bin",
          ".bms",
          ".chd",
          ".cue",
          ".gen",
          ".gg",
          ".iso",
          ".m3u",
          ".md",
          ".mdx",
          ".sg",
          ".sgd",
          ".smd",
          ".sms"
        ],
        "doc": "Genesis-Plus-GX c2838c7d libretro/libretro.c:3129"
      },
      "mednafen_psx": {
        "extensions": [
          ".bin",
          ".ccd",
          ".chd",
          ".cue",
          ".exe",
          ".img",
          ".iso",
          ".m3u",
          ".pbp",
          ".toc"
        ],
        "doc": "beetle-psx-libretro 82d8e051 libretro.c:6876 (MEDNAFEN_CORE_EXTENSIONS, libretro_options.h:20): reads .m3u itself (ReadM3U_r)"
      },
      "melonds": {
        "extensions": [
          ".dsi",
          ".ids",
          ".nds"
        ],
        "doc": "libretro/melonds 66b5d263 src/libretro/libretro.cpp:120"
      },
      "mesen": {
        "extensions": [
          ".fds",
          ".nes",
          ".unf",
          ".unif"
        ],
        "doc": "libretro/mesen 0102910c Libretro/libretro.cpp:1167"
      },
      "mgba": {
        "extensions": [
          ".gb",
          ".gba",
          ".gbc",
          ".sgb"
        ],
        "doc": "libretro/mgba 32de7921 src/platform/libretro/libretro.c:1347 (built with M_CORE_GB)"
      },
      "mupen64plus_next": {
        "extensions": [
          ".bin",
          ".n64",
          ".u1",
          ".v64",
          ".z64"
        ],
        "doc": "mupen64plus-libretro-nx f275caf4 libretro/libretro.c:656; a 64DD .ndd is a side file found beside the ROM (1884-1893), never content"
      },
      "ppsspp": {
        "extensions": [
          ".chd",
          ".cso",
          ".elf",
          ".iso",
          ".pbp",
          ".prx"
        ],
        "doc": "ppsspp a3998322 libretro/libretro.cpp:1307"
      },
      "snes9x": {
        "extensions": [
          ".bs",
          ".fig",
          ".sfc",
          ".smc",
          ".swc"
        ],
        "doc": "snes9x a0420aef libretro/libretro.cpp:779"
      }
    }
  },
  "platforms": {
    "linux": {
      "executable": "${asset_root}/bin/retroarch",
      "args": [
        "-f"
      ],
      "playlist": {
        "open": "native"
      },
      "state": {
        "data_home": "xdg",
        "seeds": [
          {
            "purpose": "system_files",
            "copy": "missing_files",
            "source_access": "read_only",
            "overwrite": false,
            "sources": [
              "${emulation_root}/RetroArch/config/system",
              "${bios}"
            ],
            "target": "${state_root}/system"
          }
        ],
        "mods": {
          "kinds": [],
          "doc": "The libretro routes are exceptions with no kind: a core reads its packs inside RetroArch's save or system folder (content_root, which Syncthing carries, or ${state_root}/system), behind a core option per core, and RetroArch rewrites the loaded .cht on every unload (command.c:1394-1417), so a linked cheat would be written into the library. ROM soft-patches (.ips, .bps, .ups beside the ROM) already apply for the cores that load content into memory (runloop.c:4918-4975). Mods for 3DS, PSP and Dreamcast install for the standalone emulators."
        }
      },
      "firmware": {
        "dir": "${emulation_root}/RetroArch/config/system",
        "fallback_dirs": [
          "${bios}"
        ]
      },
      "core_loader": {
        "filename": "${core}_libretro.so",
        "directories": [
          "${asset_root}/lib/retroarch/cores"
        ],
        "args": [
          "-L",
          "${core_file}"
        ]
      },
      "retroarch": {
        "video_driver": "glcore",
        "input_driver": "sdl2",
        "frame_output": {
          "fullscreen": true,
          "scope": "game_only",
          "origin": "bottom_left",
          "orientation": "upright",
          "filter": "nearest",
          "native_shader": false,
          "native_bezel": false
        },
        "core_options": {
          "mesen": [
            {
              "key": "mesen_aspect_ratio",
              "source": {
                "kind": "literal",
                "value": "4:3"
              }
            }
          ],
          "snes9x": [
            {
              "key": "snes9x_aspect",
              "source": {
                "kind": "literal",
                "value": "4:3"
              }
            },
            {
              "key": "snes9x_overscan",
              "source": {
                "kind": "literal",
                "value": "enabled"
              }
            }
          ],
          "genesis_plus_gx": [
            {
              "key": "genesis_plus_gx_aspect_ratio",
              "source": {
                "kind": "literal",
                "value": "4:3"
              }
            },
            {
              "key": "genesis_plus_gx_overscan",
              "source": {
                "kind": "literal",
                "value": "disabled"
              }
            },
            {
              "key": "genesis_plus_gx_render",
              "source": {
                "kind": "literal",
                "value": "single field"
              }
            }
          ],
          "mupen64plus_next": [
            {
              "key": "mupen64plus-aspect",
              "aspect": "standard",
              "source": {
                "kind": "literal",
                "value": "4:3"
              }
            },
            {
              "key": "mupen64plus-aspect",
              "aspect": "widescreen",
              "source": {
                "kind": "literal",
                "value": "16:9 adjusted"
              }
            },
            {
              "key": "mupen64plus-43screensize",
              "aspect": "standard",
              "source": {
                "kind": "render_resolution",
                "basis": "combined",
                "display_aspect": "standard",
                "anchor": "width"
              }
            },
            {
