{
  "schema_version": 1,
  "name": "RetroArch",
  "input": {
    "actions": [
      "ui.pause",
      "ui.screenshot",
      "ui.fullscreen",
      "ui.menu",
      "ui.escape",
      "app.quit",
      "state.prev",
      "state.next",
      "state.load",
      "state.save",
      "speed.rewind",
      "speed.fast"
    ]
  },
  "platforms": {
    "linux": {
      "executable": "${asset_root}/bin/retroarch",
      "args": [
        "-f"
      ],
      "state": {
        "data_home": "xdg",
        "seeds": [
          {
            "purpose": "system_files",
            "copy": "missing_files",
            "source_access": "read_only",
            "overwrite": false,
            "sources": [
              "${emulation_root}/RetroArch/config/system",
              "${bios}"
            ],
            "target": "${state_root}/system"
          }
        ]
      },
      "firmware": {
        "dir": "${emulation_root}/RetroArch/config/system",
        "fallback_dirs": [
          "${bios}"
        ]
      },
      "core_loader": {
        "filename": "${core}_libretro.so",
        "directories": [
          "${asset_root}/lib/retroarch/cores"
        ],
        "args": [
          "-L",
          "${core_file}"
        ]
      },
      "retroarch": {
        "video_driver": "glcore",
        "input_driver": "sdl2",
        "frame_output": {
          "fullscreen": true,
          "scope": "game_only",
          "origin": "bottom_left",
          "orientation": "upright",
          "filter": "nearest",
          "native_shader": false,
          "native_bezel": false
