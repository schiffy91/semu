        "key": "space"
      },
      {
        "setting": "input_hold_fast_forward",
        "key": "l"
      },
      {
        "setting": "input_hold_slowmotion",
        "key": "e"
      },
      {
        "setting": "input_rewind",
        "key": "r"
      },
      {
        "setting": "input_pause_toggle",
        "key": "p"
      },
      {
        "setting": "input_frame_advance",
        "key": "k"
      },
      {
        "setting": "input_audio_mute",
        "key": "f9"
      },
      {
        "setting": "input_volume_up",
        "key": "add"
      },
      {
        "setting": "input_volume_down",
        "key": "subtract"
      },
      {
        "setting": "input_load_state",
        "key": "f4"
      },
      {
        "setting": "input_save_state",
        "key": "f2"
      },
      {
        "setting": "input_state_slot_increase",
        "key": "f7"
      },
      {
        "setting": "input_state_slot_decrease",
        "key": "f6"
      },
      {
        "setting": "input_shader_toggle",
