  "hotkeys": {
    "keymap": [
      {
        "setting": "input_pause_toggle",
        "action": "ui.pause"
      },
      {
        "setting": "input_load_state",
        "action": "state.load",
        "slot": "selected"
      },
      {
        "setting": "input_save_state",
        "action": "state.save",
        "slot": "selected"
      },
      {
        "setting": "input_screenshot",
        "action": "ui.screenshot"
      },
      {
        "setting": "input_state_slot_decrease",
        "action": "state.prev"
      },
      {
        "setting": "input_state_slot_increase",
        "action": "state.next"
      },
      {
        "setting": "input_rewind",
        "action": "speed.rewind"
      },
      {
        "setting": "input_toggle_fast_forward",
        "action": "speed.fast"
      },
      {
        "setting": "input_toggle_fullscreen",
        "action": "ui.fullscreen"
      },
      {
        "setting": "input_exit_emulator",
        "action": "ui.escape"
      }
    ]
  },
  "files": [
    {
      "path": "${profile_name}/retroarch.cfg",
      "lines": [
        "config_save_on_exit = \"false\"",
        "global_core_options = \"true\"",
        "quit_press_twice = \"false\"",
        "pause_nonactive = \"false\"",
        {
          "if": "audio_driver",
          "line": "audio_driver = \"${audio_driver}\""
        },
        {
          "if": "input_driver",
          "line": "input_driver = \"${input_driver}\""
        },
        "input_autodetect_enable = \"true\"",
        "input_joypad_driver = \"${joypad_driver}\"",
        {
          "for_each": "players",
          "when": "assigned",
          "lines": [
            "input_player${player}_joypad_index = \"${pad_index}\""
          ]
        },
        "joypad_autoconfig_dir = \"${asset_root}/share/libretro/autoconfig\"",
        "notification_show_autoconfig = \"false\"",
        "notification_show_autoconfig_fails = \"false\"",
        "network_cmd_enable = \"true\"",
        "network_cmd_port = \"55355\"",
        "input_remap_binds_enable = \"true\"",
        "auto_remaps_enable = \"true\"",
        "input_remap_sort_by_controller_enable = \"false\"",
        "input_auto_mouse_grab = \"false\"",
        "system_directory = \"${state_root}/system\"",
        "savestate_directory = \"${content_root}/states\"",
        "savefile_directory = \"${content_root}/saves\"",
        "screenshot_directory = \"${content_root}/screenshots\"",
        "video_gpu_screenshot = \"false\"",
        "playlist_directory = \"${state_root}/playlists\"",
        "history_list_enable = \"false\"",
        "log_dir = \"${state_root}/logs\"",
        "cache_directory = \"${state_root}/cache\"",
        "thumbnails_directory = \"${state_root}/thumbnails\"",
        "input_remapping_directory = \"${state_root}/remaps\"",
        "rgui_config_directory = \"${state_root}/config\"",
        "runtime_log_directory = \"${state_root}/logs\"",
        "video_driver = \"${video_driver}\"",
        "video_fullscreen = \"true\"",
        "video_windowed_fullscreen = \"true\"",
        "video_threaded = \"false\"",
        "video_scale_integer = \"true\"",
        "video_force_aspect = \"true\"",
        "video_vsync = \"true\"",
        "video_smooth = \"false\"",
        "video_shader_enable = \"false\"",
        "input_overlay_enable = \"false\"",
        "input_overlay_enable_autopreferred = \"false\"",
        "savestate_auto_save = \"false\"",
        "savestate_auto_load = \"false\"",
        "savestate_thumbnail_enable = \"false\"",
        "input_enable_hotkey_btn = \"${hotkey_enable_hotkey_btn}\"",
        "input_save_state_btn = \"${hotkey_save_state_btn}\"",
        "input_load_state_btn = \"${hotkey_load_state_btn}\"",
        "input_menu_toggle_btn = \"${hotkey_menu_toggle_btn}\"",
        "input_toggle_fast_forward_btn = \"${hotkey_toggle_fast_forward_btn}\"",
        "input_rewind_btn = \"${hotkey_rewind_btn}\"",
        "input_screenshot_btn = \"${hotkey_screenshot_btn}\"",
        "@lines:keymap_hotkeys",
        "@lines:keyboard_hotkey_defaults",
        "@lines:keyboard_player_defaults"
      ]
    },
    {
      "path": "${profile_name}/remaps/melonDS/melonDS.rmp",
      "lines": [
        "input_player1_btn_r2 = \"-1\""
      ]
    },
    {
      "path": "${profile_name}/remaps/Azahar/Azahar.rmp",
      "lines": [
        "input_player1_btn_l3 = \"-1\""
      ]
    },
    {
      "path": "${profile_name}/remaps/Citra/Citra.rmp",
      "lines": [
        "input_player1_btn_l3 = \"-1\""
      ]
    },
    {
      "path": "${profile_name}/remaps/DeSmuME/DeSmuME.rmp",
      "lines": [
        "input_player1_btn_r3 = \"-1\""
      ]
    }
  ]
}
