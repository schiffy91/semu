+			bool isIDR = IsIDRSlice((uint8*)ctx->BitStream.ptr.GetPtr(), ctx->BitStream.length);
+			if (isIDR)
+			{
+				ctx->decoderState.isTryingToRecover = false;
+			}
+			else
+			{
+				return 0x400; // error (figure out exact error code. Bit 0x80 indicates presence of frame?)
+			}
+		}
