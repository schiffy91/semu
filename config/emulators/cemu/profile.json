  "files": [
    {
      "path": "${emulator_name}/config/controllerProfiles/controller0.xml",
      "lines": [
        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>",
        "<emulated_controller>",
        "\t<type>${controller_type}</type>",
        "\t<controller>",
        "\t\t<api>${controller_api}</api>",
        "\t\t<uuid>${cemu_uuid}</uuid>",
        "\t\t<display_name>${cemu_display_name}</display_name>",
        "\t\t<rumble>${controller_rumble}</rumble>",
        "\t\t<axis>",
        "\t\t\t<deadzone>0.1</deadzone>",
        "\t\t\t<range>1</range>",
        "\t\t</axis>",
        "\t\t<rotation>",
        "\t\t\t<deadzone>0.1</deadzone>",
        "\t\t\t<range>1</range>",
        "\t\t</rotation>",
        "\t\t<trigger>",
        "\t\t\t<deadzone>0.1</deadzone>",
        "\t\t\t<range>1</range>",
        "\t\t</trigger>",
        "\t\t<mappings>",
        "@lines:controller_mappings",
        "\t\t</mappings>",
        "\t</controller>",
        "</emulated_controller>"
      ],
      "for_each": "players",
      "when": "first"
    },
    {
      "path": "${emulator_name}/config/controllerProfiles/controller${player0}.xml",
      "lines": [
        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>",
        "<emulated_controller>",
        "\t<type>Wii U Pro Controller</type>",
        "\t<controller>",
        "\t\t<api>${controller_api}</api>",
        "\t\t<uuid>${cemu_uuid}</uuid>",
        "\t\t<display_name>${cemu_display_name}</display_name>",
        "\t\t<rumble>${controller_rumble}</rumble>",
        "\t\t<axis>",
        "\t\t\t<deadzone>0.1</deadzone>",
        "\t\t\t<range>1</range>",
        "\t\t</axis>",
        "\t\t<rotation>",
        "\t\t\t<deadzone>0.1</deadzone>",
        "\t\t\t<range>1</range>",
        "\t\t</rotation>",
        "\t\t<trigger>",
        "\t\t\t<deadzone>0.1</deadzone>",
        "\t\t\t<range>1</range>",
        "\t\t</trigger>",
        "\t\t<mappings>",
        "@lines:pro_mappings",
        "\t\t</mappings>",
        "\t</controller>",
        "</emulated_controller>"
      ],
      "for_each": "players",
      "when": "others,connected"
    },
    {
      "path": "${emulator_name}/config/settings.xml",
      "lines": [
        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>",
        "<content>",
        "\t<Graphic>",
        "\t\t<${renderer_key}>${renderer_value}</${renderer_key}>",
        "\t\t<FullscreenScaling>0</FullscreenScaling>",
        "\t\t<Notification>",
        "\t\t\t<ControllerProfiles>false</ControllerProfiles>",
        "\t\t\t<ControllerBattery>false</ControllerBattery>",
        "\t\t\t<Position>0</Position>",
        "\t\t\t<ShaderCompiling>false</ShaderCompiling>",
        "\t\t</Notification>",
        "\t</Graphic>",
        "\t<Audio>",
        "\t\t<api>3</api>",
        "\t\t<delay>2</delay>",
        "\t\t<TVChannels>1</TVChannels>",
        "\t\t<PadChannels>1</PadChannels>",
        "\t\t<InputChannels>0</InputChannels>",
        "\t\t<TVVolume>100</TVVolume>",
        "\t\t<PadVolume>0</PadVolume>",
        "\t\t<InputVolume>20</InputVolume>",
        "\t\t<TVDevice>default</TVDevice>",
        "\t\t<PadDevice></PadDevice>",
        "\t\t<InputDevice></InputDevice>",
        "\t</Audio>",
        "\t<fullscreen>true</fullscreen>",
        "\t<fullscreen_menubar>false</fullscreen_menubar>",
        "\t<open_pad>false</open_pad>",
        "\t<disable_screensaver>true</disable_screensaver>",
        "\t<feral_gamemode>false</feral_gamemode>",
        "\t<use_discord_presence>false</use_discord_presence>",
        "\t<play_boot_sound>false</play_boot_sound>",
        "\t<check_update>false</check_update>",
        "\t<GraphicPack>",
        "@lines:mods.graphicpacks",
        "\t</GraphicPack>",
        "</content>"
      ]
    }
