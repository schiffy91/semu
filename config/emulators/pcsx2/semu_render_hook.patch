+#ifdef HAVE_SEMU_RENDERER
+// Semu render hook (ABI 3): the game frame is published after the final upright present draw,
+// the post-UI pass runs after PCSX2's own ImGui immediately before the emulator-owned swap.
+static GLContext* s_semu_context = nullptr;
+static u64 s_semu_context_generation = 0;
+static SemuRenderFrameGl s_semu_frame = {};
+static u64 s_semu_frame_id = 0;
+
+static void* SemuGetProcAddress(const char* name)
+{
+	return s_semu_context ? s_semu_context->GetProcAddress(name) : nullptr;
+}
+
+static void SemuClearFrame()
+{
+	std::memset(&s_semu_frame, 0, sizeof(s_semu_frame));
+}
+
+static void SemuBindContext(GLContext* context)
+{
+	if (s_semu_context != context)
+	{
+		s_semu_context = context;
+		s_semu_context_generation++;
+	}
+}
+
+// One frame to Semu's renderer: the picture at left,bottom (rows counted up from the window's bottom),
+// width by height window pixels holding native_width by native_height GS pixels, shown at aspect.
+static int SemuPublishFrame(GLContext* context, int left, int bottom, int width, int height,
+	int native_width, int native_height, float aspect, const GSVector2i& window)
+{
+	SemuClearFrame();
+	SemuBindContext(context);
+	if (++s_semu_frame_id == 0)
+		s_semu_frame_id = 1;
+
+	s_semu_frame.abi = SEMU_RENDER_ABI_GL;
+	s_semu_frame.struct_size = sizeof(s_semu_frame);
+	s_semu_frame.frame_id = s_semu_frame_id;
+	s_semu_frame.framebuffer = 0;
+	s_semu_frame.color_buffer = GL_BACK;
+	s_semu_frame.framebuffer_width = window.x;
+	s_semu_frame.framebuffer_height = window.y;
+	s_semu_frame.presentation_aspect = aspect;
+	s_semu_frame.layout_variant = SEMU_RENDER_LAYOUT_AUTO;
+	s_semu_frame.surface_count = 1;
+	s_semu_frame.surfaces[0].x = left;
+	s_semu_frame.surfaces[0].y = bottom;
+	s_semu_frame.surfaces[0].width = width;
+	s_semu_frame.surfaces[0].height = height;
+	s_semu_frame.surfaces[0].native_width = native_width;
+	s_semu_frame.surfaces[0].native_height = native_height;
+	s_semu_frame.surfaces[0].rotation = 0;
+	s_semu_frame.surfaces[0].origin = SEMU_RENDER_ORIGIN_BOTTOM_LEFT;
+	s_semu_frame.get_proc = SemuGetProcAddress;
+	s_semu_frame.context_generation = s_semu_context_generation;
+	return semu_render_game_gl(&s_semu_frame);
+}
+#endif
+
