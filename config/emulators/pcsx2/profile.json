{
  "schema_version": 1,
  "actions": {
    "external": [
      {
        "action": "app.quit",
        "chord": "Ctrl+Q",
        "consumer": "semu-input-supervisor",
        "semantics": "immediate process-group termination"
      }
    ]
  },
  "compiler": {
    "bindings": {
      "emulator_name": {
        "source": "emulator.name"
      },
      "pad": {
        "source": "platform.input.primary_device"
      },
      "bios_directory": {
        "source": "runtime.bios_directory"
      },
      "renderer_key": {
        "source": "platform.graphics.key"
      },
      "renderer_value": {
        "source": "platform.graphics.values.opengl"
      }
    },
    "line_groups": {
      "keymap_hotkeys": {
        "rows": "hotkeys.keymap",
        "format": "${setting} = ${chord}",
        "chord_encoding": {
          "mode": "joined",
          "modifiers": {
            "Ctrl": "Control"
          },
          "keys": {
            "+": "Plus",
            "-": "Minus",
            "Enter": "Return",
            "Esc": "Escape"
          },
          "modifier_format": "Keyboard/${value}",
          "key_format": "Keyboard/${value}",
          "separator": " & "
        }
      }
    }
  },
  "controller": {
    "ownership": "semu_generated",
    "source": "platform.input.primary_device",
    "consumer": "PCSX2 Pad1 input profile"
  },
  "doc": {
    "purpose": "PCSX2 profile tree content (config/inis/PCSX2.ini plus config/inputprofiles/Steam Deck.ini) as data, substituted by Pcsx2Emitter. Variables: ${pad} is the packaged platform's first SDL gamepad identity, ${bios_directory} the resolved read-only firmware folder, ${renderer_key}/${renderer_value} the contract's required OpenGL setting, ${emulator_name} the contract name.",
    "grammar": "PCSX2's ini wire format: one '<device>/<control>' binding per line (SDL3 setting names: FaceSouth/FaceEast/FaceWest/FaceNorth by position; the SDL2 names A/B/X/Y are migrated only while that pad is already connected, so at startup PCSX2 rejects them), an alternative ('Keyboard/<key>') as the same key repeated on the next line (PCSX2 reads repeated keys as a list and rejects ' | ' as an invalid binding), 'Keyboard/Control & Keyboard/P' hotkey chords (translated by Pcsx2Emitter from the keymap).",
    "menu": "ui.menu is Semu's alone: OpenPauseMenu is not bound, or the radial's Ctrl+M would open PCSX2's pause menu under Semu's and the menu's pause would then unpause it.",
    "hotkeys": "The keymap is written into PCSX2.ini [Hotkeys], the only hotkeys PCSX2 reads without a per-game input profile, and into the Steam Deck input profile as well. Seen in the podman VM 2026-10-03: with the hotkeys only in the profile, Ctrl+P and Ctrl+S did nothing in PCSX2 2.6.3."
  },
  "blocks": {
    "pad_sections": [
      "[Pad]",
      "UseProfileHotkeyBindings = true",
      "MultitapPort1 = false",
      "MultitapPort2 = false",
      "",
      "[InputSources]",
      "Keyboard = true",
      "Mouse = true",
      "SDL = true",
      "DInput = false",
      "XInput = false",
      "",
      "[Pad1]",
      "Type = DualShock2",
      "Up = ${pad}/DPadUp",
      "Up = Keyboard/Up",
      "Right = ${pad}/DPadRight",
      "Right = Keyboard/Right",
      "Down = ${pad}/DPadDown",
      "Down = Keyboard/Down",
      "Left = ${pad}/DPadLeft",
      "Left = Keyboard/Left",
      "Triangle = ${pad}/FaceNorth",
      "Triangle = Keyboard/I",
      "Circle = ${pad}/FaceEast",
      "Circle = Keyboard/X",
      "Cross = ${pad}/FaceSouth",
      "Cross = Keyboard/Z",
      "Square = ${pad}/FaceWest",
      "Square = Keyboard/A",
      "Select = ${pad}/Back",
      "Select = Keyboard/Backspace",
      "Start = ${pad}/Start",
      "Start = Keyboard/Enter",
      "L1 = ${pad}/LeftShoulder",
      "L2 = ${pad}/+LeftTrigger",
      "R1 = ${pad}/RightShoulder",
      "R2 = ${pad}/+RightTrigger",
      "L3 = ${pad}/LeftStick",
      "R3 = ${pad}/RightStick",
      "LUp = ${pad}/-LeftY",
      "LRight = ${pad}/+LeftX",
      "LDown = ${pad}/+LeftY",
      "LLeft = ${pad}/-LeftX",
      "RUp = ${pad}/-RightY",
      "RRight = ${pad}/+RightX",
      "RDown = ${pad}/+RightY",
      "RLeft = ${pad}/-RightX",
      "",
      "[Pad2]",
      "Type = None"
    ]
  },
  "hotkeys": {
    "keymap": [
      {
        "setting": "TogglePause",
        "action": "ui.pause"
      },
      {
        "setting": "ToggleFullscreen",
        "action": "ui.fullscreen"
      },
      {
        "setting": "PreviousSaveStateSlot",
        "action": "state.prev"
      },
      {
        "setting": "NextSaveStateSlot",
        "action": "state.next"
      },
      {
        "setting": "SaveStateToSlot",
        "action": "state.save",
        "slot": "selected"
      },
      {
        "setting": "LoadStateFromSlot",
        "action": "state.load",
        "slot": "selected"
      },
      {
        "setting": "Screenshot",
        "action": "ui.screenshot"
      },
      {
        "setting": "ToggleTurbo",
        "action": "speed.fast"
      },
      {
        "setting": "ToggleSlowMotion",
        "action": "speed.rewind"
      }
    ]
  },
  "files": [
    {
      "path": "${emulator_name}/config/inis/PCSX2.ini",
      "lines": [
        "[UI]",
        "SettingsVersion = 1",
        "InhibitScreensaver = true",
        "ConfirmShutdown = false",
        "StartPaused = false",
        "PauseOnFocusLoss = false",
        "StartFullscreen = true",
        "DoubleClickTogglesFullscreen = true",
        "HideMouseCursor = true",
        "RenderToSeparateWindow = false",
        "HideMainWindowWhenRunning = true",
        "DisableWindowResize = false",
        "PreferEnglishGameList = false",
        "Theme = darkfusionblue",
        "SetupWizardIncomplete = false",
        "",
        "[Folders]",
        "Bios = ${bios_directory}",
        "Snapshots = snaps",
        "Savestates = sstates",
        "MemoryCards = memcards",
        "Logs = logs",
        "Cheats = cheats",
        "Patches = patches",
        "UserResources = resources",
        "Cache = cache",
        "Textures = textures",
        "InputProfiles = inputprofiles",
        "",
        "[EmuCore]",
        "EnablePatches = true",
        "EnableWideScreenPatches = false",
        "EnableFastBoot = true",
        "UseSavestateSelector = true",
        "McdFolderAutoManage = true",
        "InputProfileName = Steam Deck",
        "",
        "[EmuCore/GS]",
        "AspectRatio = Auto 4:3/3:2",
        "IntegerScaling = true",
        "${renderer_key} = ${renderer_value}",
        "upscale_multiplier = 1",
        "filter = 0",
        "VsyncEnable = true",
        "",
        "@block:pad_sections",
        "",
        "[Hotkeys]",
        "@lines:keymap_hotkeys"
      ]
    },
    {
      "path": "${emulator_name}/config/inputprofiles/Steam Deck.ini",
      "lines": [
        "@block:pad_sections",
        "[Hotkeys]",
        "@lines:keymap_hotkeys"
      ]
    }
  ],
  "native_shortcuts": {
    "source": "pcsx2 bc8151d pcsx2/VMManager.cpp:541-546,565-595,663-685,932-985 and pcsx2/Input/InputManager.cpp:841-853",
    "fallback": false,
    "replaced_by": {
      "file": "config/PCSX2/inis/PCSX2.ini",
      "section": "[Hotkeys]"
    },
    "why": "PCSX2 binds hotkeys from PCSX2.ini [Hotkeys]: an input profile, and with it UseProfileHotkeyBindings, is applied only through a per-game settings ini naming it (UpdateGameSettingsLayer reads EmuCore.InputProfileName from the game layer alone), so the [EmuCore] InputProfileName in PCSX2.ini loads nothing and the profile's [Hotkeys] are written for per-game use only. A hotkey PCSX2.ini leaves out stays unbound (AddHotkeyBindings skips empty lists), and Pad::SetDefaultHotkeyConfig (SIO/Pad/Pad.cpp:216-262, which also puts Toggle Pause on Space and Toggle Turbo on Tab) runs only when settings are reset, which SettingsVersion = 1 prevents; its defaults would put Zoom In and Zoom Out on Ctrl+Plus and Ctrl+Minus (Semu's fast forward and rewind) and the pause menu on Escape.",
    "fixed": []
  }
}
