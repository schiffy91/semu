        "action": "ui.fullscreen"
      },
      {
        "setting": "Main%20Window\\Exit%20Azahar",
        "action": "app.quit",
        "platforms": [
          "macos"
        ]
      },
      {
        "setting": "Main%20Window\\Quick%20Load",
        "action": "state.load"
      },
      {
        "setting": "Main%20Window\\Quick%20Save",
        "action": "state.save"
      }
    ]
  },
