{
  "schema_version": 1,
  "compiler": {
    "bindings": {
      "emulator_name": {
        "source": "emulator.name"
      },
      "controller_guid": {
        "source": "input.device_identities.azahar_controller_guid",
        "transform": "lower"
      },
      "graphics_api": {
        "source": "platform.azahar.graphics_api"
      }
    },
    "line_groups": {
      "keymap_hotkeys": {
        "rows": "hotkeys.keymap",
        "format": "Shortcuts\\${setting}\\KeySeq=${chord}\nShortcuts\\${setting}\\KeySeq\\default=false",
        "chord_encoding": {
          "mode": "joined",
          "separator": "+",
          "keys": {
            "Enter": "Return"
          },
          "quote_commas": true
        }
      },
      "native_default_blanks": {
        "kind": "collisions",
        "rows": "native_shortcuts.defaults",
        "format": "Shortcuts\\${setting}\\KeySeq=\nShortcuts\\${setting}\\KeySeq\\default=false",
        "chord_encoding_of": "keymap_hotkeys",
        "except_rows": "hotkeys.keymap",
        "always": [
          "Main%20Window\\Rotate%20Screens%20Upright",
          "Main%20Window\\Swap%20Screens",
          "Main%20Window\\Toggle%20Screen%20Layout"
        ]
      }
    }
  },
  "controller_identity": "azahar_controller_guid",
  "hotkeys": {
    "keymap": [
      {
        "setting": "Main%20Window\\Load%20File",
        "action": "ui.open"
      },
      {
        "setting": "Main%20Window\\Continue\\Pause%20Emulation",
