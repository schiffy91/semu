+// Semu draws the picture itself (VK_LAYER_SEMU_compositor): its bezel places the screens where this
+// layout does not, so a touch on the composed picture is first mapped back to the point this layout
+// drew there. Without Semu the coordinates pass through unchanged.
+enum class SemuTouch { Unavailable, Mapped, Outside };
+
+static SemuTouch SemuTouchUnmap(unsigned& framebuffer_x, unsigned& framebuffer_y, bool clamp) {
+    using Unmap = int (*)(float, float, int, float*, float*);
+    static const Unmap unmap = []() -> Unmap {
+        if (void* global = dlsym(RTLD_DEFAULT, "semu_touch_unmap"))  // macOS: the stand-in for MoltenVK
+            return reinterpret_cast<Unmap>(global);
+        void* handle = nullptr;
+        if (const char* library = std::getenv("SEMU_TOUCH_LIBRARY"))
+            handle = dlopen(library, RTLD_NOW | RTLD_NOLOAD);
+        if (!handle)
+            handle = dlopen("libsemuvulkan.so", RTLD_NOW | RTLD_NOLOAD);
+        return handle ? reinterpret_cast<Unmap>(dlsym(handle, "semu_touch_unmap")) : nullptr;
+    }();
+    float x = 0.f;
+    float y = 0.f;
+    const int result =
+        unmap ? unmap(static_cast<float>(framebuffer_x), static_cast<float>(framebuffer_y), clamp ? 1 : 0, &x, &y) : -1;
+    if (result < 0)
+        return SemuTouch::Unavailable;
+    if (result == 0)
+        return SemuTouch::Outside;
+    framebuffer_x = static_cast<unsigned>(std::max(x, 0.f));
+    framebuffer_y = static_cast<unsigned>(std::max(y, 0.f));
+    return SemuTouch::Mapped;
+}
