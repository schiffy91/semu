{
  "schema_version": 1,
  "name": "Azahar",
  "default_system": "n3ds",
  "input": {
    "actions": [
      "ui.open",
      "ui.pause",
      "ui.screenshot",
      "ui.fullscreen",
      "app.quit",
      "state.load",
      "state.save",
      "screen.swap"
    ]
  },
  "platforms": {
    "linux": {
      "executable": "${asset_root}/bin/azahar",
      "args": [
        "-f"
      ],
      "graphics": {
        "method": "config_file",
        "file": "${state_root}/config/azahar-emu/qt-config.ini",
        "format": "ini",
        "section": "Renderer",
        "key": "graphics_api",
        "values": {
          "vulkan": "2"
        },
        "extra_pins": [
          {
            "section": "Renderer",
            "key": "async_presentation",
            "value": "false"
          },
          {
            "section": "Renderer",
            "key": "use_integer_scaling",
            "value": "true"
          }
        ]
      },
      "state": {
        "config_home": "xdg",
        "data_home": "xdg",
        "config_subdir": "azahar-emu",
        "data_subdir": "azahar-emu",
        "seeds": [
          {
            "purpose": "n3ds_aes_keys",
            "target": "${state_root}/data/azahar-emu/sysdata/aes_keys.txt",
            "copy": "once_if_target_absent",
            "source_access": "read_only",
            "overwrite": false,
            "sources": [
              "${emulation_root}/bios/aes_keys.txt",
              "${emulation_root}/bios/n3ds/aes_keys.txt",
              "${bios}/n3ds/aes_keys.txt",
              "${bios}/aes_keys.txt"
            ]
          },
          {
            "purpose": "n3ds_seed_database",
            "target": "${state_root}/data/azahar-emu/sysdata/seeddb.bin",
            "copy": "once_if_target_absent",
            "source_access": "read_only",
            "overwrite": false,
            "sources": [
              "${emulation_root}/bios/seeddb.bin",
              "${emulation_root}/bios/n3ds/seeddb.bin",
              "${bios}/n3ds/seeddb.bin",
              "${bios}/seeddb.bin"
            ]
          },
          {
            "purpose": "nand",
            "target": "${state_root}/data/azahar-emu/nand",
            "copy": "once_if_target_absent",
            "source_access": "read_only",
            "overwrite": false,
            "sources": [
              "${emulation_root}/Azahar/data/nand"
            ]
          },
          {
            "purpose": "sdmc",
            "target": "${state_root}/data/azahar-emu/sdmc",
            "copy": "once_if_target_absent",
            "source_access": "read_only",
            "overwrite": false,
            "sources": [
              "${emulation_root}/Azahar/data/sdmc"
            ]
          }
        ]
      },
      "firmware": {
        "dir": "${emulation_root}/bios",
        "fallback_dirs": [
          "${bios}/n3ds",
          "${bios}"
        ]
      },
      "env": {
        "set": {
          "QT_QPA_PLATFORM": "xcb"
        }
      },
      "azahar": {
        "graphics_api": "2"
      },
      "render_vulkan": true
    },
    "macos": {
      "executable": "${asset_root}/Applications/azahar.app/Contents/MacOS/azahar",
      "args": [
        "-f"
      ],
      "graphics": {
        "method": "config_file",
        "file": "${state_root}/config/azahar-emu/qt-config.ini",
        "format": "ini",
        "section": "Renderer",
        "key": "graphics_api",
        "values": {
          "vulkan": "2"
        },
        "extra_pins": [
          {
            "section": "Renderer",
            "key": "async_presentation",
            "value": "false"
          },
          {
            "section": "Renderer",
            "key": "use_integer_scaling",
            "value": "true"
          }
        ]
      },
      "state": {
        "config_home": "xdg",
        "data_home": "xdg",
        "config_subdir": "azahar-emu",
        "data_subdir": "azahar-emu",
        "seeds": [
          {
            "purpose": "n3ds_aes_keys",
            "target": "${state_root}/data/azahar-emu/sysdata/aes_keys.txt",
            "copy": "once_if_target_absent",
            "source_access": "read_only",
            "overwrite": false,
            "sources": [
              "${emulation_root}/bios/aes_keys.txt",
              "${emulation_root}/bios/n3ds/aes_keys.txt",
              "${bios}/n3ds/aes_keys.txt",
              "${bios}/aes_keys.txt"
            ]
          },
          {
            "purpose": "n3ds_seed_database",
            "target": "${state_root}/data/azahar-emu/sysdata/seeddb.bin",
            "copy": "once_if_target_absent",
            "source_access": "read_only",
            "overwrite": false,
            "sources": [
              "${emulation_root}/bios/seeddb.bin",
              "${emulation_root}/bios/n3ds/seeddb.bin",
              "${bios}/n3ds/seeddb.bin",
              "${bios}/seeddb.bin"
            ]
          },
          {
            "purpose": "nand",
            "target": "${state_root}/data/azahar-emu/nand",
            "copy": "once_if_target_absent",
            "source_access": "read_only",
            "overwrite": false,
            "sources": [
              "${emulation_root}/Azahar/data/nand"
            ]
          },
          {
            "purpose": "sdmc",
            "target": "${state_root}/data/azahar-emu/sdmc",
            "copy": "once_if_target_absent",
            "source_access": "read_only",
            "overwrite": false,
            "sources": [
              "${emulation_root}/Azahar/data/sdmc"
            ]
          }
        ]
      },
      "firmware": {
        "dir": "${emulation_root}/bios",
        "fallback_dirs": [
          "${bios}/n3ds",
          "${bios}"
        ]
      },
      "azahar": {
        "graphics_api": "2"
      },
      "window_shim": true,
      "render_vulkan": true
    }
  },
  "doc": {
    "launch": "The source-built Azahar binary consumes --fullscreen followed by one positional ROM path.",
    "state": "Azahar reads configuration from $XDG_CONFIG_HOME/azahar-emu and keeps NAND, SDMC saves, save states, cache, and logs below the isolated $XDG_DATA_HOME/$XDG_CACHE_HOME state roots. Named key files are first-run copies; external sources are never modified.",
    "rendering": "Vulkan on both platforms (Apple builds have no OpenGL renderer). render_vulkan composes Semu's bezel and shader into the swapchain image at present: on Linux through VK_LAYER_SEMU_compositor, on macOS through Semu's stand-in for MoltenVK (lib/semu-vulkan). The semu-touch patch maps a click on the composed picture back to Azahar's own layout.",
    "display": "Azahar's Qt window refuses shared OpenGL contexts on the Wayland platform plugin; QT_QPA_PLATFORM=xcb runs it on XWayland."
  }
}
