{
  "schema_version": 1,
  "name": "Ryujinx",
  "default_system": "switch",
  "input": {
    "actions": [
      "app.quit"
    ]
  },
  "platforms": {
    "linux": {
      "executable": "${asset_root}/bin/Ryujinx",
      "args": [
        "--fullscreen",
        "--graphics-backend",
        "vulkan"
      ],
      "graphics": {
        "method": "cli"
      },
      "state": {
        "config_home": "xdg",
        "data_home": "xdg",
        "extra_args": [
          "--root-data-dir",
          "${state_root}/config/Ryujinx"
        ],
        "config_subdir": "Ryujinx",
        "seeds": [
          {
            "purpose": "prod_keys",
            "target": "${state_root}/config/Ryujinx/system/prod.keys",
            "copy": "once_if_target_absent",
            "source_access": "read_only",
            "overwrite": false,
            "sources": [
              "${semu_home}/firmware/ryujinx/prod.keys",
              "${emulation_root}/Ryujinx/config/system/prod.keys",
              "${bios}/switch/prod.keys"
            ]
          },
          {
            "purpose": "title_keys",
            "target": "${state_root}/config/Ryujinx/system/title.keys",
            "copy": "once_if_target_absent",
            "source_access": "read_only",
            "overwrite": false,
            "sources": [
              "${semu_home}/firmware/ryujinx/title.keys",
              "${emulation_root}/Ryujinx/config/system/title.keys",
              "${bios}/switch/title.keys"
            ]
          },
          {
            "purpose": "switch_firmware",
            "target": "${state_root}/config/Ryujinx/bis",
            "copy": "once_if_target_absent",
            "source_access": "read_only",
            "overwrite": false,
            "sources": [
              "${emulation_root}/Ryujinx/config/bis",
              "${bios}/switch/bis"
            ]
          }
        ]
      },
      "firmware": {
        "dir": "${state_root}/config/Ryujinx/system",
        "fallback_dirs": [
          "${emulation_root}/Ryujinx/config/system",
          "${bios}/switch"
        ],
        "content_dirs": [
          "${state_root}/config/Ryujinx/bis/system/Contents/registered",
          "${emulation_root}/Ryujinx/config/bis/system/Contents/registered"
        ]
      },
      "ryujinx": {
        "use_hypervisor": "true"
      },
      "render_vulkan": true
    },
    "macos": {
      "executable": "${asset_root}/bin/Ryujinx",
      "graphics": {
        "method": "cli"
      },
      "state": {
        "config_home": "preserve",
        "data_home": "preserve",
        "extra_args": [
          "--root-data-dir",
          "${state_root}/config/Ryujinx"
        ],
        "config_subdir": "Ryujinx",
        "seeds": [
          {
            "purpose": "prod_keys",
            "target": "${state_root}/config/Ryujinx/system/prod.keys",
            "copy": "once_if_target_absent",
            "source_access": "read_only",
            "overwrite": false,
            "sources": [
              "${semu_home}/firmware/ryujinx/prod.keys",
              "${emulation_root}/Ryujinx/config/system/prod.keys",
              "${bios}/switch/prod.keys"
            ]
          },
          {
            "purpose": "title_keys",
            "target": "${state_root}/config/Ryujinx/system/title.keys",
            "copy": "once_if_target_absent",
            "source_access": "read_only",
            "overwrite": false,
            "sources": [
              "${semu_home}/firmware/ryujinx/title.keys",
              "${emulation_root}/Ryujinx/config/system/title.keys",
              "${bios}/switch/title.keys"
            ]
          },
          {
            "purpose": "switch_firmware",
            "target": "${state_root}/config/Ryujinx/bis",
            "copy": "once_if_target_absent",
            "source_access": "read_only",
            "overwrite": false,
            "sources": [
              "${emulation_root}/Ryujinx/config/bis",
              "${bios}/switch/bis"
            ]
          }
        ]
      },
      "firmware": {
        "dir": "${state_root}/config/Ryujinx/system",
        "fallback_dirs": [
          "${emulation_root}/Ryujinx/config/system",
          "${bios}/switch"
        ],
        "content_dirs": [
          "${state_root}/config/Ryujinx/bis/system/Contents/registered",
          "${emulation_root}/Ryujinx/config/bis/system/Contents/registered"
        ]
      },
      "args": [
        "--fullscreen",
        "--graphics-backend",
        "vulkan"
      ],
      "ryujinx": {
        "use_hypervisor": "false"
      },
      "window_shim": true,
      "render_vulkan": true
    }
  },
  "doc": {
    "package": "Linux executes only the bundled source-built ${asset_root}/bin/Ryujinx. There is no Flatpak, host binary, or prebuilt Linux fallback.",
    "fullscreen": "The pinned desktop parser consumes --fullscreen before the final ROM argument. Both platforms pass --graphics-backend vulkan.",
    "input": "The managed Config.json contains the active Player1 GamepadSDL2 binding for the target Steam virtual controller. Ryujinx has no native save-state contract; app.quit remains process-group owned.",
    "keys": "prod.keys and title.keys are copied into the isolated root-data system directory from read-only external/project sources without modifying those sources.",
    "saves": "Native Switch game saves are emulator-owned at ${state_root}/config/Ryujinx/bis/user/save. Profile convergence owns only Config.json, so save data and installed firmware remain untouched.",
    "rendering": "Vulkan on both platforms. render_vulkan composes Semu's bezel and shader into the swapchain image at present: on Linux through VK_LAYER_SEMU_compositor, on macOS through Semu's stand-in placed as Ryujinx's own libMoltenVK.dylib (packaging/nix/ryujinx_semu.nix)."
  }
}
