  "native_shortcuts": {
    "source": "Semu writes Ryujinx 1.3.3's whole Config.json, hotkeys included",
    "fallback": false,
    "replaced_by": {
      "file": "config/Ryujinx/Config.json",
      "section": "\"hotkeys\""
    },
    "why": "The hotkeys object is Semu's own data (F-keys and Unbound), so no Ryujinx default applies; Ryujinx matches a hotkey key without modifiers, and no Semu chord's key is one of F1, F2, F4, F5 or F8.",
