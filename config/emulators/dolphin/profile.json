  "native_shortcuts": {
    "source": "dolphin c77bbaa Source/Core/InputCommon/InputConfig.cpp:70-100 and ControllerEmu/ControlGroup/ControlGroup.cpp:58-75",
    "fallback": false,
    "replaced_by": {
      "file": "dolphin-user/Config/Hotkeys.ini",
      "section": "[Hotkeys]"
    },
    "why": "Once Hotkeys.ini has a section, InputConfig::LoadConfig loads it and ControlGroup::LoadConfig reads every control the file leaves out as an empty expression; HotkeyManager::LoadDefaults (HotkeyManager.cpp:395-476) runs only without the file. Semu writes the whole [Hotkeys] section, so none of the defaults apply, among them Skylanders Portal on Ctrl+P, which would fire beside Toggle Pause.",
    "fixed": []
  },
