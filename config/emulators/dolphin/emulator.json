{
  "schema_version": 1,
  "name": "Dolphin",
  "default_system": "gc",
  "input": {
    "actions": [
      "ui.open",
      "ui.pause",
      "ui.screenshot",
      "ui.fullscreen",
      "app.quit",
      "state.prev",
      "state.next",
      "state.load",
      "state.save",
      "wii.controller.wiimote",
      "wii.controller.nunchuk",
      "wii.controller.classic",
      "wii.controller.gamecube"
    ]
  },
  "platforms": {
    "linux": {
      "executable": "${asset_root}/bin/dolphin-emu",
      "args": [
        "-u",
        "${state_root}/dolphin-user",
        "--config",
        "Dolphin.Display.Fullscreen=True",
        "-b",
        "-e"
      ],
      "graphics": {
        "method": "config_file",
        "file": "${state_root}/dolphin-user/Config/Dolphin.ini",
        "format": "ini",
        "section": "Core",
        "key": "GFXBackend",
        "values": {
          "opengl": "OGL"
        }
      },
      "state": {
        "config_home": "preserve",
        "data_home": "preserve",
        "profile_config_dir": "${state_root}/dolphin-user/Config",
        "seeds": [
          {
            "purpose": "gamecube_saves",
            "target": "${state_root}/dolphin-user/GC",
            "copy": "once_if_target_absent",
            "source_access": "read_only",
            "overwrite": false,
            "sources": [
              "${emulation_root}/Dolphin/data/GC"
            ]
          },
          {
            "purpose": "wii_nand",
            "target": "${state_root}/dolphin-user/Wii",
            "copy": "once_if_target_absent",
            "source_access": "read_only",
            "overwrite": false,
            "sources": [
              "${emulation_root}/Dolphin/data/Wii"
            ]
          }
        ]
      },
      "render_preload": true
    },
    "macos": {
      "executable": "${asset_root}/Applications/Dolphin.app/Contents/MacOS/Dolphin",
      "state": {
        "config_home": "preserve",
        "data_home": "preserve",
        "profile_config_dir": "${state_root}/dolphin-user/Config"
      },
      "args": [
        "-u",
        "${state_root}/dolphin-user",
        "--config",
        "Dolphin.Display.Fullscreen=True",
        "-b",
        "-e"
      ],
      "window_shim": true,
      "render_preload": true
    }
  },
  "doc": {
    "runtime": "Linux executes the pinned source-built Dolphin package from the bundle asset root; macOS runs the Dolphin.app from the same pin.",
    "rendering": "OpenGL is forced in the managed profile. render_preload composes Semu's bezel and shader at the swap, reading the emulator's back buffer and writing the composed frame back: on Linux libsemupreload at the SDL/EGL swap, on macOS the window shim at -[NSOpenGLContext flushBuffer].",
    "user_directory": "The explicit -u path keeps Dolphin's live Config tree under Semu's per-emulator state root on every platform."
  }
}
