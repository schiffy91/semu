{
  "schema_version": 1,
  "compiler": {
    "bindings": {
      "emulator_name": {
        "source": "emulator.name"
      },
      "renderer_value": {
        "source": "platform.graphics.values.opengl"
      },
      "use_gl_value": {
        "source": "platform.graphics.extra_pins.0.value"
      }
    },
    "line_groups": {
      "native_hotkeys": {
        "rows": "actions.native",
        "format": "${setting} = ${chord}",
        "chord_encoding": {
          "mode": "sum",
          "modifiers": {
            "Ctrl": 67108864,
            "Alt": 134217728,
            "Shift": 33554432,
            "Meta": 268435456
          },
          "keys": {
            "P": 80,
            "Q": 81,
            "+": 43,
            "Tab": 16777217,
            "Enter": 16777220
          }
        }
      }
    }
  },
  "controller": {
    "joystick_id": 0,
    "device": "SDL2 raw joystick zero",
    "source": "Steam Virtual Gamepad",
    "quit_chord": [
      "select",
      "start"
    ],
    "quit_owner": "steamdeck process-group watcher",
    "quit_semantics": "immediate"
  },
  "storage": {
    "config": "${state_root}/config/melonDS/melonDS.toml",
    "game_saves": "${state_root}/data/melonDS/saves",
    "save_states": "${state_root}/data/melonDS/states",
    "cheats": "${state_root}/data/melonDS/cheats",
    "firmware_copies": "${state_root}/config/melonDS/firmware",
    "external_content_read_only": true,
    "rom_adjacent_save_import": "read_once_when_state_save_is_absent"
  },
  "actions": {
    "native": [
      {
        "setting": "HK_Pause",
        "action": "ui.pause",
        "chord": "Ctrl+P",
        "consumer": "EmuThread::HK_Pause"
      },
      {
        "setting": "HK_FullscreenToggle",
        "action": "ui.fullscreen",
        "chord": "Ctrl+Enter",
        "consumer": "EmuThread::HK_FullscreenToggle"
      },
      {
        "setting": "HK_FastForwardToggle",
        "action": "speed.fast",
        "chord": "Ctrl++",
        "consumer": "EmuThread::HK_FastForwardToggle"
      },
      {
        "setting": "HK_SwapScreens",
        "action": "screen.swap",
        "chord": "Ctrl+Tab",
        "consumer": "EmuThread::HK_SwapScreens"
      }
    ],
    "external": [
      {
        "action": "app.quit",
        "chord": "Ctrl+Q",
        "keyboard_consumer": "semu-input-supervisor",
        "physical_consumer": "steamdeck process-group watcher",
        "semantics": "immediate"
      },
      {
        "action": "state.save",
        "chord": "Ctrl+S",
        "keyboard_consumer": "MainWindow::actSaveState[1]",
        "native_slot": 1,
        "native_chord": "Shift+F1"
      },
      {
        "action": "state.load",
        "chord": "Ctrl+A",
        "keyboard_consumer": "MainWindow::actLoadState[1]",
        "native_slot": 1,
        "native_chord": "F1"
      }
    ]
  },
  "files": [
    {
      "path": "${emulator_name}/config/melonDS.toml",
      "lines": [
        "[3D]",
        "Renderer = ${renderer_value}",
        "",
        "[3D.GL]",
        "ScaleFactor = 1",
        "BetterPolygons = false",
        "HiresCoordinates = true",
        "",
        "[Screen]",
        "UseGL = ${use_gl_value}",
        "Filter = false",
        "VSync = true",
        "VSyncInterval = 1",
        "",
        "[Emu]",
        "ConsoleType = 0",
        "DirectBoot = true",
        "ExternalBIOSEnable = false",
        "",
        "[DS]",
        "BIOS9Path = \"firmware/bios9.bin\"",
        "BIOS7Path = \"firmware/bios7.bin\"",
        "FirmwarePath = \"firmware/firmware.bin\"",
        "",
        "[Instance0]",
        "JoystickID = 0",
        "SaveFilePath = \"${state_root}/data/melonDS/saves\"",
        "SavestatePath = \"${state_root}/data/melonDS/states\"",
        "CheatFilePath = \"${state_root}/data/melonDS/cheats\"",
        "PauseLostFocus = false",
        "MuteFastForward = false",
        "",
        "[Instance0.Joystick]",
        "A = 1",
        "B = 0",
        "Select = 6",
        "Start = 7",
        "Right = 258",
        "Left = 264",
        "Up = 257",
        "Down = 260",
        "R = 5",
        "L = 4",
        "X = 3",
        "Y = 2",
        "",
        "[Instance0.Keyboard]",
        "@lines:native_hotkeys",
        "",
        "[Instance0.Window0]",
        "ScreenRotation = 0",
        "ScreenGap = 0",
        "ScreenLayout = 2",
        "ScreenSwap = false",
        "ScreenSizing = 0",
        "IntegerScaling = true",
        "ScreenAspectTop = 0",
        "ScreenAspectBot = 0",
        "ShowOSD = false"
      ]
    }
  ],
  "doc": {
    "controller": "melonDS reads raw SDL joystick buttons (SDL_JoystickGetButton), not game-controller buttons, and encodes a hat direction as 0x100 | hat << 4 | direction. On the Steam Virtual Gamepad (xpad layout) the raw buttons are A 0, B 1, X 2, Y 3, LB 4, RB 5, View 6, Menu 7, Guide 8, stick clicks 9/10, and the D-pad is hat 0: DS A/B/X/Y deliberately follow Nintendo east/south/north/west positions (1/0/3/2), shoulders are 4/5, Select/Start 6/7, and the D-pad is 257 up, 258 right, 260 down, 264 left. Touch remains melonDS pointer input for the Deck trackpad.",
    "quit": "Select and Start remain independent DS inputs. The target-owned evdev watcher observes the physical pair and terminates the emulator process group immediately; radial app.quit emits Qt's standard Ctrl+Q shortcut.",
    "hotkeys": "The emitter compiles four configurable Semu chords into melonDS's native hotkey table. melonDS saves and loads slot 1 only through its compiled menu shortcuts Shift+F1 and F1 (Window.cpp:318-343), never Ctrl+S and Ctrl+A, so those rows carry native_chord and the supervisor types Shift+F1 or F1 for a save or load from any source, the radial's Ctrl+S included. Ctrl+Q quits melonDS through its own Quit shortcut too, the same action the supervisor runs. Every declared action appears exactly once across native and external ownership lanes.",
    "geometry": "Horizontal layout id 2, even sizing id 0, zero gap, native 4:3 aspects, zero rotation, and no initial swap preserve two equal 256x192 LCD surfaces. Ctrl+Tab may swap positions without changing semantic tap order.",
    "storage": "Relative writable asset paths are interpreted by the source patch from $XDG_CONFIG_HOME/melonDS and resolve into $XDG_DATA_HOME/melonDS. External BIOS and ROM-adjacent save sources stay read-only; only isolated copies/state are writable."
  },
  "native_shortcuts": {
    "source": "melonds 906e9eb src/frontend/qt_sdl/Config.cpp:51 and src/frontend/qt_sdl/Window.cpp:247,318-349,363",
    "fallback": true,
    "why": "Every keyboard key and hotkey defaults to -1, unbound (DefaultInts \"Instance*.Keyboard\"), so there is no configurable default to blank. The menu shortcuts are compiled in and cannot be changed: they are listed under fixed.",
    "defaults": [],
    "fixed": [
      {
        "key": "Ctrl+O",
        "action": "ui.open",
        "consumer": "MainWindow::actOpenROM (QKeySequence::Open)"
      },
      {
        "key": "Ctrl+Q",
        "action": "app.quit",
        "consumer": "MainWindow::actQuit (QKeySequence::Quit)"
      },
      {
        "key": "Shift+F1",
        "action": "state.save",
        "consumer": "MainWindow::actSaveState[1]"
      },
      {
        "key": "F1",
        "action": "state.load",
        "consumer": "MainWindow::actLoadState[1]"
      },
      {
        "key": "Shift+F2",
        "consumer": "MainWindow::actSaveState[2]"
      },
      {
        "key": "Shift+F3",
        "consumer": "MainWindow::actSaveState[3]"
      },
      {
        "key": "Shift+F4",
        "consumer": "MainWindow::actSaveState[4]"
      },
      {
        "key": "Shift+F5",
        "consumer": "MainWindow::actSaveState[5]"
      },
      {
        "key": "Shift+F6",
        "consumer": "MainWindow::actSaveState[6]"
      },
      {
        "key": "Shift+F7",
        "consumer": "MainWindow::actSaveState[7]"
      },
      {
        "key": "Shift+F8",
        "consumer": "MainWindow::actSaveState[8]"
      },
      {
        "key": "Shift+F9",
        "consumer": "MainWindow::actSaveState[0] (save to a file)"
      },
      {
        "key": "F2",
        "consumer": "MainWindow::actLoadState[2]"
      },
      {
        "key": "F3",
        "consumer": "MainWindow::actLoadState[3]"
      },
      {
        "key": "F4",
        "consumer": "MainWindow::actLoadState[4]"
      },
      {
        "key": "F5",
        "consumer": "MainWindow::actLoadState[5]"
      },
      {
        "key": "F6",
        "consumer": "MainWindow::actLoadState[6]"
      },
      {
        "key": "F7",
        "consumer": "MainWindow::actLoadState[7]"
      },
      {
        "key": "F8",
        "consumer": "MainWindow::actLoadState[8]"
      },
      {
        "key": "F9",
        "consumer": "MainWindow::actLoadState[0] (load from a file)"
      },
      {
        "key": "F12",
        "consumer": "MainWindow::actUndoStateLoad"
      }
    ]
  }
}
