{
  "schema_version": 1,
  "id": "melonds",
  "platforms": [
    "x86_64-linux"
  ],
  "graphics_apis": [
    "opengl"
  ],
  "outputs": {
    "main_program": "bin/melonDS",
    "main_program_name": "melonDS",
    "linked_program": "bin/.melonDS-wrapped"
  },
  "native_actions": {
    "state.load": {
      "chord": "F1",
      "consumer": "MainWindow::actLoadState[1]",
      "slot": 1,
      "source_marker": "actLoadState[i]->setShortcut(QKeySequence(Qt::Key_F1 + i - 1));",
      "source_consumer_marker": "connect(actLoadState[i], &QAction::triggered, this, &MainWindow::onLoadState);"
    },
    "state.save": {
      "chord": "Shift+F1",
      "consumer": "MainWindow::actSaveState[1]",
      "slot": 1,
      "source_marker": "actSaveState[i]->setShortcut(QKeySequence(Qt::ShiftModifier | (Qt::Key_F1 + i - 1)));",
      "source_consumer_marker": "connect(actSaveState[i], &QAction::triggered, this, &MainWindow::onSaveState);"
    }
  },
  "metadata": {
    "description": "Accurate open-source Nintendo DS emulator",
    "homepage": "https://melonds.kuribo64.net/",
    "license": "gpl3Plus"
  },
  "doc": {
    "source": "The immutable GitHub revision and NAR hash are the exact source identity packaged by Semu and match the repository's locked nixpkgs melonDS dependency graph.",
    "states": "The pinned frontend (src/frontend/qt_sdl/Window.cpp:318-343 at 906e9eb) binds save slots 1-8 to Shift+F1-F8 and load slots 1-8 to F1-F8, and Semu builds it unpatched. Semu saves and loads slot 1 by typing Shift+F1 and F1 (the profile rows' native_chord), whatever sent the Ctrl+S or Ctrl+A."
  },
  "flake": "flake.nix"
}
