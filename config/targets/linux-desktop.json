{
  "schema_version": 2,
  "id": "linux-desktop",
  "platform": "linux",
  "nix_systems": [
    "x86_64-linux"
  ],
  "backend": "native",
  "input": "linux-desktop",
  "settings": {
    "paths": {
      "emulation_root": "${home}/Games/Emulation",
      "roms": "${home}/Games/Emulation/ES-DE/ES-DE/ROMs",
      "media": "${home}/Games/Emulation/ES-DE/ES-DE/downloaded_media",
      "bios": "${home}/Games/Emulation/RetroArch/config/system",
      "content_root": "${home}/Games/Emulation/Semu",
      "state_root": "${home}/.local/share/semu",
      "esde_home": "${home}/Games/Emulation/ES-DE"
    },
    "ui": {
      "display_index": 0
    }
  },
  "steam": {
    "name": "Semu",
    "launcher": "/run/current-system/sw/bin/semu-es-de",
    "start_dir": "${home}"
  }
}
