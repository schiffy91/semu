{
  "schema_version": 2,
  "id": "linux-desktop",
  "platform": "linux",
  "nix_systems": [
    "x86_64-linux"
  ],
  "backend": "native",
  "input": "linux-desktop",
  "settings": {
    "paths": {
      "root": "${home}/Games/Emulation",
      "state_root": "${home}/.cache/semu"
    },
    "ui": {
      "display_index": 0
    }
  },
  "steam": {
    "name": "Semu",
    "launcher": "/run/current-system/sw/bin/semu-es-de",
    "start_dir": "${home}",
    "input": "input/steam/steam_input.json"
  }
}
