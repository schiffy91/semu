{
  "schema_version": 2,
  "id": "steam-deck",
  "platform": "linux",
  "nix_systems": [
    "x86_64-linux"
  ],
  "backend": "native",
  "input": "steam-deck",
  "settings": {
    "paths": {
      "emulation_root": "/run/media/deck/SD/Emulation",
      "roms": "/run/media/deck/SD/Emulation/ES-DE/ES-DE/ROMs",
      "media": "/run/media/deck/SD/Emulation/ES-DE/ES-DE/downloaded_media",
      "bios": "/run/media/deck/SD/Emulation/RetroArch/config/system",
      "content_root": "/run/media/deck/SD/Emulation/Semu",
      "state_root": "${home}/.local/share/semu",
      "esde_home": "/run/media/deck/SD/Emulation/ES-DE"
    },
    "ui": {
      "display_index": 0
    }
  },
  "steam": {
    "name": "Semu",
    "launcher": "${home}/Applications/Semu/bin/semu-deck",
    "start_dir": "${home}"
  }
}
