{
  "schema_version": 2,
  "id": "steam-deck",
  "platform": "linux",
  "nix_systems": [
    "x86_64-linux"
  ],
  "backend": "native",
  "input": "steam-deck",
  "settings": {
    "paths": {
      "root": "${home}/Drive/media/Games/Emulation",
      "state_root": "${home}/.cache/semu"
    },
    "ui": {
      "display_index": 0
    },
    "visual": {
      "display": {
        "width": 1280,
        "height": 800
      }
    },
    "input": {
      "systems": {
        "switch": {
          "play_mode": "handheld"
        }
      }
    }
  },
  "steam": {
    "name": "Semu",
    "launcher": "${home}/Applications/Semu/bin/semu-deck",
    "start_dir": "${home}",
    "input": "input/steam/steam_input.json"
  }
}
