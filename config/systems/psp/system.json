{
  "schema_version": 1,
  "name": "Sony PlayStation Portable",
  "es_de": {
    "platforms": [
      "psp"
    ],
    "theme": "psp"
  },
  "rom": {
    "dir": "psp",
    "extensions": [
      ".chd",
      ".cso",
      ".elf",
      ".iso",
      ".pbp",
      ".prx",
      ".7z",
      ".zip"
    ]
  },
  "emulators": [
    {
      "emulator": "ppsspp",
      "platforms": [
        "linux"
      ]
    },
    {
      "emulator": "retroarch",
      "label": "PPSSPP (Libretro)",
      "core": "ppsspp",
      "platforms": [
        "linux",
        "macos"
      ]
    }
  ],
  "display": {
    "scaling": {
      "mode": "integer_preferred",
      "basis": "native_game_surface",
      "fit": "contain",
      "fallback": "fractional_downscale"
    },
    "screens": [
      {
        "id": "main",
        "native": {
          "w": 480,
          "h": 272
        }
      }
    ],
    "aspect": {
      "w": 30,
      "h": 17
    },
    "doc": {
      "aspect": "30:17 is the exact reduced ratio of the square-pixel 480x272 PSP LCD; it avoids the fractional horizontal distortion introduced by a nominal 16:9 override."
    },
    "refresh_hz": 59.94,
    "render_scale": {
      "choices": [
        1,
        2,
        3
      ],
      "default": 2,
      "doc": "PPSSPP draws the PSP's light 3D at 3x (1440x816) easily on the Deck. 2x is the default, the size the libretro path rendered on the Deck before (its whole step at 1280x800)."
    }
  },
  "doc": {
    "hardware": "480x272 PSP LCD",
    "intent": "Preserve the PSP LCD color response, pixel structure, and exact square-pixel panel ratio."
  }
}
