{
  "schema_version": 1,
  "name": "Sony PlayStation",
  "es_de": {
    "platforms": [
      "psx"
    ],
    "theme": "psx"
  },
  "rom": {
    "dir": "psx",
    "extensions": [
      ".bin",
      ".ccd",
      ".chd",
      ".cue",
      ".exe",
      ".img",
      ".iso",
      ".m3u",
      ".pbp",
      ".psexe",
      ".toc",
      ".7z",
      ".zip"
    ]
  },
  "emulators": [
    {
      "emulator": "retroarch",
      "label": "Beetle PSX",
      "label_aliases": [
        "SwanStation"
      ],
      "core": "mednafen_psx",
      "platforms": [
        "linux",
        "macos"
      ]
    }
  ],
  "display": {
    "scaling": {
      "mode": "integer_preferred",
      "basis": "native_game_surface",
      "fit": "contain",
      "fallback": "fractional_downscale"
    },
    "screens": [
      {
        "id": "main",
        "native": {
          "w": 320,
          "h": 240
        }
      }
    ],
    "aspect": {
      "w": 4,
      "h": 3
    },
    "widescreen": {
      "aspect": {
        "w": 16,
        "h": 9
      },
      "detect": "emulator_reported_content_aspect",
      "fallback": "default_aspect",
      "switch_at": "frame_boundary"
    },
    "refresh_hz": 59.94
  },
  "doc": {
    "hardware": "consumer CRT over composite/S-Video",
    "intent": "Preserve wobble/softness instead of HD-cleaning the output.",
    "bios": "Beetle PSX expects user-supplied PlayStation BIOS dumps.",
    "extensions": "Beetle PSX has no ECM decoder (\"File format is unknown to module psx\"), so .ecm is not offered. .7z and .zip stay because single-file archives load. Beetle reads .m3u itself."
  }
