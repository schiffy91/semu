{
  "schema_version": 1,
  "name": "Sony PlayStation",
  "es_de": {
    "platforms": [
      "psx"
    ],
    "theme": "psx"
  },
  "rom": {
    "dir": "psx",
    "extensions": [
      ".bin",
      ".ccd",
      ".chd",
      ".cue",
      ".exe",
      ".img",
      ".iso",
      ".m3u",
      ".pbp",
      ".toc",
      ".7z",
      ".zip"
    ]
  },
  "emulators": [
    {
      "emulator": "retroarch",
      "label": "Beetle PSX",
      "label_aliases": [
        "SwanStation"
      ],
      "core": "mednafen_psx",
      "platforms": [
        "linux",
        "macos"
      ]
    }
  ],
  "players": {
    "max": 2,
    "doc": "Two controller ports (a multitap is not modelled)."
  },
  "display": {
    "scaling": {
      "mode": "integer_preferred",
      "basis": "native_game_surface",
      "fit": "contain",
      "fallback": "fractional_downscale"
    },
    "screens": [
      {
        "id": "main",
        "native": {
          "w": 320,
          "h": 240
        }
      }
    ],
    "aspect": {
      "w": 4,
      "h": 3
    },
    "widescreen": {
      "aspect": {
        "w": 16,
        "h": 9
      },
      "detect": "emulator_reported_content_aspect",
      "fallback": "default_aspect",
      "switch_at": "frame_boundary"
    },
    "refresh_hz": 59.94,
    "render_scale": {
      "choices": [
        1,
        2
      ],
      "default": 1,
      "doc": "Beetle PSX's software renderer upscales on the CPU: 2x quadruples its rasterising, which the Deck's four cores carry; 4x (sixteen times) does not, and the core offers no 3x."
    }
  },
  "doc": {
    "hardware": "consumer CRT over composite/S-Video",
    "intent": "Preserve wobble/softness instead of HD-cleaning the output.",
    "bios": "Beetle PSX expects user-supplied PlayStation BIOS dumps.",
    "extensions": "Only what Beetle PSX declares it opens (it reads .m3u itself) plus the archives RetroArch unpacks. .psexe was dropped (.exe stays); it does not occur in the library."
  }
}
