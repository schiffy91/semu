{
  "schema_version": 1,
  "name": "Nintendo GameCube",
  "es_de": {
    "platforms": [
      "gc"
    ],
    "theme": "gc"
  },
  "rom": {
    "dir": "gc",
    "extensions": [
      ".ciso",
      ".dol",
      ".elf",
      ".gcm",
      ".gcz",
      ".iso",
      ".m3u",
      ".nkit.iso",
      ".rvz",
      ".tgc",
      ".wad",
      ".wbfs",
      ".wia",
      ".7z",
      ".zip"
    ]
  },
  "emulators": [
    {
      "emulator": "dolphin",
      "label_aliases": [
        "Dolphin (Standalone)"
      ]
    }
  ],
  "display": {
    "scaling": {
      "mode": "integer_preferred",
      "basis": "native_game_surface",
      "fit": "contain",
      "fallback": "fractional_downscale"
    },
    "screens": [
      {
        "id": "main",
        "native": {
          "w": 640,
          "h": 480
        }
      }
    ],
    "aspect": {
      "w": 4,
      "h": 3
    },
    "widescreen": {
      "aspect": {
        "w": 16,
        "h": 9
      },
      "detect": "emulator_reported_content_aspect",
      "fallback": "default_aspect",
      "switch_at": "frame_boundary"
    },
    "doc": {
      "native": "Real 1x emulator output (was a 256x240 placeholder that corrupted integer placement)."
    },
    "refresh_hz": 59.94
  },
  "doc": {
    "hardware": "consumer CRT or component CRT",
    "intent": "Dolphin is pinned to draw 4:3 (CustomStretch in GFX.ini) until it reports the aspect it draws; then its aspect setting can drive 4:3 vs 16:9 presentation."
  }
}
