{
  "schema_version": 1,
  "name": "Sega Dreamcast",
  "es_de": {
    "platforms": [
      "dreamcast"
    ],
    "theme": "dreamcast"
  },
  "rom": {
    "dir": "dreamcast",
    "extensions": [
      ".cdi",
      ".chd",
      ".cue",
      ".elf",
      ".gdi",
      ".iso",
      ".lst",
      ".m3u",
      ".7z",
      ".zip"
    ]
  },
  "emulators": [
    {
      "emulator": "flycast",
      "platforms": [
        "linux"
      ]
    },
    {
      "emulator": "retroarch",
      "label": "Flycast (Libretro)",
      "core": "flycast",
      "platforms": [
        "linux"
      ]
    }
  ],
  "display": {
    "scaling": {
      "mode": "integer_preferred",
      "basis": "native_game_surface",
      "fit": "contain",
      "fallback": "fractional_downscale"
    },
    "screens": [
      {
        "id": "main",
        "native": {
          "w": 640,
          "h": 480
        }
      }
    ],
    "aspect": {
      "w": 4,
      "h": 3
    },
    "widescreen": {
      "aspect": {
        "w": 16,
        "h": 9
      },
      "detect": "emulator_reported_content_aspect",
      "fallback": "default_aspect",
      "switch_at": "frame_boundary"
    },
    "refresh_hz": 59.94
  },
  "doc": {
    "hardware": "consumer CRT or VGA monitor",
    "intent": "Prefer 4:3 CRT; swap to 16:9/flat only when config or game profile proves widescreen. Linux and Steam Deck use the source-built standalone Flycast slice; Dreamcast is Linux-only, with no darwin Flycast build.",
    "bios": "Flycast can use HLE for many games, but original BIOS files improve compatibility."
  }
}
