#include <errno.h>
#include <fcntl.h>
#include <poll.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ioctl.h>
#include <sys/types.h>
#include <unistd.h>
#include "semu_evdev.h"

import Library.Console;
import Library.Strings;
import Library.Vector;
import ./input_state.btrc;
import ./input_filters.btrc;
import ./actions.btrc;
import ./controller_layouts.btrc;
import ./journal.btrc;
import ./process.btrc;
import ./plan.btrc;
import ./gamepad.btrc;
import ./x11_keys.btrc;
import ./menu_modal.btrc;
import ./input_devices.btrc;

struct SemuInputDevice SemuControllerDevices[SEMU_SUPERVISOR_DEVICES];  // GameController pads, one slot per connected controller
unsigned int SemuControllerButtons[SEMU_SUPERVISOR_DEVICES];  // last polled button bits per pad
void* SemuControllerIdentities[SEMU_SUPERVISOR_DEVICES];  // the GameController object each slot belongs to, null when free

class SemuInputEvents {  // evdev events to Semu actions and the quit chord
    class bool held(struct SemuInputDevice* device, int left, int right) { return device->down[left] != 0 || device->down[right] != 0; }

    class string keyboardAction(SemuLaunchPlan launch, struct SemuInputDevice* device, int code) {  // fires on the chord's own key with exactly its modifiers held
        for entry in launch.actionChords {
            int equals = SemuSupervisor.indexOf(entry, "=");
            if (equals < 0) { continue; }
            string action = entry.substring(0, equals);
            string chord = entry.substring(equals + 1, entry.len() - equals - 1);
            Vector<int> codes = SemuKeyNames.chord(chord);
            if (codes.isEmpty() || !SemuKeyNames.same(codes.get(codes.size() - 1), code)) { continue; }
            int leftControlKey = KEY_LEFTCTRL;
            int rightControlKey = KEY_RIGHTCTRL;
            int leftShiftKey = KEY_LEFTSHIFT;
            int rightShiftKey = KEY_RIGHTSHIFT;
            int leftAltKey = KEY_LEFTALT;
            int rightAltKey = KEY_RIGHTALT;
            int leftMetaKey = KEY_LEFTMETA;
            int rightMetaKey = KEY_RIGHTMETA;
            bool control = SemuInputEvents.held(device, leftControlKey, rightControlKey);
            bool shift = SemuInputEvents.held(device, leftShiftKey, rightShiftKey);
            bool alternate = SemuInputEvents.held(device, leftAltKey, rightAltKey);
            bool meta = SemuInputEvents.held(device, leftMetaKey, rightMetaKey);
            bool wantControl = false;
            bool wantShift = false;
            bool wantAlternate = false;
            bool wantMeta = false;
            for (int index = 0; index < codes.size() - 1; index++) {
                int modifier = codes.get(index);
                if (modifier == leftControlKey) { wantControl = true; }
                if (modifier == leftShiftKey) { wantShift = true; }
                if (modifier == leftAltKey) { wantAlternate = true; }
                if (modifier == leftMetaKey) { wantMeta = true; }
            }
            if (control == wantControl && shift == wantShift && alternate == wantAlternate && meta == wantMeta) { return action; }
        }
        if (SemuSupervisorRuntime.menu_visible != 0) {  // bare keys steer the open menu too
            int upward = KEY_UP;
            int downward = KEY_DOWN;
            int enter = KEY_ENTER;
            int space = KEY_SPACE;
            int backspace = KEY_BACKSPACE;
            int escape = KEY_ESC;
            int leftward = KEY_LEFT;
            int rightward = KEY_RIGHT;
            if (code == upward) { return "ui.menu.up"; }
            if (code == downward) { return "ui.menu.down"; }
            if (code == leftward) { return "ui.menu.left"; }  // steps a BEZEL or SHADER row
            if (code == rightward) { return "ui.menu.right"; }
            if (code == enter || code == space) { return "ui.menu.confirm"; }
            if (code == backspace || code == escape) { return "ui.menu.back"; }
        }
        return "";
    }

    class string gamepadAction(SemuLaunchPlan launch, struct SemuInputDevice* device, int code) {
        int modifier = SemuKeyNames.button(launch.chordModifier);
        if (modifier != 0 && code != modifier && device->down[modifier] != 0) {
            for (int index = 0; index < launch.chordButtons.size(); index++) {
                if (SemuKeyNames.button(launch.chordButtons.get(index)) == code) { return launch.chordActions.get(index); }
            }
            return "";
        }
        if (SemuSupervisorRuntime.menu_visible != 0) {
            int upward = BTN_DPAD_UP;
            int downward = BTN_DPAD_DOWN;
            int south = BTN_SOUTH;
            int east = BTN_EAST;
            int leftward = BTN_DPAD_LEFT;
            int rightward = BTN_DPAD_RIGHT;
            if (code == upward) { return "ui.menu.up"; }
            if (code == downward) { return "ui.menu.down"; }
            if (code == leftward) { return "ui.menu.left"; }  // steps a BEZEL or SHADER row
            if (code == rightward) { return "ui.menu.right"; }
            if (code == south) { return "ui.menu.confirm"; }
            if (code == east) { return "ui.menu.back"; }
        }
        return "";
    }

    class void hat(SemuLaunchPlan launch, struct SemuInputDevice* device, int axis, int value) {  // xpad style d-pads
        int hatX = ABS_HAT0X;
        int left = BTN_DPAD_LEFT;
        int right = BTN_DPAD_RIGHT;
        int upward = BTN_DPAD_UP;
        int downward = BTN_DPAD_DOWN;
        bool horizontal = axis == hatX;
        int previous = horizontal ? device->hat_x : device->hat_y;
        if (horizontal) { device->hat_x = value; } else { device->hat_y = value; }
        if (value == previous || value == 0) { return; }
        int code = downward;
        if (horizontal) { code = value < 0 ? left : right; } else if (value < 0) { code = upward; }
        SemuActionExecutor.fromDevice(launch, SemuInputEvents.gamepadAction(launch, device, code), device);
    }

    class void drain(SemuLaunchPlan launch, struct SemuInputDevice* device) {
        struct input_event events[32];
        while (true) {
            int handle = device->descriptor;
            ssize_t got = read(handle, events, sizeof(events));
            if (got <= (ssize_t)0) { return; }
            size_t count = (size_t)got / sizeof(struct input_event);
            long long now = SemuClock.milliseconds();
            for (size_t index = (size_t)0; index < count; index++) {
                int type = (int)events[index].type;
                int code = (int)events[index].code;
                int value = events[index].value;
                int absoluteType = EV_ABS;
                int hatX = ABS_HAT0X;
                int hatY = ABS_HAT0Y;
                int keyType = EV_KEY;
                if (type == absoluteType && device->gamepad != 0) { SemuPadRest.move(device, code, value); }  // whether the pad is at rest
                if (type == absoluteType && device->gamepad != 0 && (code == hatX || code == hatY)) {
                    SemuInputEvents.hat(launch, device, code, value);
                    continue;
                }
                if (type != keyType || value == 2) { continue; }  // autorepeat
                if (SemuInputEvents.key(launch, device, code, value, now)) { return; }
            }
        }
    }

    class bool key(SemuLaunchPlan launch, struct SemuInputDevice* device, int pressedCode, int value, long long now) {  // true once the quit chord completes
        int keyLimit = SEMU_SUPERVISOR_KEYS;
        if (pressedCode < 0 || pressedCode >= keyLimit) { return false; }
        int code = device->face_swapped != 0 ? SemuFaceLayout.positional(pressedCode) : pressedCode;
        bool press = value != 0 && device->down[code] == 0;
        device->down[code] = value != 0 ? 1 : 0;
        if (device->gamepad != 0) {
            if (SemuQuitChord.event(&device->quit_chord, code, value, now)) {
                SemuSupervisorRuntime.quit = 1;
                return true;
            }
            if (press) { SemuActionExecutor.fromDevice(launch, SemuInputEvents.gamepadAction(launch, device, code), device); }
        } else if (device->keyboard != 0 && press) {
            if (device->source == SEMU_SOURCE_X11 && SemuKeyEcho.consume(code, now)) { return false; }  // our own typing, back through X
            SemuActionExecutor.fromDevice(launch, SemuInputEvents.keyboardAction(launch, device, code), device);
        }
        return false;
    }

    class void keys(SemuLaunchPlan launch) {  // drains the key source: the X display's keyboard as one pseudo-device
        int code = 0;
        int pressed = 0;
        long long now = SemuClock.milliseconds();
        while (SemuX11KeyListener.next(&SemuSupervisorRuntime.key_source, &code, &pressed)) {
            if (SemuInputEvents.key(launch, &SemuSupervisorRuntime.x11_keyboard, code, pressed, now)) { return; }
        }
    }
}

class SemuGameControllers {  // macOS pads through GameController, fed to the same chord and actions
    class void reset() {
        memset(SemuControllerDevices, 0, sizeof(SemuControllerDevices));
        memset(SemuControllerButtons, 0, sizeof(SemuControllerButtons));
        memset(SemuControllerIdentities, 0, sizeof(SemuControllerIdentities));
    }

    class int slot(void* identity) {  // the pad's slot, claimed on first sight; -1 when every slot is taken
        int free = -1;
        for (int index = 0; index < SEMU_SUPERVISOR_DEVICES; index++) {
            if (SemuControllerIdentities[index] == identity) { return index; }
            if (free < 0 && SemuControllerIdentities[index] == null) { free = index; }
        }
        if (free < 0) { return -1; }
        struct SemuInputDevice* pad = &SemuControllerDevices[free];
        memset(pad, 0, sizeof(struct SemuInputDevice));
        pad->descriptor = -1;
        pad->gamepad = 1;
        pad->identity = (int)SEMU_IDENTITY_CONTROLLER_BASE + free;  // its own, as every evdev pad has
        memcpy(&pad->quit_chord, &SemuSupervisorRuntime.quit_template, sizeof(struct SemuChordState));
        SemuControllerButtons[free] = 0u;
        SemuControllerIdentities[free] = identity;
        return free;
    }

    class bool update(SemuLaunchPlan launch, int index, unsigned int pressed, long long now) {  // button edges become key events; true once quit fires
        unsigned int changed = pressed ^ SemuControllerButtons[index];
        SemuControllerButtons[index] = pressed;
        for (int bit = 0; bit < SEMU_GAMEPAD_BUTTONS; bit++) {
            unsigned int mask = 1u << bit;
            if ((changed & mask) == 0u) { continue; }
            int value = (pressed & mask) != 0u ? 1 : 0;
            if (SemuInputEvents.key(launch, &SemuControllerDevices[index], SemuGameControllerFramework.code(bit), value, now)) { return true; }
        }
        return false;
    }

    class int poll(SemuLaunchPlan launch) {  // returns connected pads
        void* identities[SEMU_SUPERVISOR_DEVICES];
        unsigned int pressed[SEMU_SUPERVISOR_DEVICES];
        int count = SemuGameControllerFramework.poll(identities, pressed, SEMU_SUPERVISOR_DEVICES);
        SemuGameControllers.apply(launch, identities, pressed, count, SemuClock.milliseconds());
        return count;
    }

    class void apply(SemuLaunchPlan launch, void** identities, unsigned int* pressed, int count, long long now) {  // one poll's pads; a pad that left releases what it held
        for (int index = 0; index < SEMU_SUPERVISOR_DEVICES; index++) {
            if (SemuControllerIdentities[index] == null) { continue; }
            bool present = false;
            for (int seen = 0; seen < count; seen++) {
                if (identities[seen] == SemuControllerIdentities[index]) { present = true; }
            }
            if (present) { continue; }
            bool quit = SemuGameControllers.update(launch, index, 0u, now);
            SemuControllerIdentities[index] = null;
            if (quit) { return; }
        }
        for (int seen = 0; seen < count; seen++) {
            int index = SemuGameControllers.slot(identities[seen]);
            if (index < 0) { continue; }
            if (SemuGameControllers.update(launch, index, pressed[seen], now)) { return; }
        }
    }
}

class SemuSupervisor {  // one action vocabulary for every emulator, until exit or quit
    class int indexOf(string haystack, string needle) {
        for (int index = 0; index + needle.len() <= haystack.len(); index++) {
            if (haystack.substring(index, needle.len()).equals(needle)) { return index; }
        }
        return -1;
    }

    class void begin(SemuLaunchPlan launch) {  // fresh runtime, configured chord, first device scan
        memset(&SemuSupervisorRuntime, 0, sizeof(SemuSupervisorRuntime));
        memset(SemuDevicePaths, 0, sizeof(SemuDevicePaths));
        SemuSupervisorRuntime.slot = 0;  // the first of the emulator's slots, shown as save_states.first_slot
        bool chord = SemuQuitChord.configure(&SemuSupervisorRuntime.quit_template, launch.quitButtons, launch.chordWindowMs);
        if (!chord) { Console.error("semu: the quit chord is not usable: " + SemuQuitChord.describe(launch.quitButtons)); }
        SemuActionJournal.reset(launch);
        SemuControllerLayouts.prepare(launch.players);  // Semu's one profile in the folder the emulator cycles
        if (getenv("SEMU_RENDER_DEBUG") != null) {
            for (int player0 = 0; player0 < launch.players.count; player0++) { Console.error("semu: player " + launch.players.row(player0)); }  // the pads dealt at launch
        }
        SemuInputDevices.scan(launch);
        SemuSupervisor.keySource();
        SemuX11KeyListener.connect(&SemuSupervisorRuntime.key_source);
        SemuGameControllers.reset();
        bool anyPad = SemuGameControllers.poll(launch) > 0;
        for (int index = 0; index < SemuSupervisorRuntime.device_count; index++) { if (SemuSupervisorRuntime.devices[index].gamepad != 0) { anyPad = true; } }
        if (!anyPad) { Console.error("semu: no gamepad found for the " + SemuQuitChord.describe(launch.quitButtons) + " quit chord"); }
    }

    class void keySource() {  // the X keyboard pseudo-device and an idle key source
        struct SemuInputDevice* keyboard = &SemuSupervisorRuntime.x11_keyboard;
        memset(keyboard, 0, sizeof(struct SemuInputDevice));
        keyboard->descriptor = -1;
        keyboard->keyboard = 1;
        keyboard->source = SEMU_SOURCE_X11;
        keyboard->identity = SEMU_SOURCE_X11;
        memset(&SemuSupervisorRuntime.key_source, 0, sizeof(struct SemuKeySource));
        SemuSupervisorRuntime.key_source.descriptor = -1;
    }

    class void pollDevices(SemuLaunchPlan launch) {  // one bounded wait for evdev devices and the key source, then drain them and update the menu's hold on the pads
        struct pollfd polls[SEMU_SUPERVISOR_DEVICES + 1];
        int count = SemuSupervisorRuntime.device_count;
        int open = 0;
        for (int index = 0; index < count; index++) {
            polls[index].fd = SemuSupervisorRuntime.devices[index].descriptor;
            polls[index].events = POLLIN;
            polls[index].revents = 0;
            if (polls[index].fd >= 0) { open++; }
        }
        struct SemuKeySource* source = &SemuSupervisorRuntime.key_source;
        bool keys = SemuX11KeyListener.active(source);
        polls[count].fd = keys ? source->descriptor : -1;
        polls[count].events = POLLIN;
        polls[count].revents = 0;
        if (keys) { open++; }
        int ready = 0;
        nfds_t total = (nfds_t)(count + 1);
        if (open > 0) { ready = poll(polls, total, SEMU_POLL_MS); } else { usleep(SEMU_POLL_MS * 1000); }
        if (ready > 0) { SemuSupervisor.drainReady(launch, polls, count, keys); }
        SemuPadModal.update(SemuClock.milliseconds());  // grabs once every pad is at rest, releases once the closing press is up
    }

    class void drainReady(SemuLaunchPlan launch, struct pollfd* polls, int count, bool keys) {  // the devices and key source poll() found readable
        struct SemuKeySource* source = &SemuSupervisorRuntime.key_source;
        for (int index = 0; index < count; index++) {
            int returned = (int)polls[index].revents;
            struct SemuInputDevice* device = &SemuSupervisorRuntime.devices[index];
            if (device->descriptor < 0) { continue; }
            if ((returned & (int)POLLIN) != 0) { SemuInputEvents.drain(launch, device); }
            if ((returned & ((int)POLLERR | (int)POLLHUP)) != 0) { SemuInputDevices.vacate(index); }
        }
        int sourceReturned = (int)polls[count].revents;
        if (keys && (sourceReturned & (int)POLLIN) != 0) { SemuInputEvents.keys(launch); }
        if (keys && (sourceReturned & ((int)POLLERR | (int)POLLHUP)) != 0) { SemuX11KeyListener.disconnect(source); }  // the next rescan reconnects
    }

    class void end() {  // lets every pad go, then closes every device, the key source and the virtual keyboard
        SemuPadModal.leave();
        for (int index = 0; index < SemuSupervisorRuntime.device_count; index++) {
            if (SemuSupervisorRuntime.devices[index].descriptor >= 0) { SemuInputDevices.vacate(index); }
        }
        SemuX11KeyListener.disconnect(&SemuSupervisorRuntime.key_source);
        SemuVirtualKeyboard.removeDevice();
    }

    class bool relaunching() { return SemuSupervisorRuntime.relaunch != 0; }  // the last run stopped the game to start it again on a new choice

    class int run(int child, SemuLaunchPlan launch) {  // waits for exit, the quit chord, or a quit action
        SemuSupervisor.begin(launch);
        int exitCode = 0;
        bool exited = false;
        int ticks = 0;
        SemuStopSignals.install();
        while (true) {
            exitCode = SemuProcessGroup.reap(child, &exited);
            if (exited) {
                SemuPadModal.leave();  // the emulator died, perhaps under the open menu: the pads are free at once
                SemuProcessGroup.finish(child);  // no orphan outlives the emulator
                break;
            }
            if (SemuStopSignals.pending() != 0) {
                SemuPadModal.leave();
                SemuSupervisorRuntime.relaunch = 0;  // stopped from outside: never started again
                bool honoured = SemuProcessGroup.stop(child, launch.retroarchPort);
                Console.error(honoured ? "semu: stopped; the emulator honoured QUIT" : "semu: stopped by signal");
                exitCode = 128 + SemuStopSignals.pending();
                break;
            }
            ticks++;
            int rescanTicks = SEMU_SUPERVISOR_RESCAN_TICKS;
            if (ticks % rescanTicks == 0) {
                SemuInputDevices.scan(launch);
                SemuX11KeyListener.connect(&SemuSupervisorRuntime.key_source);  // a no-op while connected or without DISPLAY
            }
            SemuSupervisor.pollDevices(launch);
            if (SemuSupervisorRuntime.quit == 0) { SemuGameControllers.poll(launch); }
            if (SemuSupervisorRuntime.quit != 0) {
                SemuPadModal.leave();  // before the QUIT wait: QUIT GAME from the menu never keeps a pad held
                bool honoured = SemuProcessGroup.stop(child, launch.retroarchPort);
                if (SemuSupervisorRuntime.relaunch != 0) { Console.error("semu: stopping the game to restart it on the new choice"); }  // `semu launch` starts it again once the group is gone
                Console.error(honoured ? "semu: quit; the emulator honoured QUIT" : "semu: quit");
                exitCode = 0;
                break;
            }
        }
        SemuProcessGroup.reapGroup(child);
        SemuSupervisor.end();
        return exitCode;
    }
}
