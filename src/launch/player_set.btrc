// What the supervisor knows of the players of a launch and changes while it runs: how many the game
// takes, the roster's pads, which pad and layout each player holds now and held at the launch, the
// system's layouts with how this emulator applies each (live, or at Restart Game), which layout each
// player's emulator runs now (the launch's or the last live switch), whether the game sees each
// player's controller linked (a layout may unlink it: Dolphin's GameCube sends the Wii Remote away),
// and the facts of the emulator's live switch (emulator.json controllers). SemuControllerLayouts and
// SemuPlayersPage change it; the menu and the renderer show it.

import Library.JSON;
import Library.Strings;
import Library.Vector;
import ../lib/json.btrc;
import ../lib/paths.btrc;
import ../model.btrc;
import ../resolve.btrc;
import ../emit/players.btrc;

class SemuPlayerSet {
    public int count;  // players this game takes
    public int padCount;  // pads in the launch's roster; 0 without one
    public Vector<int> pads;  // per player: the roster pad, -1 none (player 1: its default pad)
    public Vector<int> launchPads;
    public Vector<int> layouts;  // per player: the layout index, -1 for a system without layouts
    public Vector<int> launchLayouts;
    public Vector<int> runningLayouts;  // per player: what the emulator runs now, the launch's layout or the last live switch
    public Vector<string> layoutIds;
    public Vector<string> layoutLabels;
    public Vector<string> layoutApply;  // per layout: live, relaunch, or "" where this emulator has no row for it
    public Vector<string> layoutProfiles;  // per layout: the stored profile's name (Dolphin's "Nunchuk")
    public Vector<bool> layoutLinks;  // per layout: the game sees the controller linked (Dolphin's GameCube: the Wii Remote away)
    public Vector<string> chords;  // per player: the emulator's own key that loads the next profile
    public Vector<string> linkChords;  // per player: the emulator's own key that links or unlinks the controller (Connect Wii Remote N)
    public Vector<bool> linked;  // per player: whether the game sees the controller linked now (every one at boot)
    public string directory;  // the profile folder the emulator cycles
    public string active;  // Semu's one file in it
    public string store;  // the profiles rendered at launch, one per player and live layout
    public string retiredDirectory;
    public Vector<string> retired;
    public int pressMs;
    public int gapMs;
    public int sharedIndex;  // the emulator's one cycle index, 0 at boot
    public int defaultLayout;  // the system's default layout, what Reset returns every player to
    public bool pageOpen;  // the menu shows the players page

    public SemuPlayerSet() {
        self.count = 1;
        self.padCount = 0;
        self.pads = [-1];  // one player on the default pad until a launch deals them
        self.launchPads = [-1];
        self.layouts = [-1];
        self.launchLayouts = [-1];
        self.runningLayouts = [-1];
        self.layoutIds = [];
        self.layoutLabels = [];
        self.layoutApply = [];
        self.layoutProfiles = [];
        self.layoutLinks = [];
        self.chords = [];
        self.linkChords = [];
        self.linked = [true];
        self.directory = "";
        self.active = "";
        self.store = "";
        self.retiredDirectory = "";
        self.retired = [];
        self.pressMs = 40;
        self.gapMs = 40;
        self.sharedIndex = 0;
        self.defaultLayout = -1;
        self.pageOpen = false;
    }

    public bool connected(int player0) { return player0 == 0 || (player0 >= 0 && player0 < self.pads.size() && self.pads.get(player0) >= 0); }

    public bool playersAvailable() { return self.count >= 2; }

    public int choosable() {  // layouts this emulator can apply
        int result = 0;
        for apply in self.layoutApply { if (!apply.isEmpty()) { result++; } }
        return result;
    }

    public bool layoutsAvailable() { return self.choosable() >= 2; }

    public bool live(int layout) { return layout >= 0 && layout < self.layoutApply.size() && self.layoutApply.get(layout).equals("live") && !self.directory.isEmpty(); }

    public bool links(int layout) { return layout < 0 || layout >= self.layoutLinks.size() || self.layoutLinks.get(layout); }  // the game sees the controller while LAYOUT runs

    public bool relinks(int player0, int layout) {  // switching PLAYER0 to LAYOUT changes the link the game sees: one press of its link key
        return player0 >= 0 && player0 < self.linked.size() && self.linked.get(player0) != self.links(layout);
    }

    public bool waiting(int player0) {  // a connected player's chosen layout is not the one its emulator runs: it applies at Restart Game
        return self.connected(player0) && player0 < self.layouts.size() && player0 < self.runningLayouts.size() && self.layouts.get(player0) != self.runningLayouts.get(player0);
    }

    public bool pending() {  // something only Restart Game applies: a pad dealt anew or a layout read at boot
        for (int player0 = 0; player0 < self.count; player0++) {
            if (self.pads.get(player0) != self.launchPads.get(player0) || self.waiting(player0)) { return true; }
        }
        return false;
    }

    public bool changed() {  // anything differs from the launch, a layout switched live included: Restart Game restarts
        for (int player0 = 0; player0 < self.count; player0++) {
            if (self.pads.get(player0) != self.launchPads.get(player0) || self.layouts.get(player0) != self.launchLayouts.get(player0)) { return true; }
        }
        return false;
    }

    public string storeFile(int player0, int layout) { return PathTools.join(self.store, "P" + Strings.fromInt(player0 + 1) + " " + self.layoutProfiles.get(layout) + ".ini"); }

    public string padLabel(int player0) {
        int pad = self.pads.get(player0);
        if (pad < 0) { return player0 == 0 ? "PAD 1" : "NO PAD"; }
        return "PAD " + Strings.fromInt(pad + 1);
    }

    public string layoutLabel(int player0) {
        int layout = self.layouts.get(player0);
        return layout >= 0 && layout < self.layoutLabels.size() ? self.layoutLabels.get(layout) : "";
    }

    public void show(Vector<string> shown) {  // the menu rows this launch adds: CONTROLLER where layouts apply, PLAYERS where the game takes more than one, RESTART GAME with either, a second output or a render scale
        if (self.layoutsAvailable()) { shown.push("layouts"); }
        if (self.playersAvailable()) { shown.push("players"); }
        if (self.layoutsAvailable() || self.playersAvailable() || shown.contains("outputs") || shown.contains("scales")) { shown.push("restarts"); }  // RESTART GAME where some choice waits for it
    }

    public Vector<string> environment() {  // the CONTROLLER row's value and the layout toasts
        Vector<string> result = [];
        if (!self.layoutsAvailable()) { return result; }
        result.push("SEMU_MENU_LAYOUTS=" + self.layoutLabels.join("|"));
        result.push("SEMU_MENU_LAYOUT=" + Strings.fromInt(self.layouts.isEmpty() ? -1 : self.layouts.get(0)));
        return result;
    }

    public string row(int player0) {  // "P2  PAD 2  CLASSIC", the players page's row
        string text = "P" + Strings.fromInt(player0 + 1) + "  " + self.padLabel(player0);
        if (self.connected(player0) && !self.layoutLabel(player0).isEmpty()) { text = text + "  " + self.layoutLabel(player0); }
        return text;
    }
}

class SemuPlayerSets {
    class Vector<string> nativeChords(SemuEmulator emulator, string group) {  // per player: the native_chord of each row of profile.json GROUP
        Vector<string> result = [];
        JSONValue rows = emulator == null ? null : SemuJson.get(emulator.profile, group);
        for (int index = 0; rows != null && rows.isArray() && index < rows.size(); index++) { result.push(SemuJson.textAt(rows.at(index), "native_chord")); }
        return result;
    }

    class SemuPlayerSet from(SemuPlan plan, SemuSystem system, SemuEmulator emulator) {  // the launch's players, from the same rows the profiles were rendered from
        SemuPlayerSet set = SemuPlayerSet();
        JSONValue rows = SemuPlayers.rows(plan, system, emulator);
        set.pads = [];
        set.launchPads = [];
        set.layouts = [];
        set.launchLayouts = [];
        set.runningLayouts = [];
        set.linked = [];
        set.count = rows.size();
        set.padCount = SemuPlayers.known(plan) ? plan.pads.size() : 0;
        for (int index = 0; index < rows.size(); index++) {
            JSONValue row = rows.at(index);
            set.pads.push(Strings.toInt(SemuJson.textAt(row, "pad")));
            set.layouts.push(Strings.toInt(SemuJson.textAt(row, "layout_index")));
        }
        for pad in set.pads { set.launchPads.push(pad); }
        for layout in set.layouts { set.launchLayouts.push(layout); }
        for layout in set.layouts { set.runningLayouts.push(layout); }
        for (int index = 0; index < set.count; index++) { set.linked.push(true); }  // the emulator links every controller at boot, whatever the layout
        set.defaultLayout = SemuPlayers.layoutIndex(system, SemuPlayers.defaultLayout(system));
        JSONValue declared = SemuPlayers.layouts(system);
        for (int index = 0; index < declared.size(); index++) {
            string layout = SemuJson.textAt(declared.at(index), "id");
            JSONValue fields = SemuPlayers.layoutRow(emulator, layout);
            set.layoutIds.push(layout);
            set.layoutLabels.push(SemuJson.textAt(declared.at(index), "label"));
            set.layoutApply.push(fields == null ? "" : SemuJson.textAt(fields, "apply"));
            set.layoutProfiles.push(fields == null ? "" : SemuJson.textAt(fields, "profile"));
            set.layoutLinks.push(fields == null || !SemuJson.textAt(fields, "connection").equals("disconnected"));
        }
        set.chords = SemuPlayerSets.nativeChords(emulator, "layout_hotkeys");
        set.linkChords = SemuPlayerSets.nativeChords(emulator, "connection_hotkeys");
        JSONValue controllers = emulator == null ? null : SemuJson.get(emulator.definition, "controllers");
        if (controllers != null && controllers.isObject() && SemuJson.textAt(controllers, "switch").equals("profile_cycle")) {
            set.directory = plan.tokens.resolve(SemuJson.textAt(controllers, "directory"));
            set.active = SemuJson.textAt(controllers, "active");
            set.store = plan.tokens.resolve(SemuJson.textAt(controllers, "store"));
            set.retiredDirectory = plan.tokens.resolve(SemuJson.textAt(controllers, "retired_directory"));
            set.retired = SemuJson.strings(controllers.get("retired"));
            set.pressMs = SemuJson.intAt(controllers, "press_ms", 40);
            set.gapMs = SemuJson.intAt(controllers, "gap_ms", 40);
        }
        return set;
    }
}
