#include <fcntl.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ioctl.h>
#include <unistd.h>
#include "semu_evdev.h"

import Library.Console;
import Library.Strings;
import Library.Vector;
import ../renderer/action_abi.btrc;
import ./input_state.btrc;
import ./input_filters.btrc;
import ./journal.btrc;
import ./process.btrc;
import ./plan.btrc;
import ./visual_cycle.btrc;
import ./system_reset.btrc;
import ./paced_keys.btrc;
import ./controller_layouts.btrc;
import ./players_page.btrc;
import ./game_restart.btrc;

class SemuActionRouter {  // where an action goes: the renderer, the emulator, or the process group
    class string retroarchCommand(string action) {  // saves and loads name Semu's slot; RetroArch's counter stays
        if (action.equals("state.save")) { return "SAVE_STATE_SLOT"; }
        if (action.equals("state.load")) { return "LOAD_STATE_SLOT"; }
        if (action.equals("ui.screenshot")) { return "SCREENSHOT"; }
        if (action.equals("ui.pause")) { return "PAUSE_TOGGLE"; }
        if (action.equals("ui.fullscreen")) { return "FULLSCREEN_TOGGLE"; }
        if (action.equals("speed.fast")) { return "FAST_FORWARD"; }
        if (action.equals("speed.rewind")) { return "REWIND"; }
        return "";
    }

    class string retroarchMessage(string command, int slotNumber) {  // slot commands carry the slot as RetroArch numbers it
        return command.endsWith("_SLOT") ? command + " " + Strings.fromInt(slotNumber) : command;
    }

    class bool semuOwned(string action) {
        return action.startsWith("ui.menu") || action.equals("app.quit") || action.startsWith("visual.") || action.equals("system.reset") || action.equals("system.restart")
            || action.startsWith("controller.") || action.contains(".controller.") || action.equals("ui.players");  // layouts and players: Semu switches them
    }

    class string route(string action, bool retroarch, bool fromKeyboard) {  // "semu" | "udp:<COMMAND>" | "inject" | "none"
        if (SemuActionRouter.semuOwned(action)) { return "semu"; }
        if (retroarch) {
            string command = SemuActionRouter.retroarchCommand(action);
            return command.isEmpty() ? "none" : "udp:" + command;
        }
        return fromKeyboard ? "none" : "inject";  // a keyboard chord already reached the emulator's own hotkey table
    }

    class string routeFor(string action, bool retroarch, bool fromKeyboard, bool nativeKey) {  // nativeKey: Semu types the emulator's own key, any source
        if (nativeKey && !retroarch && !SemuActionRouter.semuOwned(action)) { return "inject"; }
        return SemuActionRouter.route(action, retroarch, fromKeyboard);
    }

    class int journalCode(string action) {  // each action journals as itself; none when the ABI lacks it
        if (action.startsWith("state.") || action.equals("ui.screenshot")) { return SemuActions.code(action); }
        return SemuActions.none();
    }
}

class SemuVirtualKeyboard {  // types an action's chord into whatever emulator has focus
    class bool open() { return SemuUinputKeyboard.open(); }  // one virtual keyboard, shared with the paced typer

    class void emit(int type, int code, int value) { SemuUinputKeyboard.emit(type, code, value); }

    class bool type(Vector<int> codes) {
        if (codes.isEmpty() || !SemuVirtualKeyboard.open()) { return false; }
        int keyType = EV_KEY;
        int synType = EV_SYN;
        int synReport = SYN_REPORT;
        for (int index = 0; index < codes.size(); index++) {
            int code = codes.get(index);
            SemuVirtualKeyboard.emit(keyType, code, 1);
            SemuVirtualKeyboard.emit(synType, synReport, 0);
            usleep(15000);
        }
        for (int index = codes.size() - 1; index >= 0; index--) {
            int code = codes.get(index);
            SemuVirtualKeyboard.emit(keyType, code, 0);
            SemuVirtualKeyboard.emit(synType, synReport, 0);
            usleep(15000);
        }
        SemuKeyEcho.expect(codes, SemuClock.milliseconds() + (long long)SEMU_ECHO_MS);  // gamescope hands the typing back as X keys
        return true;
    }

    class void removeDevice() {  // removes the virtual device at session end
        if (SemuSupervisorRuntime.uinput_descriptor <= 0) { return; }
        unsigned long deviceDestroy = (unsigned long)UI_DEV_DESTROY;
        ioctl(SemuSupervisorRuntime.uinput_descriptor, deviceDestroy);
        close(SemuSupervisorRuntime.uinput_descriptor);
        SemuSupervisorRuntime.uinput_descriptor = 0;
    }
}

class SemuActionExecutor {  // execution of one action id (SemuActions is the renderer's code table)
    class string chordFor(SemuLaunchPlan launch, string action) {
        for entry in launch.actionChords {
            if (entry.startsWith(action + "=")) { return entry.substring(action.len() + 1, entry.len() - action.len() - 1); }
        }
        return "";
    }

    class string nativeChordFor(SemuLaunchPlan launch, string action) {  // the emulator's own key, empty when it binds Semu's
        for entry in launch.nativeChords {
            if (entry.startsWith(action + "=")) { return entry.substring(action.len() + 1, entry.len() - action.len() - 1); }
        }
        return "";
    }

    class void toEmulator(SemuLaunchPlan launch, string action, bool fromKeyboard) {  // only what the emulator declares moves a slot or journals
        if (!launch.emulatorActions.contains(action)) {
            if (getenv("SEMU_RENDER_DEBUG") != null) { Console.error("semu: " + launch.emulator + " does not declare " + action); }
            return;
        }
        string native = SemuActionExecutor.nativeChordFor(launch, action);
        string route = SemuActionRouter.routeFor(action, launch.retroarchPort > 0, fromKeyboard, !native.isEmpty());
        if (route.startsWith("udp:")) {
            string command = route.substring(4, route.len() - 4);
            SemuCommandPort.send(launch.retroarchPort, SemuActionRouter.retroarchMessage(command, launch.firstSlot + SemuSupervisorRuntime.slot));
        } else if (route.equals("inject")) {
            Vector<int> codes = SemuKeyNames.chord(native.isEmpty() ? SemuActionExecutor.chordFor(launch, action) : native);
            if (!SemuVirtualKeyboard.type(codes) && getenv("SEMU_RENDER_DEBUG") != null) {
                Console.error("semu: could not type the chord for " + action + " (no /dev/uinput access?)");
            }
        }
        if (action.equals("state.next")) { SemuSupervisorRuntime.slot = SemuSlotCounter.step(SemuSupervisorRuntime.slot, launch.stateSlots, 1); }  // wraps as the emulator does
        if (action.equals("state.prev")) { SemuSupervisorRuntime.slot = SemuSlotCounter.step(SemuSupervisorRuntime.slot, launch.stateSlots, -1); }
        int journal = SemuActionRouter.journalCode(action);
        SemuActionJournal.append(launch, journal, action.startsWith("state.") ? SemuSupervisorRuntime.slot : 0);
    }

    class void openMenu(SemuLaunchPlan launch) {
        if (SemuSupervisorRuntime.menu_visible != 0) { return; }
        if (!launch.menuDrawn) {  // no compositor here: an unseen menu would freeze the game
            if (getenv("SEMU_RENDER_DEBUG") != null) { Console.error("semu: no Semu menu over " + launch.emulator + " on this platform"); }
            return;
        }
        SemuSupervisorRuntime.menu_visible = 1;
        SemuSupervisorRuntime.menu_selected = 0;
        SemuActionJournal.append(launch, SemuActions.menuToggle(), 0);
        if (!launch.pauseAction.isEmpty()) { SemuActionExecutor.toEmulator(launch, launch.pauseAction, false); }
    }

    class void closeMenu(SemuLaunchPlan launch) {
        if (SemuSupervisorRuntime.menu_visible == 0) { return; }
        SemuSupervisorRuntime.menu_visible = 0;
        launch.players.pageOpen = false;  // the menu opens on its first page next time
        SemuActionJournal.append(launch, SemuActions.menuBack(), 0);
        if (!launch.pauseAction.isEmpty()) { SemuActionExecutor.toEmulator(launch, launch.pauseAction, false); }
    }

    class void confirm(SemuLaunchPlan launch) {  // runs the selected menu item
        if (SemuSupervisorRuntime.menu_visible == 0) { return; }
        if (!launch.players.pageOpen && SemuSupervisorRuntime.menu_selected >= launch.menuActions.size()) { return; }
        string item = launch.players.pageOpen ? "" : launch.menuActions.get(SemuSupervisorRuntime.menu_selected);
        if (launch.players.pageOpen) {
            SemuPlayersPage.confirm(launch);  // a player row, RESTART GAME or BACK
        } else if (item.startsWith("visual.")) {
            SemuVisualCycle.execute(launch, item);  // a value row steps on; the menu stays open
        } else if (item.equals("controller.layout.next")) {
            SemuControllerLayouts.next(launch);  // player 1's next layout; the menu stays open
        } else if (item.equals("ui.players")) {
            SemuPlayersPage.open(launch);
        } else if (item.equals("system.restart")) {
            SemuGameRestart.execute(launch);  // restarts once when something waits; the menu stays open otherwise
        } else if (item.equals("system.reset")) {
            SemuSystemReset.execute(launch, SemuClock.milliseconds());  // asks for a second press; the menu stays open
        } else if (item.equals("app.quit")) {
            SemuSupervisorRuntime.quit = 1;
        } else {
            SemuActionExecutor.closeMenu(launch);  // resume first so the emulator can act
            if (!item.equals("ui.menu.back")) { SemuActionExecutor.toEmulator(launch, item, false); }
        }
    }

    class void menuStep(SemuLaunchPlan launch, int delta) {  // left and right: a player's layout on the players page, the CONTROLLER row, or a visual value row
        if (SemuSupervisorRuntime.menu_visible == 0) { return; }
        if (launch.players.pageOpen) {
            SemuPlayersPage.step(launch, delta);
            return;
        }
        int selected = SemuSupervisorRuntime.menu_selected;
        if (selected < launch.menuActions.size() && launch.menuActions.get(selected).equals("controller.layout.next")) {
            SemuControllerLayouts.step(launch, 0, delta);
            return;
        }
        SemuVisualCycle.menuStep(launch, delta);
    }

    class void players(SemuLaunchPlan launch) {  // the radial's Players: the menu on its players page, or the toast that the game takes one player
        if (!launch.players.playersAvailable()) {
            SemuPlayersPage.open(launch);
            return;
        }
        if (SemuSupervisorRuntime.menu_visible == 0) { SemuActionExecutor.openMenu(launch); }
        if (SemuSupervisorRuntime.menu_visible != 0 && !launch.players.pageOpen) { SemuPlayersPage.open(launch); }
    }

    class void fromDevice(SemuLaunchPlan launch, string action, struct SemuInputDevice* device) {  // a device's press: its source routes, its identity deduplicates
        SemuActionExecutor.dispatch(launch, action, device->source, device->identity != 0 ? device->identity : device->source);
    }

    class void execute(SemuLaunchPlan launch, string action, int source) {  // SEMU_SOURCE_*, deduplicated as that source
        SemuActionExecutor.dispatch(launch, action, source, source);
    }

    class void dispatch(SemuLaunchPlan launch, string action, int source, int identity) {  // the same chord from two inputs within the window runs once
        if (action.isEmpty()) { return; }
        bool fromKeyboard = source != SEMU_SOURCE_GAMEPAD;
        bool debug = getenv("SEMU_RENDER_DEBUG") != null;
        if (!SemuActionDedupe.accept(action, identity, SemuClock.milliseconds())) {
            if (debug) { Console.error("semu: " + action + " already ran from another input source"); }
            return;
        }
        if (debug) { Console.error("semu: action " + action + (fromKeyboard ? " (keyboard)" : " (gamepad)")); }
        if (action.equals("app.quit")) {
            SemuSupervisorRuntime.quit = 1;
        } else if (action.equals("ui.menu")) {
            if (SemuSupervisorRuntime.menu_visible != 0) { SemuActionExecutor.closeMenu(launch); } else { SemuActionExecutor.openMenu(launch); }
        } else if ((action.equals("ui.menu.back") || action.equals("ui.escape")) && launch.players.pageOpen) {
            SemuPlayersPage.back(launch);  // the page returns to the menu
        } else if (action.equals("ui.menu.back") || action.equals("ui.escape")) {
            SemuActionExecutor.closeMenu(launch);
        } else if (action.equals("ui.menu.up") || action.equals("ui.menu.down")) {
            if (SemuSupervisorRuntime.menu_visible == 0) { return; }
            int count = launch.menuActions.size() > 0 ? launch.menuActions.size() : 1;
            if (launch.players.pageOpen) { count = SemuPlayersPage.rowCount(launch.players); }
            SemuSupervisorRuntime.menu_selected = (SemuSupervisorRuntime.menu_selected + (action.equals("ui.menu.up") ? count - 1 : 1)) % count;
            SemuActionJournal.append(launch, action.equals("ui.menu.up") ? SemuActions.menuUp() : SemuActions.menuDown(), 0);
        } else if (action.equals("ui.menu.confirm")) {
            SemuActionExecutor.confirm(launch);
        } else if (action.equals("ui.menu.left") || action.equals("ui.menu.right")) {
            SemuActionExecutor.menuStep(launch, action.equals("ui.menu.right") ? 1 : -1);  // only the value rows step
        } else if (action.startsWith("visual.")) {
            SemuVisualCycle.execute(launch, action);
        } else if (action.equals("system.reset")) {
            SemuSystemReset.execute(launch, SemuClock.milliseconds());
        } else if (action.equals("system.restart")) {
            SemuGameRestart.execute(launch);
        } else if (action.equals("controller.layout.next")) {
            SemuControllerLayouts.next(launch);
        } else if (action.contains(".controller.")) {
            SemuControllerLayouts.pick(launch, action);  // a held layer's slot: that layout for player 1
        } else if (action.equals("ui.players")) {
            SemuActionExecutor.players(launch);
        } else {
            SemuActionExecutor.toEmulator(launch, action, fromKeyboard);
        }
    }
}
