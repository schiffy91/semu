// Process-group spawning, supervision and the bounded group kill.

#include <errno.h>
#include <fcntl.h>
#include <signal.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <time.h>
#include <unistd.h>

import Library.Console;
import Library.Strings;
import Library.Vector;

#define SEMU_POLL_MS 10

volatile sig_atomic_t semuStopSignal = 0;

void semuOnStopSignal(int signo) { semuStopSignal = signo; }

class SemuStopSignals {
    class void install() {  // a killed launcher must take its emulator with it
        int term = SIGTERM;
        int interrupt = SIGINT;
        int hangup = SIGHUP;
        signal(term, semuOnStopSignal);
        signal(interrupt, semuOnStopSignal);
        signal(hangup, semuOnStopSignal);
    }

    class int pending() { return (int)semuStopSignal; }
}

class SemuClock {
    class long long milliseconds() {
        struct timespec now;
        clock_gettime(CLOCK_MONOTONIC, &now);
        return (long long)now.tv_sec * 1000LL + (long long)(now.tv_nsec / 1000000L);
    }
}

class SemuProcessGroup {
    class char** cStrings(Vector<string> values) {
        int slots = values.size() + 1;
        char** result = (char**)calloc((size_t)slots, sizeof(char*));
        for (int index = 0; index < values.size(); index++) {
            string value = values.get(index);
            result[index] = strdup(value);
        }
        return result;
    }

    class int start(Vector<string> argv, Vector<string> environment) {  // child leads its own process group
        char** arguments = SemuProcessGroup.cStrings(argv);
        int child = (int)fork();
        if (child < 0) { return -1; }
        if (child == 0) {
            setpgid(0, 0);
            for (int index = 0; index < environment.size(); index++) {
                string assignment = environment.get(index);
                char* copy = strdup(assignment);
                putenv(copy);
            }
            char* program = arguments[0];
            execvp(program, arguments);
            _exit(127);
        }
        pid_t pid = (pid_t)child;
        setpgid(pid, pid);
        return child;
    }

    class int reap(int child, bool* exited) {  // returns exit status once the child is gone
        int status = 0;
        pid_t pid = (pid_t)child;
        pid_t waited = waitpid(pid, &status, WNOHANG);
        if (waited == pid) {
            *exited = true;
            if (WIFEXITED(status)) { return WEXITSTATUS(status); }
            if (WIFSIGNALED(status)) { return 128 + WTERMSIG(status); }
            return 1;
        }
        *exited = false;
        return 0;
    }

    class bool groupAlive(int child) {
        pid_t group = (pid_t)(-child);
        return !(kill(group, 0) != 0 && errno == ESRCH);
    }

    class void reapGroup(int child) {
        int status = 0;
        pid_t group = (pid_t)(-child);
        pid_t reaped = waitpid(group, &status, WNOHANG);
        while (reaped > (pid_t)0) { reaped = waitpid(group, &status, WNOHANG); }
    }

    class void terminate(int child) {  // TERM the group, KILL whatever survives 250 ms
        pid_t group = (pid_t)(-child);
        kill(group, SIGTERM);
        long long deadline = SemuClock.milliseconds() + 250LL;
        while (SemuClock.milliseconds() < deadline) {
            SemuProcessGroup.reapGroup(child);
            if (!SemuProcessGroup.groupAlive(child)) { break; }
            usleep(10000);
        }
        kill(group, SIGKILL);
        SemuProcessGroup.reapGroup(child);
    }

    class int supervise(int child) {  // waits for the child to exit or a stop signal
        int exitCode = 0;
        bool exited = false;
        SemuStopSignals.install();
        while (true) {
            exitCode = SemuProcessGroup.reap(child, &exited);
            if (exited) { break; }
            if (SemuStopSignals.pending() != 0) {
                SemuProcessGroup.terminate(child);
                exitCode = 128 + SemuStopSignals.pending();
                break;
            }
            usleep(SEMU_POLL_MS * 1000);
        }
        SemuProcessGroup.reapGroup(child);
        return exitCode;
    }
}
