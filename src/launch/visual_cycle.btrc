// The radial's and the menu's visual choices: bezel, shader, placement (Fit) and output (Aspect).
// The supervisor journals the absolute index into the launch's variants file, which the renderer
// applies live, and saves the choice for this system only: a system's own value beats the global
// switch, which stays the default. An output is drawn from boot, so it is saved at once and waits
// for Restart Game (SemuOutputSwitch). With nothing to choose the record carries slot -1 and
// the renderer shows the action's unavailable toast; On/Off does the same there (a Wii U press
// never flips the global switch the other systems default to, nor the live config).

#include <stdlib.h>

import Library.Console;
import Library.JSON;
import Library.Vector;
import ../lib/settings.btrc;
import ../emit/render_choices.btrc;
import ../emit/render_variants.btrc;
import ../renderer/action_abi.btrc;
import ./input_state.btrc;
import ./journal.btrc;
import ./plan.btrc;
import ./process.btrc;
import ./relaunch.btrc;

class SemuVisualCycle {
    class string kind(string action) {  // visual.<kind>.next: bezel, shader, placement or output; "" for any other action
        if (!action.startsWith("visual.") || !action.endsWith(".next") || action.len() < 13) { return ""; }
        string kind = action.substring(7, action.len() - 12);
        return kind.equals("bezel") || kind.equals("shader") || kind.equals("placement") || kind.equals("output") ? kind : "";
    }

    class bool cycles(string action) { return !SemuVisualCycle.kind(action).isEmpty(); }

    class SemuVariantChoice choice(SemuLaunchPlan launch, string action) { return launch.variants.choice(SemuVisualCycle.kind(action)); }

    class int code(string kind) {  // the select record each kind journals
        if (kind.equals("bezel")) { return SemuActions.bezelSelect(); }
        if (kind.equals("placement")) { return SemuActions.placementSelect(); }
        if (kind.equals("output")) { return SemuActions.outputSelect(); }
        return SemuActions.shaderSelect();
    }

    class void apply(SemuLaunchPlan launch, SemuVariantChoice choice, int index) {  // journal the absolute index and follow it in the launch; saves nothing
        choice.index = index;
        if (!choice.off()) { choice.lastReal = index; }
        SemuActionJournal.append(launch, SemuVisualCycle.code(choice.kind), index);
        if (choice.kind.equals("bezel")) { launch.bezelsOn = !choice.off(); }
        if (choice.kind.equals("shader")) { launch.shadersOn = !choice.off(); }
    }

    class void select(SemuLaunchPlan launch, SemuVariantChoice choice, int index) {  // journal the absolute index, save it for this system
        SemuVisualCycle.apply(launch, choice, index);
        if (launch.semuHome.isEmpty() || launch.system.isEmpty()) { return; }
        string key = choice.kind.equals("placement") ? "placement" : choice.kind + "_variant";
        SemuSettingsStore.put(launch.semuHome, "visual.systems." + launch.system + "." + key, JSONValue.makeString(choice.current()));  // never the global switch
    }

    class void step(SemuLaunchPlan launch, SemuVariantChoice choice, int delta) {  // wraps through the choices (bezels and shaders end on none)
        bool hidden = choice.kind.equals("placement") && !launch.bezelsOn;  // Fit with the bezel off would change nothing on screen and surprise later
        if (!choice.available() || hidden) {  // nothing to choose here: the renderer says so
            SemuActionJournal.append(launch, SemuVisualCycle.code(choice.kind), -1);
            if (getenv("SEMU_RENDER_DEBUG") != null) { Console.error("semu: no " + choice.kind + " to choose for " + launch.system + " here"); }
            return;
        }
        if (choice.kind.equals("output")) {
            SemuOutputSwitch.press(launch, choice, choice.next(delta));
            return;
        }
        SemuVisualCycle.select(launch, choice, choice.next(delta));
    }

    class void toggle(SemuLaunchPlan launch, string action) {  // On/Off: none, or back to the last real choice
        SemuVariantChoice choice = launch.variants.choice(action.equals("visual.bezels.toggle") ? "bezel" : "shader");
        if (choice.available()) {
            SemuVisualCycle.select(launch, choice, choice.off() ? choice.lastReal : choice.ids.size() - 1);  // none is always last
            return;
        }
        if (launch.variants.written) {  // the launch's file names every choice and this system has none (Wii U): the renderer's NONE HERE toast, nothing flipped or saved
            SemuActionJournal.append(launch, SemuVisualCycle.code(choice.kind), -1);
            return;
        }
        bool bezels = action.equals("visual.bezels.toggle");  // no variants file (no compositor reads one): the global switch, as before
        SemuActionJournal.append(launch, bezels ? SemuActions.bezelsToggle() : SemuActions.shadersToggle(), 0);
        if (bezels) { launch.bezelsOn = !launch.bezelsOn; } else { launch.shadersOn = !launch.shadersOn; }
        bool enabled = launch.shadersOn;
        if (bezels) { enabled = launch.bezelsOn; }
        if (launch.semuHome.isEmpty()) { return; }
        SemuSettingsStore.put(launch.semuHome, bezels ? "visual.bezels" : "visual.crt_shaders", JSONValue.makeBool(enabled));
    }

    class void execute(SemuLaunchPlan launch, string action) {  // every visual.* id; an unknown one does nothing
        if (SemuVisualCycle.cycles(action)) {
            SemuVisualCycle.step(launch, SemuVisualCycle.choice(launch, action), 1);
        } else if (action.equals("visual.bezels.toggle") || action.equals("visual.shaders.toggle")) {
            SemuVisualCycle.toggle(launch, action);
        } else if (getenv("SEMU_RENDER_DEBUG") != null) {
            Console.error("semu: no visual action named " + action);
        }
    }

    class bool menuStep(SemuLaunchPlan launch, int delta) {  // left and right on the selected value row: BEZEL, SHADER, FIT or ASPECT
        if (SemuSupervisorRuntime.menu_visible == 0 || SemuSupervisorRuntime.menu_selected >= launch.menuActions.size()) { return false; }
        string item = launch.menuActions.get(SemuSupervisorRuntime.menu_selected);
        if (!SemuVisualCycle.cycles(item)) { return false; }
        SemuVisualCycle.step(launch, SemuVisualCycle.choice(launch, item), delta);
        return true;
    }
}
