import Library.FileSystem;
import Library.JSON;
import Library.Process;
import Library.Strings;
import Library.Vector;
import ../lib/json.btrc;
import ../lib/paths.btrc;
import ../model.btrc;
import ../resolve.btrc;
import ../emit/profiles.btrc;
import ../emit/rendering.btrc;

class SemuLaunchPlan {
    public Vector<string> argv;
    public Vector<string> environment;
    public string error;
    public string emulator;
    public string system;
    public string core;
    public string rom;
    public bool watchPads;
    public int chordWindowMs;
    public Vector<string> quitButtons;  // config/input quit_chord.buttons, e.g. start and select
    public Vector<string> menuLabels;
    public Vector<string> menuActions;
    public string pauseAction;
    public string chordModifier;
    public Vector<string> chordButtons;
    public Vector<string> chordActions;
    public Vector<string> actionChords;  // "action=Ctrl+S" for every action with a keyboard chord
    public int retroarchPort;
    public string stateDir;
    public string semuHome;
    public bool bezelsOn;
    public bool shadersOn;

    public SemuLaunchPlan() {
        self.argv = [];
        self.environment = [];
        self.error = "";
        self.emulator = "";
        self.system = "";
        self.core = "";
        self.rom = "";
        self.watchPads = true;
        self.chordWindowMs = 250;
        self.quitButtons = [];
        self.menuLabels = [];
        self.menuActions = [];
        self.pauseAction = "";
        self.chordModifier = "";
        self.chordButtons = [];
        self.chordActions = [];
        self.actionChords = [];
        self.retroarchPort = 0;
        self.stateDir = "";
        self.semuHome = "";
        self.bezelsOn = true;
        self.shadersOn = true;
    }

    public bool ok() { return self.error.isEmpty() && !self.argv.isEmpty(); }

    public string json() {
        JSONValue result = JSONValue.makeObject();
        JSONValue argv = JSONValue.makeArray();
        for value in self.argv { argv.push(JSONValue.makeString(value)); }
        JSONValue environment = JSONValue.makeArray();
        for value in self.environment { environment.push(JSONValue.makeString(value)); }
        result.set("argv", argv);
        result.set("environment", environment);
        result.set("emulator", JSONValue.makeString(self.emulator));
        result.set("system", JSONValue.makeString(self.system));
        result.set("core", JSONValue.makeString(self.core));
        result.set("rom", JSONValue.makeString(self.rom));
        result.set("quit_chord_window_ms", JSONValue.makeInt(self.chordWindowMs));
        JSONValue quitButtons = JSONValue.makeArray();
        for button in self.quitButtons { quitButtons.push(JSONValue.makeString(button)); }
        result.set("quit_chord_buttons", quitButtons);
        result.set("command_port", JSONValue.makeInt(self.retroarchPort));
        result.set("error", JSONValue.makeString(self.error));
        return result.stringifyPretty(2);
    }
}

class SemuLauncher {
    class string romPath(SemuPlan plan, SemuSystem system, string rom) {  // ROM must live inside the system's ROM directory
        string root = PathTools.join(plan.romsRoot(), system.romDir);
        string path = PathTools.isAbsolute(rom) ? rom : PathTools.join(root, rom);
        if (FileSystem.isDir(path)) { path = PathTools.join(path, PathTools.basename(path)); }  // an ES-DE directory-as-file: the same-named file inside is the game
        string realRoot = UnixFileSystem.realPath(root);
        string realPath = UnixFileSystem.realPath(path);
        if (realRoot.isEmpty() || realPath.isEmpty() || !SemuPaths.inside(realRoot, realPath)) { return ""; }
        return FileSystem.isFile(realPath) ? path : "";
    }

    class string coreFile(SemuPlan plan, JSONValue loader, string core) {
        string filename = plan.tokens.resolve(SemuJson.textAt(loader, "filename").replace("${core}", core));
        for directory in SemuJson.strings(loader.get("directories")) {
            string candidate = PathTools.join(plan.tokens.resolve(directory), filename);
            if (FileSystem.isFile(candidate)) { return candidate; }
        }
        return "";
    }

    class string renderSize(SemuPlan plan, SemuSystem system, JSONValue source) {  // WxH for a render_resolution option; "" keeps the core's default
        string mode = SemuJson.textAt(plan.settings, "visual.render_resolution");
        JSONValue screens = system == null ? null : SemuJson.get(system.definition, "display.screens");
        if (mode.equals("native") || screens == null || !screens.isArray() || screens.size() == 0) { return ""; }
        int width = 0;
        int height = 0;
        int count = SemuJson.textAt(source, "basis").equals("screen") ? 1 : screens.size();  // combined stacks the screens
        for (int index = 0; index < count; index++) {
            int screenWidth = SemuJson.intAt(screens.at(index), "native.w", 0);
            if (screenWidth > width) { width = screenWidth; }
            height += SemuJson.intAt(screens.at(index), "native.h", 0);
        }
        if (width < 1 || height < 1) { return ""; }
        int scale = 1;
        if (!mode.equals("1x")) {  // integer: the largest whole multiple the display holds
            int across = SemuJson.intAt(plan.settings, "visual.display.width", 1280) / width;
            int down = SemuJson.intAt(plan.settings, "visual.display.height", 800) / height;
            scale = across < down ? across : down;
            if (scale < 1) { scale = 1; }
        }
        return f"{width * scale}x{height * scale}";
    }

    class string coreOptions(SemuPlan plan, JSONValue platform, string core, SemuSystem system) {  // literal options, and render sizes from the display
        Vector<string> lines = [];
        JSONValue options = SemuJson.get(platform, "retroarch.core_options." + core);
        if (options != null && options.isArray()) {
            for (int index = 0; index < options.size(); index++) {
                JSONValue option = options.at(index);
                if (option.has("aspect") && !SemuJson.textAt(option, "aspect").equals("standard")) { continue; }
                string kind = SemuJson.textAt(option, "source.kind");
                string value = kind.equals("literal") ? SemuJson.textAt(option, "source.value") : (kind.equals("render_resolution") ? SemuLauncher.renderSize(plan, system, option.get("source")) : "");
                if (!value.isEmpty()) { lines.push(f"{SemuJson.textAt(option, "key")} = \"{value}\""); }
            }
        }
        return lines.join("\n") + "\n";
    }

    class string coreOverrides(SemuPlan plan, JSONValue platform, string core) {
        JSONValue overrides = SemuJson.get(platform, "retroarch.core_overrides." + core);
        if (overrides == null || !overrides.isObject()) { return ""; }
        Vector<string> lines = [];
        for key in overrides.keys().sorted() { lines.push(f"{key} = \"{plan.tokens.resolve(SemuJson.text(overrides.get(key)))}\""); }
        return lines.join("\n") + "\n";
    }

    class bool copyMissing(string source, string target, SemuLaunchPlan launch) {  // adds what the target lacks, never replaces; links are copied as their contents
        if (!FileSystem.exists(target) && !FileSystem.isSymlink(target)) {  // nothing there yet: one copy of the whole tree cannot replace anything
            SemuPaths.prepareDirectory(PathTools.dirname(target));
            ExecResult tree = ChildProcess.run("cp", ["-RpL", source, target]);
            if (!tree.ok()) { launch.error = f"could not seed {target} from {source}: {tree.stderr()}"; }
            return tree.ok();
        }
        for name in FileSystem.listDir(source) {
            string from = PathTools.join(source, name);
            string to = PathTools.join(target, name);
            if (FileSystem.isDir(from)) {
                if (FileSystem.isSymlink(to) || (FileSystem.exists(to) && !FileSystem.isDir(to))) { continue; }
                if (!SemuLauncher.copyMissing(from, to, launch)) { return false; }
                continue;
            }
            if (FileSystem.exists(to) || FileSystem.isSymlink(to) || !FileSystem.isFile(from)) { continue; }
            ExecResult copy = ChildProcess.run("cp", ["-pL", from, to]);
            if (!copy.ok()) {
                launch.error = f"could not seed {to} from {from}: {copy.stderr()}";
                return false;
            }
        }
        return true;
    }

    class bool seed(SemuPlan plan, JSONValue platform, SemuLaunchPlan launch) {  // copy keys, firmware and system files into state; never overwrite, never write the library
        JSONValue seeds = SemuJson.get(platform, "state.seeds");
        if (seeds == null || !seeds.isArray()) { return true; }
        string stateRoot = plan.path("state_root");
        for (int index = 0; index < seeds.size(); index++) {
            JSONValue seed = seeds.at(index);
            string target = plan.tokens.resolve(SemuJson.textAt(seed, "target"));
            string mode = SemuJson.textAt(seed, "copy");  // once_if_target_absent, or missing_files: add what a directory lacks on every launch
            bool declared = (mode.equals("once_if_target_absent") || mode.equals("missing_files")) && SemuJson.textAt(seed, "source_access").equals("read_only") && !SemuJson.boolAt(seed, "overwrite", true);
            bool contained = !stateRoot.isEmpty() && SemuPaths.inside(stateRoot, target) && !FileSystem.isSymlink(target) && SemuPaths.ancestorsAreRealDirectories(stateRoot, target);
            if (!declared || !contained) {
                launch.error = f"seed {index} must copy from read-only sources, without overwriting, into a real path under {stateRoot}: {target}";
                return false;
            }
            if (mode.equals("missing_files")) {
                for source in SemuJson.strings(seed.get("sources")) {
                    string candidate = plan.tokens.resolve(source);
                    if (FileSystem.isDir(candidate) && !FileSystem.isSymlink(candidate)) {
                        if (!SemuLauncher.copyMissing(candidate, target, launch)) { return false; }
                        break;
                    }
                }
                continue;
            }
            if (FileSystem.exists(target)) { continue; }
            for source in SemuJson.strings(seed.get("sources")) {
                string candidate = plan.tokens.resolve(source);
                if (FileSystem.isSymlink(candidate)) {  // a copied link would write through into the library
                    launch.error = "seed source is a symlink: " + candidate;
                    return false;
                }
                if (!FileSystem.exists(candidate)) { continue; }
                SemuPaths.prepareDirectory(PathTools.dirname(target));
                ExecResult copy = ChildProcess.run("cp", ["-rn", candidate, target]);
                if (!copy.ok()) {
                    launch.error = f"could not seed {target} from {candidate}: {copy.stderr()}";
                    return false;
                }
                break;
            }
        }
        return true;
    }

    class void stateEnvironment(SemuLaunchPlan launch, SemuPlan plan, SemuEmulator emulator, JSONValue platform) {
        string stateRoot = PathTools.join(plan.stateRoot(), emulator.id);
        bool xdgConfig = SemuJson.textAt(platform, "state.config_home").equals("xdg");
        bool xdgData = SemuJson.textAt(platform, "state.data_home").equals("xdg");
        if (xdgConfig || xdgData) { launch.environment.push("XDG_CONFIG_HOME=" + PathTools.join(stateRoot, "config")); }
        if (xdgData) {
            launch.environment.push("XDG_DATA_HOME=" + PathTools.join(stateRoot, "data"));
            launch.environment.push("XDG_CACHE_HOME=" + PathTools.join(stateRoot, "cache"));
            launch.environment.push("XDG_STATE_HOME=" + PathTools.join(stateRoot, "state"));
        }
        JSONValue set = SemuJson.get(platform, "env.set");
        if (set.isObject()) {
            for key in set.keys().sorted() {
                if (key.isEmpty() || key.contains("=")) { launch.error = "invalid environment name: " + key; }
                launch.environment.push(key + "=" + plan.tokens.resolve(SemuJson.text(set.get(key))));
            }
        }
        launch.environment.push("SEMU_STATE_ROOT=" + stateRoot);
        launch.environment.push("SEMU_TARGET=" + plan.target.id);
    }

    class string configValue(string document, string key) {  // the last `key = "value"` line of a retroarch.cfg
        string found = "";
        for line in Strings.split(document, "\n") {
            Vector<string> parts = Strings.split(line, "=");
            if (parts.size() != 2 || !parts.get(0).trim().equals(key)) { continue; }
            found = parts.get(1).trim().replace("\"", "");
        }
        return found;
    }

    class int commandPort(string retroarchConfig) {  // the port the generated profile opens; 0 when off
        if (!SemuLauncher.configValue(retroarchConfig, "network_cmd_enable").equals("true")) { return 0; }
        int port = Strings.toInt(SemuLauncher.configValue(retroarchConfig, "network_cmd_port"));
        return port > 0 && port <= 65535 ? port : 0;
    }

    class void inputContracts(SemuLaunchPlan launch, SemuPlan plan, JSONValue platform, string stateRoot) {  // what the supervisor mirrors from config/input
        launch.stateDir = stateRoot;
        launch.semuHome = plan.semuHome;
        launch.bezelsOn = SemuJson.boolAt(plan.settings, "visual.bezels", true);
        launch.shadersOn = SemuJson.boolAt(plan.settings, "visual.crt_shaders", true);
        if (plan.input == null) { return; }
        JSONValue definition = plan.input.definition;
        JSONValue items = SemuJson.get(definition, "menu.items");
        if (items != null && items.isArray()) {
            for (int index = 0; index < items.size(); index++) {
                launch.menuLabels.push(SemuJson.textAt(items.at(index), "label"));
                launch.menuActions.push(SemuJson.textAt(items.at(index), "action"));
            }
        }
        launch.pauseAction = SemuJson.textAt(definition, "menu.pause_action");
        launch.chordModifier = SemuJson.textAt(definition, "gamepad_chords.modifier");
        JSONValue bindings = SemuJson.get(definition, "gamepad_chords.bindings");
        if (bindings != null && bindings.isObject()) {
            for button in bindings.keys().sorted() {
                launch.chordButtons.push(button);
                launch.chordActions.push(SemuJson.text(bindings.get(button)));
            }
        }
        JSONValue actions = definition.get("actions");
        if (actions != null && actions.isObject()) {
            for action in actions.keys().sorted() {
                string chord = SemuJson.textAt(actions.get(action), "chord");
                if (!chord.isEmpty()) { launch.actionChords.push(action + "=" + chord); }
            }
        }
        if (!launch.menuLabels.isEmpty()) { launch.environment.push("SEMU_MENU_ITEMS=" + launch.menuLabels.join("|")); }
    }

    class SemuLaunchPlan plan(SemuModel model, SemuPlan plan, string emulatorId, string systemId, string core, string rom, SemuDiagnostics diagnostics) {
        SemuLaunchPlan launch = SemuLaunchPlan();
        launch.emulator = emulatorId;
        launch.system = systemId;
        SemuEmulator emulator = model.emulator(emulatorId);
        SemuSystem system = model.system(systemId);
        if (emulator == null || system == null) {
            launch.error = "unknown emulator or system";
            return launch;
        }
        SemuSystemBinding binding = system.bindingFor(plan.platform, emulatorId, core);
        if (binding == null || !plan.systems.contains(systemId) || !plan.emulators.contains(emulatorId)) {
            launch.error = f"{systemId} does not bind {emulatorId} on target {plan.target.id}";
            return launch;
        }
        launch.core = binding.core;
        JSONValue platform = emulator.platform(plan.platform);
        plan.tokens.put("emulator", emulatorId);
        plan.tokens.put("system", systemId);
        plan.tokens.put("core", binding.core);
        string executable = plan.tokens.resolve(SemuJson.textAt(platform, "executable"));
        if (executable.contains("${") || !FileSystem.isFile(executable)) {
            launch.error = "emulator executable is unavailable: " + executable;
            return launch;
        }
        string selectedRom = SemuLauncher.romPath(plan, system, rom);
        if (selectedRom.isEmpty()) {
            launch.error = "ROM is not a file inside the system ROM directory: " + rom;
            return launch;
        }
        launch.rom = selectedRom;
        plan.tokens.put("rom", selectedRom);
        JSONValue loader = platform.get("core_loader");
        string coreFile = "";
        if (loader != null && loader.isObject()) {
            coreFile = SemuLauncher.coreFile(plan, loader, binding.core);
            if (coreFile.isEmpty()) {
                launch.error = "core is unavailable: " + binding.core;
                return launch;
            }
            plan.tokens.put("core_file", coreFile);
        }
        string stateRoot = PathTools.join(plan.stateRoot(), emulatorId);
        plan.tokens.put("state_root", stateRoot);
        for name in ["config", "data", "cache", "state"] {
            if (!SemuPaths.prepareDirectory(PathTools.join(stateRoot, name))) {
                launch.error = "could not create state directory " + stateRoot;
                return launch;
            }
        }
        for name in ["saves", "states", "screenshots"] { SemuPaths.prepareDirectory(PathTools.join(plan.path("content_root"), name)); }
        Vector<SemuProfileFile> files = SemuProfiles.render(model, plan, emulator, diagnostics);
        if (!diagnostics.ok() || !SemuProfiles.write(stateRoot, files, diagnostics)) {
            launch.error = "profile generation failed: " + diagnostics.render();
            return launch;
        }
        for directory in SemuJson.strings(SemuJson.get(platform, "state.create_dirs")) {  // emulator-written dirs the profile points at
            string resolved = plan.tokens.resolve(directory);
            if (SemuPaths.inside(stateRoot, resolved)) { SemuPaths.prepareDirectory(resolved); }
        }
        if (!SemuLauncher.seed(plan, platform, launch)) { return launch; }
        launch.argv.push(executable);
        for argument in SemuJson.strings(SemuJson.get(platform, "state.extra_args")) { launch.argv.push(plan.tokens.resolve(argument)); }
        for argument in SemuJson.strings(platform.get("args")) { launch.argv.push(plan.tokens.resolve(argument)); }
        if (SemuJson.get(platform, "retroarch").isObject()) {
            string config = PathTools.join(stateRoot, "retroarch.cfg");
            for file in files {
                if (!file.path.endsWith("retroarch.cfg")) { continue; }
                config = PathTools.join(stateRoot, file.path);
                launch.retroarchPort = SemuLauncher.commandPort(file.content);  // QUIT and actions use this port
            }
            launch.argv.push("--config");
            launch.argv.push(config);
            SemuPaths.writeOwned(stateRoot, PathTools.join(PathTools.dirname(config), "retroarch-core-options.cfg"),
                SemuLauncher.coreOptions(plan, platform, binding.core, system));
            string overrides = SemuLauncher.coreOverrides(plan, platform, binding.core);
            if (!overrides.isEmpty()) {  // per-core retroarch.cfg keys, e.g. a different video driver
                string overrideFile = PathTools.join(PathTools.dirname(config), "core-" + binding.core + ".cfg");
                SemuPaths.writeOwned(stateRoot, overrideFile, overrides);
                launch.argv.push("--appendconfig");
                launch.argv.push(overrideFile);
            }
        }
        for argument in binding.arguments { launch.argv.push(plan.tokens.resolve(argument)); }
        if (loader != null && loader.isObject()) {
            for argument in SemuJson.strings(loader.get("args")) { launch.argv.push(plan.tokens.resolve(argument)); }
        }
        launch.argv.push(selectedRom);
        SemuLauncher.stateEnvironment(launch, plan, emulator, platform);
        bool preload = SemuJson.boolAt(platform, "render_preload", false);  // GL emulator hooked at its SDL swap by libsemupreload
        if (SemuJson.boolAt(platform, "render_hook", false) || preload) {  // the emulator links libsemurenderer and reads SEMU_RENDER_*
            for entry in SemuRenderEnvironment.compile(plan, system, emulatorId, stateRoot, diagnostics) { launch.environment.push(entry); }
            string shim = PathTools.join(plan.assetRoot, "lib/libsemupreload.so");
            if (preload && FileSystem.isFile(shim)) { launch.environment.push("LD_PRELOAD=" + shim); }
            if (!diagnostics.ok()) {
                launch.error = "rendering configuration failed: " + diagnostics.render();
                return launch;
            }
        }
        if (SemuJson.boolAt(platform, "window_shim", false)) {  // macOS: fullscreen on the frontend's Space, shown once fullscreen (libsemuwindow)
            string windowShim = PathTools.join(plan.assetRoot, "lib/libsemuwindow.dylib");
            if (FileSystem.isFile(windowShim)) { launch.environment.push("DYLD_INSERT_LIBRARIES=" + windowShim); }
        }
        launch.chordWindowMs = plan.input == null ? 250 : plan.input.chordWindowMs();
        if (plan.input != null) { launch.quitButtons = plan.input.quitChord(); }
        SemuLauncher.inputContracts(launch, plan, platform, stateRoot);
        for argument in launch.argv {
            if (argument.contains("${")) { launch.error = "unresolved token in launch arguments: " + argument; }
        }
        for entry in launch.environment {
            if (entry.contains("${")) { launch.error = "unresolved token in launch environment: " + entry; }
        }
        return launch;
    }
}
