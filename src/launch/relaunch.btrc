// Choices an emulator reads only at boot (a Wii game's 4:3 or 16:9 output) and Reset to Default take a
// confirming press: the first press arms a short window and says what the second will do, a second
// press of the same choice inside it acts. Acting may restart the game: the supervisor stops the
// emulator as it does on quit, waits for its group, and `semu launch` plans the same game again.

import Library.JSON;
import Library.Vector;
import ../lib/settings.btrc;
import ../emit/rendering.btrc;
import ../emit/render_choices.btrc;
import ../renderer/action_abi.btrc;
import ./input_state.btrc;
import ./journal.btrc;
import ./plan.btrc;

class SemuRelaunch {
    class long long windowMs() { return 3000LL; }  // a second press later than this prompts again

    class void arm(int action, int slot, long long now) {
        SemuSupervisorRuntime.confirm_action = action;
        SemuSupervisorRuntime.confirm_slot = slot;
        SemuSupervisorRuntime.confirm_until_ms = now + SemuRelaunch.windowMs();
    }

    class bool confirmed(int action, int slot, long long now) {  // the press that completes an armed choice; any other press re-arms
        return SemuSupervisorRuntime.confirm_action == action && SemuSupervisorRuntime.confirm_slot == slot && now <= SemuSupervisorRuntime.confirm_until_ms;
    }

    class void disarm() {
        SemuSupervisorRuntime.confirm_action = 0;
        SemuSupervisorRuntime.confirm_slot = 0;
        SemuSupervisorRuntime.confirm_until_ms = 0LL;
    }

    class void request() {  // stop the emulator as on quit, then start the same game again
        SemuRelaunch.disarm();
        SemuSupervisorRuntime.relaunch = 1;
        SemuSupervisorRuntime.quit = 1;
    }
}

class SemuOutputSwitch {  // Aspect: saved for this game only, so one 16:9 title never stretches the 4:3 ones
    class Vector<string> path(SemuLaunchPlan launch) { return ["visual", "games", launch.system, SemuRenderEnvironment.gameKeyOf(launch.rom), "output"]; }

    class void press(SemuLaunchPlan launch, SemuVariantChoice choice, int target, long long now) {  // the first press prompts (82, reserved 1); the second saves, says so and restarts the game
        if (!SemuRelaunch.confirmed(SemuActions.outputSelect(), target, now)) {
            SemuRelaunch.arm(SemuActions.outputSelect(), target, now);
            SemuActionJournal.appendWith(launch, SemuActions.outputSelect(), target, 1);
            return;
        }
        if (!launch.semuHome.isEmpty() && !launch.system.isEmpty() && !launch.rom.isEmpty()) {
            SemuSettingsStore.putPath(launch.semuHome, SemuOutputSwitch.path(launch), JSONValue.makeString(choice.ids.get(target)));
        }
        SemuActionJournal.appendWith(launch, SemuActions.outputSelect(), target, 0);
        SemuRelaunch.request();
    }
}
