// Every bezel x shader combination a system offers, precomputed at launch into
// $state/semu-render-variants.env: a header naming the choices and their labels (bezels, shaders,
// placements, outputs and render scales), then one [bezel,shader] section per combination holding only the keys
// that combination changes. The supervisor journals an absolute index into these lists; the
// renderer applies that section, or the placement, live.

import Library.FileSystem;
import Library.JSON;
import Library.Strings;
import Library.Vector;
import ../lib/json.btrc;
import ../lib/paths.btrc;
import ../model.btrc;
import ../resolve.btrc;
import ./rendering.btrc;
import ./render_choices.btrc;
import ./render_scale.btrc;
import ./settings_ui.btrc;
import ../renderer/action_abi.btrc;
import ../renderer/variant_keys.btrc;

#include <stdlib.h>
#include <time.h>
#include <unistd.h>

class SemuRenderVariantSet {  // the launch's five choices; all empty when no variants file was written
    public SemuVariantChoice bezel;
    public SemuVariantChoice shader;
    public SemuVariantChoice placement;
    public SemuVariantChoice output;
    public SemuVariantChoice scale;
    public SemuRenderScaleSpec scaleSpec;  // how the emulator takes a scale: at boot, or live on its own hotkeys
    public Vector<string> computed;  // the bezel ids drawn as a computed layout: no art, so Fit has nothing to place there
    public bool written;
    public string token;  // the header's token, handed to the renderer as SEMU_MENU_VARIANTS_TOKEN

    public SemuRenderVariantSet() {
        self.bezel = SemuVariantChoice("bezel");
        self.shader = SemuVariantChoice("shader");
        self.placement = SemuVariantChoice("placement");
        self.output = SemuVariantChoice("output");
        self.scale = SemuVariantChoice("scale");
        self.scaleSpec = SemuRenderScaleSpec(JSONValue.makeNull(), "");
        self.computed = [];
        self.written = false;
        self.token = "";
    }

    public SemuVariantChoice choice(string kind) {  // KIND's choice; an unknown kind is the shader's, as before
        if (kind.equals("bezel")) { return self.bezel; }
        if (kind.equals("placement")) { return self.placement; }
        if (kind.equals("output")) { return self.output; }
        if (kind.equals("scale")) { return self.scale; }
        return self.shader;
    }

    public bool placeable() { return !self.bezel.off() && !self.computed.contains(self.bezel.current()); }  // the live bezel has art for Fit to place: not off, not a computed layout

    public Vector<string> shown() {  // the menu rows' `when` names this launch offers: a choice with two or more
        Vector<string> result = [];
        if (self.placement.cycled >= 2) { result.push("placements"); }
        if (self.output.cycled >= 2) { result.push("outputs"); }
        if (self.scale.cycled >= 2) { result.push("scales"); }
        return result;
    }
}

class SemuRenderVariants {
    class JSONValue manifest(SemuSystem system, string kind) { return kind.equals("bezel") ? system.bezels : system.shaders; }

    class Vector<string> choices(SemuSystem system, string kind) {  // the settings page's order: variant ids, then none; empty without variants
        JSONValue manifest = SemuRenderVariants.manifest(system, kind);
        Vector<string> ids = SemuSettingsUi.variantIds(manifest);
        if (ids.isEmpty() || !SemuJson.boolAt(manifest, "enabled", false)) {
            Vector<string> none = [];
            return none;
        }
        ids.push("none");
        return ids;
    }

    class Vector<string> choicesFor(SemuPlan plan, SemuSystem system, string kind) {  // only the bezels drawn for the game's output: a hole's aspect is the picture's
        Vector<string> ids = SemuRenderVariants.choices(system, kind);
        string output = SemuRenderEnvironment.outputId(plan, system);
        if (!kind.equals("bezel") || output.isEmpty()) { return ids; }
        Vector<string> drawn = [];
        for variantId in ids {
            if (variantId.equals("none") || SemuRenderEnvironment.variantOutput(system, variantId).equals(output)) { drawn.push(variantId); }
        }
        if (drawn.size() > 1) { return drawn; }
        Vector<string> none = [];
        return none;
    }

    class string current(SemuPlan plan, SemuSystem system, string kind) {  // under a second output the chosen bezel's partner drawn for it
        if (!kind.equals("bezel")) { return SemuRenderEnvironment.shaderVariantId(plan, system); }
        string chosen = SemuRenderEnvironment.bezelVariantId(plan, system);
        string output = SemuRenderEnvironment.outputId(plan, system);
        return output.isEmpty() || chosen.equals("none") ? chosen : SemuRenderEnvironment.outputVariant(system, chosen, output);
    }

    class bool drawable(char character) { return SemuRenderLabels.drawable(character); }

    class string label(JSONValue manifest, string variantId) {  // the manifest label upper-cased and filtered, at most labelCapacity; none is OFF
        if (variantId.equals("none")) { return "OFF"; }
        string source = SemuJson.textAt(SemuRenderEnvironment.findVariant(manifest, variantId), "label");
        return SemuRenderLabels.toastSafe(source.isEmpty() ? variantId : source, RendererVariantKeys.labelCapacity());
    }

    class SemuVariantChoice choice(SemuPlan plan, SemuSystem system, string kind) {  // the ids, labels and the index this launch starts on
        SemuVariantChoice result = SemuVariantChoice(kind);
        JSONValue manifest = SemuRenderVariants.manifest(system, kind);
        result.ids = SemuRenderVariants.choicesFor(plan, system, kind);
        result.cycled = result.ids.size();
        for variantId in result.ids { result.labels.push(SemuRenderVariants.label(manifest, variantId)); }
        int found = result.ids.indexOf(SemuRenderVariants.current(plan, system, kind));
        result.index = found >= 0 ? found : 0;
        string defaultId = SemuJson.textAt(manifest, "default_variant");
        string output = SemuRenderEnvironment.outputId(plan, system);
        if (kind.equals("bezel") && !output.isEmpty()) { defaultId = SemuRenderEnvironment.outputVariant(system, defaultId, output); }  // the default bezel's partner for this output
        int fallback = result.ids.indexOf(defaultId);
        result.lastReal = result.off() ? (fallback >= 0 ? fallback : 0) : result.index;
        bool switched = SemuJson.boolAt(plan.settings, kind.equals("bezel") ? "visual.bezels" : "visual.crt_shaders", true);  // the global switch stays the default
        result.defaultIndex = result.ids.isEmpty() ? -1 : (switched && fallback >= 0 ? fallback : result.ids.size() - 1);
        return result;
    }

    class SemuRenderVariantSet choose(SemuPlan plan, SemuSystem system) { return SemuRenderVariants.chooseFor(plan, system, plan.tokens.get("emulator")); }  // the launch's emulator, from the plan's tokens

    class SemuRenderVariantSet chooseFor(SemuPlan plan, SemuSystem system, string emulatorId) {  // every choice this launch offers, written or not
        SemuRenderVariantSet set = SemuRenderVariantSet();
        set.bezel = SemuRenderVariants.choice(plan, system, "bezel");
        set.shader = SemuRenderVariants.choice(plan, system, "shader");
        set.placement = SemuRenderChoices.placement(plan, system, set.bezel.available());
        set.output = SemuRenderChoices.output(plan, system);
        set.scale = SemuRenderChoices.scale(plan, system, emulatorId);  // the render scales this emulator takes
        set.scaleSpec = SemuRenderScale.specFor(plan, system, emulatorId);
        for variantId in set.bezel.ids {  // the DS and 3DS layouts Semu works out from the screen draw no art
            if (!variantId.equals("none") && SemuBezelPackage.computed(SemuBezelPackage.load(plan, SemuRenderEnvironment.packageFor(plan, system, variantId)))) { set.computed.push(variantId); }
        }
        return set;
    }

    class Vector<string> column(SemuVariantChoice choice, string launched) {  // a kind without choices keeps the launch's own value in its one column
        if (choice.available()) { return choice.ids; }
        Vector<string> single = [launched];
        return single;
    }

    class string text(SemuPlan plan, SemuSystem system, string emulatorId, string stateRoot, SemuRenderVariantSet set) {
        Vector<string> lines = [f"schema={RendererVariantKeys.schema()}", RendererVariantKeys.systemKey() + "=" + system.id];
        lines.push(RendererVariantKeys.bezelsKey() + "=" + set.bezel.ids.join("|"));
        lines.push(RendererVariantKeys.bezelLabelsKey() + "=" + set.bezel.labels.join("|"));
        lines.push(RendererVariantKeys.shadersKey() + "=" + set.shader.ids.join("|"));
        lines.push(RendererVariantKeys.shaderLabelsKey() + "=" + set.shader.labels.join("|"));
        lines.push(RendererVariantKeys.placementsKey() + "=" + set.placement.ids.join("|"));
        lines.push(RendererVariantKeys.placementLabelsKey() + "=" + set.placement.labels.join("|"));
        lines.push(RendererVariantKeys.outputsKey() + "=" + set.output.ids.join("|"));
        lines.push(RendererVariantKeys.outputLabelsKey() + "=" + set.output.labels.join("|"));
        lines.push(RendererVariantKeys.scalesKey() + "=" + set.scale.ids.join("|"));
        lines.push(RendererVariantKeys.scaleLabelsKey() + "=" + set.scale.labels.join("|"));
        int placement = set.placement.available() ? set.placement.index : -1;
        int output = set.output.available() ? set.output.index : -1;
        int scale = set.scale.available() ? set.scale.index : -1;
        lines.push(RendererVariantKeys.currentKey() + f"={set.bezel.index},{set.shader.index},{placement},{output},{scale}");
        lines.push(RendererVariantKeys.tokenKey() + "=" + set.token);
        Vector<string> bezels = SemuRenderVariants.column(set.bezel, SemuRenderEnvironment.bezelVariantId(plan, system));
        Vector<string> shaders = SemuRenderVariants.column(set.shader, SemuRenderEnvironment.shaderVariantId(plan, system));
        SemuRenderPackages packages = SemuRenderPackages();
        SemuDiagnostics quiet = SemuDiagnostics();  // the launch's own combination already reported; the checker covers the rest
        for (int bezel = 0; bezel < bezels.size(); bezel++) {
            for (int shader = 0; shader < shaders.size(); shader++) {
                lines.push(f"[{bezel},{shader}]");
                for entry in SemuRenderEnvironment.compileFor(plan, system, emulatorId, stateRoot, bezels.get(bezel), shaders.get(shader), packages, quiet) {
                    if (RendererVariantKeys.scopedLine(entry)) { lines.push(entry); }
                }
            }
        }
        return lines.join("\n") + "\n";
    }

    class string path(string stateRoot) { return PathTools.join(stateRoot, RendererActionJournal.variantsFileName()); }

    class string token() {  // this launch's: wall-clock nanoseconds and the pid, so a later session's renderer ignores the file
        struct timespec now;
        clock_gettime(CLOCK_REALTIME, &now);
        char* buffer = (char*)malloc((size_t)48);
        snprintf(buffer, (size_t)48, "%lld%09ld-%d", (long long)now.tv_sec, (long)now.tv_nsec, (int)getpid());
        return __btrc_str_track(buffer);
    }

    class Vector<string> environment(SemuRenderVariantSet set) {  // what the renderer needs to trust the file; nothing when none was written
        Vector<string> result = [];
        if (set.written) { result.push(RendererVariantKeys.tokenVariable() + "=" + set.token); }
        return result;
    }

    class SemuRenderVariantSet write(SemuPlan plan, SemuSystem system, string emulatorId, string stateRoot) {  // empty choices when the file could not be written: nothing to cycle
        SemuRenderVariantSet set = SemuRenderVariants.chooseFor(plan, system, emulatorId);
        set.token = SemuRenderVariants.token();
        if (!SemuPaths.writeOwned(stateRoot, SemuRenderVariants.path(stateRoot), SemuRenderVariants.text(plan, system, emulatorId, stateRoot, set))) { return SemuRenderVariantSet(); }
        set.written = true;
        return set;
    }
}
