import Library.FileSystem;
import Library.JSON;
import Library.Strings;
import Library.Vector;
import ../lib/json.btrc;
import ../model.btrc;
import ../resolve.btrc;

#include <stdio.h>
#include <stdlib.h>

class SemuRenderAssets {
    class string shader(SemuPlan plan, string logical) {  // assets/shaders/x -> share/libretro/shaders/semu/x
        string prefix = "assets/shaders/";
        if (!logical.startsWith(prefix)) { return ""; }
        string path = PathTools.join(plan.assetRoot, "share/libretro/shaders/semu/" + logical.substring(prefix.len(), logical.len() - prefix.len()));
        return FileSystem.isFile(path) ? path : "";
    }

    class string image(SemuPlan plan, string logical) {  // assets/bezels/x -> share/semu/assets/bezels/x
        if (!logical.startsWith("assets/")) { return ""; }
        string path = PathTools.join(plan.assetRoot, "share/semu/" + logical);
        if (FileSystem.isFile(path)) { return path; }
        string source = PathTools.join(plan.configRoot, logical);
        return FileSystem.isFile(source) ? source : "";
    }
}

class SemuRenderLayers {  // the package's layer stack for the compositor: file, extent, blend, above or below the screens
    class string pack(string upstream) {
        if (upstream.equals("duimon_mega_bezel")) { return "Duimon-Mega-Bezel"; }
        if (upstream.equals("soqueroeu_tv")) { return "Soqueroeu-TV-Backgrounds_V2.0"; }
        return upstream;
    }

    class string file(SemuPlan plan, string packageId, string layerId, string reference) {  // "semu:assets/..." or "<upstream>:<relative>" -> a file the renderer can open
        int colon = Strings.find(reference, ":", 0);
        if (colon <= 0) { return FileSystem.isFile(reference) ? reference : ""; }
        string name = reference.substring(0, colon);
        string rest = reference.substring(colon + 1, reference.len() - colon - 1);
        if (name.equals("semu")) { return SemuRenderAssets.image(plan, rest); }
        int dot = Strings.rfind(rest, ".");
        string extension = dot > 0 ? rest.substring(dot, rest.len() - dot) : "";
        string bundled = SemuRenderAssets.image(plan, "assets/bezels/layers/" + packageId + "/" + layerId + extension);
        if (!bundled.isEmpty()) { return bundled; }
        string staged = PathTools.join(PathTools.join(PathTools.join(PathTools.dirname(plan.configRoot), "build/bezel/shaders/Mega_Bezel_Packs"), SemuRenderLayers.pack(name)), rest);
        return FileSystem.isFile(staged) ? staged : "";
    }

    class void emit(SemuRenderEnvironment env, SemuPlan plan, JSONValue package, string suffix, SemuDiagnostics diagnostics) {
        JSONValue layers = package.get("layers");
        JSONValue canvas = package.get("canvas");
        if (layers == null || !layers.isArray() || canvas == null || !canvas.isObject()) { return; }
        string packageId = SemuJson.textAt(package, "id");
        int canvasWidth = SemuJson.intAt(canvas, "w", 0);
        int canvasHeight = SemuJson.intAt(canvas, "h", 0);
        double screensOrder = 0.0;
        for (int index = 0; index < layers.size(); index++) { if (SemuJson.textAt(layers.at(index), "id").equals("cutouts")) { screensOrder = atof(SemuRenderEnvironment.numberOr(layers.at(index), "order", "0")); } }
        int count = 0;
        Vector<string> lines = [];
        Vector<double> orders = [];
        for (int index = 0; index < layers.size(); index++) {
            JSONValue layer = layers.at(index);
            string id = SemuJson.textAt(layer, "id");
            if (id.equals("cutouts") || !SemuJson.boolAt(layer, "visible", true)) { continue; }
            string file = SemuRenderLayers.file(plan, packageId, id, SemuJson.textAt(layer, "file"));
            if (file.isEmpty()) { continue; }  // not bundled and not staged: the renderer skips the layer rather than the launch failing
            double order = atof(SemuRenderEnvironment.numberOr(layer, "order", "0"));
            bool canvasSized = SemuJson.intAt(layer.get("size"), "w", 0) == canvasWidth && SemuJson.intAt(layer.get("size"), "h", 0) == canvasHeight;
            string extent = SemuJson.textAt(layer, "follow").equals("viewport") ? (canvasSized ? "0,0,1,1" : "cover") : SemuRenderEnvironment.rect(layer.get("rect"), canvas);  // a viewport-following plate the size of the canvas is the canvas
            if (extent.isEmpty()) { continue; }
            string blend = SemuJson.textAt(layer, "blend");
            string blendCode = blend.equals("add") ? "1" : (blend.equals("multiply") ? "2" : "0");
            string line = f"{file}|{extent}|{order > screensOrder ? "1" : "0"}|{blendCode}|{SemuRenderEnvironment.numberOr(layer, "opacity", "1")}";
            int at = 0;
            while (at < orders.size() && orders[at] <= order) { at++; }
            lines.insert(at, line);
            orders.insert(at, order);
        }
        if (lines.size() == 0) { return; }
        env.set("SEMU_RENDER_CANVAS" + suffix, f"{SemuRenderEnvironment.numberOr(canvas, "w", "0")},{SemuRenderEnvironment.numberOr(canvas, "h", "0")}");
        for (int index = 0; index < lines.size() && index < 8; index++) { env.set(f"SEMU_RENDER_LAYER_{index}{suffix}", lines[index]); count++; }
        env.set("SEMU_RENDER_LAYER_COUNT" + suffix, f"{count}");
    }
}

class SemuBezelPackage {  // config/bezels/<id>/bezel.json: art, background, layout, frame and per-screen tubes and looks
    class string file(SemuPlan plan, string id) { return PathTools.join(plan.configRoot, "bezels/" + id + "/bezel.json"); }

    class JSONValue load(SemuPlan plan, string id) {
        if (id.isEmpty() || id.contains("/") || id.contains("..")) { return JSONValue.makeNull(); }
        string path = SemuBezelPackage.file(plan, id);
        if (!FileSystem.isFile(path)) { return JSONValue.makeNull(); }
        JSONValue document = JSONValue.parse(FileSystem.readText(path));
        return document != null && document.isObject() && SemuJson.textAt(document, "id").equals(id) ? document : JSONValue.makeNull();
    }

    class string layout(JSONValue package) {
        string value = SemuJson.textAt(package, "layout");
        for name in ["main_right", "main_left", "side_by_side", "stacked"] { if (value.equals(name)) { return value; } }
        return "fixed";
    }

    class bool computed(JSONValue package) { return !SemuBezelPackage.layout(package).equals("fixed"); }

    class JSONValue screen(JSONValue package, string id) {
        JSONValue screens = package == null ? null : package.get("screens");
        if (screens == null || !screens.isArray()) { return JSONValue.makeNull(); }
        for (int index = 0; index < screens.size(); index++) {
            if (SemuJson.textAt(screens.at(index), "id").equals(id)) { return screens.at(index); }
        }
        return screens.size() == 1 && id.equals("main") ? screens.at(0) : JSONValue.makeNull();
    }
}

class SemuRenderEnvironment {
    public Vector<string> entries;

    public SemuRenderEnvironment() { self.entries = []; }

    public void set(string name, string value) { if (!value.isEmpty()) { self.entries.push(name + "=" + value); } }

    class string number(JSONValue value) {  // shortest round-trip text: 0.04, not 0.040000000000000001
        if (value == null || !value.isNumber()) { return ""; }
        double parsed = atof(value.stringify());
        char* buffer = (char*)malloc(32);
        snprintf(buffer, 32, "%.6g", parsed);
        return __btrc_str_track(buffer);
    }

    class string numberOr(JSONValue object, string key, string fallback) {
        string text = SemuRenderEnvironment.number(object == null ? null : object.get(key));
        return text.isEmpty() ? fallback : text;
    }

    class string fraction(double value) {
        char* buffer = (char*)malloc(32);
        snprintf(buffer, 32, "%.6g", value);
        return __btrc_str_track(buffer);
    }

    class string rect(JSONValue rect, JSONValue canvas) {  // canvas pixels -> normalized top-left rectangle
        if (rect == null || !rect.isObject() || canvas == null || !canvas.isObject()) { return ""; }
        double width = atof(SemuRenderEnvironment.numberOr(canvas, "w", "0"));
        double height = atof(SemuRenderEnvironment.numberOr(canvas, "h", "0"));
        if (width <= 0.0 || height <= 0.0) { return ""; }
        double x = atof(SemuRenderEnvironment.numberOr(rect, "x", "-1"));
        double y = atof(SemuRenderEnvironment.numberOr(rect, "y", "-1"));
        double w = atof(SemuRenderEnvironment.numberOr(rect, "w", "0"));
        double h = atof(SemuRenderEnvironment.numberOr(rect, "h", "0"));
        if (x < 0.0 || y < 0.0 || w <= 0.0 || h <= 0.0 || x + w > width + 0.5 || y + h > height + 0.5) { return ""; }
        return f"{SemuRenderEnvironment.fraction(x / width)},{SemuRenderEnvironment.fraction(y / height)},{SemuRenderEnvironment.fraction(w / width)},{SemuRenderEnvironment.fraction(h / height)}";
    }

    class string tube(JSONValue screen, JSONValue canvas) {  // the opening; a calibrated image rectangle stands in when no opening was measured
        if (screen == null) { return ""; }
        string opening = SemuRenderEnvironment.rect(screen.get("tube"), canvas);
        return opening.isEmpty() ? SemuRenderEnvironment.rect(screen.get("image"), canvas) : opening;
    }

    class double shortSide(JSONValue rect) {
        double w = atof(SemuRenderEnvironment.numberOr(rect, "w", "0"));
        double h = atof(SemuRenderEnvironment.numberOr(rect, "h", "0"));
        return w < h ? w : h;
    }

    class string ring(JSONValue screen, JSONValue canvas) {  // inner rect, outer rect, corner radii as fractions of each rect's short side, r,g,b
        JSONValue ring = screen.get("ring");
        if (ring == null || !ring.isObject()) { return ""; }
        string inner = SemuRenderEnvironment.rect(ring.get("inner"), canvas);
        string outer = SemuRenderEnvironment.rect(ring.get("outer"), canvas);
        if (inner.isEmpty() || outer.isEmpty()) { return ""; }
        double innerSide = SemuRenderEnvironment.shortSide(ring.get("inner"));
        double outerSide = SemuRenderEnvironment.shortSide(ring.get("outer"));
        double innerRadius = atof(SemuRenderEnvironment.numberOr(ring, "inner_radius", "0"));
        double outerRadius = atof(SemuRenderEnvironment.numberOr(ring, "outer_radius", "0"));
        string radii = f"{SemuRenderEnvironment.fraction(innerSide > 0.0 ? innerRadius / innerSide : 0.0)},{SemuRenderEnvironment.fraction(outerSide > 0.0 ? outerRadius / outerSide : 0.0)}";
        string color = SemuJson.textAt(ring, "color");
        if (color.equals("none")) { return f"{inner},{outer},{radii},0,0,0,0"; }  // the band marks a painted bezel: reflection only, no fill
        return f"{inner},{outer},{radii},{SemuRenderEnvironment.color(color, "0.1,0.1,0.1")},1";
    }

    class string color(string hex, string fallback) {  // #rrggbb -> r,g,b in 0..1
        if (hex.len() != 7 || !hex.startsWith("#")) { return fallback; }
        int channels[3];
        for (int index = 0; index < 3; index++) {
            int value = 0;
            for (int digit = 0; digit < 2; digit++) {
                char c = hex.charAt(1 + index * 2 + digit);
                int nibble = c >= '0' && c <= '9' ? c - '0' : (c >= 'a' && c <= 'f' ? 10 + c - 'a' : (c >= 'A' && c <= 'F' ? 10 + c - 'A' : -1));
                if (nibble < 0) { return fallback; }
                value = value * 16 + nibble;
            }
            channels[index] = value;
        }
        return f"{SemuRenderEnvironment.fraction(channels[0] / 255.0)},{SemuRenderEnvironment.fraction(channels[1] / 255.0)},{SemuRenderEnvironment.fraction(channels[2] / 255.0)}";
    }

    class string bulge(JSONValue screen) {  // bx,by: how far the side and the top/bottom edges bow outward, as fractions of the opening's half width and half height
        JSONValue shape = screen.get("shape");
        JSONValue bulge = shape == null || !shape.isObject() ? null : shape.get("bulge");
        JSONValue tube = screen.get("tube");
        if (bulge == null || !bulge.isObject() || tube == null || !tube.isObject()) { return ""; }
        double w = atof(SemuRenderEnvironment.numberOr(tube, "w", "0"));
        double h = atof(SemuRenderEnvironment.numberOr(tube, "h", "0"));
        double x = atof(SemuRenderEnvironment.numberOr(bulge, "x", "0"));
        double y = atof(SemuRenderEnvironment.numberOr(bulge, "y", "0"));
        if (w <= 0.0 || h <= 0.0 || (x <= 0.0 && y <= 0.0)) { return ""; }
        return f"{SemuRenderEnvironment.fraction(x / (w / 2.0))},{SemuRenderEnvironment.fraction(y / (h / 2.0))}";
    }

    class string reflect(JSONValue screen) {  // strength,blur,fade of the picture mirrored onto the ring, or onto the plate around the opening
        JSONValue reflection = screen.get("reflection");
        if (reflection == null || !reflection.isObject()) { return ""; }
        double strength = atof(SemuRenderEnvironment.numberOr(reflection, "strength", "0"));
        if (strength <= 0.0) { return ""; }
        return f"{SemuRenderEnvironment.fraction(strength)},{SemuRenderEnvironment.fraction(atof(SemuRenderEnvironment.numberOr(reflection, "blur", "0")))},{SemuRenderEnvironment.fraction(atof(SemuRenderEnvironment.numberOr(reflection, "fade", "0")))}";
    }

    class string look(JSONValue screen) {  // shape,radius,exponent,fit,inset,curvature,vignette,bloom,glow,reflect
        JSONValue shape = screen.get("shape");
        string kind = SemuJson.textAt(shape, "kind");
        string shapeCode = kind.equals("rounded") ? "1" : (kind.equals("squircle") ? "2" : "0");
        string fit = SemuJson.textAt(screen, "fit");
        string fitCode = fit.equals("fill") ? "1" : (fit.equals("integer") ? "2" : "0");
        JSONValue glass = screen.get("glass");
        string reflect = glass != null && glass.isObject() ? SemuRenderEnvironment.numberOr(glass, "reflect", "0") : "0";
        return f"{shapeCode},{SemuRenderEnvironment.numberOr(shape, "radius", "0")},{SemuRenderEnvironment.numberOr(shape, "exponent", "4")},{fitCode},{SemuRenderEnvironment.numberOr(screen, "inset", "0")},{SemuRenderEnvironment.numberOr(screen, "curvature", "0")},{SemuRenderEnvironment.numberOr(screen, "vignette", "0")},{SemuRenderEnvironment.numberOr(screen, "bloom", "0")},{SemuRenderEnvironment.numberOr(screen, "glow", "0")},{reflect}";
    }

    class JSONValue findVariant(JSONValue manifest, string id) {
        JSONValue variants = manifest == null ? null : manifest.get("variants");
        if (variants == null || !variants.isArray()) { return JSONValue.makeNull(); }
        for (int index = 0; index < variants.size(); index++) {
            if (SemuJson.textAt(variants.at(index), "id").equals(id)) { return variants.at(index); }
        }
        return JSONValue.makeNull();
    }

    class string packageId(SemuSystem system, string variantId) {
        JSONValue variant = SemuRenderEnvironment.findVariant(system.bezels, variantId);
        return variant.isObject() ? SemuJson.textAt(variant, "bezel") : "";
    }

    class bool usable(SemuPlan plan, JSONValue package) {  // a fixed bezel needs its plate in this asset root; computed layouts need nothing
        if (package == null || !package.isObject()) { return false; }
        if (SemuBezelPackage.computed(package)) { return true; }
        return !SemuRenderAssets.image(plan, SemuJson.textAt(package, "art")).isEmpty();
    }

    class Vector<string> screenIds(SemuSystem system) {
        Vector<string> ids = [];
        JSONValue display = system.definition.get("display");
        JSONValue screens = display == null ? null : display.get("screens");
        if (screens == null || !screens.isArray()) { return ids; }
        for (int index = 0; index < screens.size(); index++) { ids.push(SemuJson.textAt(screens.at(index), "id")); }
        return ids;
    }

    class string screenShader(SemuPlan plan, SemuSystem system, string shaderId, string screenId) {  // shaders.json variants may name a preset per screen
        JSONValue variant = SemuRenderEnvironment.findVariant(system.shaders, shaderId);
        JSONValue screens = variant.isObject() ? variant.get("screens") : null;
        if (screens == null || !screens.isObject() || !screens.has(screenId)) { return ""; }
        return SemuRenderAssets.shader(plan, SemuJson.text(screens.get(screenId)));
    }

    class void variant(SemuRenderEnvironment env, SemuPlan plan, SemuSystem system, string suffix, JSONValue package, string shaderPath, string shaderId, SemuDiagnostics diagnostics) {
        if (!shaderPath.isEmpty()) { env.set("SEMU_RENDER_SHADER_PRESET" + suffix, shaderPath); }
        Vector<string> ids = SemuRenderEnvironment.screenIds(system);
        bool bezel = SemuRenderEnvironment.usable(plan, package);
        if (bezel) {
            env.set("SEMU_RENDER_BEZEL_ID" + suffix, SemuJson.textAt(package, "id"));
            env.set("SEMU_RENDER_ART" + suffix, SemuRenderAssets.image(plan, SemuJson.textAt(package, "art")));
            env.set("SEMU_RENDER_BACKGROUND" + suffix, SemuRenderAssets.image(plan, SemuJson.textAt(package, "background")));
            env.set("SEMU_RENDER_LAYOUT" + suffix, SemuBezelPackage.layout(package));
            SemuRenderLayers.emit(env, plan, package, suffix, diagnostics);
            JSONValue frame = package.get("frame");
            if (frame != null && frame.isObject()) {
                string around = SemuJson.textAt(frame, "around").equals("game") ? "1" : "0";  // ring around the fitted game inside a device opening, else around the opening
                env.set("SEMU_RENDER_FRAME" + suffix, f"{SemuRenderEnvironment.numberOr(frame, "width", "0")},{SemuRenderEnvironment.numberOr(frame, "radius", "0")},{SemuRenderEnvironment.color(SemuJson.textAt(frame, "color"), "0.08,0.08,0.08")},{around}");
            }
        }
        for (int index = 0; index < ids.size(); index++) {
            string id = ids.size() == 1 ? "main" : ids[index];
            JSONValue screen = bezel ? SemuBezelPackage.screen(package, id) : JSONValue.makeNull();
            if (screen.isObject()) {
                env.set(f"SEMU_RENDER_SCREEN_{index}{suffix}", SemuRenderEnvironment.tube(screen, package.get("canvas")));
                env.set(f"SEMU_RENDER_SCREEN_{index}_IMAGE{suffix}", SemuRenderEnvironment.rect(screen.get("image"), package.get("canvas")));  // where the upstream preset puts the picture inside the opening
                env.set(f"SEMU_RENDER_SCREEN_{index}_RING{suffix}", SemuRenderEnvironment.ring(screen, package.get("canvas")));  // the upstream preset's drawn bezel between the black edge and the opening
                env.set(f"SEMU_RENDER_SCREEN_{index}_LOOK{suffix}", SemuRenderEnvironment.look(screen));
                env.set(f"SEMU_RENDER_SCREEN_{index}_BULGE{suffix}", SemuRenderEnvironment.bulge(screen));  // each edge's middle bowed outward, like a CRT tube
                env.set(f"SEMU_RENDER_SCREEN_{index}_REFLECT{suffix}", SemuRenderEnvironment.reflect(screen));  // the picture glowing on the ring
                env.set(f"SEMU_RENDER_SCREEN_{index}_SURROUND{suffix}", SemuRenderEnvironment.color(SemuJson.textAt(screen, "surround"), "0,0,0"));
                JSONValue glass = screen.get("glass");
                if (glass != null && glass.isObject()) { env.set(f"SEMU_RENDER_SCREEN_{index}_GLASS{suffix}", SemuRenderAssets.image(plan, SemuJson.textAt(glass, "asset"))); }
            }
            string screenShader = screen.isObject() ? SemuRenderAssets.shader(plan, SemuJson.textAt(screen, "shader")) : "";
            if (screenShader.isEmpty() && !shaderPath.isEmpty()) { screenShader = SemuRenderEnvironment.screenShader(plan, system, shaderId, ids[index]); }
            env.set(f"SEMU_RENDER_SCREEN_{index}_SHADER{suffix}", screenShader);
        }
    }

    class void surfaces(SemuRenderEnvironment env, SemuSystem system, SemuDiagnostics diagnostics) {
        JSONValue display = system.definition.get("display");
        JSONValue screens = display == null ? null : display.get("screens");
        if (screens == null || !screens.isArray() || screens.size() < 1 || screens.size() > 2) {
            diagnostics.add(system.file, "display.screens", "renderer needs one or two declared screens");
            return;
        }
        string arrangement = screens.size() == 1 ? "single" : SemuJson.textAt(display, "arrangement");
        if (screens.size() == 2 && !arrangement.equals("horizontal") && !arrangement.equals("vertical")) { arrangement = "vertical"; }
        env.set("SEMU_RENDER_SURFACE_COUNT", Strings.fromInt(screens.size()));
        env.set("SEMU_RENDER_SURFACE_LAYOUT", arrangement);
        bool equalWidths = screens.size() == 2 && SemuJson.intAt(screens.at(0), "native.w", 0) == SemuJson.intAt(screens.at(1), "native.w", 0);
        env.set("SEMU_RENDER_SURFACE_NATIVE_WIDTH_POLICY", equalWidths ? "equal" : "independent");  // 3DS stacks 400 over 320
        string geometry = SemuJson.textAt(display, "source_geometry");
        env.set("SEMU_RENDER_SURFACE_GEOMETRY_POLICY", geometry.isEmpty() ? (screens.size() == 1 ? "positive" : "uniform_integer_scale") : geometry);
        for (int index = 0; index < screens.size(); index++) {
            JSONValue screen = screens.at(index);
            env.set(f"SEMU_RENDER_SURFACE_{index}_ID", SemuJson.textAt(screen, "id"));
            env.set(f"SEMU_RENDER_SURFACE_{index}_NATIVE", f"{SemuJson.intAt(screen, "native.w", 0)}x{SemuJson.intAt(screen, "native.h", 0)}");
        }
        string touch = SemuJson.textAt(display, "surface_mapping.touch_screen");
        for (int index = 0; index < screens.size(); index++) {
            if (!touch.isEmpty() && SemuJson.textAt(screens.at(index), "id").equals(touch)) {
                env.set("SEMU_RENDER_TOUCH_SURFACE_ID", touch);
                env.set("SEMU_RENDER_TOUCH_SURFACE_INDEX", Strings.fromInt(index));
            }
        }
    }

    class Vector<string> compile(SemuPlan plan, SemuSystem system, string emulatorId, string stateRoot, SemuDiagnostics diagnostics) {
        SemuRenderEnvironment env = SemuRenderEnvironment();
        JSONValue settings = plan.settings;
        bool wantShaders = SemuJson.boolAt(settings, "visual.crt_shaders", true) && SemuJson.boolAt(system.shaders, "enabled", false);
        bool wantBezels = SemuJson.boolAt(settings, "visual.bezels", true) && SemuJson.boolAt(system.bezels, "enabled", false);
        string shaderId = SemuJson.textAt(settings, "visual.systems." + system.id + ".shader_variant");
        if (shaderId.isEmpty()) { shaderId = SemuJson.textAt(system.shaders, "default_variant"); }
        string bezelId = SemuJson.textAt(settings, "visual.systems." + system.id + ".bezel_variant");
        if (bezelId.isEmpty() || SemuRenderEnvironment.packageId(system, bezelId).isEmpty()) { bezelId = SemuJson.textAt(system.bezels, "default_variant"); }
        string shaderPath = "";
        if (wantShaders && !shaderId.isEmpty() && !shaderId.equals("none")) {
            JSONValue variant = SemuRenderEnvironment.findVariant(system.shaders, shaderId);
            shaderPath = SemuRenderAssets.shader(plan, SemuJson.textAt(variant, "screen"));  // empty when the bundle lacks the preset
        } else if (wantShaders && shaderId.isEmpty()) {
            shaderPath = SemuRenderAssets.shader(plan, SemuJson.textAt(system.shaders, "screen"));  // single-preset manifests name the screen directly
        }
        JSONValue package = wantBezels && !bezelId.isEmpty() && !bezelId.equals("none") ? SemuBezelPackage.load(plan, SemuRenderEnvironment.packageId(system, bezelId)) : JSONValue.makeNull();
        if (wantBezels && !bezelId.isEmpty() && !bezelId.equals("none") && !package.isObject()) {
            diagnostics.add(system.file, "bezels.variants", "bezel variant '" + bezelId + "' names no package under config/bezels");
        }
        bool bezels = SemuRenderEnvironment.usable(plan, package);
        env.set("SEMU_RENDER_SYSTEM_ID", system.id);
        env.set("SEMU_RENDER_EMULATOR_ID", emulatorId);
        env.set("SEMU_RENDER_STATE_DIR", stateRoot);
        env.set("SEMU_RENDER_SHADERS", shaderPath.isEmpty() ? "0" : "1");
        env.set("SEMU_RENDER_BEZELS", bezels ? "1" : "0");
        env.set("SEMU_RENDER_INTEGER_SCALE", SemuJson.boolAt(settings, "visual.integer_scaling", true) ? "1" : "0");
        JSONValue display = system.definition.get("display");
        int aspectW = SemuJson.intAt(display, "aspect.w", 0);
        int aspectH = SemuJson.intAt(display, "aspect.h", 0);
        if (aspectW > 0 && aspectH > 0) { env.set("SEMU_RENDER_ASPECT", f"{aspectW}:{aspectH}"); }
        SemuRenderEnvironment.surfaces(env, system, diagnostics);
        if (bezels || !shaderPath.isEmpty()) {
            SemuRenderEnvironment.variant(env, plan, system, "", bezels ? package : JSONValue.makeNull(), shaderPath, shaderId, diagnostics);
            string widescreen = SemuJson.textAt(system.bezels, "widescreen_variant");
            if (bezels && !widescreen.isEmpty() && !widescreen.equals(bezelId)) {
                JSONValue wide = SemuBezelPackage.load(plan, SemuRenderEnvironment.packageId(system, widescreen));
                if (SemuRenderEnvironment.usable(plan, wide)) { SemuRenderEnvironment.variant(env, plan, system, "_B", wide, shaderPath, shaderId, diagnostics); }
            }
        }
        return env.entries;
    }
}
