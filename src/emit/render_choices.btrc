// The choices beside the bezel and the shader: where the picture sits (placement, Fit's four states, whole
// steps or not, picture or bezel first, SemuFitStates), which output the game draws (Aspect, 4:3 or
// 16:9 where a system declares two) and the render scale its emulator draws at (Scale, 1x native,
// 2x, 3x). Each is an ordered list of ids with toast-safe labels, the index the launch starts on and
// the one Reset to Default selects; the variants file carries them.

import Library.JSON;
import Library.Vector;
import ../lib/json.btrc;
import ../model.btrc;
import ../resolve.btrc;
import ./rendering.btrc;
import ./render_scale.btrc;
import ./fit_states.btrc;

#include <stdlib.h>

class SemuVariantChoice {  // one kind's ordered ids, their labels and the live index
    public string kind;  // "bezel", "shader", "placement", "output" or "scale", as in visual.systems.<id>.<kind>_variant
    public Vector<string> ids;
    public Vector<string> labels;
    public int index;
    public int lastReal;  // the last choice that was not none, for the On/Off switches
    public int cycled;  // how many leading ids the toggle steps through
    public int defaultIndex;  // what Reset to Default selects, -1 with nothing to choose
    public int launched;  // the index the game booted on: an output it draws from boot changes only at Restart Game

    public SemuVariantChoice(string kind) {
        self.kind = kind;
        self.ids = [];
        self.labels = [];
        self.index = 0;
        self.lastReal = 0;
        self.cycled = 0;
        self.defaultIndex = -1;
        self.launched = 0;
    }

    public bool available() { return self.cycled > 0; }

    public string current() { return self.index < 0 || self.index >= self.ids.size() ? "" : self.ids.get(self.index); }

    public bool off() { return self.current().equals("none"); }

    public int next(int delta) {  // the index DELTA steps on, wrapping inside the toggle; from outside it (the default fit) the first
        if (self.cycled < 1) { return -1; }
        if (self.index < 0 || self.index >= self.cycled) { return delta >= 0 ? 0 : self.cycled - 1; }
        return ((self.index + delta) % self.cycled + self.cycled) % self.cycled;
    }
}

class SemuRenderLabels {
    class bool drawable(char character) {  // the renderer's 5x7 font: A-Z, 0-9, space and : / + - , . ( )
        if ((character >= 'A' && character <= 'Z') || (character >= '0' && character <= '9')) { return true; }
        return character == ' ' || character == ':' || character == '/' || character == '+' || character == '-'
            || character == ',' || character == '.' || character == '(' || character == ')';
    }

    class string toastSafe(string source, int capacity) {  // upper-cased, filtered to the font, single spaces, at most CAPACITY
        char* buffer = (char*)malloc((size_t)(capacity + 1));
        int written = 0;
        for (int index = 0; index < source.len() && written < capacity; index++) {
            char character = source.charAt(index);
            if (character >= 'a' && character <= 'z') { character = character - 32; }
            if (!SemuRenderLabels.drawable(character)) { character = ' '; }
            if (character == ' ' && (written == 0 || buffer[written - 1] == ' ')) { continue; }  // no leading or doubled spaces
            buffer[written] = character;
            written++;
        }
        while (written > 0 && buffer[written - 1] == ' ') { written--; }
        buffer[written] = 0;
        return __btrc_str_track(buffer);
    }
}

class SemuRenderChoices {
    class string placementLabel(SemuPlan plan, string placement) {  // input.json's visual.placement.next choices: INTEGER GAME for game
        JSONValue actions = plan.input == null ? null : plan.input.definition.get("actions");
        JSONValue action = actions != null && actions.isObject() && actions.has("visual.placement.next") ? actions.get("visual.placement.next") : null;
        string label = SemuJson.textAt(action, "choices." + placement);
        return SemuRenderLabels.toastSafe(label.isEmpty() ? placement : label, 31);
    }

    class void pushOnce(SemuVariantChoice choice, SemuPlan plan, string placement) {
        if (choice.ids.contains(placement)) { return; }
        choice.ids.push(placement);
        choice.labels.push(SemuRenderChoices.placementLabel(plan, placement));
    }

    class SemuVariantChoice placement(SemuPlan plan, SemuSystem system, bool bezels) {  // the four Fit states in cycle order; with no bezel to place the two game states, whole steps or not
        SemuVariantChoice result = SemuVariantChoice("placement");
        Vector<string> domain = bezels ? SemuFitStates.all() : SemuFitStates.pictureOnly();
        for placement in domain { SemuRenderChoices.pushOnce(result, plan, placement); }
        result.cycled = result.ids.size();
        string fallback = SemuFitStates.fallback(plan.settings, system);
        string current = SemuFitStates.current(plan.settings, system);
        if (!bezels) {  // the integer states read as integer game, the others as non-integer game
            fallback = SemuFitStates.whole(fallback) ? "game" : "game_fractional";
            current = SemuFitStates.whole(current) ? "game" : "game_fractional";
        }
        result.index = result.ids.indexOf(current);
        result.defaultIndex = result.ids.indexOf(fallback);
        result.lastReal = result.index;
        return result;
    }

    class SemuVariantChoice output(SemuPlan plan, SemuSystem system) {  // the system's outputs, on the game's own choice; none with one output
        SemuVariantChoice result = SemuVariantChoice("output");
        JSONValue outputs = SemuJson.get(system.definition, "display.outputs");
        if (!outputs.isArray() || outputs.size() < 2) { return result; }
        for (int index = 0; index < outputs.size(); index++) {
            string identifier = SemuJson.textAt(outputs.at(index), "id");
            string label = SemuJson.textAt(outputs.at(index), "label");
            result.ids.push(identifier);
            result.labels.push(SemuRenderLabels.toastSafe(label.isEmpty() ? identifier : label, 31));
        }
        result.cycled = result.ids.size();
        result.index = result.ids.indexOf(SemuRenderEnvironment.outputId(plan, system));
        result.defaultIndex = result.ids.indexOf(SemuRenderEnvironment.defaultOutput(system));
        if (result.index < 0) { result.index = result.defaultIndex >= 0 ? result.defaultIndex : 0; }
        result.launched = result.index;
        result.lastReal = result.index;
        return result;
    }

    class SemuVariantChoice scale(SemuPlan plan, SemuSystem system, string emulatorId) {  // the render scales EMULATOR takes for this system, on its own choice; none with one
        SemuVariantChoice result = SemuVariantChoice("scale");
        Vector<int> offered = SemuRenderScale.choices(plan, system, SemuRenderScale.specFor(plan, system, emulatorId));
        if (offered.size() < 2) { return result; }
        for scale in offered {
            result.ids.push(SemuRenderScale.id(scale));
            result.labels.push(SemuRenderScale.label(scale));
        }
        result.cycled = result.ids.size();
        result.index = result.ids.indexOf(SemuRenderScale.id(SemuRenderScale.current(plan, system, offered)));
        result.defaultIndex = result.ids.indexOf(SemuRenderScale.id(SemuRenderScale.defaultScale(system)));
        if (result.defaultIndex < 0) { result.defaultIndex = 0; }  // a default the emulator cannot take here: native
        result.launched = result.index;
        result.lastReal = result.index;
        return result;
    }
}
