// An emulator's own keyboard defaults that share a key with a Semu chord: vendored rows of
// {setting, key}, cleared so the emulator never acts on a chord the supervisor already handles.

import Library.JSON;
import Library.Vector;
import ../lib/json.btrc;

class SemuKeyCollisions {
    class bool rendered(JSONValue row, string platform, Vector<string> actions) {  // renders on this platform, for a declared action
        if (row == null) { return false; }
        if (!row.isObject()) { return true; }  // a bare value row has neither
        if (row.has("platforms") && !SemuJson.strings(row.get("platforms")).contains(platform)) { return false; }
        string action = SemuJson.textAt(row, "action");
        return action.isEmpty() || actions.contains(action);
    }

    class Vector<string> settings(JSONValue rows, string platform, Vector<string> actions) {  // settings of the rows rendered here, e.g. Semu's keymap
        Vector<string> result = [];
        for (int index = 0; rows != null && rows.isArray() && index < rows.size(); index++) {
            JSONValue row = rows.at(index);
            string setting = SemuJson.textAt(row, "setting");
            if (!setting.isEmpty() && SemuKeyCollisions.rendered(row, platform, actions)) { result.push(setting); }
        }
        return result;
    }

    class bool collides(JSONValue row, Vector<string> chordKeys, Vector<string> always) {
        return chordKeys.contains(SemuJson.textAt(row, "key")) || always.contains(SemuJson.textAt(row, "setting"));
    }

    class Vector<string> lines(JSONValue rows, Vector<string> chordKeys, Vector<string> excluded, Vector<string> always, string format) {  // one line per colliding default, in vendored order
        Vector<string> result = [];
        for (int index = 0; rows != null && rows.isArray() && index < rows.size(); index++) {
            JSONValue row = rows.at(index);
            string setting = SemuJson.textAt(row, "setting");
            if (setting.isEmpty() || excluded.contains(setting) || !SemuKeyCollisions.collides(row, chordKeys, always)) { continue; }
            result.push(format.replace("${setting}", setting).replace("${key}", SemuJson.textAt(row, "key")));
        }
        return result;
    }
}
