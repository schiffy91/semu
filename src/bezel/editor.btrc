// The bezel editor's server: the page, every package with its layers and screens, each layer's
// file at full resolution, and a save that writes the edited extents back into the package (and
// into every recolor that inherits its geometry). Loopback only, one request at a time.
import Library.Bytes;
import Library.Console;
import Library.Datetime;
import Library.FileSystem;
import Library.HTTP;
import Library.JSON;
import Library.Map;
import Library.Process;
import Library.Strings;
import Library.Vector;
import ../lib/json.btrc;
import ../lib/paths.btrc;
import ./preset.btrc;
import ./placement.btrc;
import ./package.btrc;
import ../renderer/renderer_layout.btrc;

class BezelEditor {
    public BezelRepository repository;
    public MegaBezelTree tree;
    public string pagePath;
    public string assetRoot;  // the bundle: the background plates and tube glass the renderer reads
    public BezelProductionRender production;
    public int port;

    public BezelEditor(BezelRepository repository, MegaBezelTree tree, string assetRoot) {
        self.repository = repository;
        self.tree = tree;
        self.assetRoot = BezelEditor.assets(repository.configRoot, assetRoot);
        self.production = BezelProductionRender(repository, self.assetRoot);
        self.pagePath = PathTools.join(repository.configRoot, "editor/bezel-editor.html");
        self.port = 0;
    }

    public int serve(int port) {
        self.port = port;
        HTTPServer server = HTTPServer(port);
        server.timeoutSecs = 30;
        server.maxBodyBytes = 4194304;
        if (!server.start()) { Console.error(f"bezel editor: cannot listen on port {port}"); return 1; }
        Console.log(f"bezel editor on http://127.0.0.1:{port}/ (Ctrl-C stops)");
        while (true) {
            int connection = server.acceptConn();
            if (connection < 0) { continue; }
            HTTPRequest request = server.readRequest(connection);
            HTTPResponse response = request.valid ? self.route(request) : HTTPResponse.error(400, request.error);
            server.respond(connection, response);
            server.closeConn(connection);
        }
        return 0;
    }

    public bool trusted(HTTPRequest request) {  // only this page on loopback: a foreign site or a rebound name gets nothing
        string host = request.header("host");
        if (!host.equals(f"127.0.0.1:{self.port}") && !host.equals(f"localhost:{self.port}")) { return false; }
        string origin = request.header("origin");
        return origin.isEmpty() || origin.equals(f"http://127.0.0.1:{self.port}") || origin.equals(f"http://localhost:{self.port}");
    }

    public HTTPResponse route(HTTPRequest request) {
        if (!self.trusted(request)) { return HTTPResponse.error(403, "the bezel editor answers only its own page on loopback"); }
        string path = HTTPServer.urlDecode(request.path);
        if (request.isPost() && path.equals("/api/save")) { return self.save(request.body); }
        if (request.isPost() && path.equals("/api/production")) { return self.production.render(request.body); }
        if (path.equals("/")) { return FileSystem.isFile(self.pagePath) ? HTTPResponse.html(FileSystem.readText(self.pagePath)) : HTTPResponse.error(500, "no editor page at " + self.pagePath); }
        if (path.equals("/api/packages")) { return HTTPResponse.json(self.packages().stringify()); }
        if (path.equals("/api/geometry")) { return HTTPResponse.json(BezelComputedLayout.lanes(request.queryParams()).stringify()); }
        if (path.startsWith("/layer/")) { return self.layer(path.substring(7, path.len() - 7)); }
        if (path.equals("/bezel-renderer.js")) { return self.script("bezel-renderer.js"); }
        if (path.equals("/render/compositor.frag") || path.equals("/render/compositor.vert")) { return self.compositor(path.substring(8, path.len() - 8)); }
        if (path.startsWith("/asset/")) { return self.asset(path.substring(7, path.len() - 7)); }
        return HTTPResponse.notFound();
    }

    class string assets(string configRoot, string declared) {  // --asset-root or SEMU_ASSET_ROOT, else the checkout's build/asset-root
        if (!declared.isEmpty()) { return declared; }
        string built = SemuPaths.normalize(PathTools.join(PathTools.join(configRoot, ".."), "build/asset-root"));
        return FileSystem.isDir(built) ? built : "";
    }

    public HTTPResponse compositor(string name) {  // config/render as WebGL2 compiles it: GLSL ES 3.00 in place of 330 core, the rest the renderer's own text
        if (!name.equals("compositor.frag") && !name.equals("compositor.vert")) { return HTTPResponse.notFound(); }
        string file = PathTools.join(PathTools.join(self.repository.configRoot, "render"), name);
        if (!FileSystem.isFile(file)) { return HTTPResponse.error(500, "no compositor shader at " + file); }
        string text = FileSystem.readText(file);
        string header = "#version 330 core";
        if (!text.startsWith(header)) { return HTTPResponse.error(500, file + " does not start with " + header); }
        return HTTPResponse.text("#version 300 es\nprecision highp float;\nprecision highp int;\nprecision highp sampler2D;" + text.substring(header.len(), text.len() - header.len()));
    }

    public HTTPResponse asset(string rest) {  // /asset/<package>/background or /asset/<package>/glass/<screen id>: what SEMU_RENDER_BACKGROUND and _GLASS name
        int slash = Strings.find(rest, "/", 0);
        JSONValue package = slash > 0 ? self.repository.package(rest.substring(0, slash)) : null;
        if (package == null) { return HTTPResponse.notFound(); }
        string what = rest.substring(slash + 1, rest.len() - slash - 1);
        string logical = what.equals("background") ? SemuJson.textAt(package, "background") : "";
        JSONValue screens = package.get("screens");
        for (int index = 0; what.startsWith("glass/") && screens != null && screens.isArray() && index < screens.size(); index++) {
            if (SemuJson.textAt(screens.at(index), "id").equals(what.substring(6, what.len() - 6))) { logical = SemuJson.textAt(screens.at(index), "glass.asset"); }
        }
        if (!logical.startsWith("assets/") || logical.contains("..")) { return HTTPResponse.notFound(); }
        string file = PathTools.join(PathTools.join(self.assetRoot, "share/semu"), logical);  // SemuRenderAssets.image: the bundle, then the config tree
        if (self.assetRoot.isEmpty() || !FileSystem.isFile(file)) { file = PathTools.join(self.repository.configRoot, logical); }
        if (!FileSystem.isFile(file)) { return HTTPResponse.notFound(); }
        Bytes data = SemuPaths.readBytes(file);
        if (data.len == 0) { return HTTPResponse.error(500, "unreadable " + file); }
        return HTTPResponse.bytes(200, file.toLower().endsWith(".png") ? "image/png" : "image/jpeg", data);
    }

    public HTTPResponse script(string name) {  // the page's own scripts beside it in config/editor
        string file = PathTools.join(PathTools.join(self.repository.configRoot, "editor"), name);
        return FileSystem.isFile(file) ? HTTPResponse.js(FileSystem.readText(file)) : HTTPResponse.error(500, "no editor script at " + file);
    }

    public JSONValue packages() {
        Map<string, Vector<string>> bindings = self.repository.bindings();
        JSONValue settings = SemuJson.readFile(PathTools.join(self.repository.configRoot, "settings/defaults.json"));
        JSONValue result = JSONValue.makeArray();
        for id in self.repository.packageIds() {
            JSONValue package = self.repository.package(id);
            bool computed = package != null && BezelComputedLayout.code(SemuJson.textAt(package, "layout")) != SEMU_LAYOUT_FIXED;  // a DS/3DS layout the renderer works out from the screen: no canvas, drawn frames
            if (package == null || (!computed && (package.get("canvas") == null || !package.get("canvas").isObject()))) { continue; }
            JSONValue systems = JSONValue.makeArray();
            Vector<string> bound = [];
            if (bindings.has(id)) { for system in bindings.get(id) { systems.push(JSONValue.makeString(system)); bound.push(system); } }
            package.set("systems", systems);
            package.set("previews", BezelPreview.all(self.repository, id, bound, settings));
            result.push(package);
        }
        return result;
    }

    public HTTPResponse layer(string rest) {  // /layer/<package>/<layer id>
        int slash = Strings.find(rest, "/", 0);
        if (slash <= 0) { return HTTPResponse.notFound(); }
        JSONValue package = self.repository.package(rest.substring(0, slash));
        string layerId = rest.substring(slash + 1, rest.len() - slash - 1);
        JSONValue layers = package == null ? null : package.get("layers");
        if (layers == null || !layers.isArray()) { return HTTPResponse.notFound(); }
        string reference = "";
        for (int index = 0; index < layers.size(); index++) { if (SemuJson.textAt(layers.at(index), "id").equals(layerId)) { reference = SemuJson.textAt(layers.at(index), "file"); } }
        JSONValue ambient = package.get("ambient");
        if (layerId.equals("ambient") && ambient != null && ambient.isObject()) { reference = SemuJson.textAt(ambient, "file"); }  // the night plate the renderer multiplies in
        if (reference.isEmpty()) { return HTTPResponse.notFound(); }
        string file = SemuPaths.normalize(self.tree.absolute(reference));
        bool served = SemuPaths.inside(self.tree.root, file) || SemuPaths.inside("/nix/store", file) || SemuPaths.inside(self.repository.configRoot, file);
        if (!served || !FileSystem.isFile(file)) { return HTTPResponse.notFound(); }
        Bytes data = SemuPaths.readBytes(file);
        if (data.len == 0) { return HTTPResponse.error(500, "unreadable " + file); }
        return HTTPResponse.bytes(200, file.toLower().endsWith(".png") ? "image/png" : "image/jpeg", data);
    }

    class JSONValue rounded(JSONValue rect) {  // whatever the page sends, integer canvas pixels
        if (rect == null || !rect.isObject()) { return null; }
        JSONValue value = JSONValue.makeObject();
        for key in ["x", "y", "w", "h"] { value.set(key, JSONValue.makeInt((int)(BezelNumber.of(rect.get(key)) + (BezelNumber.of(rect.get(key)) < 0.0 ? -0.5 : 0.5)))); }
        return value;
    }

    class JSONValue find(JSONValue array, string id) {
        if (array == null || !array.isArray()) { return null; }
        for (int index = 0; index < array.size(); index++) { if (SemuJson.textAt(array.at(index), "id").equals(id)) { return array.at(index); } }
        return null;
    }

    public HTTPResponse save(string body) {
        JSONValue payload = JSONValue.parse(body);
        string id = SemuJson.textAt(payload, "id");
        JSONValue package = self.repository.package(id);
        if (package == null) { return HTTPResponse.error(404, "no such package"); }
        string when = DateTime.now().format();
        string canvasLayer = SemuJson.textAt(payload, "canvas_layer");
        if (!canvasLayer.isEmpty()) { package.set("canvas_layer", JSONValue.makeString(canvasLayer)); }
        JSONValue layers = payload.get("layers");
        JSONValue existing = package.get("layers");
        if (layers != null && layers.isArray() && existing != null && existing.isArray()) {
            for (int index = 0; index < layers.size(); index++) {
                JSONValue edited = layers.at(index);
                JSONValue layer = BezelEditor.find(existing, SemuJson.textAt(edited, "id"));
                if (layer == null) { continue; }
                if (edited.has("visible")) { layer.set("visible", JSONValue.makeBool(SemuJson.boolAt(edited, "visible", true))); }
                if (edited.has("order")) { layer.set("order", JSONValue.makeFloat(BezelNumber.of(edited.get("order")))); }
                string blend = SemuJson.textAt(edited, "blend");
                if (blend.equals("normal") || blend.equals("add") || blend.equals("multiply")) { layer.set("blend", JSONValue.makeString(blend)); }
                if (edited.has("opacity")) { layer.set("opacity", JSONValue.makeFloat(BezelNumber.clamp(BezelNumber.of(edited.get("opacity")), 0.0, 1.0))); }
                JSONValue rect = BezelEditor.rounded(edited.get("rect"));
                if (rect != null) { layer.set("rect", rect); }
            }
            JSONValue canvasEntry = BezelEditor.find(existing, SemuJson.textAt(package, "canvas_layer"));
            JSONValue size = canvasEntry == null ? null : canvasEntry.get("size");
            if (size != null && size.isObject()) { package.set("canvas", size); }  // the canvas is the addressable layer's own pixel grid
        }
        JSONValue screens = payload.get("screens");
        JSONValue targets = package.get("screens");
        if (screens != null && screens.isArray() && targets != null && targets.isArray()) {
            for (int index = 0; index < screens.size(); index++) {
                JSONValue edited = screens.at(index);
                JSONValue screen = BezelEditor.find(targets, SemuJson.textAt(edited, "id"));
                if (screen == null) { continue; }
                for key in ["tube", "image"] { JSONValue rect = BezelEditor.rounded(edited.get(key)); if (rect != null) { screen.set(key, rect); } }
                string surround = SemuJson.textAt(edited, "surround");
                if (surround.len() == 7 && surround.startsWith("#")) { screen.set("surround", JSONValue.makeString(surround)); }
                JSONValue shape = edited.get("shape");
                if (shape != null && shape.isObject()) {
                    JSONValue kept = JSONValue.makeObject();
                    string kind = SemuJson.textAt(shape, "kind");
                    kept.set("kind", JSONValue.makeString(kind.equals("squircle") || kind.equals("none") ? kind : "rounded"));
                    kept.set("radius", JSONValue.makeFloat(BezelNumber.clamp(BezelNumber.of(shape.get("radius")), 0.0, 0.5)));
                    kept.set("exponent", JSONValue.makeFloat(BezelNumber.clamp(BezelNumber.of(shape.get("exponent")) < 2.0 ? 4.0 : BezelNumber.of(shape.get("exponent")), 2.0, 32.0)));
                    JSONValue bulge = shape.get("bulge");
                    if (bulge != null && bulge.isObject()) {
                        JSONValue keptBulge = JSONValue.makeObject();
                        keptBulge.set("x", JSONValue.makeInt((int)(BezelNumber.clamp(BezelNumber.of(bulge.get("x")), 0.0, 100000.0) + 0.5)));
                        keptBulge.set("y", JSONValue.makeInt((int)(BezelNumber.clamp(BezelNumber.of(bulge.get("y")), 0.0, 100000.0) + 0.5)));
                        kept.set("bulge", keptBulge);
                    }
                    screen.set("shape", kept);
                }
                JSONValue ring = edited.get("ring");
                if (ring != null && ring.isObject()) {
                    JSONValue target = screen.get("ring");
                    if (target == null || !target.isObject()) { target = JSONValue.makeObject(); screen.set("ring", target); }
                    for key in ["inner", "outer"] { JSONValue rect = BezelEditor.rounded(ring.get(key)); if (rect != null) { target.set(key, rect); } }
                    for key in ["inner_radius", "outer_radius"] { if (ring.has(key)) { target.set(key, JSONValue.makeFloat(BezelNumber.of(ring.get(key)))); } }
                    string color = SemuJson.textAt(ring, "color");
                    if ((color.len() == 7 && color.startsWith("#")) || color.equals("none")) { target.set("color", JSONValue.makeString(color)); }

                }
                JSONValue reflection = edited.get("reflection");
                if (reflection != null && reflection.isObject()) {
                    JSONValue kept = JSONValue.makeObject();
                    for key in ["strength", "blur", "fade"] { kept.set(key, JSONValue.makeFloat(BezelNumber.clamp(BezelNumber.of(reflection.get(key)), 0.0, 1.0))); }
                    screen.set("reflection", kept);
                }
                JSONValue provenance = screen.get("provenance");
                if (provenance == null || !provenance.isObject()) { provenance = JSONValue.makeObject(); screen.set("provenance", provenance); }
                JSONValue edit = JSONValue.makeObject();
                edit.set("tool", JSONValue.makeString("semu bezel edit"));
                edit.set("when", JSONValue.makeString(when));
                provenance.set("edited", edit);
            }
        }
        JSONValue frame = payload.get("frame");
        JSONValue drawnFrame = package.get("frame");
        if (frame != null && frame.isObject() && drawnFrame != null && drawnFrame.isObject()) {  // a drawn frame's width (a share of the screen height) and colour; a package without one keeps none
            drawnFrame.set("width", JSONValue.makeFloat(BezelNumber.clamp(BezelNumber.of(frame.get("width")), 0.0, 0.25)));
            string frameColor = SemuJson.textAt(frame, "color");
            if (frameColor.len() == 7 && frameColor.startsWith("#")) { drawnFrame.set("color", JSONValue.makeString(frameColor)); }
        }
        if (!self.repository.save(id, package)) { return HTTPResponse.error(500, "could not write config/bezels/" + id + "/bezel.json"); }
        JSONValue saved = JSONValue.makeArray();
        saved.push(JSONValue.makeString(id));
        BezelPackageWriter writer = BezelPackageWriter(self.repository, self.tree);
        for other in self.repository.packageIds() {
            JSONValue follower = self.repository.package(other);
            if (follower != null && SemuJson.textAt(follower, "geometry_from").equals(id) && writer.inherit(other).isEmpty()) { saved.push(JSONValue.makeString(other)); }
        }
        JSONValue result = JSONValue.makeObject();
        result.set("saved", saved);
        return HTTPResponse.json(result.stringify());
    }
}

class BezelPreview {  // what the launcher gives the renderer when a system shows a package: native screens, aspect, placement, default shader, dual gap
    class JSONValue all(BezelRepository repository, string packageId, Vector<string> systems, JSONValue settings) {
        JSONValue previews = JSONValue.makeArray();
        Vector<string> seen = [];
        for system in systems {  // a system binding the package in two variants is listed twice
            if (seen.contains(system)) { continue; }
            seen.push(system);
            string folder = PathTools.join(PathTools.join(repository.configRoot, "systems"), system);
            JSONValue definition = repository.system(system);
            JSONValue bezels = SemuJson.readFile(PathTools.join(folder, "bezels.json"));
            JSONValue shaders = SemuJson.readFile(PathTools.join(folder, "shaders.json"));
            JSONValue variants = bezels.get("variants");
            if (definition == null || variants == null || !variants.isArray()) { continue; }
            for (int index = 0; index < variants.size(); index++) {
                if (SemuJson.textAt(variants.at(index), "bezel").equals(packageId)) { previews.push(BezelPreview.one(system, definition, bezels, shaders, variants.at(index), settings)); }
            }
        }
        return previews;
    }

    class JSONValue one(string system, JSONValue definition, JSONValue bezels, JSONValue shaders, JSONValue variant, JSONValue settings) {
        JSONValue preview = JSONValue.makeObject();
        string variantId = SemuJson.textAt(variant, "id");
        preview.set("system", JSONValue.makeString(system));
        preview.set("variant", JSONValue.makeString(variantId));
        preview.set("label", JSONValue.makeString(SemuJson.textAt(definition, "name") + " · " + SemuJson.textAt(variant, "label")));
        JSONValue screens = JSONValue.makeArray();
        JSONValue declared = SemuJson.get(definition, "display.screens");
        for (int index = 0; declared != null && declared.isArray() && index < declared.size(); index++) {  // SEMU_RENDER_SURFACE_<n>_NATIVE
            JSONValue screen = JSONValue.makeObject();
            screen.set("id", JSONValue.makeString(SemuJson.textAt(declared.at(index), "id")));
            screen.set("w", JSONValue.makeInt(SemuJson.intAt(declared.at(index), "native.w", 0)));
            screen.set("h", JSONValue.makeInt(SemuJson.intAt(declared.at(index), "native.h", 0)));
            screens.push(screen);
        }
        preview.set("screens", screens);
        JSONValue aspect = JSONValue.makeObject();  // SEMU_RENDER_ASPECT=W:H
        aspect.set("w", JSONValue.makeInt(SemuJson.intAt(definition, "display.aspect.w", 0)));
        aspect.set("h", JSONValue.makeInt(SemuJson.intAt(definition, "display.aspect.h", 0)));
        preview.set("aspect", aspect);
        string widescreen = SemuJson.textAt(bezels, "widescreen_variant");
        preview.set("presentation", JSONValue.makeFloat(!widescreen.isEmpty() && widescreen.equals(variantId) ? 1.777778 : 0.0));  // the wide variant shows a 16:9 title, as gallery.sh renders it
        string placement = SemuJson.textAt(bezels, "placement");  // the system's own default, else the setting
        if (placement.isEmpty()) { placement = SemuJson.textAt(settings, "visual.placement"); }
        preview.set("placement", JSONValue.makeString(placement.equals("game") || placement.equals("bezel") ? placement : "fit"));
        preview.set("gap", JSONValue.makeFloat(BezelNumber.of(SemuJson.get(settings, "visual.dual_screen_gap"))));  // SEMU_RENDER_DUAL_GAP, a fraction of the width
        preview.set("frame_width", JSONValue.makeFloat(BezelNumber.of(SemuJson.get(settings, "visual.frame_width"))));  // a drawn frame's width when its package names none
        preview.set("shader", BezelPreview.shader(shaders, settings));
        return preview;
    }

    class JSONValue shader(JSONValue shaders, JSONValue settings) {  // the default shader variant's preset (per screen when it names one each); null when the system has none
        if (shaders.isError() || !SemuJson.boolAt(shaders, "enabled", false) || !SemuJson.boolAt(settings, "visual.crt_shaders", true)) { return JSONValue.makeNull(); }
        string id = SemuJson.textAt(shaders, "default_variant");
        JSONValue chosen = JSONValue.makeNull();
        JSONValue variants = shaders.get("variants");
        for (int index = 0; variants != null && variants.isArray() && index < variants.size(); index++) { if (SemuJson.textAt(variants.at(index), "id").equals(id)) { chosen = variants.at(index); } }
        string preset = chosen.isObject() ? SemuJson.textAt(chosen, "screen") : SemuJson.textAt(shaders, "screen");
        if (id.equals("none") || preset.isEmpty()) { return JSONValue.makeNull(); }
        JSONValue result = JSONValue.makeObject();
        result.set("variant", JSONValue.makeString(id));
        result.set("label", JSONValue.makeString(chosen.isObject() ? SemuJson.textAt(chosen, "label") : id));
        result.set("preset", JSONValue.makeString(preset));
        JSONValue screens = chosen.isObject() ? chosen.get("screens") : null;
        result.set("screens", screens != null && screens.isObject() ? screens : JSONValue.makeObject());
        return result;
    }
}

class BezelComputedLayout {  // the computed DS/3DS layouts by the renderer's own arithmetic (src/renderer/renderer_layout.btrc), for the editor's preview
    class int code(string layout) {  // RendererConfiguration.parseLayout
        if (layout.equals("main_right")) { return SEMU_LAYOUT_MAIN_RIGHT; }
        if (layout.equals("main_left")) { return SEMU_LAYOUT_MAIN_LEFT; }
        if (layout.equals("side_by_side")) { return SEMU_LAYOUT_SIDE_BY_SIDE; }
        if (layout.equals("stacked")) { return SEMU_LAYOUT_STACKED; }
        return SEMU_LAYOUT_FIXED;
    }

    class JSONValue rect(int x, int y, int width, int height) {
        JSONValue value = JSONValue.makeObject();
        value.set("x", JSONValue.makeInt(x));
        value.set("y", JSONValue.makeInt(y));
        value.set("width", JSONValue.makeInt(width));
        value.set("height", JSONValue.makeInt(height));
        return value;
    }

    class JSONValue lanes(Map<string, string> query) {  // ?layout=&width=&height=&native=WxH,WxH&frame=&gap=: each lane and the drawn frame, bottom-up as GL counts rows
        int layout = BezelComputedLayout.code(query.getOrDefault("layout", ""));
        int areaWidth = Strings.toInt(query.getOrDefault("width", "0"));
        int areaHeight = Strings.toInt(query.getOrDefault("height", "0"));
        float frameFraction = (float)BezelNumber.parse(query.getOrDefault("frame", "0"), 0.0);  // SEMU_RENDER_FRAME's width, a fraction of the height
        float gapFraction = (float)BezelNumber.clamp(BezelNumber.parse(query.getOrDefault("gap", "0"), 0.0), 0.0, 1.0);
        Vector<string> natives = Strings.split(query.getOrDefault("native", ""), ",");
        JSONValue result = JSONValue.makeObject();
        if (layout == SEMU_LAYOUT_FIXED || areaWidth < 16 || areaHeight < 16 || natives.size() != 2) { result.set("error", JSONValue.makeString("a computed layout, a screen size and two native sizes")); return result; }
        struct RendererCompositionGeometry geometry;
        memset(&geometry, 0, sizeof(struct RendererCompositionGeometry));
        geometry.lane_count = 2;
        for (int index = 0; index < 2; index++) {
            Vector<string> size = Strings.split(natives[index], "x");
            geometry.lanes[index].native_width = size.size() == 2 ? Strings.toInt(size[0]) : 0;
            geometry.lanes[index].native_height = size.size() == 2 ? Strings.toInt(size[1]) : 0;
            if (geometry.lanes[index].native_width < 1 || geometry.lanes[index].native_height < 1) { result.set("error", JSONValue.makeString("native sizes are WxH")); return result; }
        }
        int frameWidth = frameFraction > 0.0f ? (int)(frameFraction * (float)areaHeight + 0.5f) : 0;  // RendererGeometry.resolve: the frame, then the room the screens leave it
        int frame = frameWidth;
        int drawn = RendererLayout.computed(&geometry, layout, areaWidth, areaHeight, frameWidth, gapFraction);
        if (frameWidth > 0) { frame = drawn; }
        JSONValue lanes = JSONValue.makeArray();
        for (int index = 0; index < 2; index++) {
            struct RendererLaneGeometry* lane = &geometry.lanes[index];
            JSONValue entry = JSONValue.makeObject();
            entry.set("output", BezelComputedLayout.rect(lane->output_x, lane->output_y, lane->output_width, lane->output_height));
            entry.set("tube", BezelComputedLayout.rect(lane->tube_x, lane->tube_y, lane->tube_width, lane->tube_height));
            lanes.push(entry);
        }
        result.set("lanes", lanes);
        result.set("frame", JSONValue.makeInt(frame));
        return result;
    }
}

class BezelProductionRender {  // the real renderer on this machine (a checkout's build/render-host) fed the unsaved package: the shader chain the page does not draw
    public BezelRepository repository;
    public string assetRoot;
    public string scratch;  // a copy of config with the edited package written in; the real config is never touched

    public BezelProductionRender(BezelRepository repository, string assetRoot) {
        self.repository = repository;
        self.assetRoot = assetRoot;
        self.scratch = "";
    }

    class bool plainName(string name) {  // a system, variant or package id: letters, digits, dot, dash, underscore
        if (name.isEmpty() || name.contains("..")) { return false; }
        for (int index = 0; index < name.len(); index++) {
            char letter = name.charAt(index);
            if (!((letter >= 'a' && letter <= 'z') || (letter >= 'A' && letter <= 'Z') || (letter >= '0' && letter <= '9') || letter == '-' || letter == '_' || letter == '.')) { return false; }
        }
        return true;
    }

    public HTTPResponse render(string body) {  // {package, system, variant, width, height, card, aspect} -> the frame as PPM
        string build = SemuPaths.normalize(PathTools.join(PathTools.join(self.repository.configRoot, ".."), "build"));
        string host = PathTools.join(build, "render-host");
        string semu = PathTools.join(build, "semu");
        if (!FileSystem.isFile(host) || !FileSystem.isFile(semu)) { return HTTPResponse.error(404, "the production render needs a checkout with build/render-host and build/semu (make build/semu build/render-host)"); }
        if (self.assetRoot.isEmpty()) { return HTTPResponse.error(404, "the production render needs the bundle's data (nix build --out-link build/asset-root .#asset-root)"); }
        JSONValue request = JSONValue.parse(body);
        JSONValue package = request == null ? null : request.get("package");
        string id = SemuJson.textAt(package, "id");
        string system = SemuJson.textAt(request, "system");
        string variant = SemuJson.textAt(request, "variant");
        string card = SemuJson.textAt(request, "card");
        int width = SemuJson.intAt(request, "width", 0);
        int height = SemuJson.intAt(request, "height", 0);
        if (!BezelProductionRender.plainName(id) || self.repository.package(id) == null || !BezelProductionRender.plainName(system) || !BezelProductionRender.plainName(variant)) { return HTTPResponse.error(400, "a known package, a system and a variant"); }
        if (width < 16 || height < 16 || width > 7680 || height > 4320) { return HTTPResponse.error(400, "a screen between 16x16 and 7680x4320"); }
        if (self.scratch.isEmpty()) {
            ExecResult made = ChildProcess.run("mktemp", ["-d"]);
            if (!made.ok()) { return HTTPResponse.error(500, "no scratch directory: " + made.stderr()); }
            self.scratch = made.trimmed();
        }
        string config = PathTools.join(self.scratch, "config");
        ExecResult copied = ChildProcess.run("cp", ["-R", self.repository.configRoot + "/.", config]);  // the current config, then the unsaved package over its own file
        if (!copied.ok() || !SemuPaths.writeOwned(self.scratch, PathTools.join(config, "bezels/" + id + "/bezel.json"), package.stringifyPretty(2) + "\n")) { return HTTPResponse.error(500, "could not stage the package in " + self.scratch); }
        string settings = f"{{\"visual\":{{\"systems\":{{\"{system}\":{{\"bezel_variant\":\"{variant}\"}}}}}}}}";  // the system's own shader, as a launch would choose it
        ExecResult environment = ChildProcess.run(semu, ["render-env", "--system", system, "--project", config, "--asset-root", self.assetRoot, "--settings-json", settings], "", CommandEnvironment.empty(), CommandEnvironment.empty(), 60000);
        if (!environment.ok()) { return HTTPResponse.error(500, "semu render-env: " + environment.stderr()); }
        Vector<string> entries = [];
        for line in Strings.split(environment.stdout(), "\n") { if (line.contains("=") && !line.startsWith("SEMU_RENDER_COMPOSITOR_DIR=")) { entries.push(line); } }
        entries.push("SEMU_RENDER_COMPOSITOR_DIR=" + PathTools.join(self.repository.configRoot, "render"));  // the compositor being edited, not the copy
        entries.push("RENDER_HOST_CARD=" + (card.equals("white") || card.equals("black") ? card : "editor"));
        double aspect = BezelNumber.of(request.get("aspect"));
        if (aspect > 0.1) { entries.push(f"RENDER_HOST_ASPECT={aspect}"); }
        string frame = PathTools.join(self.scratch, "production.ppm");
        ExecResult drawn = ChildProcess.run(host, [f"{width}", f"{height}", frame], "", entries, CommandEnvironment.empty(), 120000);
        if (!drawn.ok()) { return HTTPResponse.error(500, "render-host: " + drawn.stderr()); }
        Bytes data = SemuPaths.readBytes(frame);
        if (data.len == 0) { return HTTPResponse.error(500, "render-host wrote nothing"); }
        return HTTPResponse.bytes(200, "image/x-portable-pixmap", data);
    }
}
