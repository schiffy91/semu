// A TV does not resize when the game changes resolution (M16, the final Deck run's PS1 boot: Beetle PSX's 256x240
// placeholder, then 640x472, then a 478-line blip, breathed the whole room by 1.3 to 1.7%). A single screen's set,
// and with no bezel its frame, are sized from the system's nominal display: its declared native lines less its
// declared crop (SEMU_RENDER_SURFACE_0_NATIVE and _CROP: the PS1's 240, the N64's 237 cropped VI lines, the PS2's
// 448), at the Fit state's step. A picture of another height is drawn inside that frame as a CRT draws it: each line
// at the frame's step for the multiple of the nominal lines it is (a 480-line interlaced or hi-res mode of a 240-line
// frame draws every line half as tall and fills the same frame; a field of half the nominal lines draws each line
// twice), at its own aspect, centred, the rows it lacks black inside the opening like a CRT's border (Beetle's 472
// lines in the PS1's 480-row frame); a picture taller than its frame (a PAL or overscan mode, a 480-line PS2 game in
// the 448-line frame) is fitted to the frame, never past the opening. In the integer states the border splits on
// whole rows, so a whole step keeps every native pixel k by k. Pure arithmetic, no GL: the contracts and the
// editor's port (config/editor/bezel-renderer.js, NominalFrame) place a picture exactly as the compositor does.

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

import ./renderer_abi.btrc;
import ./renderer_surface_crop.btrc;

class RendererNominalFrame {
    class int lines(char* native, struct RendererSurfaceCrop* crop) {  // SEMU_RENDER_SURFACE_0_NATIVE's lines less the declared crop; 0 undeclared, so the reported height sizes the set as before
        int width = 0;
        int height = 0;
        if (native == null || sscanf(native, "%dx%d", &width, &height) != 2 || height < 1) { return 0; }
        int kept = crop != null && crop->set != 0 ? height - crop->top - crop->bottom : height;
        return kept >= 1 ? kept : height;
    }

    class int load() {  // the launch's nominal lines, as RendererConfiguration reads them into each variant
        struct RendererSurfaceCrop crop;
        RendererSurfaceCropping.parse(&crop, getenv("SEMU_RENDER_SURFACE_0_CROP"));
        return RendererNominalFrame.lines(getenv("SEMU_RENDER_SURFACE_0_NATIVE"), &crop);
    }

    class float multiple(int lines, int nominal) {  // which multiple of the nominal frame a picture's lines are: half (a field drawn once), one, or two and more (the interlaced and hi-res modes)
        if (nominal < 1 || lines < 1) { return 1.0f; }
        if ((float)lines < (float)nominal * 0.75f) { return 0.5f; }
        int whole = (int)((float)lines / (float)nominal + 0.5f);
        return whole > 1 ? (float)whole : 1.0f;
    }

    class float shown(int width, int height, float aspect) {  // the picture's aspect: the declared one, else its own shape
        if (aspect > 0.01f) { return aspect; }
        return width > 0 && height > 0 ? (float)width / (float)height : 0.0f;
    }

    class void inside(struct RendererCanvasRect* frame, int lines, int nominal, float aspect, bool whole, struct RendererCanvasRect* picture) {  // the picture of LINES in the nominal FRAME (unrounded, rows counted up); WHOLE: its border split on whole rows
        *picture = *frame;
        if (nominal < 1 || lines < 1 || lines == nominal || frame->width <= 0.0f || frame->height <= 0.0f || aspect <= 0.01f) { return; }
        float height = (float)lines * frame->height / ((float)nominal * RendererNominalFrame.multiple(lines, nominal));
        if (height >= frame->height) { return; }  // the frame's own lines, or more: fitted to the frame
        float width = height * aspect;
        if (width > frame->width) {
            width = frame->width;
            height = width / aspect;
        }
        float border = (frame->height - height) * 0.5f;
        picture->x = frame->x + (frame->width - width) * 0.5f;
        picture->y = frame->y + (whole ? (float)(int)border : border);
        picture->width = width;
        picture->height = height;
    }

    class void framed(struct RendererCanvasRect* canvas, struct RendererNormalizedHole* image, int nativeWidth, int nativeHeight, int rotation, float aspect, int nominal, bool whole, struct RendererPixelRect* output) {  // a bezel's picture: the nominal frame fills its picture rectangle (the set was sized for it), the picture in that frame, its edges rounded once
        struct RendererCanvasRect frame;
        RendererCompositionContract.fitInsideFrame(canvas, image->x, image->y, image->width, image->height, nativeWidth, nativeHeight, rotation, aspect, &frame);
        int across = rotation == 90 || rotation == 270 ? nativeHeight : nativeWidth;
        int lines = rotation == 90 || rotation == 270 ? nativeWidth : nativeHeight;
        struct RendererCanvasRect picture;
        RendererNominalFrame.inside(&frame, lines, nominal, RendererNominalFrame.shown(across, lines, aspect), whole, &picture);
        RendererCompositionContract.edges(&picture, output);
    }

    class void bare(struct RendererPixelRect* area, int nativeWidth, int nativeHeight, int rotation, float aspect, int nominal, int integerScaling, struct RendererPixelRect* output) {  // one screen with no bezel: the nominal frame at the Fit state's step, as fit places a picture, and the picture in it
        int across = rotation == 90 || rotation == 270 ? nativeHeight : nativeWidth;
        int lines = rotation == 90 || rotation == 270 ? nativeWidth : nativeHeight;
        float shown = RendererNominalFrame.shown(across, lines, aspect);
        if (nominal < 1 || lines == nominal || shown <= 0.01f) {
            RendererCompositionContract.fit(area, nativeWidth, nativeHeight, rotation, aspect, integerScaling, output);
            return;
        }
        int frameWidth = (int)((float)nominal * shown + 0.5f);
        struct RendererCanvasRect frame;
        RendererCompositionContract.fitFrame(area, frameWidth < 1 ? 1 : frameWidth, nominal, 0, shown, integerScaling, &frame);
        struct RendererCanvasRect picture;
        RendererNominalFrame.inside(&frame, lines, nominal, shown, integerScaling != 0, &picture);
        if (picture.width == frame.width && picture.height == frame.height) {  // the frame itself: rounded as fit rounds it
            RendererCompositionContract.fit(area, frameWidth < 1 ? 1 : frameWidth, nominal, 0, shown, integerScaling, output);
            return;
        }
        RendererCompositionContract.edges(&picture, output);
    }
}
