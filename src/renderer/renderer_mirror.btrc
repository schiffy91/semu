// Where a screen's reflection lands and how strongly: the picture mirrored onto its bezel's ring band (or a
// drawn frame), at the package's strength, whenever the package's shell is shown and its ring is on the canvas.
// The ring's edges follow the picture actually drawn: a whole step past the package's own picture rectangle (the
// 3DS touch screen at 1x over its 0.94x window on the Deck) carries the lip out with it, so the band keeps its
// declared width instead of shrinking to the pixel that only stops it masking the picture. The compositor sends
// this strength and these edges to the fragment shader's reflectAt; no GL, so the contracts audit every package,
// placement and screen size against the same decision.

import ./renderer_abi.btrc;
import ./renderer_config_screen.btrc;
import ./renderer_layout.btrc;

class RendererMirror {
    class bool ringShown(struct RendererScreenConfig* screen, bool dressed, struct RendererPixelRect* outer, float bezelWidth) {  // the drawn bezel lives on the plate: only a fixed package with its shell shown has one
        return dressed && screen != null && screen->look_set != 0 && screen->ring_set != 0 && bezelWidth > 0.0f
            && outer != null && outer->width > 0 && outer->height > 0;
    }

    class float strength(struct RendererScreenConfig* screen, bool dressed, bool ring, int framed) {  // the reflection lands on a ring band or a drawn frame, never on a bare screen
        if (screen == null || !dressed || screen->look_set == 0) { return 0.0f; }
        return ring || framed == 1 ? screen->ring_reflect : 0.0f;
    }

    class void picture(struct RendererScreenConfig* screen, struct RendererCanvasRect* canvas, struct RendererPixelRect* picture) {  // the package's own picture rectangle on screen: its calibrated image, else its opening
        struct RendererNormalizedHole* hole = screen->image.set != 0 ? &screen->image : &screen->tube;
        RendererCompositionContract.aperture(canvas, hole->x, hole->y, hole->width, hole->height, picture);
    }

    class void ring(struct RendererScreenConfig* screen, struct RendererCanvasRect* canvas, struct RendererLaneGeometry* lane, struct RendererPixelRect* inner, struct RendererPixelRect* outer) {  // the lip's inner and outer edges on screen, carried with a picture that runs past the package's picture rectangle
        struct RendererPixelRect picture;
        RendererMirror.picture(screen, canvas, &picture);
        RendererCompositionContract.aperture(canvas, screen->ring_inner.x, screen->ring_inner.y, screen->ring_inner.width, screen->ring_inner.height, inner);
        RendererCompositionContract.aperture(canvas, screen->ring_outer.x, screen->ring_outer.y, screen->ring_outer.width, screen->ring_outer.height, outer);
        RendererLayout.carry(inner, &picture, lane);
        RendererLayout.carry(outer, &picture, lane);
    }
}
