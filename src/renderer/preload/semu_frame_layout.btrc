// Where an emulator draws its screens inside its own frame, ported from that emulator's layout code,
// so the compositor cuts each screen out exactly where it was drawn. Pure arithmetic, no GL, so the
// contracts check it directly.

struct SemuComposeRect {  // top-left origin, in framebuffer pixels
    int x;
    int y;
    int width;
    int height;
};

class SemuFrameLayout {
    // One screen letterboxed at the system aspect (SEMU_RENDER_ASPECT) and centered, where every
    // single-screen standalone is expected to draw it (Dolphin by its CustomStretch pin). Only the
    // pixels wholly inside the exact letterbox are cut, so the cut stays inside the picture however
    // the emulator rounds its edges: Dolphin rounds its offset (107 at 1280x800), Flycast draws from
    // a fractional one (106.67); a floored cut (106) took a column of their black clear colour.
    // No aspect (0) cuts the whole frame.
    class void letterboxed(int width, int height, float aspect, struct SemuComposeRect* picture) {
        picture->x = 0;
        picture->y = 0;
        picture->width = width;
        picture->height = height;
        if (aspect <= 0.01f) { return; }
        if ((float)width / (float)height > aspect) {
            float exact = (float)height * aspect;
            float left = ((float)width - exact) * 0.5f;
            picture->x = SemuFrameLayout.inside(left, true);
            picture->width = SemuFrameLayout.inside(left + exact, false) - picture->x;
        } else {
            float exact = (float)width / aspect;
            float upper = ((float)height - exact) * 0.5f;
            picture->y = SemuFrameLayout.inside(upper, true);
            picture->height = SemuFrameLayout.inside(upper + exact, false) - picture->y;
        }
    }

    // The aspect the renderer shows a letterboxed picture at: the declared one, exact. The cut's whole
    // pixels round it (PSP's 480:272 cut to 1280x724 at 1280x800 put its integer 2x lane at 962 wide
    // instead of 960, and the LCD grid beat in two bands); with nothing declared, the cut's own shape.
    class float presentationAspect(float declared, struct SemuComposeRect* picture) {
        if (declared > 0.01f) { return declared; }
        return picture->height > 0 ? (float)picture->width / (float)picture->height : 0.0f;
    }

    // A point the renderer's pointer map normalized on a screen (0 to 1 across, and down in that
    // screen's row order: bottom-up for the compositor's bottom-left surfaces) back to where the
    // emulator drew that point, inside the screen's rectangle in its own frame.
    class void drawnPoint(struct SemuComposeRect* drawn, float normalizedX, float normalizedY, bool bottomUp, float* emulatorX, float* emulatorY) {
        *emulatorX = (float)drawn->x + normalizedX * (float)drawn->width;
        float fromTop = bottomUp ? 1.0f - normalizedY : normalizedY;
        *emulatorY = (float)drawn->y + fromTop * (float)drawn->height;
    }

    // A picture edge (non-negative, in pixels) moved to the nearest pixel boundary inside the
    // picture: up for a leading edge, down for a trailing one, ignoring float noise on whole edges.
    class int inside(float edge, bool leading) {
        if (!leading) { return (int)(edge + 0.001f); }
        float shifted = edge - 0.001f;
        int truncated = (int)shifted;
        return (float)truncated < shifted ? truncated + 1 : truncated;
    }

    // Azahar's DefaultFrameLayout (LargeFrameLayout with the small screen below), neither upright,
    // swapped nor gapped, with its arithmetic: the box of both screens takes the largest scale that
    // fits (floored to a whole multiple under use_integer_scaling, from 1x up) and is centered; each
    // screen is cut from it at the box's scale, the narrower one centered under the wider one.
    class void stacked(int width, int height, int largeWidth, int largeHeight, int smallWidth, int smallHeight, bool integer,
                       struct SemuComposeRect* top, struct SemuComposeRect* bottom) {
        int boxWidth = largeWidth > smallWidth ? largeWidth : smallWidth;
        int boxHeight = largeHeight + smallHeight;
        float scale = (float)width / (float)boxWidth;
        if ((float)height / (float)boxHeight < scale) { scale = (float)height / (float)boxHeight; }
        if (integer && scale >= 1.0f) { scale = (float)(int)scale; }
        int totalWidth = (int)((float)boxWidth * scale);
        int totalHeight = (int)((float)boxHeight * scale);
        int left = (width - totalWidth) / 2;
        int upper = (height - totalHeight) / 2;
        float amount = (float)totalHeight / (float)boxHeight;
        top->x = left;
        top->y = upper;
        top->width = (int)((float)largeWidth * amount);
        top->height = (int)((float)largeHeight * amount);
        if (top->width < totalWidth) { top->x = top->x + (totalWidth - top->width) / 2; }
        bottom->width = (int)((float)smallWidth * amount);
        bottom->height = (int)((float)smallHeight * amount);
        bottom->y = upper + top->height;
        bottom->x = top->x + top->width / 2 - bottom->width / 2;
    }
}
