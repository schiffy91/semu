// LD_PRELOAD shim for SDL2 + OpenGL emulators: Semu composes bezel and shader
// at SDL_GL_SwapWindow, reading the emulator's back buffer and writing the
// composed frame back before the real swap. Configuration comes from the
// SEMU_RENDER_* environment the launcher already emits for hooked emulators.
#include <dlfcn.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "semu_renderer.h"

struct SemuPreloadState {
    int initialized;
    int enabled;
    int reported;
    __fn_ptr<void, void*> swap;
    __fn_ptr<void, void*, int*, int*> drawable;
    __fn_ptr<void*, const char*> get_proc;
    __fn_ptr<unsigned int, void*, void*> egl_swap;
    __fn_ptr<unsigned int, void*, void*, int, int*> egl_query;
    __fn_ptr<void*, const char*> egl_get_proc;
    __fn_ptr<void, void*, unsigned long> glx_swap;
    __fn_ptr<void, void*, unsigned long, int, unsigned int*> glx_query;
    __fn_ptr<void*, const unsigned char*> glx_get_proc;
    unsigned long long frame_id;
    float aspect;
    int native_width;
    int native_height;
};

struct SemuPreloadState SemuPreload;

class SemuPreloadHooks {
    class void bind(void* slot, void* handle, const char* name) {  // C11 forbids casting void* to a function pointer
        void* symbol = dlsym(handle, name);
        memcpy(slot, &symbol, sizeof(symbol));
    }

    class void initialize() {
        if (SemuPreload.initialized) { return; }
        SemuPreload.initialized = 1;
        void* next = RTLD_NEXT;
        void* any = RTLD_DEFAULT;
        SemuPreloadHooks.bind(&SemuPreload.swap, next, "SDL_GL_SwapWindow");
        SemuPreloadHooks.bind(&SemuPreload.drawable, any, "SDL_GL_GetDrawableSize");
        SemuPreloadHooks.bind(&SemuPreload.get_proc, any, "SDL_GL_GetProcAddress");
        SemuPreloadHooks.bind(&SemuPreload.egl_swap, next, "eglSwapBuffers");
        SemuPreloadHooks.bind(&SemuPreload.egl_query, any, "eglQuerySurface");
        SemuPreloadHooks.bind(&SemuPreload.egl_get_proc, any, "eglGetProcAddress");
        SemuPreloadHooks.bind(&SemuPreload.glx_swap, next, "glXSwapBuffers");
        SemuPreloadHooks.bind(&SemuPreload.glx_query, any, "glXQueryDrawable");
        SemuPreloadHooks.bind(&SemuPreload.glx_get_proc, any, "glXGetProcAddressARB");
        int aspectWidth = 0;
        int aspectHeight = 0;
        char* aspect = getenv("SEMU_RENDER_ASPECT");
        if (aspect != null && sscanf(aspect, "%d:%d", &aspectWidth, &aspectHeight) == 2 && aspectWidth > 0 && aspectHeight > 0) {
            SemuPreload.aspect = (float)aspectWidth / (float)aspectHeight;
        }
        int nativeWidth = 0;
        int nativeHeight = 0;
        char* native = getenv("SEMU_RENDER_SURFACE_0_NATIVE");
        if (native != null && sscanf(native, "%dx%d", &nativeWidth, &nativeHeight) == 2 && nativeWidth > 0 && nativeHeight > 0) {
            SemuPreload.native_width = nativeWidth;
            SemuPreload.native_height = nativeHeight;
        }
        SemuPreload.enabled = getenv("SEMU_RENDER_SYSTEM_ID") != null ? 1 : 0;
        if (getenv("SEMU_RENDER_DEBUG") != null) {
            fprintf(stderr, "semu-preload: %s (aspect %.3f, native %dx%d, sdl=%d egl=%d glx=%d)\n",
                SemuPreload.enabled ? "active" : "inactive", SemuPreload.aspect,
                SemuPreload.native_width, SemuPreload.native_height,
                SemuPreload.swap != null ? 1 : 0, SemuPreload.egl_swap != null ? 1 : 0, SemuPreload.glx_swap != null ? 1 : 0);
        }
    }

    class void rebind() {  // libEGL/libGLX may be dlopened after the first swap of another API
        void* any = RTLD_DEFAULT;
        if (SemuPreload.egl_query == null) { SemuPreloadHooks.bind(&SemuPreload.egl_query, any, "eglQuerySurface"); }
        if (SemuPreload.egl_get_proc == null) { SemuPreloadHooks.bind(&SemuPreload.egl_get_proc, any, "eglGetProcAddress"); }
        if (SemuPreload.glx_query == null) { SemuPreloadHooks.bind(&SemuPreload.glx_query, any, "glXQueryDrawable"); }
        if (SemuPreload.glx_get_proc == null) { SemuPreloadHooks.bind(&SemuPreload.glx_get_proc, any, "glXGetProcAddressARB"); }
        if (SemuPreload.drawable == null) { SemuPreloadHooks.bind(&SemuPreload.drawable, any, "SDL_GL_GetDrawableSize"); }
        if (SemuPreload.get_proc == null) { SemuPreloadHooks.bind(&SemuPreload.get_proc, any, "SDL_GL_GetProcAddress"); }
    }

    class void compose(int width, int height, __fn_ptr<void*, const char*> getProc) {  // the emulator letterboxes itself: the game sits centered at the system aspect
        if (width < 1 || height < 1 || getProc == null) { return; }
        int surfaceWidth = width;
        int surfaceHeight = height;
        int surfaceX = 0;
        int surfaceY = 0;
        if (SemuPreload.aspect > 0.01f) {
            float have = (float)width / (float)height;
            if (have > SemuPreload.aspect) {
                surfaceWidth = (int)((float)height * SemuPreload.aspect + 0.5f);
                surfaceX = (width - surfaceWidth) / 2;
            } else {
                surfaceHeight = (int)((float)width / SemuPreload.aspect + 0.5f);
                surfaceY = (height - surfaceHeight) / 2;
            }
        }
        if (surfaceWidth < 1 || surfaceHeight < 1) { return; }
        struct SemuRenderFrameGl frame;
        memset(&frame, 0, sizeof(struct SemuRenderFrameGl));
        frame.abi = SEMU_RENDER_ABI_GL;
        frame.struct_size = sizeof(struct SemuRenderFrameGl);
        SemuPreload.frame_id = SemuPreload.frame_id + 1ULL;
        frame.frame_id = SemuPreload.frame_id;
        frame.framebuffer = 0u;
        frame.color_buffer = 0x0405u;  // GL_BACK
        frame.framebuffer_width = width;
        frame.framebuffer_height = height;
        frame.presentation_aspect = (float)surfaceWidth / (float)surfaceHeight;
        frame.layout_variant = SEMU_RENDER_LAYOUT_AUTO;
        frame.surface_count = 1;
        frame.surfaces[0].x = surfaceX;
        frame.surfaces[0].y = surfaceY;
        frame.surfaces[0].width = surfaceWidth;
        frame.surfaces[0].height = surfaceHeight;
        frame.surfaces[0].native_width = SemuPreload.native_width > 0 ? SemuPreload.native_width : surfaceWidth;
        frame.surfaces[0].native_height = SemuPreload.native_height > 0 ? SemuPreload.native_height : surfaceHeight;
        frame.surfaces[0].rotation = 0;
        frame.surfaces[0].origin = SEMU_RENDER_ORIGIN_BOTTOM_LEFT;
        frame.get_proc = getProc;
        frame.context_generation = 1ULL;
        int status = semu_render_game_gl(&frame);
        int post = status == SEMU_RENDER_INVALID_FRAME ? status : semu_render_post_ui_gl(&frame);
        if (!SemuPreload.reported && getenv("SEMU_RENDER_DEBUG") != null) {
            SemuPreload.reported = 1;
            fprintf(stderr, "semu-preload: first frame %dx%d surface %d,%d %dx%d game=%d post=%d\n",
                width, height, surfaceX, surfaceY, surfaceWidth, surfaceHeight, status, post);
        }
    }
}

void SDL_GL_SwapWindow(void* window) {
    SemuPreloadHooks.initialize();
    SemuPreloadHooks.rebind();
    if (SemuPreload.enabled != 0 && SemuPreload.drawable != null) {
        int width = 0;
        int height = 0;
        SemuPreload.drawable(window, &width, &height);
        SemuPreloadHooks.compose(width, height, SemuPreload.get_proc);
    }
    if (SemuPreload.swap != null) { SemuPreload.swap(window); }
}

unsigned int eglSwapBuffers(void* display, void* surface) {
    SemuPreloadHooks.initialize();
    SemuPreloadHooks.rebind();
    if (SemuPreload.enabled != 0 && SemuPreload.egl_query != null) {
        int width = 0;
        int height = 0;
        SemuPreload.egl_query(display, surface, 0x3057, &width);  // EGL_WIDTH
        SemuPreload.egl_query(display, surface, 0x3056, &height);  // EGL_HEIGHT
        SemuPreloadHooks.compose(width, height, SemuPreload.egl_get_proc);
    }
    return SemuPreload.egl_swap != null ? SemuPreload.egl_swap(display, surface) : 0u;
}

void glXSwapBuffers(void* display, unsigned long drawable) {
    SemuPreloadHooks.initialize();
    SemuPreloadHooks.rebind();
    if (SemuPreload.enabled != 0 && SemuPreload.glx_query != null) {
        unsigned int width = 0;
        unsigned int height = 0;
        SemuPreload.glx_query(display, drawable, 0x801D, &width);  // GLX_WIDTH
        SemuPreload.glx_query(display, drawable, 0x801E, &height);  // GLX_HEIGHT
        __fn_ptr<void*, const char*> getProc;
        memcpy(&getProc, &SemuPreload.glx_get_proc, sizeof(getProc));  // same ABI, different declared parameter type
        SemuPreloadHooks.compose((int)width, (int)height, getProc);
    }
    if (SemuPreload.glx_swap != null) { SemuPreload.glx_swap(display, drawable); }
}
