// Composition of a standalone emulator's finished frame through libsemurenderer, shared by every
// hook that reaches one: the LD_PRELOAD shim at a GL swap and the Vulkan layer at present. The
// renderer reads each game screen where the emulator drew it and writes the composed frame back
// into the same framebuffer. Configuration comes from the SEMU_RENDER_* environment the launcher
// emits. Where the emulator draws its screens:
//   one screen: letterboxed, centered at the system aspect (every single-screen emulator);
//   two screens (SEMU_RENDER_SURFACE_COUNT=2, vertical): Azahar's default layout (its
//   LargeFrameLayout, small screen below): both screens form one box, scaled to the largest fit
//   (a whole multiple when SEMU_RENDER_FRAME_INTEGER=1, as Azahar's use_integer_scaling does) and
//   centered; each screen is cut from it at the box's scale.
// The last composition's pointer map is kept, so a touch hook can turn a click on the composed
// picture back into the point the emulator drew there. The map is written at present on the render
// thread and read by the toolkit's input thread (Qt's GUI thread for Azahar), so one mutex guards it.
// That thread also reports the window pointer (semu_pointer_sample), and each composed frame carries
// it as the cursor Semu draws on a touch system, under its own mutex.
// The map also turns the window pointer an emulator aims (Dolphin's Wii Remote IR, which it reads with
// XIQueryPointer) into the point it drew under the finger: semu_preload.btrc, on the declared pointer screen.
#include <pthread.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "semu_renderer.h"
import ./semu_frame_layout.btrc;
import ../retroarch/cursor_policy.btrc;

struct SemuComposeState {
    bool initialized;
    bool enabled;
    bool reported;
    bool stacked;
    bool integer;  // the emulator scales its frame by whole multiples (SEMU_RENDER_FRAME_INTEGER=1)
    unsigned long long frame_id;
    float aspect;
    int native_width;
    int native_height;
    int second_native_width;
    int second_native_height;
    int framebuffer_width;
    int framebuffer_height;
    struct SemuComposeRect drawn[2];
    bool mapped;
    struct SemuRenderPointerMap pointer_map;
    __fn_ptr<int, struct SemuRenderPointerMap*, struct SemuRenderPointerQuery*, struct SemuRenderPointerResult*> map_pointer;
    int touch_index;  // SEMU_RENDER_TOUCH_SURFACE_INDEX, -1 without a touch screen: gates the cursor
    int pointer_index;  // SEMU_RENDER_POINTER_SURFACE_INDEX, -1 unless the emulator aims its window pointer at a screen (Dolphin's Wii Remote IR)
    int cursor_serial;  // the last sample serial a frame carried, read and written at present only
};

struct SemuComposePointerSample {  // the window pointer the emulator last reported, framebuffer pixels from the top left
    bool known;
    bool inside;
    bool pressed;
    float pointer_x;
    float pointer_y;
    int serial;  // bumped per reported event, so the first frame carrying one counts it as motion
};

struct SemuComposeState SemuComposition;
pthread_mutex_t SemuComposePointerLock = PTHREAD_MUTEX_INITIALIZER;  // the map, its callback, the drawn rects, the size
struct SemuComposePointerSample SemuComposeSample;
pthread_mutex_t SemuComposeSampleLock = PTHREAD_MUTEX_INITIALIZER;  // written on the toolkit's input thread, read at present

class SemuCompose {
    class bool size(const char* name, int* width, int* height) {
        char* value = getenv(name);
        return value != null && sscanf(value, "%dx%d", width, height) == 2 && *width > 0 && *height > 0;
    }

    class void initialize() {
        if (SemuComposition.initialized) { return; }
        SemuComposition.initialized = true;
        int aspectWidth = 0;
        int aspectHeight = 0;
        char* aspect = getenv("SEMU_RENDER_ASPECT");
        if (aspect != null && sscanf(aspect, "%d:%d", &aspectWidth, &aspectHeight) == 2 && aspectWidth > 0 && aspectHeight > 0) {
            SemuComposition.aspect = (float)aspectWidth / (float)aspectHeight;
        }
        SemuCompose.size("SEMU_RENDER_SURFACE_0_NATIVE", &SemuComposition.native_width, &SemuComposition.native_height);
        char* count = getenv("SEMU_RENDER_SURFACE_COUNT");
        char* layout = getenv("SEMU_RENDER_SURFACE_LAYOUT");
        SemuComposition.stacked = count != null && strcmp(count, "2") == 0 && layout != null && strcmp(layout, "vertical") == 0
            && SemuComposition.native_width > 0
            && SemuCompose.size("SEMU_RENDER_SURFACE_1_NATIVE", &SemuComposition.second_native_width, &SemuComposition.second_native_height);
        char* integer = getenv("SEMU_RENDER_FRAME_INTEGER");
        SemuComposition.integer = integer != null && strcmp(integer, "1") == 0;
        SemuComposition.touch_index = SemuCursorPolicy.touchIndex(getenv("SEMU_RENDER_TOUCH_SURFACE_INDEX"));
        SemuComposition.pointer_index = SemuCursorPolicy.touchIndex(getenv("SEMU_RENDER_POINTER_SURFACE_INDEX"));  // the same short-number rule
        SemuComposition.enabled = getenv("SEMU_RENDER_SYSTEM_ID") != null;
    }

    // The emulator's window pointer (Azahar's semu-touch patch, from its render window's mouse
    // events): kept for the next composed frame's cursor.
    class void sample(float pointerX, float pointerY, bool pressed, bool inside) {
        pthread_mutex_lock(&SemuComposeSampleLock);
        SemuComposeSample.known = true;
        SemuComposeSample.inside = inside;
        SemuComposeSample.pressed = pressed;
        SemuComposeSample.pointer_x = pointerX;
        SemuComposeSample.pointer_y = pointerY;
        SemuComposeSample.serial = SemuComposeSample.serial + 1;
        pthread_mutex_unlock(&SemuComposeSampleLock);
    }

    class void cursor(struct SemuRenderFrameGl* frame) {  // the frame's cursor from the last sample, through the policy RetroArch's bridge uses
        pthread_mutex_lock(&SemuComposeSampleLock);
        struct SemuComposePointerSample pointer;
        memcpy(&pointer, &SemuComposeSample, sizeof(struct SemuComposePointerSample));
        pthread_mutex_unlock(&SemuComposeSampleLock);
        SemuCursorPolicy.fill(SemuComposition.touch_index, pointer.known && pointer.inside,
            (int)pointer.pointer_x, (int)pointer.pointer_y, pointer.pressed, SemuCursorPolicy.fresh(pointer.serial, &SemuComposition.cursor_serial),
            frame->framebuffer_width, frame->framebuffer_height,
            &frame->cursor.visible, &frame->cursor.x, &frame->cursor.y, &frame->cursor.pressed);
    }

    class bool enabled() {
        SemuCompose.initialize();
        return SemuComposition.enabled;
    }

    class bool debug() {
        return getenv("SEMU_RENDER_DEBUG") != null;
    }

    class void stackedLayout(int width, int height, struct SemuComposeRect* top, struct SemuComposeRect* bottom) {
        SemuFrameLayout.stacked(width, height, SemuComposition.native_width, SemuComposition.native_height,
                                SemuComposition.second_native_width, SemuComposition.second_native_height, SemuComposition.integer, top, bottom);
    }

    class void surface(struct SemuRenderFrameGl* frame, struct SemuComposeRect* drawn, int index, struct SemuComposeRect rect, int nativeWidth, int nativeHeight) {
        frame->surfaces[index].x = rect.x;
        frame->surfaces[index].y = frame->framebuffer_height - rect.y - rect.height;  // OpenGL rows start at the bottom
        frame->surfaces[index].width = rect.width;
        frame->surfaces[index].height = rect.height;
        frame->surfaces[index].native_width = nativeWidth > 0 ? nativeWidth : rect.width;
        frame->surfaces[index].native_height = nativeHeight > 0 ? nativeHeight : rect.height;
        frame->surfaces[index].rotation = 0;
        frame->surfaces[index].origin = SEMU_RENDER_ORIGIN_BOTTOM_LEFT;
        drawn[index] = rect;
    }

    // framebuffer 0 with GL_BACK is a window's back buffer; a hook with its own target passes that
    // framebuffer and GL_COLOR_ATTACHMENT0.
    class void compose(int width, int height, __fn_ptr<void*, const char*> getProc, unsigned int framebuffer, unsigned int colorBuffer) {
        if (!SemuCompose.enabled() || width < 1 || height < 1 || getProc == null) { return; }
        struct SemuRenderFrameGl frame;
        memset(&frame, 0, sizeof(struct SemuRenderFrameGl));
        frame.abi = SEMU_RENDER_ABI_GL;
        frame.struct_size = sizeof(struct SemuRenderFrameGl);
        SemuComposition.frame_id = SemuComposition.frame_id + 1ULL;
        frame.frame_id = SemuComposition.frame_id;
        frame.framebuffer = framebuffer;
        frame.color_buffer = colorBuffer;
        frame.framebuffer_width = width;
        frame.framebuffer_height = height;
        frame.layout_variant = SEMU_RENDER_LAYOUT_AUTO;
        frame.get_proc = getProc;
        frame.context_generation = 1ULL;
        SemuCompose.cursor(&frame);
        struct SemuComposeRect drawn[2];
        memset(drawn, 0, sizeof(drawn));
        if (SemuComposition.stacked) {
            struct SemuComposeRect top;
            struct SemuComposeRect bottom;
            SemuCompose.stackedLayout(width, height, &top, &bottom);
            if (top.width < 1 || bottom.width < 1) { return; }
            frame.surface_count = 2;
            frame.presentation_aspect = (float)top.width / (float)(top.height + bottom.height);
            SemuCompose.surface(&frame, drawn, 0, top, SemuComposition.native_width, SemuComposition.native_height);
            SemuCompose.surface(&frame, drawn, 1, bottom, SemuComposition.second_native_width, SemuComposition.second_native_height);
        } else {
            struct SemuComposeRect picture;
            SemuFrameLayout.letterboxed(width, height, SemuComposition.aspect, &picture);
            if (picture.width < 1 || picture.height < 1) { return; }
            frame.surface_count = 1;
            frame.presentation_aspect = SemuFrameLayout.presentationAspect(SemuComposition.aspect, &picture);
            SemuCompose.surface(&frame, drawn, 0, picture, SemuComposition.native_width, SemuComposition.native_height);
        }
        int status = semu_render_game_gl(&frame);
        int post = status == SEMU_RENDER_INVALID_FRAME ? status : semu_render_post_ui_gl(&frame);
        pthread_mutex_lock(&SemuComposePointerLock);  // publish this frame's map in one step
        SemuComposition.framebuffer_width = width;
        SemuComposition.framebuffer_height = height;
        memcpy(SemuComposition.drawn, drawn, sizeof(drawn));
        SemuComposition.mapped = status != SEMU_RENDER_INVALID_FRAME && frame.map_pointer != null;
        if (SemuComposition.mapped) {
            memcpy(&SemuComposition.pointer_map, &frame.pointer_map, sizeof(struct SemuRenderPointerMap));
            SemuComposition.map_pointer = frame.map_pointer;
        }
        pthread_mutex_unlock(&SemuComposePointerLock);
        if (!SemuComposition.reported && SemuCompose.debug()) {
            SemuComposition.reported = true;
            fprintf(stderr, "semu-compose: first frame %dx%d, %d screen(s), first at %d,%d %dx%d, game=%d post=%d\n",
                width, height, frame.surface_count, drawn[0].x, drawn[0].y,
                drawn[0].width, drawn[0].height, status, post);
        }
    }

    // A point on the composed picture (top-left origin, framebuffer pixels) back to where the emulator
    // drew that point of its touch screen (the declared one, else the last): 1 mapped, 0 not on that
    // screen, -1 nothing composed yet. Clamped, a point off the screen maps to its nearest edge (a
    // drag that leaves it).
    class int unmap(float x, float y, bool clamp, float* emulatorX, float* emulatorY) {
        char* touch = getenv("SEMU_RENDER_TOUCH_SURFACE_INDEX");
        return SemuCompose.unmapOn(touch != null ? atoi(touch) : -1, x, y, clamp, emulatorX, emulatorY);
    }

    // The screen the emulator aims its window pointer at (SEMU_RENDER_POINTER_SURFACE_INDEX), or -1.
    class int pointerSurface() {
        SemuCompose.initialize();
        return SemuComposition.pointer_index;
    }

    // unmap on one screen; a negative index is the composed frame's last screen.
    class int unmapOn(int screen, float x, float y, bool clamp, float* emulatorX, float* emulatorY) {
        pthread_mutex_lock(&SemuComposePointerLock);  // one frame's map, rects and size together
        bool mapped = SemuComposition.mapped;
        struct SemuRenderPointerMap map;
        memcpy(&map, &SemuComposition.pointer_map, sizeof(struct SemuRenderPointerMap));
        __fn_ptr<int, struct SemuRenderPointerMap*, struct SemuRenderPointerQuery*, struct SemuRenderPointerResult*> mapPointer = SemuComposition.map_pointer;
        struct SemuComposeRect rects[2];
        memcpy(rects, SemuComposition.drawn, sizeof(rects));
        int framebufferWidth = SemuComposition.framebuffer_width;
        int framebufferHeight = SemuComposition.framebuffer_height;
        pthread_mutex_unlock(&SemuComposePointerLock);
        int surface = screen >= 0 ? screen : map.surface_count - 1;
        if (!mapped || mapPointer == null || surface < 0 || surface >= map.surface_count || surface > 1) { return -1; }
        struct SemuRenderPointerQuery query;
        memset(&query, 0, sizeof(struct SemuRenderPointerQuery));
        query.abi = SEMU_RENDER_ABI_GL;
        query.struct_size = sizeof(struct SemuRenderPointerQuery);
        query.frame_id = map.frame_id;
        query.x = x;
        query.y = y;
        query.viewport_width = framebufferWidth;
        query.viewport_height = framebufferHeight;
        query.origin = SEMU_RENDER_ORIGIN_TOP_LEFT;
        query.surface_index = surface;
        query.clamp = clamp ? 1 : 0;
        struct SemuRenderPointerResult result;
        memset(&result, 0, sizeof(struct SemuRenderPointerResult));
        result.abi = SEMU_RENDER_ABI_GL;
        result.struct_size = sizeof(struct SemuRenderPointerResult);
        if (mapPointer(&map, &query, &result) != SEMU_RENDER_POINTER_MAPPED) { return 0; }
        SemuFrameLayout.drawnPoint(&rects[surface], result.normalized_x, result.normalized_y,
            (int)result.origin == (int)SEMU_RENDER_ORIGIN_BOTTOM_LEFT, emulatorX, emulatorY);  // normalized in the surface's row order
        return 1;
    }
}
