// What the launch asked the renderer to draw: SEMU_RENDER_* parsed into the two variants (A, and B for
// 16:9 pictures) and the global switches. A live bezel or shader choice re-parses the variant keys from
// the variants file's section instead of the environment. No GL, so the contracts parse it directly.

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

import ./renderer_abi.btrc;
import ./renderer_file_hash.btrc;
import ./renderer_layout.btrc;
import ./renderer_variants.btrc;
import ./variant_keys.btrc;
import ./renderer_config_screen.btrc;
import ./renderer_surface_crop.btrc;

struct RendererVariantConfig {
    int declared;
    struct RendererPath bezel_id;  // SEMU_RENDER_BEZEL_ID: the package name, for the debug line
    struct RendererPath shader_preset;
    struct RendererPath art;
    struct RendererPath background;
    int canvas_width;   // SEMU_RENDER_CANVAS: the pixel grid the layers and screens are addressed in
    int canvas_cover;   // SEMU_RENDER_CANVAS_FIT=cover: a scene fills the screen instead of letterboxing
    int canvas_height;
    struct RendererNormalizedHole canvas_shell;  // SEMU_RENDER_CANVAS_SHELL: the device's silhouette on the canvas, unset when it is all plate
    int layer_count;
    struct RendererLayerConfig layers[8];
    int layout;
    int frame_set;
    float frame_width;
    float frame_r;
    float frame_g;
    float frame_b;
    struct RendererScreenConfig screens[2];
    char shader_sha256[65];
    char art_sha256[65];
    int shader_available;
};

struct RendererConfig {
    int loaded;
    int shaders_enabled;
    int bezels_enabled;
    int integer_scaling;  // one screen without a fixed bezel; two screens always integer
    int placement;  // SEMU_RENDER_PLACEMENT: 0 fit, 1 game (integer, shell cropped), 2 bezel (integer, shell whole)
    int game_fractional_below;  // SEMU_RENDER_GAME_FRACTIONAL_BELOW: a 3D-era system's game placement fills the screen below this whole step; 0 never
    int active_variant;
    float display_aspect;
    float frames_per_second;
    unsigned int frame_delta_ms;
    float dual_screen_gap;  // SEMU_RENDER_DUAL_GAP: space between two screens, fraction of width
    struct RendererPath system_id;
    struct RendererPath emulator_id;
    struct RendererSurfaceCrop surface_crops[2];  // SEMU_RENDER_SURFACE_<n>_CROP: what the emulator hands over that is no picture
    struct RendererVariantConfig variants[4];  // A and B are emitted; C and D stay undeclared
};

class RendererConfiguration {
    class int placementCode(char* value) {  // fit 0, game 1, bezel 2: SEMU_RENDER_PLACEMENT and the variants file's placement ids
        if (value == null) { return 0; }
        return strcmp(value, "game") == 0 ? 1 : (strcmp(value, "bezel") == 0 ? 2 : 0);
    }

    class void reloadVariants(struct RendererConfig* config, struct RendererVariantOverlay* overlay) {  // A and B from one section; C and D stay undeclared
        if (config == null || overlay == null) { return; }
        RendererLookup.overlay = overlay;
        RendererConfiguration.loadVariant(&config->variants[0], "");
        RendererConfiguration.loadVariant(&config->variants[1], "_B");
        memset(&config->variants[2], 0, sizeof(struct RendererVariantConfig) * (size_t)2);
        config->shaders_enabled = RendererConfigKeys.enabled("SEMU_RENDER_SHADERS") ? 1 : 0;
        config->bezels_enabled = RendererConfigKeys.enabled("SEMU_RENDER_BEZELS") ? 1 : 0;
        RendererLookup.overlay = null;
    }

    class unsigned long long mix(unsigned long long value, char* text) {  // FNV-1a over TEXT and a separator
        for (int index = 0; text != null && text[index] != 0; index++) { value = (value ^ (unsigned long long)(unsigned char)text[index]) * 1099511628211ULL; }
        return (value ^ 124ULL) * 1099511628211ULL;
    }

    class unsigned long long imageSignature(struct RendererConfig* config) {  // every image file the variants draw: unchanged, no image reloads
        unsigned long long value = 1469598103934665603ULL;
        for (int variantIndex = 0; variantIndex < 4; variantIndex++) {
            struct RendererVariantConfig* variant = &config->variants[variantIndex];
            value = RendererConfiguration.mix(value, variant->art.value);
            value = RendererConfiguration.mix(value, variant->background.value);
            for (int layer = 0; layer < variant->layer_count; layer++) { value = RendererConfiguration.mix(value, variant->layers[layer].file.value); }
            for (int lane = 0; lane < 2; lane++) { value = RendererConfiguration.mix(value, variant->screens[lane].glass.value); }
        }
        return value;
    }

    class void loadVariant(struct RendererVariantConfig* variant, char* suffix) {
        char name[128];
        memset(variant, 0, sizeof(struct RendererVariantConfig));
        snprintf(name, sizeof(name), "SEMU_RENDER_BEZEL_ID%s", suffix);
        RendererConfigKeys.copyEnvironment(&variant->bezel_id, name);
        snprintf(name, sizeof(name), "SEMU_RENDER_SHADER_PRESET%s", suffix);
        RendererConfigKeys.copyEnvironment(&variant->shader_preset, name);
        snprintf(name, sizeof(name), "SEMU_RENDER_ART%s", suffix);
        RendererConfigKeys.copyEnvironment(&variant->art, name);
        snprintf(name, sizeof(name), "SEMU_RENDER_BACKGROUND%s", suffix);
        RendererConfigKeys.copyEnvironment(&variant->background, name);
        snprintf(name, sizeof(name), "SEMU_RENDER_LAYOUT%s", suffix);
        variant->layout = RendererConfigKeys.parseLayout(RendererConfigKeys.lookup(name));
        snprintf(name, sizeof(name), "SEMU_RENDER_CANVAS%s", suffix);
        char* canvas = RendererConfigKeys.lookup(name);
        if (canvas == null || sscanf(canvas, "%d,%d", &variant->canvas_width, &variant->canvas_height) != 2 || variant->canvas_width < 1 || variant->canvas_height < 1) {
            variant->canvas_width = 0;
            variant->canvas_height = 0;
        }
        snprintf(name, sizeof(name), "SEMU_RENDER_CANVAS_FIT%s", suffix);
        char* canvasFit = RendererConfigKeys.lookup(name);
        variant->canvas_cover = canvasFit != null && strcmp(canvasFit, "cover") == 0 ? 1 : 0;
        snprintf(name, sizeof(name), "SEMU_RENDER_CANVAS_SHELL%s", suffix);
        RendererConfigKeys.parseHole(&variant->canvas_shell, name);
        snprintf(name, sizeof(name), "SEMU_RENDER_LAYER_COUNT%s", suffix);
        char* countText = RendererConfigKeys.lookup(name);
        int declaredLayers = countText == null ? 0 : atoi(countText);
        if (declaredLayers > 8) { declaredLayers = 8; }
        variant->layer_count = 0;
        for (int index = 0; index < declaredLayers; index++) {
            snprintf(name, sizeof(name), "SEMU_RENDER_LAYER_%d%s", index, suffix);
            if (RendererConfigKeys.parseLayer(&variant->layers[variant->layer_count], RendererConfigKeys.lookup(name))) { variant->layer_count++; }
        }
        snprintf(name, sizeof(name), "SEMU_RENDER_FRAME%s", suffix);
        char* frame = RendererConfigKeys.lookup(name);
        int parsed = frame == null ? 0 : sscanf(frame, "%f,%f,%f,%f", &variant->frame_width, &variant->frame_r, &variant->frame_g, &variant->frame_b);  // width, r, g, b: the frame rounds concentric with its opening
        if (parsed == 4 && variant->frame_width > 0.0f) { variant->frame_set = 1; }
        for (int index = 0; index < 2; index++) {
            RendererConfigKeys.loadScreen(&variant->screens[index], index, suffix);
        }
        variant->shader_available = RendererFileHash.sha256(
            variant->shader_preset.value, variant->shader_sha256) ? 1 : 0;
        RendererFileHash.sha256(variant->art.value, variant->art_sha256);
        variant->declared = (variant->art.value[0] != 0
            || variant->layer_count > 0
            || variant->shader_preset.value[0] != 0
            || variant->layout != SEMU_LAYOUT_FIXED
            || variant->screens[0].tube.set != 0) ? 1 : 0;
    }

    class struct RendererVariantConfig* active(struct RendererConfig* config) {
        return &config->variants[config->active_variant];
    }

    class char* lanePreset(struct RendererConfig* config, int lane) {  // the screen's own preset, else the variant's, else variant A's
        struct RendererVariantConfig* active = RendererConfiguration.active(config);
        if (lane >= 0 && lane < 2 && active->screens[lane].shader.value[0] != 0 && active->screens[lane].shader_available != 0) {
            return active->screens[lane].shader.value;
        }
        if (active->shader_preset.value[0] != 0) {
            return active->shader_preset.value;
        }
        return config->variants[0].shader_preset.value;
    }

    class char* shaderPreset(struct RendererConfig* config) {
        return RendererConfiguration.lanePreset(config, 0);
    }

    class char* shaderHash(struct RendererConfig* config) {
        struct RendererVariantConfig* active = RendererConfiguration.active(config);
        if (active->screens[0].shader.value[0] != 0 && active->screens[0].shader_available != 0) {
            return active->screens[0].shader_sha256;
        }
        if (active->shader_preset.value[0] != 0) {
            return active->shader_sha256;
        }
        return config->variants[0].shader_sha256;
    }

    class bool shaderAvailable(struct RendererConfig* config) {
        if (config == null) { return false; }
        char* preset = RendererConfiguration.lanePreset(config, 0);
        if (preset == null || preset[0] == 0) { return false; }
        struct RendererVariantConfig* active = RendererConfiguration.active(config);
        if (active->screens[0].shader.value[0] != 0 && active->screens[0].shader_available != 0) { return true; }
        if (active->shader_preset.value[0] != 0) { return active->shader_available != 0; }
        return config->variants[0].shader_available != 0;
    }

    class float widescreenThreshold() {  // halfway between the 4:3 and 16:9 pictures
        float standard = 4.0f / 3.0f;
        float widescreen = 16.0f / 9.0f;
        return (standard + widescreen) * 0.5f;
    }

    class int select(struct RendererConfig* config,
                     struct SemuRenderFrameGl* frame) {
        int selected = 0;
        if (frame->layout_variant >= (unsigned int)SEMU_RENDER_LAYOUT_DEFAULT
            && frame->layout_variant <= (unsigned int)SEMU_RENDER_LAYOUT_VARIANT_D) {
            int explicitVariant = (int)frame->layout_variant - 1;
            if (config->variants[explicitVariant].declared != 0) {
                selected = explicitVariant;
            }
        } else if (frame->presentation_aspect >= RendererConfiguration.widescreenThreshold()
                && config->variants[1].declared != 0) {
            selected = 1;
        }
        config->active_variant = selected;
        return selected;
    }

    class void load(struct RendererConfig* config) {
        if (config == null || config->loaded != 0) { return; }
        memset(config, 0, sizeof(struct RendererConfig));
        config->loaded = 1;
        config->shaders_enabled = 1;
        config->bezels_enabled = 1;
        config->frames_per_second = 60.0f;
        config->frame_delta_ms = 17;
        char* value = getenv("SEMU_RENDER_SHADERS");
        if (value != null && value[0] == '0') { config->shaders_enabled = 0; }
        value = getenv("SEMU_RENDER_BEZELS");
        if (value != null && value[0] == '0') { config->bezels_enabled = 0; }
        value = getenv("SEMU_RENDER_INTEGER_SCALE");
        if (value != null && value[0] == '1') { config->integer_scaling = 1; }
        value = getenv("SEMU_RENDER_PLACEMENT");
        config->placement = RendererConfiguration.placementCode(value);
        value = getenv("SEMU_RENDER_GAME_FRACTIONAL_BELOW");
        config->game_fractional_below = value == null ? 0 : atoi(value);
        value = getenv("SEMU_RENDER_ASPECT");
        if (value != null) {
            float width = 0.0f;
            float height = 0.0f;
            if (sscanf(value, "%f:%f", &width, &height) == 2 && height > 0.0f) {
                config->display_aspect = width / height;
            } else {
                config->display_aspect = (float)atof(value);
            }
        }
        value = getenv("SEMU_RENDER_FPS");
        if (value != null && atof(value) > 0.0) {
            config->frames_per_second = (float)atof(value);
        }
        value = getenv("SEMU_RENDER_FRAME_DELTA_MS");
        if (value != null && atoi(value) > 0) {
            config->frame_delta_ms = (unsigned int)atoi(value);
        }
        value = getenv("SEMU_RENDER_DUAL_GAP");
        if (value != null) { config->dual_screen_gap = RendererConfigKeys.clamp01((float)atof(value)); }
        RendererConfigKeys.copyEnvironment(&config->system_id,
            "SEMU_RENDER_SYSTEM_ID");
        RendererConfigKeys.copyEnvironment(&config->emulator_id,
            "SEMU_RENDER_EMULATOR_ID");
        RendererSurfaceCropping.load(config->surface_crops);
        char* suffixes[2] = {"", "_B"};
        for (int index = 0; index < 2; index++) {
            RendererConfiguration.loadVariant(&config->variants[index],
                suffixes[index]);
        }
    }
}

class RendererClock {
    class long long milliseconds() {  // monotonic, for the reload check and retry backoff
        struct timespec now;
        clock_gettime(CLOCK_MONOTONIC, &now);
        return (long long)now.tv_sec * 1000LL + (long long)(now.tv_nsec / 1000000L);
    }

    class long long epochMilliseconds() {  // wall clock, for debug lines a harness lines up with its own date +%s%3N
        struct timespec now;
        clock_gettime(CLOCK_REALTIME, &now);
        return (long long)now.tv_sec * 1000LL + (long long)(now.tv_nsec / 1000000L);
    }
}
