// Lane rectangles: the opening a lane fills and the computed layouts of two screens (a large main beside
// a second, side by side, stacked). Pure arithmetic over renderer_abi's records, no GL, so the contracts
// check it directly.

#include <string.h>

import ./renderer_abi.btrc;

int SEMU_LAYOUT_FIXED = 0;
int SEMU_LAYOUT_MAIN_RIGHT = 1;
int SEMU_LAYOUT_MAIN_LEFT = 2;
int SEMU_LAYOUT_SIDE_BY_SIDE = 3;
int SEMU_LAYOUT_STACKED = 4;

struct RendererBesideArrangement {  // a large main with the second beside it, centred alone or as a pair
    bool centered;      // the main centred on its own, else the pair centred
    int scale;          // the main's whole step, 0 when none leaves the second 1x beside it
    int side;           // the room beside the main past the gap, for the second and any frame
    int second_width;
    int second_height;
    int frame;          // the drawn frame width the screens leave room for
};

class RendererLayout {
    class void setTube(struct RendererLaneGeometry* lane, int x, int y, int width, int height) {
        lane->tube_x = x;
        lane->tube_y = y;
        lane->tube_width = width;
        lane->tube_height = height;
    }

    class void tubeFromOutput(struct RendererLaneGeometry* lane) {
        RendererLayout.setTube(lane, lane->output_x, lane->output_y, lane->output_width, lane->output_height);
    }

    class void hold(struct RendererPixelRect* rectangle, struct RendererLaneGeometry* lane) {  // a drawn rectangle the lane's picture runs past grows a pixel beyond it: a whole step past its opening is never masked, nor its edge antialiased
        if (rectangle->width < 1 || rectangle->height < 1) { return; }
        int right = rectangle->x + rectangle->width;
        int top = rectangle->y + rectangle->height;
        if (lane->output_x >= rectangle->x && lane->output_y >= rectangle->y && lane->output_x + lane->output_width <= right && lane->output_y + lane->output_height <= top) { return; }  // inside or flush: unchanged
        int left = lane->output_x - 1 < rectangle->x ? lane->output_x - 1 : rectangle->x;
        int bottom = lane->output_y - 1 < rectangle->y ? lane->output_y - 1 : rectangle->y;
        if (lane->output_x + lane->output_width + 1 > right) { right = lane->output_x + lane->output_width + 1; }
        if (lane->output_y + lane->output_height + 1 > top) { top = lane->output_y + lane->output_height + 1; }
        rectangle->x = left;
        rectangle->y = bottom;
        rectangle->width = right - left;
        rectangle->height = top - bottom;
    }

    class void carry(struct RendererPixelRect* rectangle, struct RendererPixelRect* picture, struct RendererLaneGeometry* lane) {  // a whole-step picture past the package's own picture rectangle (PICTURE) carries a drawn rectangle out with it, each side by the picture's overrun there, so a lip keeps its declared width round the picture actually drawn; then held a pixel past it
        if (rectangle->width < 1 || rectangle->height < 1) { return; }
        if (picture->width >= 1 && picture->height >= 1) {
            int left = picture->x - lane->output_x;
            int bottom = picture->y - lane->output_y;
            int right = lane->output_x + lane->output_width - picture->x - picture->width;
            int top = lane->output_y + lane->output_height - picture->y - picture->height;
            if (left > 0) { rectangle->x = rectangle->x - left; rectangle->width = rectangle->width + left; }
            if (bottom > 0) { rectangle->y = rectangle->y - bottom; rectangle->height = rectangle->height + bottom; }
            if (right > 0) { rectangle->width = rectangle->width + right; }
            if (top > 0) { rectangle->height = rectangle->height + top; }
        }
        RendererLayout.hold(rectangle, lane);
    }

    class int rotatedWidth(struct RendererLaneGeometry* lane) {
        return lane->rotation == 90 || lane->rotation == 270 ? lane->native_height : lane->native_width;
    }

    class int rotatedHeight(struct RendererLaneGeometry* lane) {
        return lane->rotation == 90 || lane->rotation == 270 ? lane->native_width : lane->native_height;
    }

    class void exact(struct RendererLaneGeometry* lane, int x, int y, int width, int height) {
        lane->output_x = x;
        lane->output_y = y;
        lane->output_width = width;
        lane->output_height = height;
        RendererLayout.tubeFromOutput(lane);
    }

    class int fitted(int frame, int spare, int count) {  // the drawn frame shrunk to the room the screens leave: never a scale step
        int room = count > 0 ? spare / count : frame;
        int width = frame < room ? frame : room;
        return width > 0 ? width : 0;
    }

    class float whole(float scale) {  // both screens at the largest whole step the display holds; below 1x the fractional fallback
        if (scale >= 1.0f) { return (float)(int)scale; }
        return scale > 0.0f ? scale : 0.01f;
    }

    class void arrange(struct RendererBesideArrangement* arrangement, struct RendererCompositionGeometry* geometry,
                       int areaWidth, int areaHeight, int frame, int gap, bool centered) {  // the largest main step that leaves the second 1x beside it, then the second's step and the frame
        int mainWidth = RendererLayout.rotatedWidth(&geometry->lanes[0]);
        int mainHeight = RendererLayout.rotatedHeight(&geometry->lanes[0]);
        int secondWidth = RendererLayout.rotatedWidth(&geometry->lanes[1]);
        int secondHeight = RendererLayout.rotatedHeight(&geometry->lanes[1]);
        memset(arrangement, 0, sizeof(struct RendererBesideArrangement));
        arrangement->centered = centered;
        int scale = areaHeight / mainHeight;  // the screens alone choose the step; the frames take what is left
        int side = 0;
        while (scale >= 1) {
            side = centered ? (areaWidth - scale * mainWidth) / 2 - gap : areaWidth - scale * mainWidth - gap;  // only the gap between: plain screens need no end margin
            if (side >= secondWidth) { break; }
            scale--;
        }
        if (scale < 1) { return; }
        float secondScale = (float)side / (float)secondWidth;
        float tall = (float)(scale * mainHeight) / (float)secondHeight;
        if (tall < secondScale) { secondScale = tall; }
        if (secondScale >= 1.0f) { secondScale = (float)(int)secondScale; }  // whole steps like the main; below 1x the fractional fallback
        arrangement->scale = scale;
        arrangement->side = side;
        arrangement->second_width = (int)((float)secondWidth * secondScale + 0.5f);
        arrangement->second_height = (int)((float)secondHeight * secondScale + 0.5f);
        int width = RendererLayout.fitted(frame, areaHeight - scale * mainHeight, 2);
        arrangement->frame = RendererLayout.fitted(width, side - arrangement->second_width, centered ? 3 : 4);  // the main's near frame and the second's two, or all four for a pair
    }

    class bool better(struct RendererBesideArrangement* candidate, struct RendererBesideArrangement* other) {  // a larger main, then a larger second, then a wider frame
        if (candidate->scale != other->scale) { return candidate->scale > other->scale; }
        if (candidate->second_width != other->second_width) { return candidate->second_width > other->second_width; }
        return candidate->frame > other->frame;
    }

    class int mainBeside(struct RendererCompositionGeometry* geometry, int areaWidth, int areaHeight,
                         int frame, int gap, bool right) {  // the main centred alone unless centring the pair gives more; the frame width it drew, or -1
        struct RendererLaneGeometry* main = &geometry->lanes[0];
        struct RendererLaneGeometry* second = &geometry->lanes[1];
        struct RendererBesideArrangement alone;
        struct RendererBesideArrangement pair;
        RendererLayout.arrange(&alone, geometry, areaWidth, areaHeight, frame, gap, true);
        RendererLayout.arrange(&pair, geometry, areaWidth, areaHeight, frame, gap, false);
        struct RendererBesideArrangement* chosen = RendererLayout.better(&pair, &alone) ? &pair : &alone;  // a tie keeps the main centred
        if (chosen->scale < 1) { return -1; }
        int mainOutWidth = chosen->scale * RendererLayout.rotatedWidth(main);
        int mainOutHeight = chosen->scale * RendererLayout.rotatedHeight(main);
        int width = chosen->frame;
        int mainX = (areaWidth - mainOutWidth) / 2;
        int mainY = (areaHeight - mainOutHeight) / 2;
        if (!chosen->centered) {
            int pairWidth = mainOutWidth + 2 * width + gap + chosen->second_width;  // the floored second, so the pair stays centred
            mainX = right ? (areaWidth - pairWidth) / 2 : (areaWidth + pairWidth) / 2 - mainOutWidth;
        }
        RendererLayout.exact(main, mainX, mainY, mainOutWidth, mainOutHeight);
        int offset = chosen->centered ? (chosen->side - 3 * width - chosen->second_width) / 2 : 0;  // beside a centred main, centred in the room it had
        int secondX = right ? mainX + mainOutWidth + 2 * width + gap + offset : mainX - 2 * width - gap - chosen->second_width - offset;
        int secondY = mainY + (mainOutHeight - chosen->second_height) / 2;
        RendererLayout.exact(second, secondX, secondY, chosen->second_width, chosen->second_height);
        return width;
    }

    class int sideBySide(struct RendererCompositionGeometry* geometry, int areaWidth, int areaHeight,
                         int frame, int gap) {  // one uniform scale for both screens; the frame width it drew
        struct RendererLaneGeometry* main = &geometry->lanes[0];
        struct RendererLaneGeometry* second = &geometry->lanes[1];
        int mainWidth = RendererLayout.rotatedWidth(main);
        int mainHeight = RendererLayout.rotatedHeight(main);
        int secondWidth = RendererLayout.rotatedWidth(second);
        int secondHeight = RendererLayout.rotatedHeight(second);
        int tallest = mainHeight > secondHeight ? mainHeight : secondHeight;
        float scale = (float)(areaWidth - gap) / (float)(mainWidth + secondWidth);
        float vertical = (float)areaHeight / (float)tallest;
        if (vertical < scale) { scale = vertical; }
        scale = RendererLayout.whole(scale);
        int mainOutWidth = (int)((float)mainWidth * scale + 0.5f);
        int mainOutHeight = (int)((float)mainHeight * scale + 0.5f);
        int secondOutWidth = (int)((float)secondWidth * scale + 0.5f);
        int secondOutHeight = (int)((float)secondHeight * scale + 0.5f);
        int width = RendererLayout.fitted(frame, areaWidth - gap - mainOutWidth - secondOutWidth, 4);
        width = RendererLayout.fitted(width, areaHeight - (mainOutHeight > secondOutHeight ? mainOutHeight : secondOutHeight), 2);
        int groupWidth = mainOutWidth + secondOutWidth + 2 * width + gap;
        int x = (areaWidth - groupWidth) / 2;
        RendererLayout.exact(main, x, (areaHeight - mainOutHeight) / 2, mainOutWidth, mainOutHeight);
        RendererLayout.exact(second, x + mainOutWidth + 2 * width + gap, (areaHeight - secondOutHeight) / 2, secondOutWidth, secondOutHeight);
        return width;
    }

    class int stacked(struct RendererCompositionGeometry* geometry, int areaWidth, int areaHeight,
                      int frame, int gap) {  // lane 0 above lane 1 in GL space; the frame width it drew
        struct RendererLaneGeometry* main = &geometry->lanes[0];
        struct RendererLaneGeometry* second = &geometry->lanes[1];
        int mainWidth = RendererLayout.rotatedWidth(main);
        int mainHeight = RendererLayout.rotatedHeight(main);
        int secondWidth = RendererLayout.rotatedWidth(second);
        int secondHeight = RendererLayout.rotatedHeight(second);
        int widest = mainWidth > secondWidth ? mainWidth : secondWidth;
        float scale = (float)areaWidth / (float)widest;
        float vertical = (float)(areaHeight - gap) / (float)(mainHeight + secondHeight);
        if (vertical < scale) { scale = vertical; }
        scale = RendererLayout.whole(scale);
        int mainOutWidth = (int)((float)mainWidth * scale + 0.5f);
        int mainOutHeight = (int)((float)mainHeight * scale + 0.5f);
        int secondOutWidth = (int)((float)secondWidth * scale + 0.5f);
        int secondOutHeight = (int)((float)secondHeight * scale + 0.5f);
        int width = RendererLayout.fitted(frame, areaHeight - gap - mainOutHeight - secondOutHeight, 4);
        width = RendererLayout.fitted(width, areaWidth - (mainOutWidth > secondOutWidth ? mainOutWidth : secondOutWidth), 2);
        int groupHeight = mainOutHeight + secondOutHeight + 2 * width + gap;
        int y = (areaHeight - groupHeight) / 2;
        RendererLayout.exact(second, (areaWidth - secondOutWidth) / 2, y, secondOutWidth, secondOutHeight);
        RendererLayout.exact(main, (areaWidth - mainOutWidth) / 2, y + secondOutHeight + 2 * width + gap, mainOutWidth, mainOutHeight);
        return width;
    }

    class int computedAt(struct RendererCompositionGeometry* geometry, int layout, int areaWidth, int areaHeight,
                         int frame, float gapFraction, bool fractional) {  // FRACTIONAL: a non-integer Fit state, the whole-step layout grown as one to the largest the display holds
        int drawn = RendererLayout.computed(geometry, layout, areaWidth, areaHeight, frame, gapFraction);
        return fractional ? RendererLayout.grown(geometry, areaWidth, areaHeight, drawn) : drawn;
    }

    class int grown(struct RendererCompositionGeometry* geometry, int areaWidth, int areaHeight, int frame) {  // every screen, its frame and the gaps scaled about the group's centre until the group meets the display's edge; the frame width then drawn
        int count = geometry->lane_count < 2 ? geometry->lane_count : 2;
        if (count < 1) { return frame; }
        float left = 1.0e9f;
        float bottom = 1.0e9f;
        float right = -1.0e9f;
        float top = -1.0e9f;
        for (int index = 0; index < count; index++) {
            struct RendererLaneGeometry* lane = &geometry->lanes[index];
            if ((float)(lane->output_x - frame) < left) { left = (float)(lane->output_x - frame); }
            if ((float)(lane->output_y - frame) < bottom) { bottom = (float)(lane->output_y - frame); }
            if ((float)(lane->output_x + lane->output_width + frame) > right) { right = (float)(lane->output_x + lane->output_width + frame); }
            if ((float)(lane->output_y + lane->output_height + frame) > top) { top = (float)(lane->output_y + lane->output_height + frame); }
        }
        if (right <= left || top <= bottom) { return frame; }
        float across = (float)areaWidth / (right - left);
        float down = (float)areaHeight / (top - bottom);
        float scale = across < down ? across : down;
        if (scale <= 1.0f) { return frame; }  // already as large as the display holds
        float middleX = (left + right) * 0.5f;
        float middleY = (bottom + top) * 0.5f;
        for (int index = 0; index < count; index++) {
            struct RendererLaneGeometry* lane = &geometry->lanes[index];
            float leftEdge = (float)areaWidth * 0.5f + ((float)lane->output_x - middleX) * scale;
            float bottomEdge = (float)areaHeight * 0.5f + ((float)lane->output_y - middleY) * scale;
            float rightEdge = (float)areaWidth * 0.5f + ((float)(lane->output_x + lane->output_width) - middleX) * scale;
            float topEdge = (float)areaHeight * 0.5f + ((float)(lane->output_y + lane->output_height) - middleY) * scale;
            int column = (int)(leftEdge + 0.5f);
            int row = (int)(bottomEdge + 0.5f);
            RendererLayout.exact(lane, column, row, (int)(rightEdge + 0.5f) - column, (int)(topEdge + 0.5f) - row);  // each edge rounded, so the screens keep their shapes and their spacing
        }
        return (int)((float)frame * scale);
    }

    class int computed(struct RendererCompositionGeometry* geometry, int layout, int areaWidth, int areaHeight,
                       int frame, float gapFraction) {  // the frame width the layout left room for, at most frame
        int gap = (int)(gapFraction * (float)areaWidth + 0.5f);  // visual.dual_screen_gap, a fraction of the width
        if (layout == SEMU_LAYOUT_MAIN_RIGHT || layout == SEMU_LAYOUT_MAIN_LEFT) {
            int width = RendererLayout.mainBeside(geometry, areaWidth, areaHeight, frame, gap, layout == SEMU_LAYOUT_MAIN_RIGHT);
            if (width >= 0) { return width; }
            return RendererLayout.sideBySide(geometry, areaWidth, areaHeight, frame, gap);  // too small for the policy: the plain side-by-side keeps both screens whole
        }
        if (layout == SEMU_LAYOUT_SIDE_BY_SIDE) { return RendererLayout.sideBySide(geometry, areaWidth, areaHeight, frame, gap); }
        return RendererLayout.stacked(geometry, areaWidth, areaHeight, frame, gap);
    }
}
