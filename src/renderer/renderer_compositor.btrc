// Semantic surface extraction, librashader lanes, and bezel composition.
// A bezel package (config/bezels/<id>/bezel.json) arrives as SEMU_RENDER_* env:
// per-screen tubes, shapes, looks, glass plates and shader presets, plus an
// optional art plate, background plate, drawn frame and computed dual layout.

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include "stb_image.h"

import ./renderer_abi.btrc;
import ./renderer_gl_api.btrc;
import ./librashader_gl.btrc;
import ./renderer_file_hash.btrc;
import ./renderer_layout.btrc;
import ./renderer_config.btrc;
import ./renderer_placement.btrc;
import ./renderer_dual_shell.btrc;
import ./renderer_mirror.btrc;
import ./renderer_scaled_lane.btrc;
int RGL_VERTEX_SHADER = 0x8B31;
int RGL_FRAGMENT_SHADER = 0x8B30;
int RGL_LINK_STATUS = 0x8B82;
int RGL_TRIANGLES = 0x0004;
int RGL_ZERO = 0;
int RGL_ONE = 1;
int RGL_SRC_ALPHA = 0x0302;
int RGL_ONE_MINUS_SRC_ALPHA = 0x0303;
int RGL_DST_COLOR = 0x0306;
int RGL_ONE_MINUS_SRC_COLOR = 0x0301;
int RGL_FUNC_ADD = 0x8006;

int SEMU_SHAPE_NONE = 0;
int SEMU_SHAPE_ROUNDED = 1;
int SEMU_SHAPE_SQUIRCLE = 2;
int SEMU_FIT_ASPECT = 0;
int SEMU_FIT_FILL = 1;
int SEMU_FIT_INTEGER = 2;

struct RendererCompositorSource {
    char* vertex;  // the two GLSL files under $SEMU_RENDER_COMPOSITOR_DIR, as last read
    char* fragment;
};

int RendererCompositorMissingReported = 0;  // survives resets, so a retried launch logs once

class RendererFallbackCompositor {  // the plain picture and the menu, when config/render cannot be read or compiled at launch
    class char* vertex() { return "#version 330 core\nvoid main(){vec2 p=vec2((gl_VertexID==1)?3.0:-1.0,(gl_VertexID==2)?3.0:-1.0);gl_Position=vec4(p,0.0,1.0);}\n"; }

    class char* fragment() {
        return "#version 330 core\nout vec4 frag;\nuniform sampler2D uGame;uniform sampler2D uGame2;uniform sampler2D uMenu;\nuniform vec4 uRect;uniform vec4 uRect2;uniform vec4 uFlags;uniform vec4 uRotation;uniform vec4 uMenuRect;uniform float uPass;uniform float uMenuOn;\nbool inside(vec2 p,vec4 r){return p.x>=r.x&&p.x<=r.x+r.z&&p.y>=r.y&&p.y<=r.y+r.w;}\nvec2 uv(vec2 p,vec4 r){return(p-r.xy)/r.zw;}\nvec2 rotatedUv(vec2 q,float r){if(r<0.5)return q;if(r<1.5)return vec2(1.0-q.y,q.x);if(r<2.5)return vec2(1.0-q.x,1.0-q.y);return vec2(q.y,1.0-q.x);}\nvoid main(){vec2 p=gl_FragCoord.xy;\n if(uPass>3.5)discard;\n if(uPass<0.5){frag=vec4(0.0,0.0,0.0,1.0);return;}\n if(uPass<1.5){if(inside(p,uRect)){frag=vec4(texture(uGame,rotatedUv(uv(p,uRect),uRotation.x)).rgb,1.0);return;}\n  if(uFlags.x>0.5&&inside(p,uRect2)){frag=vec4(texture(uGame2,rotatedUv(uv(p,uRect2),uRotation.y)).rgb,1.0);return;}discard;}\n if(uPass<2.5)discard;\n if(uMenuOn<0.5||!inside(p,uMenuRect))discard;vec2 q=uv(p,uMenuRect);q.y=1.0-q.y;frag=texture(uMenu,q);\n}\n";
    }

    class void use(struct RendererCompositorSource* source) {  // becomes the current text, so a fixed file reloads over it
        RendererCompositorFiles.discard(source);
        source->vertex = strdup(RendererFallbackCompositor.vertex());
        source->fragment = strdup(RendererFallbackCompositor.fragment());
        fprintf(stderr, "semu-renderer: config/render is missing or does not compile; drawing the plain fallback until it is fixed\n");
    }
}

class RendererCompositorFiles {
    class char* path(char* name) {  // $SEMU_RENDER_COMPOSITOR_DIR/<name>, malloc'd, or null without the directory
        char* dir = getenv("SEMU_RENDER_COMPOSITOR_DIR");
        if (dir == null || dir[0] == 0) { return null; }
        int length = (int)strlen(dir) + (int)strlen(name) + 2;
        char* full = (char*)malloc((size_t)length);
        if (full == null) { return null; }
        snprintf(full, (size_t)length, "%s/%s", dir, name);
        return full;
    }

    class char* read(char* name) {  // the whole file as text, malloc'd, or null
        char* full = RendererCompositorFiles.path(name);
        if (full == null) { return null; }
        FILE* file = fopen(full, "rb");
        free((void*)full);
        if (file == null) { return null; }
        if (fseek(file, 0L, SEEK_END) != 0) { fclose(file); return null; }
        int size = (int)ftell(file);
        if (size < 0 || size > 4000000 || fseek(file, 0L, SEEK_SET) != 0) { fclose(file); return null; }
        char* text = (char*)malloc((size_t)(size + 1));
        if (text == null) { fclose(file); return null; }
        int got = (int)fread(text, 1, (size_t)size, file);
        fclose(file);
        if (got != size) { free((void*)text); return null; }
        text[got] = 0;
        return text;
    }

    class bool load(struct RendererCompositorSource* source) {  // both files; true when something new was read
        char* vertex = RendererCompositorFiles.read("compositor.vert");
        char* fragment = RendererCompositorFiles.read("compositor.frag");
        if (vertex == null || fragment == null) {
            if (vertex != null) { free((void*)vertex); }
            if (fragment != null) { free((void*)fragment); }
            if (RendererCompositorMissingReported == 0) {
                char* dir = getenv("SEMU_RENDER_COMPOSITOR_DIR");
                fprintf(stderr, "semu-renderer: no compositor.vert/compositor.frag under %s\n", dir == null ? "(SEMU_RENDER_COMPOSITOR_DIR unset)" : dir);
                RendererCompositorMissingReported = 1;
            }
            return false;
        }
        bool changed = source->vertex == null || source->fragment == null
            || strcmp(source->vertex, vertex) != 0 || strcmp(source->fragment, fragment) != 0;
        if (!changed) { free((void*)vertex); free((void*)fragment); return false; }
        if (source->vertex != null) { free((void*)source->vertex); }
        if (source->fragment != null) { free((void*)source->fragment); }
        source->vertex = vertex;
        source->fragment = fragment;
        return true;
    }

    class void discard(struct RendererCompositorSource* source) {  // the last-read text, before the resources are cleared
        if (source->vertex != null) { free((void*)source->vertex); }
        if (source->fragment != null) { free((void*)source->fragment); }
        source->vertex = null;
        source->fragment = null;
    }
}

unsigned int RendererAssetReported = 0u;  // one bit per missing-asset reason, logged once per process
unsigned int RendererLayerReported = 0u;  // one bit per variant layer slot that would not load

struct RendererGlResources {
    long long compositor_checked_ms;  // last look at the compositor files for an edit
    int ready;
    unsigned long long owner_context_generation;
    unsigned int program;
    unsigned int vertex_array;
    unsigned int extraction_framebuffer;
    struct RendererGlAtomicTarget composition;
    unsigned int raw_textures[2];
    unsigned int shader_textures[2];
    unsigned int bezel_textures[4];
    unsigned int background_textures[4];
    unsigned int glass_textures[8];
    unsigned int menu_texture;
    int lane_native_width[2];
    int lane_native_height[2];
    int lane_output_width[2];
    int lane_output_height[2];
    int lane_shader_native_width[2];
    int lane_shader_native_height[2];
    int lane_shader_output_width[2];
    int lane_shader_output_height[2];
    unsigned long long lane_history[2];
    struct RendererPath lane_shader_presets[2];
    struct RendererPath lane_shader_failed[2];  // a preset that would not build or run here: logged once, never retried
    int art_width[4];
    int art_height[4];
    int art_loaded[4];
    unsigned int layer_textures[32];  // 4 variants x 8 layers
    int layer_loaded[32];
    int layer_width[32];
    int layer_height[32];
    int background_width[4];
    int background_height[4];
    int background_loaded[4];
    int glass_loaded[8];
    int shader_actual;
    int bezel_actual;
    char failure_reason[64];
    int uniform_game;
    int uniform_game2;
    int uniform_raw;   // the unshaded frames: their size is the source-pixel grid reflections average the shaded picture over
    int uniform_raw2;
    int uniform_bezel;
    int uniform_glass;
    int uniform_glass2;
    int uniform_background;
    int uniform_menu;
    int uniform_rect;
    int uniform_rect2;
    int uniform_tube;
    int uniform_tube2;
    int uniform_shape;
    int uniform_shape2;
    int uniform_fx;
    int uniform_fx2;
    int uniform_surround;
    int uniform_surround2;
    int uniform_reflect;
    int uniform_bezel_rect;
    int uniform_background_rect;
    int uniform_menu_rect;
    int uniform_flags;
    int uniform_frame;
    int uniform_frame_color;
    int uniform_ring_inner;
    int uniform_ring_inner2;
    int uniform_ring_outer;
    int uniform_ring_outer2;
    int uniform_ring_look;
    int uniform_ring_look2;
    int uniform_ring_reflect;
    int uniform_ring_reflect2;
    struct RendererCompositorSource compositor;  // the GLSL as files, re-read while running
    int uniform_ring_color;
    int uniform_ring_color2;
    int uniform_layer;
    int uniform_layer_tint;
    int uniform_bulge;
    int uniform_rotation;
    int uniform_pass;
    int uniform_menu_on;
    int variant_images;  // 1 once this context holds the config's bezel, layer, background and glass images
    int variant_images_stale;  // a live choice changed the config: reload those images, nothing else
    struct RendererScaledTextures scaled;  // each lane's picture above native, under a render scale
};

SemuLibrashaderOpenGLChain RendererShaderLane0;
SemuLibrashaderOpenGLChain RendererShaderLane1;



class RendererGeometry {
    class void fit(int areaX, int areaY, int areaWidth, int areaHeight,
                   int nativeWidth, int nativeHeight, float declaredAspect,
                   int integerScaling, struct RendererLaneGeometry* lane) {
        struct RendererPixelRect area;
        area.x = areaX;
        area.y = areaY;
        area.width = areaWidth;
        area.height = areaHeight;
        struct RendererPixelRect output;
        RendererCompositionContract.fit(&area, nativeWidth, nativeHeight,
            lane->rotation, declaredAspect, integerScaling, &output);
        lane->output_x = output.x;
        lane->output_y = output.y;
        lane->output_width = output.width;
        lane->output_height = output.height;
    }

    class void placeInTube(struct RendererLaneGeometry* lane, struct RendererScreenConfig* screen,
                           struct RendererPixelRect* tube, struct RendererPixelRect* image,
                           float declaredAspect, int integerScaling) {  // the game inside the calibrated image rectangle, else inside the inset opening
        RendererLayout.setTube(lane, tube->x, tube->y, tube->width, tube->height);
        int insetX = (int)(screen->inset * (float)(tube->width < tube->height ? tube->width : tube->height) + 0.5f);
        int areaX = tube->x + insetX;
        int areaY = tube->y + insetX;
        int areaWidth = tube->width - 2 * insetX;
        int areaHeight = tube->height - 2 * insetX;
        if (image != null && image->width > 0 && image->height > 0) {
            areaX = image->x;
            areaY = image->y;
            areaWidth = image->width;
            areaHeight = image->height;
        }
        if (areaWidth < 1 || areaHeight < 1) {
            areaX = tube->x;
            areaY = tube->y;
            areaWidth = tube->width;
            areaHeight = tube->height;
        }
        if (screen->fit == SEMU_FIT_FILL) {
            lane->output_x = areaX;
            lane->output_y = areaY;
            lane->output_width = areaWidth;
            lane->output_height = areaHeight;
            return;
        }
        int integer = screen->fit == SEMU_FIT_INTEGER ? 1 : 0;
        RendererGeometry.fit(areaX, areaY, areaWidth, areaHeight, lane->native_width, lane->native_height,
            declaredAspect, integer != 0 ? 1 : integerScaling, lane);
    }

    class void background(struct RendererCompositionGeometry* geometry, int areaWidth, int areaHeight,
                          int imageWidth, int imageHeight) {  // cover fit: the plate always fills the viewport
        if (imageWidth < 1 || imageHeight < 1) { return; }
        float horizontal = (float)areaWidth / (float)imageWidth;
        float vertical = (float)areaHeight / (float)imageHeight;
        float scale = horizontal > vertical ? horizontal : vertical;
        geometry->background_width = scale * (float)imageWidth;
        geometry->background_height = scale * (float)imageHeight;
        geometry->background_x = ((float)areaWidth - geometry->background_width) * 0.5f;
        geometry->background_y = ((float)areaHeight - geometry->background_height) * 0.5f;
    }

    class bool resolve(struct SemuRenderFrameGl* frame,
                       struct RendererConfig* config,
                       struct RendererGlResources* resources,
                       struct RendererCompositionGeometry* geometry) {
        if (frame == null || config == null || resources == null
            || geometry == null) { return false; }
        memset(geometry, 0, sizeof(struct RendererCompositionGeometry));
        geometry->lane_count = frame->surface_count;
        for (int index = 0; index < frame->surface_count; index++) {
            struct SemuRenderSurfaceGl* surface = &frame->surfaces[index];
            struct RendererLaneGeometry* lane = &geometry->lanes[index];
            lane->source_x = surface->x;
            lane->source_y = RendererFrameContract.sourceY(frame, surface);
            lane->source_width = surface->width;
            lane->source_height = surface->height;
            lane->native_width = surface->native_width;
            lane->native_height = surface->native_height;
            lane->rotation = surface->rotation;
            lane->origin = surface->origin;
            RendererRenderScaling.scaled(lane, config->render_scale.scale);  // above native, the picture the emulator drew is kept beside the native one
        }

        int areaWidth = frame->framebuffer_width;
        int areaHeight = frame->framebuffer_height;
        int variantIndex = config->active_variant;
        struct RendererVariantConfig* variant = RendererConfiguration.active(config);
        float singleAspect = frame->presentation_aspect > 0.01f ? frame->presentation_aspect : config->display_aspect;
        bool bezel = config->bezels_enabled != 0;
        bool fixed = variant->layout == SEMU_LAYOUT_FIXED;
        bool layered = variant->layer_count > 0 && variant->canvas_width > 0;
        if (bezel && fixed) {
            bool tubes = variant->screens[0].tube.set != 0 && (frame->surface_count < 2 || variant->screens[1].tube.set != 0);
            if ((resources->art_loaded[variantIndex] == 0 && !layered) || !tubes) { bezel = false; }  // a fixed bezel needs its plate or its layers, and its openings
        }
        if (bezel && resources->background_loaded[variantIndex] != 0) {
            RendererGeometry.background(geometry, areaWidth, areaHeight,
                resources->background_width[variantIndex], resources->background_height[variantIndex]);
        }
        int frameWidth = 0;
        if (bezel && variant->frame_set != 0) {
            frameWidth = (int)(variant->frame_width * (float)areaHeight + 0.5f);
            geometry->frame_width = (float)frameWidth;
            geometry->framed = 1;
        }
        if (bezel && fixed) {
            struct RendererCanvasRect canvas;
            int sourceWidth = layered ? variant->canvas_width : resources->art_width[variantIndex];
            int sourceHeight = layered ? variant->canvas_height : resources->art_height[variantIndex];
            bool dual = frame->surface_count == 2 && RendererDualShell.place(variant, geometry, config->placement, sourceWidth, sourceHeight, areaWidth, areaHeight, &canvas);  // DS and 3DS shells: both screens whole in every Fit state, the shell always drawn
            if (!dual) { RendererPlacement.canvas(frame, variant, config->placement, config->game_fractional_below, singleAspect, areaWidth, areaHeight, sourceWidth, sourceHeight, &canvas); }  // contained, covered, then at the placement's whole step
            geometry->bezel_x = canvas.x;
            geometry->bezel_y = canvas.y;
            geometry->bezel_width = canvas.width;
            geometry->bezel_height = canvas.height;
            for (int index = 0; index < frame->surface_count && !dual; index++) {
                struct RendererScreenConfig* screen = &variant->screens[index];
                struct RendererPixelRect tube;
                RendererCompositionContract.aperture(&canvas, screen->tube.x, screen->tube.y,
                    screen->tube.width, screen->tube.height, &tube);
                struct RendererPixelRect image;
                memset(&image, 0, sizeof(struct RendererPixelRect));
                if (screen->image.set != 0) {
                    RendererCompositionContract.aperture(&canvas, screen->image.x, screen->image.y,
                        screen->image.width, screen->image.height, &image);
                }
                RendererGeometry.placeInTube(&geometry->lanes[index], screen, &tube, &image,
                    frame->surface_count == 1 ? singleAspect : 0.0f, 0);  // a framed screen fills its picture rectangle; integer steps only without a bezel
            }
            return true;
        }
        if (frame->surface_count == 1) {
            RendererGeometry.fit(0, 0, areaWidth, areaHeight,
                geometry->lanes[0].native_width, geometry->lanes[0].native_height,
                singleAspect, config->integer_scaling, &geometry->lanes[0]);
            if (bezel && variant->frame_set != 0) {  // a computed single screen keeps room for its drawn frame
                RendererGeometry.fit(frameWidth, frameWidth, areaWidth - 2 * frameWidth, areaHeight - 2 * frameWidth,
                    geometry->lanes[0].native_width, geometry->lanes[0].native_height,
                    singleAspect, config->integer_scaling, &geometry->lanes[0]);
            }
            RendererLayout.tubeFromOutput(&geometry->lanes[0]);
            return true;
        }
        int layout = bezel ? variant->layout : (variant->layout == SEMU_LAYOUT_FIXED ? SEMU_LAYOUT_STACKED : variant->layout);
        if (layout == SEMU_LAYOUT_FIXED) { layout = SEMU_LAYOUT_STACKED; }
        int drawn = RendererLayout.computed(geometry, layout, areaWidth, areaHeight, bezel ? frameWidth : 0, config->dual_screen_gap);  // whole steps whatever integer_scaling says
        if (bezel && frameWidth > 0) { geometry->frame_width = (float)drawn; }  // the frame shrinks to the room the screens leave
        return true;
    }
}

class RendererResourceFailure {
    class void clear(struct RendererGlResources* resources) {
        if (resources == null) { return; }
        resources->failure_reason[0] = 0;
    }

    class int set(struct RendererGlResources* resources, int status,
                  char* reason) {
        if (resources != null) {
            snprintf(resources->failure_reason,
                sizeof(resources->failure_reason), "%s",
                reason == null ? "unknown" : reason);
        }
        return status;
    }
}

class RendererResources {
    class bool releaseCurrentContext(struct RendererGlApi* gl,
                                     struct RendererGlResources* resources,
                                     unsigned long long contextGeneration) {
        if (gl == null || resources == null || contextGeneration == 0ULL
                || (resources->owner_context_generation != 0ULL
                    && resources->owner_context_generation
                        != contextGeneration)) { return false; }
        for (int index = 0; index < 2; index++) {
            SemuLibrashaderOpenGLChain chain = index == 0
                ? RendererShaderLane0 : RendererShaderLane1;
            if (chain != null) {
                if (!chain.close(contextGeneration)) {
                    chain.abandonDestroyedContext();
                }
                chain = null;  // ARC releases the last reference
            }
            if (index == 0) { RendererShaderLane0 = null; }
            else { RendererShaderLane1 = null; }
        }
        if (gl->delete_textures != null) {
            gl->delete_textures(2, resources->raw_textures);
            gl->delete_textures(2, resources->shader_textures);
            gl->delete_textures(4, resources->bezel_textures);
            gl->delete_textures(4, resources->background_textures);
            gl->delete_textures(8, resources->glass_textures);
            gl->delete_textures(32, resources->layer_textures);
            gl->delete_textures(1, &resources->menu_texture);
            gl->delete_textures(1, &resources->composition.texture);
            RendererScaledLane.discard(gl, &resources->scaled);
        }
        if (gl->delete_framebuffers != null) {
            gl->delete_framebuffers(1, &resources->extraction_framebuffer);
            gl->delete_framebuffers(1, &resources->composition.framebuffer);
        }
        if (gl->delete_vertex_arrays != null) {
            gl->delete_vertex_arrays(1, &resources->vertex_array);
        }
        if (gl->delete_program != null && resources->program != 0u) {
            gl->delete_program(resources->program);
        }
        RendererCompositorFiles.discard(&resources->compositor);
        memset(resources, 0, sizeof(struct RendererGlResources));
        return true;
    }

    class void abandonDestroyedContext(struct RendererGlResources* resources) {
        if (resources == null) { return; }
        for (int index = 0; index < 2; index++) {
            SemuLibrashaderOpenGLChain chain = index == 0
                ? RendererShaderLane0 : RendererShaderLane1;
            if (chain != null) {
                chain.abandonDestroyedContext();
                chain = null;  // ARC releases the last reference
            }
            if (index == 0) { RendererShaderLane0 = null; }
            else { RendererShaderLane1 = null; }
        }
        RendererCompositorFiles.discard(&resources->compositor);  // the GL objects died with the context; the text did not
        memset(resources, 0, sizeof(struct RendererGlResources));
    }

    class bool current(struct RendererGlApi* gl,
                       struct RendererGlResources* resources,
                       unsigned long long contextGeneration) {
        if (gl == null || gl->is_program == null || resources == null) {
            return false;
        }
        bool programAlive = resources->program != 0u
            && gl->is_program(resources->program) != 0;
        return RendererContextContract.resourcesCurrent(
            resources->owner_context_generation, contextGeneration,
            resources->ready,
            resources->program, programAlive);
    }

    class void normalizeUnpack(struct RendererGlApi* gl) {
        gl->bind_buffer((unsigned int)RGL_PIXEL_UNPACK_BUFFER, 0);
        gl->pixel_store((unsigned int)RGL_UNPACK_SWAP_BYTES, 0);
        gl->pixel_store((unsigned int)RGL_UNPACK_LSB_FIRST, 0);
        gl->pixel_store((unsigned int)RGL_UNPACK_ROW_LENGTH, 0);
        gl->pixel_store((unsigned int)RGL_UNPACK_IMAGE_HEIGHT, 0);
        gl->pixel_store((unsigned int)RGL_UNPACK_SKIP_PIXELS, 0);
        gl->pixel_store((unsigned int)RGL_UNPACK_SKIP_ROWS, 0);
        gl->pixel_store((unsigned int)RGL_UNPACK_SKIP_IMAGES, 0);
        gl->pixel_store((unsigned int)RGL_UNPACK_ALIGNMENT, 1);
    }

    class void configureTexture(struct RendererGlApi* gl, unsigned int texture,
                                int filter) {
        gl->bind_texture((unsigned int)RGL_TEXTURE_2D, texture);
        gl->texture_parameter((unsigned int)RGL_TEXTURE_2D,
            (unsigned int)RGL_TEXTURE_BASE_LEVEL, 0);
        gl->texture_parameter((unsigned int)RGL_TEXTURE_2D,
            (unsigned int)RGL_TEXTURE_MAX_LEVEL, 0);
        gl->texture_parameter((unsigned int)RGL_TEXTURE_2D,
            (unsigned int)RGL_TEXTURE_MIN_FILTER, filter);
        gl->texture_parameter((unsigned int)RGL_TEXTURE_2D,
            (unsigned int)RGL_TEXTURE_MAG_FILTER, filter);
        gl->texture_parameter((unsigned int)RGL_TEXTURE_2D,
            (unsigned int)RGL_TEXTURE_WRAP_S, RGL_CLAMP_TO_EDGE);
        gl->texture_parameter((unsigned int)RGL_TEXTURE_2D,
            (unsigned int)RGL_TEXTURE_WRAP_T, RGL_CLAMP_TO_EDGE);
    }

    class void mipmap(struct RendererGlApi* gl) {  // the bound 2D texture: full chain, trilinear when minified
        gl->texture_parameter((unsigned int)RGL_TEXTURE_2D,
            (unsigned int)RGL_TEXTURE_MAX_LEVEL, 1000);
        gl->texture_parameter((unsigned int)RGL_TEXTURE_2D,
            (unsigned int)RGL_TEXTURE_MIN_FILTER, RGL_LINEAR_MIPMAP_LINEAR);
        gl->generate_mipmap((unsigned int)RGL_TEXTURE_2D);
    }

    class bool loadImage(struct RendererGlApi* gl, char* path,
                         unsigned int* texture, int* width, int* height) {
        if (path == null || path[0] == 0) { return false; }
        int channels = 0;
        unsigned char* pixels = stbi_load(path, width, height, &channels, 4);
        if (pixels == null) { return false; }
        if (*width < 1 || *height < 1) {
            stbi_image_free((void*)pixels);
            return false;
        }
        *texture = 0u;
        RendererGlErrors.clear(gl);
        gl->gen_textures(1, texture);
        bool textureAllocated = *texture != 0u;
        bool textureAllocationErrorFree = RendererGlErrors.none(gl);
        if (!textureAllocated || !textureAllocationErrorFree) {
            if (*texture != 0u) { gl->delete_textures(1, texture); }
            *texture = 0u;
            stbi_image_free((void*)pixels);
            return false;
        }
        RendererGlErrors.clear(gl);
        RendererResources.configureTexture(gl, *texture, RGL_LINEAR);
        RendererResources.normalizeUnpack(gl);
        gl->texture_image_2d((unsigned int)RGL_TEXTURE_2D, 0, RGL_RGBA8,
            *width, *height, 0, (unsigned int)RGL_RGBA,
            (unsigned int)RGL_UNSIGNED_BYTE, pixels);
        RendererResources.mipmap(gl);  // plates up to 4400 px shrink onto 1280x800 without aliasing
        bool uploaded = RendererGlErrors.none(gl);
        stbi_image_free((void*)pixels);
        if (!uploaded) {
            gl->delete_textures(1, texture);
            *texture = 0u;
        }
        return uploaded;
    }

    class void bindSamplers(struct RendererGlApi* gl, struct RendererGlResources* resources) {  // a program starts with every sampler on unit 0; every link needs this
        gl->use_program(resources->program);
        if (resources->uniform_game >= 0) { gl->uniform_1i(resources->uniform_game, 0); }
        if (resources->uniform_bezel >= 0) { gl->uniform_1i(resources->uniform_bezel, 1); }
        if (resources->uniform_glass >= 0) { gl->uniform_1i(resources->uniform_glass, 2); }
        if (resources->uniform_menu >= 0) { gl->uniform_1i(resources->uniform_menu, 3); }
        if (resources->uniform_game2 >= 0) { gl->uniform_1i(resources->uniform_game2, 4); }
        if (resources->uniform_glass2 >= 0) { gl->uniform_1i(resources->uniform_glass2, 5); }
        if (resources->uniform_background >= 0) { gl->uniform_1i(resources->uniform_background, 6); }
        if (resources->uniform_raw >= 0) { gl->uniform_1i(resources->uniform_raw, 7); }
        if (resources->uniform_raw2 >= 0) { gl->uniform_1i(resources->uniform_raw2, 8); }
    }

    class void lookupUniforms(struct RendererGlApi* gl, struct RendererGlResources* resources) {
        resources->uniform_game = RendererResources.uniform(gl, resources, "uGame");
        resources->uniform_game2 = RendererResources.uniform(gl, resources, "uGame2");
        resources->uniform_raw = RendererResources.uniform(gl, resources, "uRaw");
        resources->uniform_raw2 = RendererResources.uniform(gl, resources, "uRaw2");
        resources->uniform_bezel = RendererResources.uniform(gl, resources, "uBezel");
        resources->uniform_glass = RendererResources.uniform(gl, resources, "uGlass");
        resources->uniform_glass2 = RendererResources.uniform(gl, resources, "uGlass2");
        resources->uniform_background = RendererResources.uniform(gl, resources, "uBackground");
        resources->uniform_menu = RendererResources.uniform(gl, resources, "uMenu");
        resources->uniform_rect = RendererResources.uniform(gl, resources, "uRect");
        resources->uniform_rect2 = RendererResources.uniform(gl, resources, "uRect2");
        resources->uniform_tube = RendererResources.uniform(gl, resources, "uTube");
        resources->uniform_tube2 = RendererResources.uniform(gl, resources, "uTube2");
        resources->uniform_shape = RendererResources.uniform(gl, resources, "uShape");
        resources->uniform_shape2 = RendererResources.uniform(gl, resources, "uShape2");
        resources->uniform_fx = RendererResources.uniform(gl, resources, "uFx");
        resources->uniform_fx2 = RendererResources.uniform(gl, resources, "uFx2");
        resources->uniform_surround = RendererResources.uniform(gl, resources, "uSurround");
        resources->uniform_surround2 = RendererResources.uniform(gl, resources, "uSurround2");
        resources->uniform_reflect = RendererResources.uniform(gl, resources, "uReflect");
        resources->uniform_bezel_rect = RendererResources.uniform(gl, resources, "uBezelRect");
        resources->uniform_background_rect = RendererResources.uniform(gl, resources, "uBackgroundRect");
        resources->uniform_menu_rect = RendererResources.uniform(gl, resources, "uMenuRect");
        resources->uniform_flags = RendererResources.uniform(gl, resources, "uFlags");
        resources->uniform_frame = RendererResources.uniform(gl, resources, "uFrame");
        resources->uniform_frame_color = RendererResources.uniform(gl, resources, "uFrameColor");
        resources->uniform_ring_inner = RendererResources.uniform(gl, resources, "uRingIn");
        resources->uniform_ring_inner2 = RendererResources.uniform(gl, resources, "uRingIn2");
        resources->uniform_ring_outer = RendererResources.uniform(gl, resources, "uRingOut");
        resources->uniform_ring_outer2 = RendererResources.uniform(gl, resources, "uRingOut2");
        resources->uniform_ring_look = RendererResources.uniform(gl, resources, "uRingLook");
        resources->uniform_ring_look2 = RendererResources.uniform(gl, resources, "uRingLook2");
        resources->uniform_ring_reflect = RendererResources.uniform(gl, resources, "uRingReflect");
        resources->uniform_ring_reflect2 = RendererResources.uniform(gl, resources, "uRingReflect2");
        resources->uniform_ring_color = RendererResources.uniform(gl, resources, "uRingColor");
        resources->uniform_ring_color2 = RendererResources.uniform(gl, resources, "uRingColor2");
        resources->uniform_layer = RendererResources.uniform(gl, resources, "uLayer");
        resources->uniform_layer_tint = RendererResources.uniform(gl, resources, "uLayerTint");
        resources->uniform_bulge = RendererResources.uniform(gl, resources, "uBulge");
        resources->uniform_rotation = RendererResources.uniform(gl, resources, "uRotation");
        resources->uniform_pass = RendererResources.uniform(gl, resources, "uPass");
        resources->uniform_menu_on = RendererResources.uniform(gl, resources, "uMenuOn");
    }

    class void relinkIfChanged(struct RendererGlApi* gl, struct RendererGlResources* resources) {  // an edited compositor file replaces the program mid-game; a broken edit keeps the last good one
        if (!RendererCompositorFiles.load(&resources->compositor)) { return; }
        unsigned int vertex = RendererGlShader.compile(gl, (unsigned int)RGL_VERTEX_SHADER, resources->compositor.vertex);
        unsigned int fragment = vertex == 0u ? 0u : RendererGlShader.compile(gl, (unsigned int)RGL_FRAGMENT_SHADER, resources->compositor.fragment);
        if (vertex == 0u || fragment == 0u) {
            if (vertex != 0u) { gl->delete_shader(vertex); }
            fprintf(stderr, "semu-renderer: compositor shader edit does not compile, keeping the previous one\n");
            return;
        }
        unsigned int program = gl->create_program();
        if (program == 0u) { gl->delete_shader(vertex); gl->delete_shader(fragment); return; }
        gl->attach_shader(program, vertex);
        gl->attach_shader(program, fragment);
        gl->link_program(program);
        gl->delete_shader(vertex);
        gl->delete_shader(fragment);
        int linked = 0;
        gl->get_program_integer(program, (unsigned int)RGL_LINK_STATUS, &linked);
        if (linked == 0 || !RendererGlErrors.none(gl)) {
            RendererGlErrors.clear(gl);
            if (gl->delete_program != null) { gl->delete_program(program); }
            fprintf(stderr, "semu-renderer: compositor shader edit does not link, keeping the previous one\n");
            return;
        }
        if (gl->delete_program != null && resources->program != 0u) { gl->delete_program(resources->program); }
        resources->program = program;
        RendererResources.lookupUniforms(gl, resources);
        RendererResources.bindSamplers(gl, resources);
        fprintf(stderr, "semu-renderer: compositor shader reloaded\n");
    }

    class int uniform(struct RendererGlApi* gl, struct RendererGlResources* resources, char* name) {
        return gl->uniform_location(resources->program, name);
    }

    class bool initialize(struct RendererGlApi* gl,
                          struct RendererGlResources* resources,
                          struct RendererConfig* config,
                          unsigned long long contextGeneration) {
        if (gl == null || resources == null || config == null
                || contextGeneration == 0ULL) {
            return false;
        }
        if (resources->ready != 0 && RendererResources.current(
                gl, resources, contextGeneration)) { return true; }
        if (!RendererGlCapabilities.supported(gl)) { return false; }
        if (resources->ready != 0) {
            bool released = resources->owner_context_generation
                    == contextGeneration
                && RendererResources.releaseCurrentContext(
                    gl, resources, contextGeneration);
            if (!released) {
                RendererResources.abandonDestroyedContext(resources);
            }
        }
        resources->owner_context_generation = contextGeneration;
        RendererGlErrors.clear(gl);
        gl->gen_textures(2, resources->raw_textures);
        gl->gen_textures(2, resources->shader_textures);
        gl->gen_textures(1, &resources->menu_texture);
        gl->gen_textures(1, &resources->composition.texture);
        gl->gen_framebuffers(1, &resources->extraction_framebuffer);
        gl->gen_framebuffers(1, &resources->composition.framebuffer);
        gl->gen_vertex_arrays(1, &resources->vertex_array);
        bool allocated = resources->raw_textures[0] != 0u
            && resources->raw_textures[1] != 0u
            && resources->shader_textures[0] != 0u
            && resources->shader_textures[1] != 0u
            && resources->menu_texture != 0u
            && RendererGlAtomicComposition.allocated(&resources->composition)
            && resources->extraction_framebuffer != 0u
            && resources->vertex_array != 0u;
        bool allocationErrorFree = RendererGlErrors.none(gl);
        if (!allocated || !allocationErrorFree) {
            RendererResources.releaseCurrentContext(gl, resources,
                contextGeneration);
            return false;
        }
        RendererCompositorFiles.load(&resources->compositor);
        if (resources->compositor.vertex == null || resources->compositor.fragment == null) { RendererFallbackCompositor.use(&resources->compositor); }
        unsigned int vertex = RendererGlShader.compile(gl, (unsigned int)RGL_VERTEX_SHADER, resources->compositor.vertex);
        unsigned int fragment = vertex == 0u ? 0u : RendererGlShader.compile(gl, (unsigned int)RGL_FRAGMENT_SHADER, resources->compositor.fragment);
        if (vertex == 0u || fragment == 0u) {  // the files read but do not compile: the fallback still draws the game and the menu
            if (vertex != 0u) { gl->delete_shader(vertex); }
            RendererGlErrors.clear(gl);
            RendererFallbackCompositor.use(&resources->compositor);
            vertex = RendererGlShader.compile(gl, (unsigned int)RGL_VERTEX_SHADER, resources->compositor.vertex);
            fragment = vertex == 0u ? 0u : RendererGlShader.compile(gl, (unsigned int)RGL_FRAGMENT_SHADER, resources->compositor.fragment);
        }
        if (vertex == 0u || fragment == 0u) {
            if (vertex != 0u) { gl->delete_shader(vertex); }
            RendererResources.releaseCurrentContext(gl, resources,
                contextGeneration);
            return false;
        }
        resources->program = gl->create_program();
        bool programAllocated = resources->program != 0u;
        bool programAllocationErrorFree = RendererGlErrors.none(gl);
        if (!programAllocated || !programAllocationErrorFree) {
            gl->delete_shader(vertex);
            gl->delete_shader(fragment);
            RendererResources.releaseCurrentContext(gl, resources,
                contextGeneration);
            return false;
        }
        RendererGlErrors.clear(gl);
        gl->attach_shader(resources->program, vertex);
        gl->attach_shader(resources->program, fragment);
        gl->link_program(resources->program);
        gl->delete_shader(vertex);
        gl->delete_shader(fragment);
        int linked = 0;
        gl->get_program_integer(resources->program,
            (unsigned int)RGL_LINK_STATUS, &linked);
        if (linked == 0 || !RendererGlErrors.none(gl)) {
            RendererResources.releaseCurrentContext(gl, resources,
                contextGeneration);
            return false;
        }

        RendererResources.lookupUniforms(gl, resources);
        RendererResources.bindSamplers(gl, resources);
        if (!RendererGlErrors.none(gl)) {
            RendererResources.releaseCurrentContext(gl, resources,
                contextGeneration);
            return false;
        }
        resources->ready = 1;
        return true;
    }
}

class RendererShaderPasses {
    class SemuLibrashaderOpenGLChain lane(int index) {
        return index == 0 ? RendererShaderLane0 : RendererShaderLane1;
    }

    class void setLane(int index, SemuLibrashaderOpenGLChain lane) {
        if (index == 0) { RendererShaderLane0 = lane; }
        else { RendererShaderLane1 = lane; }
    }

    class void resetLane(int index, struct RendererGlResources* resources,
                         unsigned long long contextGeneration) {
        SemuLibrashaderOpenGLChain chain = RendererShaderPasses.lane(index);
        if (chain != null) {
            if (!chain.close(contextGeneration)) {
                chain.abandonDestroyedContext();
            }
            chain = null;  // ARC releases the last reference
        }
        RendererShaderPasses.setLane(index, null);
        resources->lane_history[index] = 0;
        resources->lane_shader_presets[index].value[0] = 0;
        resources->lane_shader_native_width[index] = 0;
        resources->lane_shader_native_height[index] = 0;
        resources->lane_shader_output_width[index] = 0;
        resources->lane_shader_output_height[index] = 0;
    }

    class bool presetAvailable(struct RendererConfig* config) {
        return RendererConfiguration.shaderAvailable(config);
    }

    class bool prepareTexture(struct RendererGlApi* gl, unsigned int texture,
                              int width, int height, bool resize, int filter) {
        RendererGlErrors.clear(gl);
        RendererResources.configureTexture(gl, texture, filter);
        if (resize) {
            RendererResources.normalizeUnpack(gl);
            gl->texture_image_2d((unsigned int)RGL_TEXTURE_2D, 0, RGL_RGBA8,
                width, height, 0, (unsigned int)RGL_RGBA,
                (unsigned int)RGL_UNSIGNED_BYTE, null);
        }
        return RendererGlErrors.none(gl);
    }

    class bool extract(struct RendererGlApi* gl,
                       struct RendererGlResources* resources,
                       struct SemuRenderFrameGl* frame,
                       struct RendererLaneGeometry* lane,
                       int index) {
        bool nativeChanged = resources->lane_native_width[index]
                != lane->native_width
            || resources->lane_native_height[index] != lane->native_height;
        bool outputChanged = resources->lane_output_width[index]
                != lane->output_width
            || resources->lane_output_height[index] != lane->output_height;
        gl->active_texture((unsigned int)RGL_TEXTURE0);
        gl->bind_sampler(0, 0);
        if (!RendererShaderPasses.prepareTexture(gl,
                resources->raw_textures[index], lane->native_width,
                lane->native_height, nativeChanged, RGL_NEAREST)  // the core's pixels: the unfiltered picture and the reflections' source-pixel grid
            || !RendererShaderPasses.prepareTexture(gl,
                resources->shader_textures[index], lane->output_width,
                lane->output_height, outputChanged, RGL_LINEAR)) {  // already screen-sized: only the curvature resamples it, and point sampling bends its scanlines into rings
            return false;
        }
        resources->lane_native_width[index] = lane->native_width;
        resources->lane_native_height[index] = lane->native_height;
        resources->lane_output_width[index] = lane->output_width;
        resources->lane_output_height[index] = lane->output_height;

        gl->bind_framebuffer((unsigned int)RGL_READ_FRAMEBUFFER, frame->framebuffer);
        gl->read_buffer(frame->color_buffer);
        gl->bind_framebuffer((unsigned int)RGL_DRAW_FRAMEBUFFER,
            resources->extraction_framebuffer);
        gl->framebuffer_texture_2d((unsigned int)RGL_DRAW_FRAMEBUFFER,
            (unsigned int)RGL_COLOR_ATTACHMENT0, (unsigned int)RGL_TEXTURE_2D,
            resources->raw_textures[index], 0);
        gl->draw_buffer((unsigned int)RGL_COLOR_ATTACHMENT0);
        if (gl->check_framebuffer((unsigned int)RGL_DRAW_FRAMEBUFFER)
                != (unsigned int)RGL_FRAMEBUFFER_COMPLETE) {
            return false;
        }
        gl->disable((unsigned int)RGL_SCISSOR_TEST);
        RendererGlErrors.clear(gl);
        if (lane->scaled_width > 0) {  // a render scale: the picture kept at its own size, the native one its box average
            if (!RendererScaledLane.capture(gl, &resources->scaled, resources->extraction_framebuffer, frame, lane, index)
                || !RendererScaledLane.native(gl, &resources->scaled, resources->extraction_framebuffer, resources->raw_textures[index], lane, index)) { return false; }
            gl->bind_texture((unsigned int)RGL_TEXTURE_2D, resources->raw_textures[index]);
            RendererResources.mipmap(gl);
            return RendererGlErrors.none(gl);
        }
        bool downscale = lane->source_width > lane->native_width || lane->source_height > lane->native_height;  // high-resolution emulators: average, never decimate
        gl->blit_framebuffer(lane->source_x, lane->source_y,
            lane->source_x + lane->source_width,
            lane->source_y + lane->source_height, 0, 0,
            lane->native_width, lane->native_height,
            (unsigned int)RGL_COLOR_BUFFER_BIT, (unsigned int)(downscale ? RGL_LINEAR : RGL_NEAREST));
        if (!RendererGlErrors.none(gl)) { return false; }
        gl->bind_texture((unsigned int)RGL_TEXTURE_2D, resources->raw_textures[index]);
        RendererResources.mipmap(gl);  // magnified stays point-sampled; minified, the mips average
        return RendererGlErrors.none(gl);
    }

    class bool render(struct RendererGlApi* gl,
                      struct RendererConfig* config,
                      struct RendererGlResources* resources,
                      struct SemuRenderFrameGl* frame,
                      struct RendererLaneGeometry* lane,
                      int index) {
        if (config->shaders_enabled == 0
            || !RendererShaderPasses.presetAvailable(config)) { return false; }
        char* preset = RendererConfiguration.lanePreset(config, index);
        if (preset == null || preset[0] == 0) { return false; }
        if (strcmp(resources->lane_shader_failed[index].value, preset) == 0) { return false; }
        SemuLibrashaderOpenGLChain chain = RendererShaderPasses.lane(index);
        bool presetChanged = resources->lane_shader_presets[index].value[0] != 0
            && strcmp(resources->lane_shader_presets[index].value, preset) != 0;
        bool dimensionsChanged = chain != null
            && (resources->lane_shader_native_width[index] != lane->native_width
                || resources->lane_shader_native_height[index] != lane->native_height
                || resources->lane_shader_output_width[index] != lane->output_width
                || resources->lane_shader_output_height[index]
                    != lane->output_height);
        if (presetChanged || dimensionsChanged) {
            RendererShaderPasses.resetLane(index, resources,
                frame->context_generation);
            chain = null;
        }
        if (chain == null) {
            void* loader = null;
            memcpy(&loader, &frame->get_proc, sizeof(loader));  // C11 forbids casting a function pointer to void*
            chain = new SemuLibrashaderOpenGLChain(loader, frame->context_generation);
            long long compileStarted = RendererClock.milliseconds();
            bool created = chain.create(preset, 330, false, false,
                false, true, true);  // librashader's disk cache on: a preset compiled once builds fast at the next switch or launch
            if (created && getenv("SEMU_RENDER_DEBUG") != null) { fprintf(stderr, "semu-renderer: shader chain for %s built in %lld ms\n", preset, RendererClock.milliseconds() - compileStarted); }
            if (!created) {
                fprintf(stderr, "semu-renderer: shader chain failed for %s (failure %d, library %d); the game runs unfiltered\n", preset, chain.lastFailure(), chain.lastLibraryErrorCode());
                chain.printLibraryError();
                snprintf(resources->lane_shader_failed[index].value, 4096, "%s", preset);
                chain = null;  // ARC releases the last reference
                return false;
            }
            RendererShaderPasses.setLane(index, chain);
            snprintf(resources->lane_shader_presets[index].value, 4096,
                "%s", preset);
        }
        unsigned int rotation = lane->rotation == 90 ? 1
            : (lane->rotation == 180 ? 2 : (lane->rotation == 270 ? 3 : 0));
        float aspect = (float)lane->native_width / (float)lane->native_height;
        int result = chain.render(resources->raw_textures[index], RGL_RGBA8,
            (unsigned int)lane->native_width, (unsigned int)lane->native_height,
            resources->shader_textures[index], RGL_RGBA8,
            (unsigned int)lane->output_width, (unsigned int)lane->output_height,
            (size_t)resources->lane_history[index], false, 1, rotation, aspect,
            config->frames_per_second, config->frame_delta_ms,
            frame->context_generation);
        if (result == SEMU_LIBRASHADER_RENDERED) {  // the mip chain holds each source pixel's light as displayed, which reflections mirror
            gl->active_texture((unsigned int)RGL_TEXTURE0);
            gl->bind_texture((unsigned int)RGL_TEXTURE_2D, resources->shader_textures[index]);
            RendererResources.mipmap(gl);
        }
        if (result != SEMU_LIBRASHADER_RENDERED
                || !RendererGlErrors.none(gl)) {
            fprintf(stderr, "semu-renderer: shader chain for %s stopped rendering; the game runs unfiltered\n", preset);
            snprintf(resources->lane_shader_failed[index].value, 4096, "%s", preset);
            RendererShaderPasses.resetLane(index, resources,
                frame->context_generation);
            return false;
        }
        resources->lane_shader_native_width[index] = lane->native_width;
        resources->lane_shader_native_height[index] = lane->native_height;
        resources->lane_shader_output_width[index] = lane->output_width;
        resources->lane_shader_output_height[index] = lane->output_height;
        resources->lane_history[index] = resources->lane_history[index] + 1;
        return true;
    }
}

class RendererAssetContract {  // a missing asset degrades the frame and is logged once; it never fails the phase
    class void missing(struct RendererGlResources* resources, int bit, char* reason) {
        RendererResourceFailure.set(resources, SEMU_RENDER_ASSET_MISSING, reason);
        if ((RendererAssetReported & (1u << bit)) != 0u) { return; }
        RendererAssetReported = RendererAssetReported | (1u << bit);
        fprintf(stderr, "semu-renderer: %s; drawing without it\n", reason);
    }

    class void report(struct RendererConfig* config,
                      struct RendererGlResources* resources,
                      int surfaceCount) {
        RendererResourceFailure.clear(resources);
        struct RendererVariantConfig* variant = RendererConfiguration.active(config);
        int selected = config->active_variant;
        if (config->shaders_enabled != 0 && !RendererShaderPasses.presetAvailable(config)) {
            RendererAssetContract.missing(resources, 0, "shader_preset_missing");
        }
        if (config->bezels_enabled != 0 && variant->layout == SEMU_LAYOUT_FIXED) {
            bool layered = variant->layer_count > 0 && variant->canvas_width > 0;
            if (!layered && (variant->art.value[0] == 0 || resources->art_loaded[selected] == 0)) {
                RendererAssetContract.missing(resources, 1, "bezel_art_missing");
            }
            bool tubes = variant->screens[0].tube.set != 0 && (surfaceCount < 2 || variant->screens[1].tube.set != 0);
            if (!tubes) {
                RendererAssetContract.missing(resources, 2, "bezel_aperture_missing");
            }
            for (int lane = 0; lane < surfaceCount; lane++) {
                if (variant->screens[lane].glass.value[0] != 0 && resources->glass_loaded[selected * 2 + lane] == 0) {
                    RendererAssetContract.missing(resources, 3, "bezel_glass_missing");
                }
            }
        }
        if (config->bezels_enabled != 0 && variant->background.value[0] != 0 && resources->background_loaded[selected] == 0) {
            RendererAssetContract.missing(resources, 4, "bezel_background_missing");
        }
    }

    class void layerFailed(struct RendererLayerConfig* layer, int slot) {  // an unreadable layer is skipped; the rest of the stack draws
        if ((RendererLayerReported & (1u << slot)) != 0u) { return; }
        RendererLayerReported = RendererLayerReported | (1u << slot);
        fprintf(stderr, "semu-renderer: layer %s did not load; it is skipped\n", layer->file.value);
    }
}

class RendererCompositor {
    class bool fullFramebufferState(struct RendererGlApi* gl,
                                    struct SemuRenderFrameGl* frame) {
        int viewport[4] = {0, 0, 0, 0};
        gl->get_integer((unsigned int)RGL_VIEWPORT, viewport);
        return viewport[0] == 0 && viewport[1] == 0
            && viewport[2] == frame->framebuffer_width
            && viewport[3] == frame->framebuffer_height
            && gl->is_enabled((unsigned int)RGL_SCISSOR_TEST) == 0;
    }

    class void setRect(struct RendererGlApi* gl, int location,
                       int x, int y, int width, int height) {
        if (location >= 0) {
            gl->uniform_4f(location, (float)x, (float)y, (float)width, (float)height);
        }
    }

    class void set4(struct RendererGlApi* gl, int location, float a, float b, float c, float d) {
        if (location >= 0) { gl->uniform_4f(location, a, b, c, d); }
    }

    class void drawLayers(struct RendererGlApi* gl, struct RendererGlResources* resources,
                          struct RendererVariantConfig* variant, struct RendererCompositionGeometry* geometry,
                          int variantIndex, struct SemuRenderFrameGl* frame, bool above) {  // each layer as one textured quad through the layer pass
        struct RendererCanvasRect canvas;
        canvas.x = geometry->bezel_x;
        canvas.y = geometry->bezel_y;
        canvas.width = geometry->bezel_width;
        canvas.height = geometry->bezel_height;
        for (int index = 0; index < variant->layer_count; index++) {
            struct RendererLayerConfig* layer = &variant->layers[index];
            int slot = variantIndex * 8 + index;
            if ((layer->above != 0) != above || resources->layer_loaded[slot] == 0 || layer->opacity <= 0.0f) { continue; }
            float x = 0.0f;
            float y = 0.0f;
            float width = 0.0f;
            float height = 0.0f;
            if (layer->cover != 0) {  // cover-fit like the background plate
                float horizontal = (float)frame->framebuffer_width / (float)resources->layer_width[slot];
                float vertical = (float)frame->framebuffer_height / (float)resources->layer_height[slot];
                float scale = horizontal > vertical ? horizontal : vertical;
                width = scale * (float)resources->layer_width[slot];
                height = scale * (float)resources->layer_height[slot];
                x = ((float)frame->framebuffer_width - width) * 0.5f;
                y = ((float)frame->framebuffer_height - height) * 0.5f;
            } else {
                struct RendererPixelRect rect;
                RendererCompositionContract.aperture(&canvas, layer->rect.x, layer->rect.y, layer->rect.width, layer->rect.height, &rect);
                x = (float)rect.x;
                y = (float)rect.y;
                width = (float)rect.width;
                height = (float)rect.height;
            }
            if (width <= 0.0f || height <= 0.0f) { continue; }
            gl->active_texture((unsigned int)(RGL_TEXTURE0 + 1));
            gl->bind_sampler(1, 0);
            gl->bind_texture((unsigned int)RGL_TEXTURE_2D, resources->layer_textures[slot]);
            gl->active_texture((unsigned int)RGL_TEXTURE0);
            if (resources->uniform_bezel_rect >= 0) { gl->uniform_4f(resources->uniform_bezel_rect, x, y, width, height); }
            RendererCompositor.set4(gl, resources->uniform_layer, layer->opacity, (float)layer->blend, layer->lift, layer->room != 0 ? 1.0f : 0.0f);  // w: the room carries on past its rectangle
            RendererCompositor.set4(gl, resources->uniform_layer_tint, layer->tint[0], layer->tint[1], layer->tint[2], layer->tint[3]);
            gl->enable((unsigned int)RGL_BLEND);
            if (layer->blend == 1) {
                gl->blend_function_separate((unsigned int)RGL_SRC_ALPHA, (unsigned int)RGL_ONE, (unsigned int)RGL_ZERO, (unsigned int)RGL_ONE);  // add: black adds nothing
            } else if (layer->blend == 2) {
                gl->blend_function_separate((unsigned int)RGL_DST_COLOR, (unsigned int)RGL_ONE_MINUS_SRC_ALPHA, (unsigned int)RGL_ZERO, (unsigned int)RGL_ONE);  // multiply
            } else {
                gl->blend_function_separate((unsigned int)RGL_SRC_ALPHA, (unsigned int)RGL_ONE_MINUS_SRC_ALPHA, (unsigned int)RGL_SRC_ALPHA, (unsigned int)RGL_ONE_MINUS_SRC_ALPHA);
            }
            gl->blend_equation_separate((unsigned int)RGL_FUNC_ADD, (unsigned int)RGL_FUNC_ADD);
            if (resources->uniform_pass >= 0) { gl->uniform_1f(resources->uniform_pass, (float)SEMU_RENDER_PASS_LAYER); }
            gl->draw_arrays((unsigned int)RGL_TRIANGLES, 0, 3);
        }
        if (resources->uniform_bezel_rect >= 0) {
            gl->uniform_4f(resources->uniform_bezel_rect, geometry->bezel_x, geometry->bezel_y, geometry->bezel_width, geometry->bezel_height);
        }
    }

    class bool paintedLens(struct RendererVariantConfig* variant, struct RendererCompositionGeometry* geometry) {  // a screen whose ring only marks a painted lens and reflects
        for (int index = 0; index < geometry->lane_count && index < 2; index++) {
            struct RendererScreenConfig* screen = &variant->screens[index];
            if (screen->look_set != 0 && screen->ring_set != 0 && screen->ring_opacity <= 0.0f && screen->ring_reflect > 0.0f) { return true; }
        }
        return false;
    }

    class void drawLensMirror(struct RendererGlApi* gl, struct RendererGlResources* resources) {  // screen blend: the plate stays, the mirror lightens it
        gl->enable((unsigned int)RGL_BLEND);
        gl->blend_function_separate((unsigned int)RGL_ONE, (unsigned int)RGL_ONE_MINUS_SRC_COLOR, (unsigned int)RGL_ZERO, (unsigned int)RGL_ONE);
        gl->blend_equation_separate((unsigned int)RGL_FUNC_ADD, (unsigned int)RGL_FUNC_ADD);
        if (resources->uniform_pass >= 0) { gl->uniform_1f(resources->uniform_pass, (float)SEMU_RENDER_PASS_LENS); }
        gl->draw_arrays((unsigned int)RGL_TRIANGLES, 0, 3);
    }

    class void drawPass(struct RendererGlApi* gl,
                        struct RendererGlResources* resources,
                        int pass, bool blend) {
        if (blend) {
            gl->enable((unsigned int)RGL_BLEND);
            gl->blend_function_separate((unsigned int)RGL_SRC_ALPHA,
                (unsigned int)RGL_ONE_MINUS_SRC_ALPHA,
                (unsigned int)RGL_SRC_ALPHA,
                (unsigned int)RGL_ONE_MINUS_SRC_ALPHA);
            gl->blend_equation_separate((unsigned int)RGL_FUNC_ADD,
                (unsigned int)RGL_FUNC_ADD);
        } else {
            gl->disable((unsigned int)RGL_BLEND);
        }
        if (resources->uniform_pass >= 0) {
            gl->uniform_1f(resources->uniform_pass, (float)pass);
        }
        gl->draw_arrays((unsigned int)RGL_TRIANGLES, 0, 3);
    }

    class void laneUniforms(struct RendererGlApi* gl, struct RendererGlResources* resources,
                            struct RendererScreenConfig* screen, struct RendererLaneGeometry* lane,
                            struct RendererCompositionGeometry* geometry,
                            bool bezel, int index) {  // without a bezel the screen is a plain rectangle: the look belongs to the bezel
        bool look = bezel && screen->look_set != 0;
        struct RendererPixelRect inner;
        struct RendererPixelRect outer;
        memset(&inner, 0, sizeof(struct RendererPixelRect));
        memset(&outer, 0, sizeof(struct RendererPixelRect));
        if (look && screen->ring_set != 0 && geometry->bezel_width > 0.0f) {
            struct RendererCanvasRect canvas;
            canvas.x = geometry->bezel_x;
            canvas.y = geometry->bezel_y;
            canvas.width = geometry->bezel_width;
            canvas.height = geometry->bezel_height;
            RendererMirror.ring(screen, &canvas, lane, &inner, &outer);  // a whole-step screen past its picture rectangle (the 3DS touch screen on the Deck) carries its lip out with it: the declared width round the picture drawn, never a pixel masked
        }
        bool ring = RendererMirror.ringShown(screen, bezel, &outer, geometry->bezel_width);
        RendererCompositor.setRect(gl, index == 0 ? resources->uniform_ring_inner : resources->uniform_ring_inner2, inner.x, inner.y, inner.width, inner.height);
        RendererCompositor.setRect(gl, index == 0 ? resources->uniform_ring_outer : resources->uniform_ring_outer2, outer.x, outer.y, outer.width, outer.height);
        RendererCompositor.set4(gl, index == 0 ? resources->uniform_ring_look : resources->uniform_ring_look2,
            screen->ring_inner_radius, screen->ring_outer_radius, ring ? 1.0f : 0.0f, screen->ring_bevel);
        RendererCompositor.set4(gl, index == 0 ? resources->uniform_ring_color : resources->uniform_ring_color2,
            screen->ring_r, screen->ring_g, screen->ring_b, screen->ring_opacity);
        RendererCompositor.set4(gl, index == 0 ? resources->uniform_ring_reflect : resources->uniform_ring_reflect2,
            RendererMirror.strength(screen, bezel, ring, geometry->framed), screen->ring_reflect_blur, screen->ring_reflect_fade, 0.0f);  // the reflection lands on a ring band or a drawn frame
        RendererCompositor.setRect(gl, index == 0 ? resources->uniform_rect : resources->uniform_rect2,
            lane->output_x, lane->output_y, lane->output_width, lane->output_height);
        RendererCompositor.setRect(gl, index == 0 ? resources->uniform_tube : resources->uniform_tube2,
            lane->tube_x, lane->tube_y, lane->tube_width, lane->tube_height);
        RendererCompositor.set4(gl, index == 0 ? resources->uniform_shape : resources->uniform_shape2,
            look ? (float)screen->shape : 0.0f, look ? screen->radius : 0.0f, look ? screen->exponent : 2.0f, 0.0f);
        RendererCompositor.set4(gl, index == 0 ? resources->uniform_fx : resources->uniform_fx2,
            look ? screen->curvature : 0.0f, look ? screen->vignette : 0.0f, look ? screen->bloom : 0.0f, 0.0f);
        RendererCompositor.set4(gl, index == 0 ? resources->uniform_surround : resources->uniform_surround2,
            look ? screen->surround_r : 0.0f, look ? screen->surround_g : 0.0f, look ? screen->surround_b : 0.0f, 1.0f);
    }

    class int game(struct RendererGlApi* gl,
                   struct RendererGlResources* resources,
                   struct RendererConfig* config,
                   struct SemuRenderFrameGl* frame,
                   struct RendererCompositionGeometry* geometry) {
        int filtered[2] = {0, 0};
        resources->shader_actual = 0;
        resources->bezel_actual = 0;
        RendererAssetContract.report(config, resources, geometry->lane_count);
        bool shaderRequested = config->shaders_enabled != 0;
        for (int index = 0; index < geometry->lane_count; index++) {
            if (!RendererShaderPasses.extract(gl, resources, frame,
                    &geometry->lanes[index], index)) {
                return RendererResourceFailure.set(resources,
                    SEMU_RENDER_PIPELINE_FAILED, "surface_extract_failed");
            }
            if (shaderRequested && RendererShaderPasses.render(gl, config, resources, frame, &geometry->lanes[index], index)) { filtered[index] = 1; }  // a failed chain leaves this lane unfiltered, never the frame bare
        }
        resources->shader_actual = filtered[0] != 0 ? 1 : 0;

        if (!RendererGlAtomicComposition.prepare(gl, &resources->composition,
                frame->framebuffer_width, frame->framebuffer_height)) {
            resources->shader_actual = 0;
            return RendererResourceFailure.set(resources,
                SEMU_RENDER_PIPELINE_FAILED, "composition_target_failed");
        }

        int variantIndex = config->active_variant;
        struct RendererVariantConfig* variant = RendererConfiguration.active(config);
        int second = geometry->lane_count > 1 ? 1 : 0;
        unsigned int pictures[2];  // what an unshaded lane draws and mirrors: the picture above native when one is kept, else the native one
        for (int index = 0; index < 2; index++) {
            int lane = index < geometry->lane_count ? index : second;
            pictures[index] = geometry->lanes[lane].scaled_width > 0 ? resources->scaled.textures[lane] : resources->raw_textures[lane];
        }
        RendererGlErrors.clear(gl);
        gl->active_texture((unsigned int)RGL_TEXTURE0);
        gl->bind_sampler(0, 0);
        gl->bind_texture((unsigned int)RGL_TEXTURE_2D, filtered[0] != 0
            ? resources->shader_textures[0] : pictures[0]);
        gl->active_texture((unsigned int)(RGL_TEXTURE0 + 4));
        gl->bind_sampler(4, 0);
        gl->bind_texture((unsigned int)RGL_TEXTURE_2D, filtered[second] != 0
            ? resources->shader_textures[second] : pictures[1]);
        gl->active_texture((unsigned int)(RGL_TEXTURE0 + 1));
        gl->bind_sampler(1, 0);
        gl->bind_texture((unsigned int)RGL_TEXTURE_2D,
            resources->bezel_textures[variantIndex]);
        gl->active_texture((unsigned int)(RGL_TEXTURE0 + 2));
        gl->bind_sampler(2, 0);
        gl->bind_texture((unsigned int)RGL_TEXTURE_2D,
            resources->glass_textures[variantIndex * 2]);
        gl->active_texture((unsigned int)(RGL_TEXTURE0 + 5));
        gl->bind_sampler(5, 0);
        gl->bind_texture((unsigned int)RGL_TEXTURE_2D,
            resources->glass_textures[variantIndex * 2 + 1]);
        gl->active_texture((unsigned int)(RGL_TEXTURE0 + 6));
        gl->bind_sampler(6, 0);
        gl->bind_texture((unsigned int)RGL_TEXTURE_2D,
            resources->background_textures[variantIndex]);
        gl->active_texture((unsigned int)(RGL_TEXTURE0 + 7));  // the raw frames give the source-pixel size: reflections mirror the shaded picture one source pixel wide, its colour without the mask and scanlines
        gl->bind_sampler(7, 0);
        gl->bind_texture((unsigned int)RGL_TEXTURE_2D, filtered[0] != 0 ? resources->raw_textures[0] : pictures[0]);  // an unshaded picture above native mirrors from its own pixels
        gl->active_texture((unsigned int)(RGL_TEXTURE0 + 8));
        gl->bind_sampler(8, 0);
        gl->bind_texture((unsigned int)RGL_TEXTURE_2D, filtered[second] != 0 ? resources->raw_textures[second] : pictures[1]);

        gl->disable((unsigned int)RGL_DEPTH_TEST);
        gl->disable((unsigned int)RGL_SCISSOR_TEST);
        gl->disable((unsigned int)RGL_CULL_FACE);
        gl->disable((unsigned int)RGL_STENCIL_TEST);
        gl->disable((unsigned int)RGL_MULTISAMPLE);
        gl->disable((unsigned int)RGL_FRAMEBUFFER_SRGB);
        gl->color_mask(1, 1, 1, 1);
        gl->depth_mask(0);
        gl->stencil_mask_separate((unsigned int)RGL_FRONT, 0xffffffffu);
        gl->stencil_mask_separate((unsigned int)RGL_BACK, 0xffffffffu);
        gl->viewport(0, 0, frame->framebuffer_width, frame->framebuffer_height);
        if (!RendererCompositor.fullFramebufferState(gl, frame)) {
            return RendererResourceFailure.set(resources,
                SEMU_RENDER_PIPELINE_FAILED, "framebuffer_state_invalid");
        }
        long long nowMs = RendererClock.milliseconds();
        if (nowMs - resources->compositor_checked_ms >= 1000LL) { resources->compositor_checked_ms = nowMs; RendererResources.relinkIfChanged(gl, resources); }  // the files are data: an edit shows within a second
        gl->use_program(resources->program);
        gl->bind_vertex_array(resources->vertex_array);

        bool bezel = config->bezels_enabled != 0;
        bool layered = bezel && variant->layout == SEMU_LAYOUT_FIXED && variant->layer_count > 0 && variant->canvas_width > 0
            && geometry->bezel_width > 0.0f && geometry->bezel_height > 0.0f;
        bool art = bezel && variant->layout == SEMU_LAYOUT_FIXED && !layered
            && resources->art_loaded[variantIndex] != 0
            && geometry->bezel_width > 0.0f && geometry->bezel_height > 0.0f;
        bool background = bezel && resources->background_loaded[variantIndex] != 0
            && geometry->background_width > 0.0f;
        bool framed = bezel && geometry->framed != 0;
        resources->bezel_actual = (art || framed) ? 1 : 0;
        for (int index = 0; index < 2; index++) {
            int lane = index < geometry->lane_count ? index : second;
            RendererCompositor.laneUniforms(gl, resources, &variant->screens[lane], &geometry->lanes[lane], geometry, bezel, index);
        }
        float rotation0 = filtered[0] != 0 ? 0.0f : (float)geometry->lanes[0].rotation / 90.0f;
        float rotation1 = filtered[second] != 0 ? 0.0f : (float)geometry->lanes[second].rotation / 90.0f;
        RendererCompositor.set4(gl, resources->uniform_rotation, rotation0, rotation1, 0.0f, 0.0f);
        bool glass0 = bezel && resources->glass_loaded[variantIndex * 2] != 0 && variant->screens[0].look_set != 0;
        bool glass1 = bezel && geometry->lane_count > 1 && resources->glass_loaded[variantIndex * 2 + 1] != 0 && variant->screens[1].look_set != 0;
        RendererCompositor.set4(gl, resources->uniform_reflect,
            glass0 ? variant->screens[0].reflect : 0.0f, glass1 ? variant->screens[1].reflect : 0.0f,
            glass0 ? 1.0f : 0.0f, glass1 ? 1.0f : 0.0f);
        if (resources->uniform_bezel_rect >= 0) {
            gl->uniform_4f(resources->uniform_bezel_rect, geometry->bezel_x,
                geometry->bezel_y, geometry->bezel_width, geometry->bezel_height);
        }
        if (resources->uniform_background_rect >= 0) {
            gl->uniform_4f(resources->uniform_background_rect, geometry->background_x,
                geometry->background_y, geometry->background_width, geometry->background_height);
        }
        RendererCompositor.set4(gl, resources->uniform_flags,
            geometry->lane_count > 1 ? 1.0f : 0.0f, art ? 1.0f : 0.0f, background ? 1.0f : 0.0f, layered ? 1.0f : 0.0f);
        RendererCompositor.set4(gl, resources->uniform_frame,
            geometry->frame_width, framed ? (float)geometry->framed : 0.0f, 0.0f, 0.0f);  // width, then whether a frame is drawn
        RendererCompositor.set4(gl, resources->uniform_frame_color,
            variant->frame_r, variant->frame_g, variant->frame_b, 1.0f);
        RendererCompositor.set4(gl, resources->uniform_bulge,
            bezel ? variant->screens[0].bulge_x : 0.0f, bezel ? variant->screens[0].bulge_y : 0.0f,
            bezel ? variant->screens[second].bulge_x : 0.0f, bezel ? variant->screens[second].bulge_y : 0.0f);
        if (resources->uniform_menu_on >= 0) {
            gl->uniform_1f(resources->uniform_menu_on, 0.0f);
        }
        RendererCompositor.drawPass(gl, resources,
            SEMU_RENDER_PASS_BACKGROUND, false);
        if (layered) { RendererCompositor.drawLayers(gl, resources, variant, geometry, variantIndex, frame, false); }  // the stack under the screens, in its own order
        if (layered && RendererCompositor.paintedLens(variant, geometry)) { RendererCompositor.drawLensMirror(gl, resources); }  // an unfilled ring marks a lens painted on the plate
        if (art || framed) {
            RendererCompositor.drawPass(gl, resources,
                SEMU_RENDER_PASS_CHROME, true);  // plate and frames first, so the screen edge blends over them
        }
        RendererCompositor.drawPass(gl, resources,
            SEMU_RENDER_PASS_GAME, true);  // alpha carries the screen shape mask
        if (layered) {
            RendererCompositor.drawLayers(gl, resources, variant, geometry, variantIndex, frame, true);  // glass, top plates and lights over the screens
            gl->active_texture((unsigned int)(RGL_TEXTURE0 + 1));
            gl->bind_texture((unsigned int)RGL_TEXTURE_2D, resources->bezel_textures[variantIndex]);
            gl->active_texture((unsigned int)RGL_TEXTURE0);
        }
        bool drew = RendererGlErrors.none(gl);
        if (getenv("SEMU_RENDER_DEBUG") != null && (frame->frame_id % 120ULL) == 1ULL) {
            struct RendererLaneGeometry* lane0 = &geometry->lanes[0];
            fprintf(stderr, "semu-renderer: frame %llu bezel %s fb %dx%d lane0 out %d,%d %dx%d tube %d,%d %dx%d native %dx%d scaled %dx%d source %dx%d art=%d bg=%d framed=%d bezelrect %.0f,%.0f %.0fx%.0f shaders=%d drew=%d\n",
                frame->frame_id, variant->bezel_id.value[0] != 0 ? variant->bezel_id.value : "none",
                frame->framebuffer_width, frame->framebuffer_height,
                lane0->output_x, lane0->output_y, lane0->output_width, lane0->output_height,
                lane0->tube_x, lane0->tube_y, lane0->tube_width, lane0->tube_height,
                lane0->native_width, lane0->native_height, lane0->scaled_width, lane0->scaled_height, lane0->source_width, lane0->source_height, art ? 1 : 0, background ? 1 : 0, framed ? 1 : 0,
                geometry->bezel_x, geometry->bezel_y, geometry->bezel_width, geometry->bezel_height,
                resources->shader_actual, drew ? 1 : 0);
            if (geometry->lane_count == 2) {  // the second screen: tests/visual/reflection-audit.sh measures each screen's mirror against its own picture
                struct RendererLaneGeometry* lane1 = &geometry->lanes[1];
                fprintf(stderr, "semu-renderer: frame %llu lane1 out %d,%d %dx%d tube %d,%d %dx%d native %dx%d\n",
                    frame->frame_id, lane1->output_x, lane1->output_y, lane1->output_width, lane1->output_height,
                    lane1->tube_x, lane1->tube_y, lane1->tube_width, lane1->tube_height, lane1->native_width, lane1->native_height);
            }
        }
        if (!drew) {
            resources->shader_actual = 0;
            resources->bezel_actual = 0;
            return RendererResourceFailure.set(resources,
                SEMU_RENDER_PIPELINE_FAILED, "composition_draw_failed");
        }
        if (!RendererGlAtomicComposition.commit(gl, &resources->composition,
                frame->framebuffer, frame->color_buffer,
                frame->framebuffer_width, frame->framebuffer_height)) {
            resources->shader_actual = 0;
            resources->bezel_actual = 0;
            return RendererResourceFailure.set(resources,
                SEMU_RENDER_PIPELINE_FAILED, "composition_commit_failed");
        }
        return SEMU_RENDER_APPLIED;
    }
}
