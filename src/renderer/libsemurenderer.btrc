// Direct emulator-owned OpenGL renderer. Render entrypoints publish an
// immutable pointer-map callback; no display discovery or input polling exists.

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

import ./renderer_abi.btrc;
import ./renderer_gl_api.btrc;
import ./renderer_config.btrc;
import ./renderer_variants.btrc;
import ./renderer_live_switch.btrc;
import ./renderer_compositor.btrc;
import ./renderer_variant_images.btrc;
import ./renderer_menu.btrc;
import ./renderer_cursor.btrc;
import ./renderer_post_ui.btrc;
import ./renderer_frame_timing.btrc;
int semu_render_map_pointer_abi3(struct SemuRenderPointerMap* map,
                                 struct SemuRenderPointerQuery* query,
                                 struct SemuRenderPointerResult* result) {
    return RendererPointerContract.map(map, query, result);
}

struct SemuRendererRuntime {
    int initialized;
    int gl_loaded;
    unsigned long long owner_context_generation;
    unsigned long long last_frame_id;
    int game_failure_status;
    int post_failure_status;
    long long initialize_retry_ms;  // a failed initialize waits until then before trying again
    long long initialize_backoff_ms;  // doubles per failure from one second to eight
    struct RendererGlApi gl;
    struct RendererGlState game_state;
    struct RendererGlState post_state;
    struct RendererConfig config;
    struct RendererGlResources resources;
    struct RendererCompositionGeometry geometry;
    struct SemuRenderPendingFrame pending;
    struct RendererPostUiState post_ui;
    struct RendererLiveChoice live;  // the variants-file section a select applied; a context reset keeps it
    long long switch_started_ms;  // a switch this frame: when it began, 0 otherwise
    long long switch_images_ms;
    struct RendererCursorState cursor;  // the touch cursor follows the frame's pointer sample
};

struct SemuRendererRuntime SemuRenderer;

class SemuRendererLifecycle {
    class void reset(bool contextIsCurrent,
                     unsigned long long contextGeneration) {
        if (contextIsCurrent) {
            RendererResources.releaseCurrentContext(&SemuRenderer.gl,
                &SemuRenderer.resources, contextGeneration);
        } else {
            RendererResources.abandonDestroyedContext(&SemuRenderer.resources);
        }
        SemuRenderer.gl_loaded = 0;
        SemuRenderer.owner_context_generation = 0ULL;
        SemuRenderer.last_frame_id = 0ULL;
        memset(&SemuRenderer.gl, 0, sizeof(struct RendererGlApi));
        memset(&SemuRenderer.game_state, 0, sizeof(struct RendererGlState));
        memset(&SemuRenderer.post_state, 0, sizeof(struct RendererGlState));
        memset(&SemuRenderer.config, 0, sizeof(struct RendererConfig));
        memset(&SemuRenderer.geometry, 0,
            sizeof(struct RendererCompositionGeometry));
        memset(&SemuRenderer.post_ui, 0, sizeof(struct RendererPostUiState));
        RendererPhaseOwnership.clear(&SemuRenderer.pending);
        SemuRenderer.game_failure_status = 0;
        SemuRenderer.post_failure_status = 0;
        SemuRenderer.initialize_retry_ms = 0LL;
        SemuRenderer.initialize_backoff_ms = 0LL;
    }

    class void activate(unsigned long long contextGeneration,
                        unsigned long long frameId) {
        if (RendererContextContract.changed(
                SemuRenderer.owner_context_generation, contextGeneration,
                SemuRenderer.last_frame_id, frameId)) {
            SemuRendererLifecycle.reset(false,
                SemuRenderer.owner_context_generation);
        }
        SemuRenderer.owner_context_generation = contextGeneration;
        SemuRenderer.last_frame_id = frameId;
    }
}

class SemuRendererReceipts {
    class bool failureTransition(int status, int* previous) {
        if (previous == null) { return false; }
        if (status >= 0) {
            *previous = 0;
            return false;
        }
        if (*previous == status) { return false; }
        *previous = status;
        return true;
    }
}

class SemuRendererInitialization {  // a failed initialize backs off instead of rereading files every frame
    class bool resources(unsigned long long contextGeneration) {
        if (SemuRenderer.resources.ready == 0 && SemuRenderer.initialize_retry_ms != 0LL
                && RendererClock.milliseconds() < SemuRenderer.initialize_retry_ms) { return false; }
        bool ready = RendererResources.initialize(&SemuRenderer.gl, &SemuRenderer.resources,
            &SemuRenderer.config, contextGeneration);
        if (ready && RendererVariantImages.due(&SemuRenderer.resources)
                && !RendererVariantImages.load(&SemuRenderer.gl, &SemuRenderer.resources, &SemuRenderer.config)) {  // a GL error: start the context's resources over
            RendererResources.releaseCurrentContext(&SemuRenderer.gl, &SemuRenderer.resources, contextGeneration);
            ready = false;
        }
        if (SemuRenderer.switch_started_ms != 0LL && SemuRenderer.switch_images_ms == 0LL) { SemuRenderer.switch_images_ms = RendererClock.milliseconds(); }
        if (ready) {
            SemuRenderer.initialize_retry_ms = 0LL;
            SemuRenderer.initialize_backoff_ms = 0LL;
            return true;
        }
        long long backoff = SemuRenderer.initialize_backoff_ms * 2LL;
        if (backoff < 1000LL) { backoff = 1000LL; }
        if (backoff > 8000LL) { backoff = 8000LL; }
        SemuRenderer.initialize_backoff_ms = backoff;
        SemuRenderer.initialize_retry_ms = RendererClock.milliseconds() + backoff;
        return false;
    }
}

class SemuRendererLiveVariants {  // a select from the journal: its section replaces the variant keys, then only the images reload
    class void apply() {  // in the game phase, once the toast has been on screen for two frames
        long long started = RendererClock.milliseconds();
        int switched = RendererLiveSwitch.apply(&SemuRenderer.post_ui, &SemuRenderer.config, &SemuRenderer.live, &SemuRenderer.resources.variant_images_stale);
        if (RendererLiveSwitch.applyPlacement(&SemuRenderer.post_ui, &SemuRenderer.config, &SemuRenderer.live) == SEMU_RENDER_SWITCH_APPLIED) {
            RendererPlacementNotice.remember(&SemuRenderer.live);  // the geometry follows on this frame, compared with Fit: Bezel's
            if (getenv("SEMU_RENDER_DEBUG") != null) { fprintf(stderr, "semu-renderer: placement %d\n", SemuRenderer.config.placement); }
        }
        if (switched != SEMU_RENDER_SWITCH_APPLIED) { return; }
        SemuRenderer.switch_started_ms = started;  // the receipt and the toast count the switch from here
        SemuRenderer.switch_images_ms = 0LL;
    }

    class void notice(struct SemuRenderFrameGl* frame) {  // once a placement's geometry resolves: the same frame placed in the state the press left, what the toast compares it with
        bool resolved = SemuRenderer.geometry.lane_count > 0;
        int placement = SemuRenderer.config.placement;
        struct RendererCompositionGeometry before;
        memset(&before, 0, sizeof(struct RendererCompositionGeometry));
        bool placed = false;
        if (SemuRenderer.live.placement_compare != 0 && resolved && placement != SemuRenderer.live.placement_before) {
            SemuRenderer.config.placement = SemuRenderer.live.placement_before;
            placed = RendererGeometry.resolve(frame, &SemuRenderer.config, &SemuRenderer.resources, &before);
            SemuRenderer.config.placement = placement;
        }
        RendererPlacementNotice.after(&SemuRenderer.post_ui, &SemuRenderer.live, resolved ? &SemuRenderer.geometry : null, placed ? &before : null, RendererClock.milliseconds());
    }

    class void reapply() {  // a freshly loaded config (a new context) starts on the live choice
        RendererLiveSwitch.reapply(&SemuRenderer.config, &SemuRenderer.live);
    }

    class void receipt(struct SemuRenderFrameGl* frame, unsigned long long contextGeneration, int status) {  // phase=switch with the new art, layout and lanes, and what the switch cost
        if (SemuRenderer.switch_started_ms == 0LL) { return; }
        long long now = RendererClock.milliseconds();
        long long images = SemuRenderer.switch_images_ms != 0LL ? SemuRenderer.switch_images_ms : now;
        char extra[160];
        snprintf(extra, sizeof(extra), " bezel_index=%d shader_index=%d reload_ms=%lld frame_ms=%lld",
            SemuRenderer.live.bezel, SemuRenderer.live.shader, images - SemuRenderer.switch_started_ms, now - SemuRenderer.switch_started_ms);
        RendererStateFiles.appendReceiptWith("switch", frame, contextGeneration, 1, status, 0, 0ULL, -1,
            &SemuRenderer.config, &SemuRenderer.resources, &SemuRenderer.geometry, null, extra);
        if (getenv("SEMU_RENDER_DEBUG") != null) { fprintf(stderr, "semu-renderer: switched to [%d,%d]:%s\n", SemuRenderer.live.bezel, SemuRenderer.live.shader, extra); }
        RendererToast.finish(&SemuRenderer.post_ui, SemuRenderer.switch_started_ms, now);  // LOADING becomes the plain toast; a showing toast outlasts the stall
        SemuRenderer.switch_started_ms = 0LL;
        SemuRenderer.switch_images_ms = 0LL;
    }
}

class SemuRendererCalls {
    class void initialize() {
        if (SemuRenderer.initialized != 0) { return; }
        memset(&SemuRenderer, 0, sizeof(struct SemuRendererRuntime));
        SemuRenderer.initialized = 1;
        RendererLiveSwitch.reset(&SemuRenderer.live);
        RendererPhaseOwnership.clear(&SemuRenderer.pending);
    }

    class int prepare(struct SemuRenderFrameGl* frame,
                      unsigned long long* contextGeneration) {
        SemuRendererCalls.initialize();
        if (!RendererFrameContract.valid(frame)) { return SEMU_RENDER_INVALID_FRAME; }
        *contextGeneration = frame->context_generation;
        if (*contextGeneration == 0ULL) { return SEMU_RENDER_NO_CONTEXT; }
        SemuRendererLifecycle.activate(*contextGeneration, frame->frame_id);
        if (SemuRenderer.gl_loaded != 0 && SemuRenderer.resources.ready != 0
                && !RendererResources.current(&SemuRenderer.gl,
                    &SemuRenderer.resources, *contextGeneration)) {
            bool released = SemuRenderer.resources.owner_context_generation
                    == *contextGeneration
                && RendererResources.releaseCurrentContext(
                    &SemuRenderer.gl, &SemuRenderer.resources,
                    *contextGeneration);
            if (!released) {
                RendererResources.abandonDestroyedContext(
                    &SemuRenderer.resources);
            }
            SemuRenderer.gl_loaded = 0;
            memset(&SemuRenderer.gl, 0, sizeof(struct RendererGlApi));
        }
        if (SemuRenderer.gl_loaded == 0) {
            if (!RendererGlProcedures.load(&SemuRenderer.gl, frame)) {
                return SEMU_RENDER_GL_UNAVAILABLE;
            }
            SemuRenderer.gl_loaded = 1;
        }
        bool fresh = SemuRenderer.config.loaded == 0;
        RendererConfiguration.load(&SemuRenderer.config);
        if (fresh) { SemuRendererLiveVariants.reapply(); }
        return SEMU_RENDER_APPLIED;
    }
}

void semu_render_context_invalidate_gl(
        unsigned long long contextGeneration) {
    SemuRendererCalls.initialize();
    if (contextGeneration == 0ULL
            || SemuRenderer.owner_context_generation
                != contextGeneration) { return; }
    SemuRendererLifecycle.reset(true, contextGeneration);
}

int semu_render_game_gl(struct SemuRenderFrameGl* frame) {
    SemuRendererCalls.initialize();
    if (!RendererFrameContract.compatible(frame)) {
        RendererPhaseOwnership.clear(&SemuRenderer.pending);
        if (SemuRendererReceipts.failureTransition(SEMU_RENDER_INVALID_FRAME,
                &SemuRenderer.game_failure_status)) {
            RendererStateFiles.appendReceipt("game", null, 0ULL, 0,
                SEMU_RENDER_INVALID_FRAME, 0, 0ULL, -1,
                null, null, null, null);
        }
        return SEMU_RENDER_INVALID_FRAME;
    }
    RendererPointerContract.clearMap(&frame->pointer_map);
    frame->map_pointer = semu_render_map_pointer_abi3;
    unsigned long long contextGeneration = 0ULL;
    int prepared = SemuRendererCalls.prepare(frame, &contextGeneration);
    if (prepared != SEMU_RENDER_APPLIED) {
        RendererPhaseOwnership.clear(&SemuRenderer.pending);
        if (SemuRendererReceipts.failureTransition(prepared,
                &SemuRenderer.game_failure_status)) {
            RendererStateFiles.appendReceipt("game", frame,
                contextGeneration, 0,
                prepared, 0, 0ULL, -1, null, null, null, null);
        }
        return prepared;
    }
    if (!RendererGlStateGuard.save(&SemuRenderer.gl,
            &SemuRenderer.game_state)) {
        RendererPhaseOwnership.clear(&SemuRenderer.pending);
        if (SemuRendererReceipts.failureTransition(SEMU_RENDER_GL_UNAVAILABLE,
                &SemuRenderer.game_failure_status)) {
            RendererStateFiles.appendReceipt("game", frame,
                contextGeneration, 0,
                SEMU_RENDER_GL_UNAVAILABLE, 0, 0ULL, -1,
                &SemuRenderer.config, &SemuRenderer.resources, null, null);
        }
        return SEMU_RENDER_GL_UNAVAILABLE;
    }

    RendererFrameTiming.begin(frame);  // SEMU_RENDER_DEBUG: size changes, frame rate, the game phase's cost
    if (SemuRenderer.post_ui.scale_live > 0) { SemuRenderer.config.render_scale.scale = SemuRenderer.post_ui.scale_live; }  // a scale the emulator switched to live
    RendererRenderScaling.normalize(frame, &SemuRenderer.config.render_scale);  // a scaled frame's size back to the game's, before the crop counts game pixels
    RendererSurfaceCropping.apply(frame, SemuRenderer.config.surface_crops, SemuRenderer.config.display_aspect);  // the picture only, before anything places or mirrors it
    SemuRendererLiveVariants.apply();  // a pending select replaces the variant keys before this frame's geometry
    RendererConfiguration.select(&SemuRenderer.config, frame);
    int status = SEMU_RENDER_APPLIED;
    if (!SemuRendererInitialization.resources(contextGeneration)) {
        memset(&SemuRenderer.geometry, 0, sizeof(struct RendererCompositionGeometry));  // no stale rectangles for the post phase
        status = RendererResourceFailure.set(&SemuRenderer.resources,
            SEMU_RENDER_PIPELINE_FAILED, "resource_initialization_failed");
    } else if (!RendererGeometry.resolve(frame, &SemuRenderer.config,
            &SemuRenderer.resources, &SemuRenderer.geometry)) {
        status = RendererResourceFailure.set(&SemuRenderer.resources,
            SEMU_RENDER_PIPELINE_FAILED, "geometry_resolution_failed");
    } else {
        status = RendererCompositor.game(&SemuRenderer.gl,
            &SemuRenderer.resources, &SemuRenderer.config, frame,
            &SemuRenderer.geometry);
    }
    SemuRendererLiveVariants.notice(frame);  // a Fit choice that draws what Fit: Bezel draws says so
    RendererFrameTiming.end();
    RendererGlStateGuard.restore(&SemuRenderer.gl, &SemuRenderer.game_state);
    SemuRendererLiveVariants.receipt(frame, contextGeneration, status);
    if (status != SEMU_RENDER_APPLIED) {
        RendererPhaseOwnership.acceptGame(&SemuRenderer.pending, frame,
            contextGeneration);  // the emulator's own picture stays, and the menu still draws over it
        if (SemuRendererReceipts.failureTransition(status,
                &SemuRenderer.game_failure_status)) {
            fprintf(stderr, "semu-renderer: game phase status %d (%s); the emulator's picture shows unframed\n", status, SemuRenderer.resources.failure_reason);
            RendererStateFiles.appendReceipt("game", frame,
                contextGeneration, 1,
                status, 0, 0ULL, -1, &SemuRenderer.config,
                &SemuRenderer.resources, &SemuRenderer.geometry, null);
        }
        return status;
    }

    SemuRendererReceipts.failureTransition(SEMU_RENDER_APPLIED,
        &SemuRenderer.game_failure_status);
    RendererPointerContract.publish(frame, &SemuRenderer.geometry,
        &frame->pointer_map);
    RendererPhaseOwnership.acceptGame(&SemuRenderer.pending, frame,
        contextGeneration);
    return SEMU_RENDER_APPLIED;
}

int semu_render_post_ui_gl(struct SemuRenderFrameGl* frame) {
    SemuRendererCalls.initialize();
    if (!RendererFrameContract.valid(frame)) { return SEMU_RENDER_INVALID_FRAME; }
    unsigned long long contextGeneration = frame->context_generation;
    if (!RendererPhaseOwnership.matchesPost(&SemuRenderer.pending,
            frame, contextGeneration)) {
        return SEMU_RENDER_PASSTHROUGH;
    }

    int consumed = 0;
    bool needsGl = RendererPostUiPhase.prepare(&SemuRenderer.post_ui,
        frame, &consumed);
    bool cursor = RendererCursor.update(&SemuRenderer.cursor,
        RendererFrameContract.cursor(frame), RendererClock.milliseconds());
    if (RendererCursor.changed(&SemuRenderer.cursor, cursor) && getenv("SEMU_RENDER_DEBUG") != null) {  // epoch ms: a harness lines it up with its own moves
        fprintf(stderr, "semu-renderer: cursor %s %d,%d ms=%lld\n", cursor ? "shown" : "hidden",
            SemuRenderer.cursor.x, SemuRenderer.cursor.y, RendererClock.epochMilliseconds());
    }
    bool warm = SemuRenderer.post_ui.menu_warmed == 0 && SemuRenderer.gl_loaded != 0
        && RendererResources.current(&SemuRenderer.gl, &SemuRenderer.resources, contextGeneration);  // once per context, at its first composed frame
    needsGl = needsGl || cursor || warm;
    if ((SemuRenderer.post_ui.bezels_toggles & 1) != 0) {  // menu toggles flip the live config; odd counts flip
        SemuRenderer.config.bezels_enabled = SemuRenderer.config.bezels_enabled != 0 ? 0 : 1;
    }
    if ((SemuRenderer.post_ui.shaders_toggles & 1) != 0) {
        SemuRenderer.config.shaders_enabled = SemuRenderer.config.shaders_enabled != 0 ? 0 : 1;
    }
    SemuRenderer.post_ui.bezels_toggles = 0;
    SemuRenderer.post_ui.shaders_toggles = 0;
    if (!needsGl) {
        RendererPhaseOwnership.clear(&SemuRenderer.pending);
        SemuRendererReceipts.failureTransition(SEMU_RENDER_APPLIED,
            &SemuRenderer.post_failure_status);
        return SEMU_RENDER_APPLIED;
    }
    if (SemuRenderer.gl_loaded == 0
            || !RendererResources.current(&SemuRenderer.gl,
                &SemuRenderer.resources, contextGeneration)
            || !RendererGlStateGuard.save(&SemuRenderer.gl,
                &SemuRenderer.post_state)) {
        RendererPhaseOwnership.clear(&SemuRenderer.pending);
        if (SemuRendererReceipts.failureTransition(SEMU_RENDER_GL_UNAVAILABLE,
                &SemuRenderer.post_failure_status)) {
            RendererStateFiles.appendReceipt("post_ui", frame,
                contextGeneration, 1,
                SEMU_RENDER_GL_UNAVAILABLE, consumed, 0ULL, -1,
                &SemuRenderer.config, &SemuRenderer.resources,
                &SemuRenderer.geometry, &SemuRenderer.post_ui);
        }
        return SEMU_RENDER_GL_UNAVAILABLE;
    }

    unsigned long long hash = 0ULL;
    int nonblank = -1;
    bool applied = RendererPostUiPhase.apply(&SemuRenderer.gl,
        &SemuRenderer.resources, frame, &SemuRenderer.post_ui,
        &SemuRenderer.geometry, cursor ? &SemuRenderer.cursor : null,
        &hash, &nonblank);
    RendererGlStateGuard.restore(&SemuRenderer.gl, &SemuRenderer.post_state);
    RendererPhaseOwnership.clear(&SemuRenderer.pending);
    int status = applied ? SEMU_RENDER_APPLIED : SEMU_RENDER_PIPELINE_FAILED;
    bool failureReceipt = SemuRendererReceipts.failureTransition(status,
        &SemuRenderer.post_failure_status);
    if (failureReceipt
            || SemuRenderer.post_ui.capture_outcome != SEMU_RENDER_CAPTURE_NONE) {
        RendererStateFiles.appendReceipt("post_ui", frame,
            contextGeneration, 1,
            status, consumed, hash, nonblank,
            &SemuRenderer.config, &SemuRenderer.resources,
            &SemuRenderer.geometry, &SemuRenderer.post_ui);
    }
    return status;
}
