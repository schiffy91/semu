// Where a fixed bezel's canvas lands on the screen: contained, covered when the scene asks for it and its
// openings stay on screen, then moved to the placement's whole step (game: the largest the screen holds,
// the shell cropped and centred where it fits; bezel: the largest that keeps the shell). Pure arithmetic
// over the renderer's records, no GL, so the contracts place a package exactly as the compositor does.

import ./renderer_abi.btrc;
import ./renderer_config.btrc;

class RendererPlacement {
    class void canvas(struct SemuRenderFrameGl* frame, struct RendererVariantConfig* variant, int placement, int fractionalBelow, float aspect, int areaWidth, int areaHeight, int sourceWidth, int sourceHeight, struct RendererCanvasRect* canvas) {  // SOURCE: the layered canvas, else the art plate; FRACTIONAL_BELOW: a 3D-era system's opt-in for game
        RendererCompositionContract.contain(areaWidth, areaHeight, sourceWidth, sourceHeight, canvas);
        bool layered = variant->layer_count > 0 && variant->canvas_width > 0;
        if (layered && variant->canvas_cover != 0) { RendererPlacement.coverKeepingTubes(frame, variant, areaWidth, areaHeight, canvas); }
        if (placement != 0 && frame->surface_count == 1 && (variant->screens[0].image.set != 0 || variant->screens[0].tube.set != 0)) { RendererPlacement.integerPlacement(frame, variant, placement, fractionalBelow, aspect, areaWidth, areaHeight, canvas); }
    }

    class void integerPlacement(struct SemuRenderFrameGl* frame, struct RendererVariantConfig* variant, int placement, int fractionalBelow, float aspect, int areaWidth, int areaHeight, struct RendererCanvasRect* canvas) {  // the picture at a whole multiple of its native height
        struct RendererScreenConfig* screen = &variant->screens[0];
        struct RendererNormalizedHole area = screen->image;  // the calibrated picture rectangle, else the opening less its inset, as placeInTube fits the game
        if (area.set == 0) {
            float tubeWidth = screen->tube.width * canvas->width;
            float tubeHeight = screen->tube.height * canvas->height;
            float inset = screen->inset * (tubeWidth < tubeHeight ? tubeWidth : tubeHeight);
            area.x = screen->tube.x + inset / canvas->width;
            area.y = screen->tube.y + inset / canvas->height;
            area.width = screen->tube.width - 2.0f * inset / canvas->width;
            area.height = screen->tube.height - 2.0f * inset / canvas->height;
        }
        struct RendererNormalizedHole* image = &area;
        if (image->width <= 0.0f || image->height <= 0.0f) { return; }
        float pictureWidth = image->width * canvas->width;
        float pictureHeight = image->height * canvas->height;
        float shown = aspect > 0.01f ? aspect : pictureWidth / pictureHeight;
        if (pictureWidth / pictureHeight > shown) { pictureWidth = pictureHeight * shown; } else { pictureHeight = pictureWidth / shown; }  // the game inside its rectangle
        float native = (float)frame->surfaces[0].native_height;  // the height the emulator reports for this frame (a core that crops its overscan reports the cropped height)
        if (native < 1.0f || pictureHeight < 1.0f) { return; }
        int multiple = (int)(pictureHeight / native);  // bezel: the largest step that keeps the whole shell
        if (placement == 1) {  // game: the largest step the screen holds
            int down = (int)((float)areaHeight / native);
            int across = (int)((float)areaWidth / (native * shown));
            multiple = down < across ? down : across;
        }
        float steps = (float)multiple;
        bool fills = placement == 1 && multiple < fractionalBelow;  // game on a system that opts in (display.scaling.game_fractional_below): a 480-line picture fills the 800-line screen instead of sitting at 1x; bezel stays whole
        if (multiple < 1 || fills) {  // larger than the screen at 1x (PPSSPP's internal resolution set for a bigger display): the scaling fallback, fractional_downscale, never an overflow
            float down = (float)areaHeight / native;
            float across = (float)areaWidth / (native * shown);
            steps = placement == 1 ? (down < across ? down : across) : pictureHeight / native;
        }
        float grow = steps * native / pictureHeight;
        float centerX = canvas->x + (image->x + image->width * 0.5f) * canvas->width;
        float centerY = canvas->y + (1.0f - image->y - image->height * 0.5f) * canvas->height;  // pixel rows count up from the bottom
        float anchorX = placement == 1 ? (float)areaWidth * 0.5f : canvas->x + canvas->width * 0.5f + (centerX - canvas->x - canvas->width * 0.5f) * grow;
        float anchorY = placement == 1 ? (float)areaHeight * 0.5f : canvas->y + canvas->height * 0.5f + (centerY - canvas->y - canvas->height * 0.5f) * grow;
        canvas->x = anchorX - (centerX - canvas->x) * grow;  // game centres the picture, bezel keeps the shell centred
        canvas->y = anchorY - (centerY - canvas->y) * grow;
        canvas->width = canvas->width * grow;
        canvas->height = canvas->height * grow;
        if (placement == 1) {  // game: on an axis the whole shell fits, the shell is centred so the backdrop shows evenly (a device whose screen sits above its middle); a whole-pixel shift keeps the picture on the grid
            if (canvas->width <= (float)areaWidth) { canvas->x = canvas->x + RendererPlacement.wholePixels(((float)areaWidth - canvas->width) * 0.5f - canvas->x); }
            if (canvas->height <= (float)areaHeight) { canvas->y = canvas->y + RendererPlacement.wholePixels(((float)areaHeight - canvas->height) * 0.5f - canvas->y); }
        }
        if (placement == 2 && variant->canvas_cover != 0 && canvas->height < (float)areaHeight) { canvas->y = canvas->y + RendererPlacement.wholePixels(0.0f - canvas->y); }  // bezel on a scene shorter than the screen: the table stays on the screen's bottom edge and the wall carries on above, never a band under the table
    }

    class bool shellHidden(int placement, int surfaceCount) { return placement == 1 && surfaceCount == 2; }  // DS and 3DS screen placement: no shell, the whole-step layout over the background

    class float wholePixels(float shift) {  // rounded half away from zero
        return shift >= 0.0f ? (float)(int)(shift + 0.5f) : -(float)(int)(0.5f - shift);
    }

    class void coverKeepingTubes(struct SemuRenderFrameGl* frame, struct RendererVariantConfig* variant, int areaWidth, int areaHeight, struct RendererCanvasRect* canvas) {  // scale the canvas to fill the area; keep contain if a tube would leave it
        if (canvas->width <= 0.0f || canvas->height <= 0.0f) { return; }
        float horizontal = (float)areaWidth / canvas->width;
        float vertical = (float)areaHeight / canvas->height;
        float grow = horizontal > vertical ? horizontal : vertical;
        float width = canvas->width * grow;
        float height = canvas->height * grow;
        float coveredX = ((float)areaWidth - width) * 0.5f;
        float coveredY = ((float)areaHeight - height) * 0.5f;
        for (int index = 0; index < frame->surface_count && index < 2; index++) {
            struct RendererNormalizedHole* tube = &variant->screens[index].tube;
            float left = coveredX + tube->x * width;
            float top = coveredY + tube->y * height;
            if (left < 0.0f || top < 0.0f || left + tube->width * width > (float)areaWidth || top + tube->height * height > (float)areaHeight) { return; }
        }
        canvas->x = coveredX;
        canvas->y = coveredY;
        canvas->width = width;
        canvas->height = height;
    }
}
