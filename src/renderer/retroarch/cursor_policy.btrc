// When a frame carries Semu's touch cursor, header-free and shared by every route that reports a
// pointer: RetroArch's bridge (runtime_bridge.btrc, from its window pointer) and the standalone
// compositor (preload/semu_compose.btrc, from Azahar's semu_pointer_sample). It lives beside the
// RetroArch bridge because only this directory reaches RetroArch's build. The renderer then shows
// the arrow on motion or a press and hides it when idle (renderer_cursor.btrc). RetroArch's bridge
// polls the pointer every frame, so its first sample is only a position; Azahar reports a sample only
// on a mouse event, so a sample new since the last frame is motion: visible 2 says so.

class SemuCursorPolicy {
    class bool shown(int touchIndex, bool allowed, int screenX, int screenY, int framebufferWidth, int framebufferHeight) {  // a touch system, a pointer the game may read, in the window
        return touchIndex >= 0 && allowed && screenX >= 0 && screenY >= 0
            && screenX < framebufferWidth && screenY < framebufferHeight;
    }

    class void fill(int touchIndex, bool allowed, int screenX, int screenY, bool pressed, bool fresh, int framebufferWidth, int framebufferHeight,
                    int* visible, int* cursorX, int* cursorY, int* cursorPressed) {  // the frame's cursor fields: the pointer where it shows, zeros elsewhere
        bool shown = SemuCursorPolicy.shown(touchIndex, allowed, screenX, screenY, framebufferWidth, framebufferHeight);
        *visible = shown ? (fresh ? 2 : 1) : 0;  // 2: an event the emulator reported since the last frame
        *cursorX = shown ? screenX : 0;
        *cursorY = shown ? screenY : 0;
        *cursorPressed = shown && pressed ? 1 : 0;
    }

    class bool fresh(int serial, int* consumed) {  // true once per new event-driven sample: the frame that first carries it
        bool result = serial != *consumed;
        *consumed = serial;
        return result;
    }

    class int touchIndex(const char* value) {  // SEMU_RENDER_TOUCH_SURFACE_INDEX: the touch screen's index, -1 when unset or not a number
        if (value == null || value[0] == '\0') { return -1; }
        int index = 0;
        for (int position = 0; value[position] != '\0'; position++) {
            if (value[position] < '0' || value[position] > '9' || position >= 4) { return -1; }
            index = index * 10 + (int)(value[position] - '0');
        }
        return index;
    }
}
