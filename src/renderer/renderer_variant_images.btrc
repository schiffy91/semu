// The images a bezel variant draws (art plate, layers, background, glass) as textures. Loaded once a
// context is ready, and again when a live choice changes the variants; the program, the composition
// target, the menu texture and the shader chains stay as they are.

#include <string.h>

import ./renderer_gl_api.btrc;
import ./renderer_config.btrc;
import ./renderer_compositor.btrc;

class RendererVariantImages {
    class void unload(struct RendererGlApi* gl, struct RendererGlResources* resources) {  // deleting texture 0 is a no-op, so a first load passes through
        if (gl->delete_textures != null) {
            gl->delete_textures(4, resources->bezel_textures);
            gl->delete_textures(4, resources->background_textures);
            gl->delete_textures(8, resources->glass_textures);
            gl->delete_textures(32, resources->layer_textures);
        }
        memset(resources->bezel_textures, 0, sizeof(resources->bezel_textures));
        memset(resources->background_textures, 0, sizeof(resources->background_textures));
        memset(resources->glass_textures, 0, sizeof(resources->glass_textures));
        memset(resources->layer_textures, 0, sizeof(resources->layer_textures));
        memset(resources->art_loaded, 0, sizeof(resources->art_loaded));
        memset(resources->art_width, 0, sizeof(resources->art_width));
        memset(resources->art_height, 0, sizeof(resources->art_height));
        memset(resources->layer_loaded, 0, sizeof(resources->layer_loaded));
        memset(resources->layer_width, 0, sizeof(resources->layer_width));
        memset(resources->layer_height, 0, sizeof(resources->layer_height));
        memset(resources->background_loaded, 0, sizeof(resources->background_loaded));
        memset(resources->background_width, 0, sizeof(resources->background_width));
        memset(resources->background_height, 0, sizeof(resources->background_height));
        memset(resources->glass_loaded, 0, sizeof(resources->glass_loaded));
    }

    class bool load(struct RendererGlApi* gl, struct RendererGlResources* resources,
                    struct RendererConfig* config) {  // a missing image draws without it; false only on a GL error
        if (resources->variant_images_stale != 0) {  // a new variant reports its own missing assets
            RendererAssetReported = 0u;
            RendererLayerReported = 0u;
        }
        RendererVariantImages.unload(gl, resources);
        for (int variantIndex = 0; variantIndex < 4; variantIndex++) {
            struct RendererVariantConfig* variant = &config->variants[variantIndex];
            gl->active_texture((unsigned int)(RGL_TEXTURE0 + 1));
            resources->art_loaded[variantIndex] = RendererResources.loadImage(gl,
                variant->art.value, &resources->bezel_textures[variantIndex],
                &resources->art_width[variantIndex],
                &resources->art_height[variantIndex]) ? 1 : 0;
            for (int layerIndex = 0; layerIndex < 8; layerIndex++) {
                int slot = variantIndex * 8 + layerIndex;
                resources->layer_loaded[slot] = 0;
                if (layerIndex >= variant->layer_count) { continue; }
                gl->active_texture((unsigned int)(RGL_TEXTURE0 + 1));
                resources->layer_loaded[slot] = RendererResources.loadImage(gl,
                    variant->layers[layerIndex].file.value, &resources->layer_textures[slot],
                    &resources->layer_width[slot], &resources->layer_height[slot]) ? 1 : 0;
                if (resources->layer_loaded[slot] == 0) { RendererAssetContract.layerFailed(&variant->layers[layerIndex], slot); }
            }
            gl->active_texture((unsigned int)(RGL_TEXTURE0 + 6));
            resources->background_loaded[variantIndex] = RendererResources.loadImage(gl,
                variant->background.value, &resources->background_textures[variantIndex],
                &resources->background_width[variantIndex],
                &resources->background_height[variantIndex]) ? 1 : 0;
            for (int lane = 0; lane < 2; lane++) {
                int glassWidth = 0;
                int glassHeight = 0;
                int slot = variantIndex * 2 + lane;
                gl->active_texture((unsigned int)(RGL_TEXTURE0 + (lane == 0 ? 2 : 5)));
                resources->glass_loaded[slot] = RendererResources.loadImage(gl,
                    variant->screens[lane].glass.value, &resources->glass_textures[slot],
                    &glassWidth, &glassHeight) ? 1 : 0;
            }
        }
        gl->active_texture((unsigned int)RGL_TEXTURE0);
        resources->variant_images = 1;
        resources->variant_images_stale = 0;
        return RendererGlErrors.none(gl);
    }

    class bool due(struct RendererGlResources* resources) {  // a fresh context, or a live choice since the last load
        return resources->ready != 0 && (resources->variant_images == 0 || resources->variant_images_stale != 0);
    }
}
