// VK_LAYER_SEMU_compositor: Semu's bezels and shaders for Vulkan emulators on Linux, drawn into the
// emulator's own swapchain image at present (semu_vulkan_core.btrc). No window of Semu's is
// involved, so focus, keyboard, pads and mouse stay the emulator's. The shared image's memory is
// exported as a file descriptor and imported by a surfaceless EGL context
// (GL_EXT_memory_object_fd). A device without external memory, or a missing GL import, presents
// unchanged.
import ./semu_vulkan_core.btrc;
#include <vulkan/vk_layer.h>
#include <EGL/egl.h>

struct SemuLayerCreateInfo {  // VkLayerInstanceCreateInfo and VkLayerDeviceCreateInfo: untagged in vk_layer.h, one pointer-sized union
    int sType;
    const void* pNext;
    int role;  // VkLayerFunction
    void* data;  // the link (VK_LAYER_LINK_INFO) or the loader-data callback (VK_LOADER_DATA_CALLBACK)
};

struct SemuVulkanEglState {  // one surfaceless OpenGL context for every composition in the process
    bool attempted;
    bool ready;
    void* display;
    void* context;
    __fn_ptr<void*, const char*> getProc;
    __fn_ptr<void, int, unsigned int*> createMemoryObjects;
    __fn_ptr<void, int, unsigned int*> deleteMemoryObjects;
    __fn_ptr<void, unsigned int, int, const int*> memoryObjectParameter;
    __fn_ptr<void, unsigned int, uint64_t, unsigned int, int> importMemoryFd;
    __fn_ptr<void, unsigned int, int, unsigned int, int, int, unsigned int, uint64_t> textureStorageMemory;
    __fn_ptr<void, int, unsigned int*> generateTextures;
    __fn_ptr<void, int, const unsigned int*> deleteTextures;
    __fn_ptr<void, unsigned int, unsigned int> bindTexture;
    __fn_ptr<void, unsigned int, unsigned int, int> textureParameter;
    __fn_ptr<void, int, unsigned int*> generateFramebuffers;
    __fn_ptr<void, int, const unsigned int*> deleteFramebuffers;
    __fn_ptr<void, unsigned int, unsigned int> bindFramebuffer;
    __fn_ptr<void, unsigned int, unsigned int, unsigned int, unsigned int, int> framebufferTexture;
    __fn_ptr<unsigned int, unsigned int> framebufferStatus;
    __fn_ptr<void> finish;
    __fn_ptr<void, unsigned int> disable;
};

struct SemuVulkanEglState SemuVulkanEgl;

class SemuVulkanLinux {
    class void* glProc(const char* name) {
        return SemuVulkanEgl.getProc(name);
    }

    class bool start() {
        if (SemuVulkanEgl.attempted) { return SemuVulkanEgl.ready; }
        SemuVulkanEgl.attempted = true;
        SemuVulkanCore.bind(&SemuVulkanEgl.getProc, dlsym(RTLD_DEFAULT, "eglGetProcAddress"));
        if (SemuVulkanEgl.getProc == null) { return false; }
        __fn_ptr<void*, unsigned int, void*, const int*> platformDisplay;
        SemuVulkanCore.bind(&platformDisplay, SemuVulkanEgl.getProc("eglGetPlatformDisplayEXT"));
        void* display = null;
        if (platformDisplay != null) { display = platformDisplay(0x31DDu, null, null); }  // EGL_PLATFORM_SURFACELESS_MESA
        if (display == null || eglInitialize(display, null, null) == 0u) {
            display = (void*)eglGetDisplay(null);  // EGL_DEFAULT_DISPLAY
            if (display == null || eglInitialize(display, null, null) == 0u) { return false; }
        }
        eglBindAPI(0x30A2u);  // EGL_OPENGL_API
        int attributes[8];
        attributes[0] = 0x3098; attributes[1] = 4;  // EGL_CONTEXT_MAJOR_VERSION
        attributes[2] = 0x30FB; attributes[3] = 1;  // EGL_CONTEXT_MINOR_VERSION
        attributes[4] = 0x30FD; attributes[5] = 1;  // EGL_CONTEXT_OPENGL_PROFILE_MASK: core
        attributes[6] = 0x3038; attributes[7] = 0;  // EGL_NONE
        void* context = (void*)eglCreateContext(display, null, null, attributes);
        if (context == null) { return false; }
        SemuVulkanEgl.display = display;
        SemuVulkanEgl.context = context;
        SemuVulkanCore.bind(&SemuVulkanEgl.createMemoryObjects, SemuVulkanLinux.glProc("glCreateMemoryObjectsEXT"));
        SemuVulkanCore.bind(&SemuVulkanEgl.deleteMemoryObjects, SemuVulkanLinux.glProc("glDeleteMemoryObjectsEXT"));
        SemuVulkanCore.bind(&SemuVulkanEgl.memoryObjectParameter, SemuVulkanLinux.glProc("glMemoryObjectParameterivEXT"));
        SemuVulkanCore.bind(&SemuVulkanEgl.importMemoryFd, SemuVulkanLinux.glProc("glImportMemoryFdEXT"));
        SemuVulkanCore.bind(&SemuVulkanEgl.textureStorageMemory, SemuVulkanLinux.glProc("glTexStorageMem2DEXT"));
        SemuVulkanCore.bind(&SemuVulkanEgl.generateTextures, SemuVulkanLinux.glProc("glGenTextures"));
        SemuVulkanCore.bind(&SemuVulkanEgl.deleteTextures, SemuVulkanLinux.glProc("glDeleteTextures"));
        SemuVulkanCore.bind(&SemuVulkanEgl.bindTexture, SemuVulkanLinux.glProc("glBindTexture"));
        SemuVulkanCore.bind(&SemuVulkanEgl.textureParameter, SemuVulkanLinux.glProc("glTexParameteri"));
        SemuVulkanCore.bind(&SemuVulkanEgl.generateFramebuffers, SemuVulkanLinux.glProc("glGenFramebuffers"));
        SemuVulkanCore.bind(&SemuVulkanEgl.deleteFramebuffers, SemuVulkanLinux.glProc("glDeleteFramebuffers"));
        SemuVulkanCore.bind(&SemuVulkanEgl.bindFramebuffer, SemuVulkanLinux.glProc("glBindFramebuffer"));
        SemuVulkanCore.bind(&SemuVulkanEgl.framebufferTexture, SemuVulkanLinux.glProc("glFramebufferTexture2D"));
        SemuVulkanCore.bind(&SemuVulkanEgl.framebufferStatus, SemuVulkanLinux.glProc("glCheckFramebufferStatus"));
        SemuVulkanCore.bind(&SemuVulkanEgl.finish, SemuVulkanLinux.glProc("glFinish"));
        SemuVulkanCore.bind(&SemuVulkanEgl.disable, SemuVulkanLinux.glProc("glDisable"));
        SemuVulkanEgl.ready = SemuVulkanEgl.createMemoryObjects != null && SemuVulkanEgl.importMemoryFd != null
            && SemuVulkanEgl.textureStorageMemory != null;
        if (SemuVulkan.debug) { fprintf(stderr, "semu-vulkan: OpenGL %s\n", SemuVulkanEgl.ready ? "ready" : "lacks GL_EXT_memory_object_fd"); }
        return SemuVulkanEgl.ready;
    }

    class void current() {
        eglMakeCurrent(SemuVulkanEgl.display, null, null, SemuVulkanEgl.context);  // EGL_NO_SURFACE: surfaceless
        SemuVulkanEgl.disable(0x8DB9u);  // GL_FRAMEBUFFER_SRGB: raw values, as on RetroArch's framebuffer
    }

    class void finish() {
        SemuVulkanEgl.finish();
    }

    class int sharedFormat(int swapchainFormat) {  // same encoding as the swapchain, RGBA order for OpenGL
        if (swapchainFormat == 50 || swapchainFormat == 43) { return 43; }  // B8G8R8A8_SRGB, R8G8B8A8_SRGB
        return 37;  // R8G8B8A8_UNORM
    }

    class bool share(struct SemuVulkanDevice* device, struct SemuVulkanSwapchain* swapchain) {
        struct VkExternalMemoryImageCreateInfo external;
        memset(&external, 0, sizeof(struct VkExternalMemoryImageCreateInfo));
        external.sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO;
        external.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT;
        struct VkExportMemoryAllocateInfo export;
        memset(&export, 0, sizeof(struct VkExportMemoryAllocateInfo));
        export.sType = VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO;
        export.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT;
        int format = SemuVulkanLinux.sharedFormat(swapchain->format);
        if (!SemuVulkanCore.createShared(device, swapchain, format, &external, &export)) { return false; }
        struct VkMemoryGetFdInfoKHR fdInfo;
        memset(&fdInfo, 0, sizeof(struct VkMemoryGetFdInfoKHR));
        fdInfo.sType = VK_STRUCTURE_TYPE_MEMORY_GET_FD_INFO_KHR;
        fdInfo.memory = swapchain->sharedMemory;
        fdInfo.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT;
        int descriptor = -1;
        if (device->memoryFd == null || device->memoryFd(device->handle, &fdInfo, &descriptor) < 0 || descriptor < 0) { return false; }
        SemuVulkanLinux.current();
        int dedicatedFlag = 1;
        SemuVulkanEgl.createMemoryObjects(1, &swapchain->glMemory);
        if (SemuVulkanEgl.memoryObjectParameter != null) { SemuVulkanEgl.memoryObjectParameter(swapchain->glMemory, 0x9581, &dedicatedFlag); }  // GL_DEDICATED_MEMORY_OBJECT_EXT
        SemuVulkanEgl.importMemoryFd(swapchain->glMemory, swapchain->sharedSize, 0x9586u, descriptor);  // GL_HANDLE_TYPE_OPAQUE_FD_EXT; GL owns the fd now
        SemuVulkanEgl.generateTextures(1, &swapchain->glTexture);
        SemuVulkanEgl.bindTexture(0x0DE1u, swapchain->glTexture);  // GL_TEXTURE_2D
        SemuVulkanEgl.textureParameter(0x0DE1u, 0x9580u, 0x9584);  // GL_TEXTURE_TILING_EXT: GL_OPTIMAL_TILING_EXT
        bool srgb = format == 43;
        SemuVulkanEgl.textureStorageMemory(0x0DE1u, 1, srgb ? 0x8C43u : 0x8058u, swapchain->width, swapchain->height, swapchain->glMemory, 0ULL);  // GL_SRGB8_ALPHA8 : GL_RGBA8
        if (srgb) { SemuVulkanEgl.textureParameter(0x0DE1u, 0x8A48u, 0x8A4A); }  // GL_TEXTURE_SRGB_DECODE_EXT: GL_SKIP_DECODE_EXT
        SemuVulkanEgl.generateFramebuffers(1, &swapchain->glFramebuffer);
        SemuVulkanEgl.bindFramebuffer(0x8D40u, swapchain->glFramebuffer);  // GL_FRAMEBUFFER
        SemuVulkanEgl.framebufferTexture(0x8D40u, 0x8CE0u, 0x0DE1u, swapchain->glTexture, 0);  // GL_COLOR_ATTACHMENT0
        bool complete = SemuVulkanEgl.framebufferStatus(0x8D40u) == 0x8CD5u;  // GL_FRAMEBUFFER_COMPLETE
        SemuVulkanEgl.bindFramebuffer(0x8D40u, 0u);
        if (SemuVulkan.debug) { fprintf(stderr, "semu-vulkan: swapchain %dx%d format %d, %u images, shared framebuffer %s\n", swapchain->width, swapchain->height, swapchain->format, swapchain->imageCount, complete ? "complete" : "incomplete"); }
        return complete;
    }

    class void unshare(struct SemuVulkanDevice* device, struct SemuVulkanSwapchain* swapchain) {
        SemuVulkanLinux.current();
        if (swapchain->glFramebuffer != 0u) { SemuVulkanEgl.deleteFramebuffers(1, &swapchain->glFramebuffer); }
        if (swapchain->glTexture != 0u) { SemuVulkanEgl.deleteTextures(1, &swapchain->glTexture); }
        if (swapchain->glMemory != 0u && SemuVulkanEgl.deleteMemoryObjects != null) { SemuVulkanEgl.deleteMemoryObjects(1, &swapchain->glMemory); }
    }

    class void install() {
        if (SemuVulkan.interop.start != null) { return; }
        SemuVulkan.interop.deviceExtension = "VK_KHR_external_memory_fd";
        SemuVulkan.interop.start = SemuVulkanLinux.start;
        SemuVulkan.interop.current = SemuVulkanLinux.current;
        SemuVulkan.interop.share = SemuVulkanLinux.share;
        SemuVulkan.interop.unshare = SemuVulkanLinux.unshare;
        SemuVulkan.interop.glProc = SemuVulkanLinux.glProc;
        SemuVulkan.interop.finish = SemuVulkanLinux.finish;
    }
}

// ---- entry points (named in the layer manifest) ----

int semu_vkCreateInstance(const struct VkInstanceCreateInfo* create, const void* allocator, void** result);
void semu_vkDestroyInstance(void* instance, const void* allocator);
int semu_vkCreateDevice(void* physical, const struct VkDeviceCreateInfo* create, const void* allocator, void** result);
void semu_vkDestroyDevice(void* device, const void* allocator);
int semu_vkCreateSwapchainKHR(void* device, const struct VkSwapchainCreateInfoKHR* create, const void* allocator, void** result);
void semu_vkDestroySwapchainKHR(void* device, void* swapchain, const void* allocator);
int semu_vkQueuePresentKHR(void* queue, const struct VkPresentInfoKHR* info);
void semu_vkGetDeviceQueue(void* device, uint32_t family, uint32_t index, void** queue);
void semu_vkGetDeviceQueue2(void* device, const struct VkDeviceQueueInfo2* info, void** queue);
__fn_ptr<void> semu_vkGetDeviceProcAddr(void* device, const char* name);

__fn_ptr<void> semu_vkGetInstanceProcAddr(void* instance, const char* name) {
    if (strcmp(name, "vkGetInstanceProcAddr") == 0) { return (__fn_ptr<void>)semu_vkGetInstanceProcAddr; }
    if (strcmp(name, "vkCreateInstance") == 0) { return (__fn_ptr<void>)semu_vkCreateInstance; }
    if (strcmp(name, "vkDestroyInstance") == 0) { return (__fn_ptr<void>)semu_vkDestroyInstance; }
    if (strcmp(name, "vkCreateDevice") == 0) { return (__fn_ptr<void>)semu_vkCreateDevice; }
    if (strcmp(name, "vkGetDeviceProcAddr") == 0 || strncmp(name, "vkQueuePresent", 14) == 0 || strcmp(name, "vkCreateSwapchainKHR") == 0
        || strcmp(name, "vkDestroySwapchainKHR") == 0 || strcmp(name, "vkDestroyDevice") == 0 || strncmp(name, "vkGetDeviceQueue", 16) == 0) {
        return semu_vkGetDeviceProcAddr(null, name);
    }
    if (instance == null) { return SemuVulkanCore.callable(null); }
    struct SemuVulkanInstance* record = SemuVulkanCore.instance(instance);
    return SemuVulkanCore.callable(record != null ? record->nextInstanceProcAddress(instance, name) : null);
}

__fn_ptr<void> semu_vkGetDeviceProcAddr(void* device, const char* name) {
    if (strcmp(name, "vkGetDeviceProcAddr") == 0) { return (__fn_ptr<void>)semu_vkGetDeviceProcAddr; }
    if (strcmp(name, "vkDestroyDevice") == 0) { return (__fn_ptr<void>)semu_vkDestroyDevice; }
    if (strcmp(name, "vkCreateSwapchainKHR") == 0) { return (__fn_ptr<void>)semu_vkCreateSwapchainKHR; }
    if (strcmp(name, "vkDestroySwapchainKHR") == 0) { return (__fn_ptr<void>)semu_vkDestroySwapchainKHR; }
    if (strcmp(name, "vkQueuePresentKHR") == 0) { return (__fn_ptr<void>)semu_vkQueuePresentKHR; }
    if (strcmp(name, "vkGetDeviceQueue") == 0) { return (__fn_ptr<void>)semu_vkGetDeviceQueue; }
    if (strcmp(name, "vkGetDeviceQueue2") == 0) { return (__fn_ptr<void>)semu_vkGetDeviceQueue2; }
    if (device == null) { return SemuVulkanCore.callable(null); }
    struct SemuVulkanDevice* record = SemuVulkanCore.device(device);
    return SemuVulkanCore.callable(record != null ? SemuVulkanCore.deviceFunction(record, name) : null);
}

int semu_vkCreateInstance(const struct VkInstanceCreateInfo* create, const void* allocator, void** result) {
    SemuVulkanLinux.install();
    struct SemuLayerCreateInfo* link = (struct SemuLayerCreateInfo*)create->pNext;
    while (link != null && (link->sType != 47 || link->role != 0)) {  // LOADER_INSTANCE_CREATE_INFO, VK_LAYER_LINK_INFO
        link = (struct SemuLayerCreateInfo*)link->pNext;
    }
    if (link == null) { return -3; }  // VK_ERROR_INITIALIZATION_FAILED
    __fn_ptr<void*, void*, const char*> next;
    struct VkLayerInstanceLink_* instanceLink = (struct VkLayerInstanceLink_*)link->data;
    memcpy(&next, &instanceLink->pfnNextGetInstanceProcAddr, sizeof(next));
    link->data = (void*)instanceLink->pNext;  // the next layer sees its own link
    __fn_ptr<int, const void*, const void*, void**> nextCreate;
    SemuVulkanCore.bind(&nextCreate, next(null, "vkCreateInstance"));
    int status = nextCreate(create, allocator, result);
    if (status >= 0) { SemuVulkanCore.addInstance(*result, next); }
    return status;
}

void semu_vkDestroyInstance(void* instance, const void* allocator) {
    struct SemuVulkanInstance* record = SemuVulkanCore.instance(instance);
    if (record == null) { return; }
    __fn_ptr<void, void*, const void*> destroy;
    memcpy(&destroy, &record->destroy, sizeof(destroy));
    record->key = null;
    destroy(instance, allocator);
}

int semu_vkCreateDevice(void* physical, const struct VkDeviceCreateInfo* create, const void* allocator, void** result) {
    struct SemuLayerCreateInfo* link = (struct SemuLayerCreateInfo*)create->pNext;
    while (link != null && (link->sType != 48 || link->role != 0)) {  // LOADER_DEVICE_CREATE_INFO, VK_LAYER_LINK_INFO
        link = (struct SemuLayerCreateInfo*)link->pNext;
    }
    struct SemuLayerCreateInfo* loaderData = (struct SemuLayerCreateInfo*)create->pNext;
    while (loaderData != null && (loaderData->sType != 48 || loaderData->role != 1)) {  // VK_LOADER_DATA_CALLBACK
        loaderData = (struct SemuLayerCreateInfo*)loaderData->pNext;
    }
    struct SemuVulkanInstance* instance = SemuVulkanCore.instance(physical);
    if (link == null || instance == null) { return -3; }
    __fn_ptr<void*, void*, const char*> nextInstance;
    __fn_ptr<void*, void*, const char*> nextDevice;
    struct VkLayerDeviceLink_* deviceLink = (struct VkLayerDeviceLink_*)link->data;
    memcpy(&nextInstance, &deviceLink->pfnNextGetInstanceProcAddr, sizeof(nextInstance));
    memcpy(&nextDevice, &deviceLink->pfnNextGetDeviceProcAddr, sizeof(nextDevice));
    link->data = (void*)deviceLink->pNext;
    __fn_ptr<int, void*, const void*, const void*, void**> nextCreate;
    SemuVulkanCore.bind(&nextCreate, nextInstance(instance->handle, "vkCreateDevice"));
    return SemuVulkanCore.createDevice(instance, physical, create, allocator, result, nextCreate, nextDevice, loaderData != null ? loaderData->data : null);
}

void semu_vkDestroyDevice(void* device, const void* allocator) {
    SemuVulkanCore.destroyDevice(device, allocator);
}

void semu_vkGetDeviceQueue(void* device, uint32_t family, uint32_t index, void** queue) {
    SemuVulkanCore.deviceQueue(device, family, index, queue);
}

void semu_vkGetDeviceQueue2(void* device, const struct VkDeviceQueueInfo2* info, void** queue) {
    SemuVulkanCore.deviceQueue2(device, info, queue);
}

int semu_vkCreateSwapchainKHR(void* device, const struct VkSwapchainCreateInfoKHR* create, const void* allocator, void** result) {
    return SemuVulkanCore.createSwapchain(device, create, allocator, result);
}

void semu_vkDestroySwapchainKHR(void* device, void* swapchain, const void* allocator) {
    SemuVulkanCore.destroySwapchain(device, swapchain, allocator);
}

int semu_vkQueuePresentKHR(void* queue, const struct VkPresentInfoKHR* info) {
    return SemuVulkanCore.present(queue, info);
}

// For an emulator's touch input: Azahar's semu-touch patch finds it with dlopen RTLD_NOLOAD.
int semu_touch_unmap(float x, float y, int clamp, float* emulatorX, float* emulatorY) {
    return SemuVulkanCore.unmapTouch(x, y, clamp, emulatorX, emulatorY);
}
