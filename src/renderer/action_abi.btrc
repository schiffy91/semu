// Stable native action journal ABI shared by the input supervisor and renderer.
// Controller composition, chords, icons, and evidence markers are declarative
// Steam Deck target data and do not belong in this wire contract.

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct SemuActionRecord {
    unsigned int abi;
    unsigned int size;
    unsigned long long sequence;
    long long monotonic_ms;
    int action;
    int radial;
    int slot;
    int reserved;
    char source[16];
};

#define SEMU_ACTION_EXTENSION_CAPACITY 64
#define SEMU_ACTION_EXTENSION_ID_CAPACITY 128

struct SemuActionExtensionIdentity {
    char value[SEMU_ACTION_EXTENSION_ID_CAPACITY];
};

struct SemuActionExtensionIdentity
    SemuActionExtensionIds[SEMU_ACTION_EXTENSION_CAPACITY];
int SemuActionExtensionCount = 0;

class SemuActions {
    class int none() { return 0; }
    class int menuToggle() { return 1; }
    class int menuUp() { return 2; }
    class int menuDown() { return 3; }
    class int menuConfirm() { return 4; }
    class int menuBack() { return 5; }
    class int stateSave() { return 6; }
    class int stateLoad() { return 7; }
    class int appQuit() { return 8; }
    class int screenshot() { return 9; }
    class int escape() { return 10; }
    class int bezelsToggle() { return 11; }
    class int shadersToggle() { return 12; }
    class int extensionBase() { return 13; }
    class int extensionCapacity() { return SEMU_ACTION_EXTENSION_CAPACITY; }
    class int stateNext() { return SemuActions.extensionBase() + SemuActions.extensionCapacity(); }  // past the extension range: every older code stays
    class int statePrev() { return SemuActions.stateNext() + 1; }
    class int bezelSelect() { return SemuActions.statePrev() + 1; }  // slot carries the absolute index into the variants file's bezels
    class int shaderSelect() { return SemuActions.bezelSelect() + 1; }
    // Past 80 the slot is still an absolute index into the variants file's lists, and -1 means this
    // system has nothing to choose (the action's unavailable toast). No record restarts the game but
    // 87: an output select carries 1 in reserved when the chosen output waits for Restart Game (0: it
    // is the one running); a reset notice's slot 0 asks for the confirming press and slot 1 is done
    // (reserved 1: something waits for Restart Game). 83 carries the player in reserved plus 16
    // times its kind (0 applied, 1 saved and waiting for Restart Game); 84 the player in reserved;
    // 86 slot 1 the players page (reserved 3 rows rewritten), 0 back to the menu; 87 slot 1
    // restarting, 0 nothing to apply. 88 is the render scale's absolute index, reserved 1 while the
    // chosen scale waits for Restart Game (0: the emulator renders at it).
    class int placementSelect() { return SemuActions.shaderSelect() + 1; }  // 81: the Fit state, an index into the variants file's four placements (integer game, integer bezel, non-integer game, non-integer bezel; the two game states where there is no bezel to place)
    class int outputSelect() { return SemuActions.shaderSelect() + 2; }  // 82: the system's outputs, 4:3 or 16:9
    class int layoutSelect() { return SemuActions.shaderSelect() + 3; }  // 83: a player's controller layout
    class int playerAssign() { return SemuActions.shaderSelect() + 4; }  // 84: the pad a player holds on the players page
    class int resetNotice() { return SemuActions.shaderSelect() + 5; }  // 85: slot 0 armed, 1 done
    class int menuPage() { return SemuActions.shaderSelect() + 6; }  // 86: the players page
    class int restartNotice() { return SemuActions.shaderSelect() + 7; }  // 87: Restart Game
    class int scaleSelect() { return SemuActions.shaderSelect() + 8; }  // 88: the render scale, 1x native, 2x, 3x

    class void resetExtensions() {
        memset(SemuActionExtensionIds, 0,
            sizeof(SemuActionExtensionIds));
        SemuActionExtensionCount = 0;
    }

    class bool extensionId(string actionId) {
        return actionId.contains(".controller.");
    }

    class int extensionCode(string actionId) {
        if (!SemuActions.extensionId(actionId)) { return SemuActions.none(); }
        for (int index = 0; index < SemuActionExtensionCount; index++) {
            if (actionId.equals(SemuActionExtensionIds[index].value)) {
                return SemuActions.extensionBase() + index;
            }
        }
        if (SemuActionExtensionCount >= SemuActions.extensionCapacity()
                || actionId.len() >= SEMU_ACTION_EXTENSION_ID_CAPACITY) {
            return SemuActions.none();
        }
        snprintf(SemuActionExtensionIds[SemuActionExtensionCount].value,
            SEMU_ACTION_EXTENSION_ID_CAPACITY, "%s", actionId);
        SemuActionExtensionCount++;
        return SemuActions.extensionBase() + SemuActionExtensionCount - 1;
    }

    class string extensionIdentity(int action) {
        int slot = action - SemuActions.extensionBase();
        return slot >= 0 && slot < SemuActionExtensionCount
            ? SemuActionExtensionIds[slot].value : "";
    }

    class int code(string actionId) {
        if (actionId.equals("ui.menu")) { return SemuActions.menuToggle(); }
        if (actionId.equals("visual.bezels.toggle")) { return SemuActions.bezelsToggle(); }
        if (actionId.equals("visual.shaders.toggle")) { return SemuActions.shadersToggle(); }
        if (actionId.equals("ui.menu.up")) { return SemuActions.menuUp(); }
        if (actionId.equals("ui.menu.down")) { return SemuActions.menuDown(); }
        if (actionId.equals("ui.menu.confirm")) { return SemuActions.menuConfirm(); }
        if (actionId.equals("ui.menu.back")) { return SemuActions.menuBack(); }
        if (actionId.equals("state.save")) { return SemuActions.stateSave(); }
        if (actionId.equals("state.load")) { return SemuActions.stateLoad(); }
        if (actionId.equals("state.next")) { return SemuActions.stateNext(); }
        if (actionId.equals("state.prev")) { return SemuActions.statePrev(); }
        if (actionId.equals("visual.bezel.select")) { return SemuActions.bezelSelect(); }
        if (actionId.equals("visual.shader.select")) { return SemuActions.shaderSelect(); }
        if (actionId.equals("visual.placement.select")) { return SemuActions.placementSelect(); }
        if (actionId.equals("visual.output.select")) { return SemuActions.outputSelect(); }
        if (actionId.equals("system.reset.notice")) { return SemuActions.resetNotice(); }
        if (actionId.equals("controller.layout.select")) { return SemuActions.layoutSelect(); }
        if (actionId.equals("player.assign")) { return SemuActions.playerAssign(); }
        if (actionId.equals("ui.players.page")) { return SemuActions.menuPage(); }
        if (actionId.equals("system.restart.notice")) { return SemuActions.restartNotice(); }
        if (actionId.equals("visual.scale.select")) { return SemuActions.scaleSelect(); }
        if (actionId.equals("app.quit")) { return SemuActions.appQuit(); }
        if (actionId.equals("ui.screenshot")) { return SemuActions.screenshot(); }
        if (actionId.equals("ui.escape")) { return SemuActions.escape(); }
        return SemuActions.extensionCode(actionId);
    }

    class string id(int action) {
        if (action == SemuActions.menuToggle()) { return "ui.menu"; }
        if (action == SemuActions.bezelsToggle()) { return "visual.bezels.toggle"; }
        if (action == SemuActions.shadersToggle()) { return "visual.shaders.toggle"; }
        if (action == SemuActions.menuUp()) { return "ui.menu.up"; }
        if (action == SemuActions.menuDown()) { return "ui.menu.down"; }
        if (action == SemuActions.menuConfirm()) { return "ui.menu.confirm"; }
        if (action == SemuActions.menuBack()) { return "ui.menu.back"; }
        if (action == SemuActions.stateSave()) { return "state.save"; }
        if (action == SemuActions.stateLoad()) { return "state.load"; }
        if (action == SemuActions.stateNext()) { return "state.next"; }
        if (action == SemuActions.statePrev()) { return "state.prev"; }
        if (action == SemuActions.bezelSelect()) { return "visual.bezel.select"; }
        if (action == SemuActions.shaderSelect()) { return "visual.shader.select"; }
        if (action == SemuActions.placementSelect()) { return "visual.placement.select"; }
        if (action == SemuActions.outputSelect()) { return "visual.output.select"; }
        if (action == SemuActions.resetNotice()) { return "system.reset.notice"; }
        if (action == SemuActions.layoutSelect()) { return "controller.layout.select"; }
        if (action == SemuActions.playerAssign()) { return "player.assign"; }
        if (action == SemuActions.menuPage()) { return "ui.players.page"; }
        if (action == SemuActions.restartNotice()) { return "system.restart.notice"; }
        if (action == SemuActions.scaleSelect()) { return "visual.scale.select"; }
        if (action == SemuActions.appQuit()) { return "app.quit"; }
        if (action == SemuActions.screenshot()) { return "ui.screenshot"; }
        if (action == SemuActions.escape()) { return "ui.escape"; }
        return SemuActions.extensionIdentity(action);
    }

    class string toastAction(int action) {  // whose input.json toast a record shows: a select is the cycle's outcome
        if (action == SemuActions.bezelSelect()) { return "visual.bezel.next"; }
        if (action == SemuActions.shaderSelect()) { return "visual.shader.next"; }
        if (action == SemuActions.placementSelect()) { return "visual.placement.next"; }
        if (action == SemuActions.outputSelect()) { return "visual.output.next"; }
        if (action == SemuActions.resetNotice()) { return "system.reset"; }
        if (action == SemuActions.layoutSelect()) { return "controller.layout.next"; }
        if (action == SemuActions.playerAssign() || action == SemuActions.menuPage()) { return "ui.players"; }
        if (action == SemuActions.restartNotice()) { return "system.restart"; }
        if (action == SemuActions.scaleSelect()) { return "visual.scale.next"; }
        return SemuActions.id(action);
    }

    class bool controllerMode(int action) {
        return action >= SemuActions.extensionBase()
            && action < SemuActions.extensionBase() + SemuActionExtensionCount;
    }

    class int controllerModeSlot(int action) {
        return SemuActions.controllerMode(action)
            ? action - SemuActions.extensionBase() : -1;
    }

    class bool rendererOwned(int action) {
        return action == SemuActions.menuToggle()
            || action == SemuActions.menuUp()
            || action == SemuActions.menuDown()
            || action == SemuActions.menuConfirm()
            || action == SemuActions.menuBack()
            || action == SemuActions.stateSave()
            || action == SemuActions.stateLoad()
            || action == SemuActions.stateNext()
            || action == SemuActions.statePrev()
            || action == SemuActions.screenshot()
            || action == SemuActions.bezelsToggle()
            || action == SemuActions.shadersToggle()
            || action == SemuActions.bezelSelect()
            || action == SemuActions.shaderSelect()
            || action == SemuActions.placementSelect()
            || action == SemuActions.outputSelect()
            || action == SemuActions.resetNotice()
            || action == SemuActions.layoutSelect()
            || action == SemuActions.playerAssign()
            || action == SemuActions.menuPage()
            || action == SemuActions.restartNotice()
            || action == SemuActions.scaleSelect();
    }
}

class RendererActionJournal {
    class int abi() { return 1; }
    class string fileName() { return "semu-render-actions.bin"; }
    class string evidenceFileName() { return "semu-input-evidence.log"; }
    class string variantsFileName() { return "semu-render-variants.env"; }  // every bezel x shader combination, written at launch
    class int direct() { return 0; }
    class int quickRadial() { return 1; }
    class int menuRadial() { return 2; }
    class int systemRadial() { return 3; }
}

class SemuSlotLabel {  // records carry Semu's index; emulators show first_slot + index
    class int configured(char* name, int fallback, int largest) {  // SEMU_MENU_SLOTS or SEMU_MENU_FIRST_SLOT, the launcher's numbers
        char* value = getenv(name);
        if (value == null || value[0] == 0) { return fallback; }
        char* end = null;
        long number = strtol(value, &end, 10);
        return end != null && *end == 0 && number >= 0L && number <= (long)largest ? (int)number : fallback;
    }

    class bool text(char* buffer, int capacity, int firstSlot, int slotCount, int index) {  // "SLOT 10"; empty and false without a slot to choose
        if (buffer == null || capacity < 1) { return false; }
        buffer[0] = 0;
        if (slotCount < 2 || index < 0 || index >= slotCount || capacity < 12) { return false; }
        snprintf(buffer, (size_t)capacity, "SLOT %d", firstSlot + index);
        return true;
    }
}

class SemuToastText {  // SEMU_MENU_TOASTS "action=template|...", the input.json toasts; {slot} and {label} filled in
    class bool find(char* toasts, char* actionId, char* buffer, int capacity) {  // ACTION_ID's template; false when it declares none
        if (buffer == null || capacity < 1) { return false; }
        buffer[0] = 0;
        if (toasts == null || actionId == null || actionId[0] == 0) { return false; }
        size_t length = strlen(actionId);
        char* entry = toasts;
        while (*entry != 0) {
            char* end = strchr(entry, (int)'|');
            if (end == null) { end = entry + strlen(entry); }
            if ((size_t)(end - entry) > length && strncmp(entry, actionId, length) == 0 && entry[length] == '=') {
                int copied = (int)(end - entry - (long)length - 1L);
                if (copied > capacity - 1) { copied = capacity - 1; }
                memcpy(buffer, entry + length + 1, (size_t)copied);
                buffer[copied] = 0;
                return copied > 0;
            }
            entry = *end == '|' ? end + 1 : end;
        }
        return false;
    }

    class int append(char* buffer, int written, int capacity, char* text) {  // copies TEXT while room is left; the new length
        for (int index = 0; text != null && text[index] != 0 && written < capacity - 1; index++) {
            buffer[written] = text[index];
            written++;
        }
        return written;
    }

    class void compose(char* buffer, int capacity, char* pattern, char* slot, char* label) {  // cut to CAPACITY-1; an empty slot drops its trailing ": "
        if (buffer == null || capacity < 1) { return; }
        int written = 0;
        int index = 0;
        while (pattern != null && pattern[index] != 0 && written < capacity - 1) {
            if (strncmp(pattern + index, "{slot}", 6) == 0) {
                written = SemuToastText.append(buffer, written, capacity, slot);
                index += 6;
            } else if (strncmp(pattern + index, "{label}", 7) == 0) {
                written = SemuToastText.append(buffer, written, capacity, label);
                index += 7;
            } else {
                buffer[written] = pattern[index];
                written++;
                index++;
            }
        }
        while (written > 0 && (buffer[written - 1] == ' ' || buffer[written - 1] == ':')) { written--; }
        buffer[written] = 0;
    }
}
