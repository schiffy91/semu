// The pointer cursor Semu draws over a touch screen system, without GL: Steam's trackpad mouse is
// relative, so the player aims with this arrow. It follows the emulator's pointer sample in the
// frame, shows on motion or a press, and hides after three idle seconds. The post-UI pass uploads
// the arrow and draws it last, above the bezel and the menu.

#include <string.h>

import ./renderer_abi.btrc;

int SEMU_RENDER_CURSOR_WIDTH = 12;
int SEMU_RENDER_CURSOR_HEIGHT = 19;
int SEMU_RENDER_CURSOR_IDLE_MS = 3000;

struct RendererCursorState {
    int known;  // a sample arrived; cleared whenever the emulator stops reporting one
    int x;
    int y;
    int pressed;
    long long active_ms;  // the last motion or press, 0 before any
    unsigned char pixels[12 * 19 * 4];
};

class RendererCursor {
    class const char* row(int index) {  // B outline, W fill, space clear; the tip is the hotspot
        if (index == 0) { return "B           "; }
        if (index == 1) { return "BB          "; }
        if (index == 2) { return "BWB         "; }
        if (index == 3) { return "BWWB        "; }
        if (index == 4) { return "BWWWB       "; }
        if (index == 5) { return "BWWWWB      "; }
        if (index == 6) { return "BWWWWWB     "; }
        if (index == 7) { return "BWWWWWWB    "; }
        if (index == 8) { return "BWWWWWWWB   "; }
        if (index == 9) { return "BWWWWWWWWB  "; }
        if (index == 10) { return "BWWWWWWWWWB "; }
        if (index == 11) { return "BWWWWWWBBBBB"; }
        if (index == 12) { return "BWWWBWWB    "; }
        if (index == 13) { return "BWWBBWWB    "; }
        if (index == 14) { return "BWB  BWWB   "; }
        if (index == 15) { return "BB   BWWB   "; }
        if (index == 16) { return "B     BWWB  "; }
        if (index == 17) { return "      BWWB  "; }
        return "       BB   ";
    }

    class void raster(unsigned char* pixels) {  // RGBA rows top first, as the menu texture is
        for (int line = 0; line < SEMU_RENDER_CURSOR_HEIGHT; line++) {
            const char* text = RendererCursor.row(line);
            for (int column = 0; column < SEMU_RENDER_CURSOR_WIDTH; column++) {
                unsigned char* pixel = pixels + (line * SEMU_RENDER_CURSOR_WIDTH + column) * 4;
                unsigned char level = text[column] == 'W' ? (unsigned char)255 : (unsigned char)0;
                pixel[0] = level;
                pixel[1] = level;
                pixel[2] = level;
                pixel[3] = text[column] == ' ' ? (unsigned char)0 : (unsigned char)255;
            }
        }
    }

    class bool update(struct RendererCursorState* state, struct SemuRenderCursorGl* cursor, long long now) {  // true while the arrow should show
        if (state == null) { return false; }
        if (cursor == null || cursor->visible == 0) {  // forget it all: a returning pointer must move to show
            state->known = 0;
            state->active_ms = 0LL;
            return false;
        }
        bool moved = state->known != 0 && (cursor->x != state->x || cursor->y != state->y || cursor->pressed != state->pressed);
        bool arrivedPressed = state->known == 0 && cursor->pressed != 0;  // a first sample shows only when pressed
        if (moved || arrivedPressed) { state->active_ms = now; }
        state->known = 1;
        state->x = cursor->x;
        state->y = cursor->y;
        state->pressed = cursor->pressed;
        return RendererCursor.visible(state, now);
    }

    class bool visible(struct RendererCursorState* state, long long now) {
        return state != null && state->known != 0 && state->active_ms > 0LL
            && now - state->active_ms < (long long)SEMU_RENDER_CURSOR_IDLE_MS;
    }

    class int scale(int framebufferHeight) {  // one whole step per 400 rows: 38 pixels tall at 800
        int steps = framebufferHeight / 400;
        if (steps < 1) { return 1; }
        return steps > 8 ? 8 : steps;
    }

    class void placement(struct RendererCursorState* state, int framebufferHeight, struct RendererPixelRect* rectangle) {  // GL rows from the bottom, the tip on the pointer
        int scale = RendererCursor.scale(framebufferHeight);
        rectangle->width = SEMU_RENDER_CURSOR_WIDTH * scale;
        rectangle->height = SEMU_RENDER_CURSOR_HEIGHT * scale;
        rectangle->x = state->x;
        rectangle->y = framebufferHeight - state->y - rectangle->height;
    }
}
