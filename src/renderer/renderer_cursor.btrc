// The pointer cursor Semu draws over a touch screen system, without GL: Steam's trackpad mouse is
// relative, so the player aims with this crosshair. It follows the emulator's pointer sample in the
// frame, shows on motion or a press (held ones too), and hides after three idle seconds. Thin white
// arms with a black outline read on light and dark pictures; the centre is a clear gap, and the
// pointer (the hotspot, where a tap lands) is its middle. The post-UI pass uploads it and draws it
// last, above the bezel and the menu.

#include <string.h>

import ./renderer_abi.btrc;

int SEMU_RENDER_CURSOR_WIDTH = 15;
int SEMU_RENDER_CURSOR_HEIGHT = 15;
int SEMU_RENDER_CURSOR_HOTSPOT = 7;  // the centre cell, across and down: the clear gap's middle
int SEMU_RENDER_CURSOR_IDLE_MS = 3000;

struct RendererCursorState {
    int known;  // a sample arrived; cleared whenever the emulator stops reporting one
    int x;
    int y;
    int pressed;
    long long active_ms;  // the last motion or held press, 0 before any
    int shown;  // what the debug line last reported
    unsigned char pixels[15 * 15 * 4];
};

class RendererCursor {
    class const char* row(int index) {  // B outline, W arm, space clear; the clear centre holds the hotspot
        if (index == 0 || index == 14) { return "      BBB      "; }
        if (index == 5 || index == 9) { return "      BBB      "; }
        if (index == 6 || index == 8) { return "BBBBBB   BBBBBB"; }
        if (index == 7) { return "BWWWWB   BWWWWB"; }
        return "      BWB      ";
    }

    class void raster(unsigned char* pixels) {  // RGBA rows top first, as the menu texture is
        for (int line = 0; line < SEMU_RENDER_CURSOR_HEIGHT; line++) {
            const char* text = RendererCursor.row(line);
            for (int column = 0; column < SEMU_RENDER_CURSOR_WIDTH; column++) {
                unsigned char* pixel = pixels + (line * SEMU_RENDER_CURSOR_WIDTH + column) * 4;
                unsigned char level = text[column] == 'W' ? (unsigned char)255 : (unsigned char)0;
                pixel[0] = level;
                pixel[1] = level;
                pixel[2] = level;
                pixel[3] = text[column] == ' ' ? (unsigned char)0 : (unsigned char)255;
            }
        }
    }

    class bool update(struct RendererCursorState* state, struct SemuRenderCursorGl* cursor, long long now) {  // true while the crosshair should show
        if (state == null) { return false; }
        if (cursor == null || cursor->visible == 0) {  // forget it all: a returning pointer must move to show
            state->known = 0;
            state->active_ms = 0LL;
            return false;
        }
        bool moved = state->known != 0 && (cursor->x != state->x || cursor->y != state->y || cursor->pressed != state->pressed);
        bool held = cursor->pressed != 0;  // a held press is activity: a drag that pauses keeps its crosshair
        bool reported = cursor->visible == 2;  // an event-driven sample (Azahar): even the first one is motion; a polled first one shows only when pressed
        if (moved || held || reported) { state->active_ms = now; }
        state->known = 1;
        state->x = cursor->x;
        state->y = cursor->y;
        state->pressed = cursor->pressed;
        return RendererCursor.visible(state, now);
    }

    class bool changed(struct RendererCursorState* state, bool visible) {  // true once per show and once per hide, for the debug line
        if (state == null || state->shown == (visible ? 1 : 0)) { return false; }
        state->shown = visible ? 1 : 0;
        return true;
    }

    class bool visible(struct RendererCursorState* state, long long now) {
        return state != null && state->known != 0 && state->active_ms > 0LL
            && now - state->active_ms < (long long)SEMU_RENDER_CURSOR_IDLE_MS;
    }

    class int scale(int framebufferHeight) {  // one whole step per 400 rows: 30 pixels across at 800
        int steps = framebufferHeight / 400;
        if (steps < 1) { return 1; }
        return steps > 8 ? 8 : steps;
    }

    class int hotspot(int scale) { return SEMU_RENDER_CURSOR_HOTSPOT * scale + scale / 2; }  // the centre cell's middle pixel at a scale

    class void placement(struct RendererCursorState* state, int framebufferHeight, struct RendererPixelRect* rectangle) {  // GL rows from the bottom, the centre on the pointer
        int scale = RendererCursor.scale(framebufferHeight);
        int offset = RendererCursor.hotspot(scale);
        rectangle->width = SEMU_RENDER_CURSOR_WIDTH * scale;
        rectangle->height = SEMU_RENDER_CURSOR_HEIGHT * scale;
        rectangle->x = state->x - offset;
        rectangle->y = framebufferHeight - (state->y - offset) - rectangle->height;
    }
}
