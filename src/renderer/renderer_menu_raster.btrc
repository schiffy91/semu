// The Semu menu and the toast as RGBA bytes in the 384x468 menu texture: a 5x7 font, the rows with
// the BEZEL and SHADER values, and the toast band at the top. No GL; the post-UI pass uploads it.

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

import ./renderer_variants.btrc;
import ./renderer_menu.btrc;
import ./action_abi.btrc;

class RendererMenuRaster {
    class int rowCharacters() { return 28; }  // scale-2 glyphs from x 30 inside the 352-pixel row
    class int toastTop() { return 8; }  // the toast band's first and last rows in the texture
    class int toastBottom() { return 55; }

    class const char* glyph(char value) {
        if (value == 'A') { return "01110100011000111111100011000110001"; }
        if (value == 'B') { return "11110100011000111110100011000111110"; }
        if (value == 'C') { return "01111100001000010000100001000001111"; }
        if (value == 'D') { return "11110100011000110001100011000111110"; }
        if (value == 'E') { return "11111100001000011110100001000011111"; }
        if (value == 'F') { return "11111100001000011110100001000010000"; }
        if (value == 'G') { return "01111100001000010111100011000101111"; }
        if (value == 'H') { return "10001100011000111111100011000110001"; }
        if (value == 'I') { return "11111001000010000100001000010011111"; }
        if (value == 'J') { return "00111000100001000010000101001001100"; }
        if (value == 'K') { return "10001100101010011000101001001010001"; }
        if (value == 'L') { return "10000100001000010000100001000011111"; }
        if (value == 'M') { return "10001110111010110101100011000110001"; }
        if (value == 'N') { return "10001110011010110011100011000110001"; }
        if (value == 'O') { return "01110100011000110001100011000101110"; }
        if (value == 'P') { return "11110100011000111110100001000010000"; }
        if (value == 'Q') { return "01110100011000110001101011001001101"; }
        if (value == 'R') { return "11110100011000111110101001001010001"; }
        if (value == 'S') { return "01111100001000001110000010000111110"; }
        if (value == 'T') { return "11111001000010000100001000010000100"; }
        if (value == 'U') { return "10001100011000110001100011000101110"; }
        if (value == 'V') { return "10001100011000110001100010101000100"; }
        if (value == 'W') { return "10001100011000110101101011101110001"; }
        if (value == 'X') { return "10001010100010000100001000101010001"; }
        if (value == 'Y') { return "10001010100010000100001000010000100"; }
        if (value == 'Z') { return "11111000010001000100010001000011111"; }
        if (value == '0') { return "01110100011001110101110011000101110"; }
        if (value == '1') { return "00100011000010000100001000010001110"; }
        if (value == '2') { return "01110100010000100110010001000011111"; }
        if (value == '3') { return "11110000010000101110000010000111110"; }
        if (value == '4') { return "00010001100101010010111110001000010"; }
        if (value == '5') { return "11111100001111000001000011000101110"; }
        if (value == '6') { return "00110010001000011110100011000101110"; }
        if (value == '7') { return "11111000010001000100010000100001000"; }
        if (value == '8') { return "01110100011000101110100011000101110"; }
        if (value == '9') { return "01110100011000101111000010001001100"; }
        if (value == '/') { return "00001000100001000100010000100010000"; }
        if (value == '-') { return "00000000000000011111000000000000000"; }
        if (value == ':') { return "00000001000000000000000000010000000"; }
        if (value == '+') { return "00000001000010011111001000010000000"; }
        if (value == ',') { return "00000000000000000000001100010001000"; }
        if (value == '.') { return "00000000000000000000000000110001100"; }
        if (value == '(') { return "00010001000100001000010000010000010"; }
        if (value == ')') { return "01000001000001000010000100010001000"; }
        return "00000000000000000000000000000000000";
    }

    class void pixel(unsigned char* pixels, int x, int y,
                     unsigned char red, unsigned char green,
                     unsigned char blue, unsigned char alpha) {
        if (pixels == null || x < 0 || y < 0 || x >= SEMU_RENDER_MENU_WIDTH
            || y >= SEMU_RENDER_MENU_HEIGHT) { return; }
        int offset = (y * SEMU_RENDER_MENU_WIDTH + x) * 4;
        pixels[offset] = red;
        pixels[offset + 1] = green;
        pixels[offset + 2] = blue;
        pixels[offset + 3] = alpha;
    }

    class void rectangle(unsigned char* pixels, int x, int y,
                         int width, int height, unsigned char red,
                         unsigned char green, unsigned char blue,
                         unsigned char alpha) {
        for (int row = y; row < y + height; row++) {
            for (int column = x; column < x + width; column++) {
                RendererMenuRaster.pixel(pixels, column, row,
                    red, green, blue, alpha);
            }
        }
    }

    class void text(unsigned char* pixels, const char* value, int x, int y,
                    int scale, unsigned char red, unsigned char green,
                    unsigned char blue) {
        if (value == null) { return; }
        for (int character = 0; value[character] != 0; character++) {
            const char* glyph = RendererMenuRaster.glyph(value[character]);
            for (int row = 0; row < 7; row++) {
                for (int column = 0; column < 5; column++) {
                    if (glyph[row * 5 + column] == '1') {
                        RendererMenuRaster.rectangle(pixels,
                            x + character * 6 * scale + column * scale,
                            y + row * scale, scale, scale,
                            red, green, blue, 255);
                    }
                }
            }
        }
    }

    class int textWidth(const char* value, int scale) {  // the drawn width, without the last glyph's spacing
        int length = value == null ? 0 : (int)strlen(value);
        return length < 1 ? 0 : length * 6 * scale - scale;
    }

    class char* rowValue(struct RendererPostUiState* state, int item) {  // the BEZEL and SHADER rows' current choice, else ""
        char* action = state->actions + item * 32;
        if (strcmp(action, "visual.bezel.next") == 0) { return RendererVariantFile.label(&state->catalog, true, state->bezel_shown); }
        if (strcmp(action, "visual.shader.next") == 0) { return RendererVariantFile.label(&state->catalog, false, state->shader_shown); }
        return "";
    }

    class void rowText(struct RendererPostUiState* state, int item, char* buffer, int capacity) {  // "BEZEL  DUIMON SHELL", cut to the row
        char* value = RendererMenuRaster.rowValue(state, item);
        snprintf(buffer, (size_t)capacity, value[0] != 0 ? "%s  %s" : "%s", state->labels + item * 24, value);
        if ((int)strlen(buffer) > RendererMenuRaster.rowCharacters()) { buffer[RendererMenuRaster.rowCharacters()] = 0; }
    }

    class bool buffer(struct RendererPostUiState* state) {  // the texture's bytes, cleared to transparent
        size_t bytes = (size_t)SEMU_RENDER_MENU_WIDTH
            * (size_t)SEMU_RENDER_MENU_HEIGHT * (size_t)4;
        if (state->menu_pixels == null) {
            state->menu_pixels = (unsigned char*)malloc(bytes);
        }
        if (state->menu_pixels == null) { return false; }
        memset(state->menu_pixels, 0, bytes);
        return true;
    }

    class bool render(struct RendererPostUiState* state, long long now) {  // the menu; a toast takes the header's place
        if (state == null || !RendererMenuRaster.buffer(state)) { return false; }
        RendererMenuRaster.rectangle(state->menu_pixels, 0, 0,
            SEMU_RENDER_MENU_WIDTH, SEMU_RENDER_MENU_HEIGHT,
            14, 18, 22, 242);
        RendererMenuRaster.rectangle(state->menu_pixels, 0, 0,
            SEMU_RENDER_MENU_WIDTH, 58, 18, 112, 120, 255);
        if (RendererToast.active(state, now)) {
            RendererMenuRaster.text(state->menu_pixels, state->toast, (SEMU_RENDER_MENU_WIDTH - RendererMenuRaster.textWidth(state->toast, 2)) / 2, 22, 2, 245, 249, 250);
        } else {
            RendererMenuRaster.text(state->menu_pixels, "SEMU", 24, 16, 4, 245, 249, 250);
        }

        int count = RendererMenuModel.itemCount(state);
        char row[64];
        for (int item = 0; item < count; item++) {
            int y = 72 + item * 43;
            if (item == state->selected) {
                RendererMenuRaster.rectangle(state->menu_pixels, 16, y,
                    SEMU_RENDER_MENU_WIDTH - 32, 35, 32, 134, 142, 255);
            } else {
                RendererMenuRaster.rectangle(state->menu_pixels, 16, y,
                    SEMU_RENDER_MENU_WIDTH - 32, 35, 29, 35, 40, 232);
            }
            RendererMenuRaster.rowText(state, item, row, (int)sizeof(row));
            RendererMenuRaster.text(state->menu_pixels, row, 30, y + 8, 2, 238, 242, 244);
        }
        char slotText[16];
        if (SemuSlotLabel.text(slotText, (int)sizeof(slotText), state->first_slot, state->slot_count, state->slot)) {  // no line without a slot to choose
            RendererMenuRaster.text(state->menu_pixels, slotText, 268, 72 + count * 43 + 10, 2,
                164, 180, 184);
        }
        return true;
    }

    class bool renderToast(struct RendererPostUiState* state) {  // one band near the texture's top, the rest transparent
        if (state == null || !RendererMenuRaster.buffer(state)) { return false; }
        int width = RendererMenuRaster.textWidth(state->toast, 2) + 32;
        if (width > SEMU_RENDER_MENU_WIDTH) { width = SEMU_RENDER_MENU_WIDTH; }
        int left = (SEMU_RENDER_MENU_WIDTH - width) / 2;
        int top = RendererMenuRaster.toastTop();
        RendererMenuRaster.rectangle(state->menu_pixels, left, top, width, RendererMenuRaster.toastBottom() - top + 1, 18, 112, 120, 236);
        RendererMenuRaster.text(state->menu_pixels, state->toast, (SEMU_RENDER_MENU_WIDTH - RendererMenuRaster.textWidth(state->toast, 2)) / 2, top + 17, 2, 245, 249, 250);
        return true;
    }
}
