// A bezel or shader select applied to the renderer's config without GL: the section the request
// names replaces the variant keys, the image signature says whether the bezel images must reload,
// and the live choice is kept, so a context reset starts on it and the next select compares to it.
// A Fit press whose geometry is the one the state before it drew on this frame (integer game and integer bezel on
// a 480-line TV at 1280x800, both 1x) turns its toast into FIT: INTEGER BEZEL (SAME): it is compared with the
// state the press left, resolved again on the same frame, so the notice names exactly what did not move.

#include <stdio.h>
#include <string.h>

import ./renderer_config.btrc;
import ./renderer_variants.btrc;
import ./renderer_menu.btrc;
import ./action_abi.btrc;

int SEMU_RENDER_SWITCH_NONE = 0;  // nothing due this frame
int SEMU_RENDER_SWITCH_APPLIED = 1;
int SEMU_RENDER_SWITCH_MISSING = -1;  // the variants file lacks the requested section: the picture stays

struct RendererLiveChoice {  // the variants-file section a select applied, and the placement
    int bezel;  // -1 before any select
    int shader;
    int placement;  // RendererConfig.placement a placement select set; -1 before any
    int placement_compare;  // a placement applied this frame: once its geometry resolves it is compared with the state before
    int placement_before;  // RendererConfig.placement when that select applied: what the press left
    struct RendererVariantOverlay overlay;  // that section's keys, re-applied over a freshly loaded config
};

class RendererLiveSwitch {
    class void reset(struct RendererLiveChoice* live) {  // no select applied yet: the launch's own section
        memset(live, 0, sizeof(struct RendererLiveChoice));
        live->bezel = -1;
        live->shader = -1;
        live->placement = -1;
    }

    class int apply(struct RendererPostUiState* state, struct RendererConfig* config, struct RendererLiveChoice* live, int* imagesStale) {  // SEMU_RENDER_SWITCH_*, once the request's countdown ends
        int bezel = -1;
        int shader = -1;
        if (!RendererVariantRequests.due(state, live->bezel, live->shader, &bezel, &shader)) { return SEMU_RENDER_SWITCH_NONE; }
        char path[8192];
        struct RendererVariantOverlay next;
        if (!RendererStatePaths.path(path, sizeof(path), RendererActionJournal.variantsFileName())
                || !RendererVariantFile.section(path, bezel, shader, &next)) {
            fprintf(stderr, "semu-renderer: the variants file has no section [%d,%d]; the picture stays\n", bezel, shader);
            return SEMU_RENDER_SWITCH_MISSING;
        }
        RendererVariantFile.discard(&live->overlay);
        memcpy(&live->overlay, &next, sizeof(struct RendererVariantOverlay));  // the live choice owns the text now
        unsigned long long images = RendererConfiguration.imageSignature(config);
        RendererConfiguration.reloadVariants(config, &live->overlay);
        if (RendererConfiguration.imageSignature(config) != images) { *imagesStale = 1; }  // a shader-only change decodes nothing
        live->bezel = bezel;
        live->shader = shader;
        return SEMU_RENDER_SWITCH_APPLIED;
    }

    class int applyPlacement(struct RendererPostUiState* state, struct RendererConfig* config, struct RendererLiveChoice* live) {  // a placement select, once the countdown ends: the geometry follows next frame, nothing reloads
        if (state == null || state->placement_request < 0 || state->apply_countdown > 0) { return SEMU_RENDER_SWITCH_NONE; }
        char* placement = RendererVariantFile.placementId(&state->catalog, state->placement_request);
        state->placement_request = -1;
        if (placement[0] == 0) { return SEMU_RENDER_SWITCH_MISSING; }
        live->placement_before = config->placement;
        config->placement = RendererConfiguration.placementCode(placement);
        live->placement = config->placement;
        return SEMU_RENDER_SWITCH_APPLIED;
    }

    class void reapply(struct RendererConfig* config, struct RendererLiveChoice* live) {  // a freshly loaded config (a new context) starts on the live choice
        if (live->bezel >= 0 && live->overlay.text != null) { RendererConfiguration.reloadVariants(config, &live->overlay); }
        if (live->placement >= 0) { config->placement = live->placement; }
    }

    class bool imagesDue(int ready, int loaded, int stale) {  // a fresh context's first load, or a live choice since the last one
        return ready != 0 && (loaded == 0 || stale != 0);
    }
}

class RendererPlacementNotice {  // a Fit press that draws exactly what the state before it drew on this display says so: FIT: INTEGER BEZEL (SAME)
    class void remember(struct RendererLiveChoice* live) { live->placement_compare = 1; }  // a placement applied: compare once its geometry resolves

    class bool same(struct RendererCompositionGeometry* before, struct RendererCompositionGeometry* after) {  // the same screens and the same shell, to the pixel
        if (before->lane_count != after->lane_count || before->lane_count < 1) { return false; }
        for (int index = 0; index < after->lane_count && index < 2; index++) {
            struct RendererLaneGeometry* old = &before->lanes[index];
            struct RendererLaneGeometry* now = &after->lanes[index];
            if (old->output_x != now->output_x || old->output_y != now->output_y || old->output_width != now->output_width || old->output_height != now->output_height) { return false; }
        }
        float moved = before->bezel_x - after->bezel_x;
        float grown = before->bezel_width - after->bezel_width;
        float lifted = before->bezel_y - after->bezel_y;
        return moved * moved < 0.25f && grown * grown < 0.25f && lifted * lifted < 0.25f;
    }

    class void after(struct RendererPostUiState* state, struct RendererLiveChoice* live, struct RendererCompositionGeometry* after, struct RendererCompositionGeometry* before, long long now) {  // once the new geometry is resolved (null when it was not); BEFORE: this frame placed in the state the press left (null when it was not)
        if (live->placement_compare == 0) { return; }
        live->placement_compare = 0;
        bool noticed = state != null && state->placement_noticed != 0;
        if (state != null) { state->placement_noticed = 0; }
        if (!noticed || after == null || before == null || !RendererPlacementNotice.same(before, after)) { return; }
        char* label = RendererVariantFile.choiceLabel(&state->catalog, SemuActions.placementSelect(), state->placement_shown);
        RendererMenuModel.notice(state, SemuActions.placementSelect(), "same", label, now);
    }
}
