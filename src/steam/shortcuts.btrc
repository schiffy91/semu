import Library.Console;
import Library.FileSystem;
import Library.JSON;
import Library.Platform;
import Library.Steam.SteamShortcuts;
import Library.Strings;
import Library.Vector;
import ../lib/json.btrc;
import ../lib/paths.btrc;
import ../model.btrc;
import ../resolve.btrc;

class SemuShortcut {  // Semu's own entry in each Steam profile; the file itself is Library.Steam's
    class Vector<string> steamRoots(string steamRoot) {
        Vector<string> roots = [];
        if (!steamRoot.isEmpty()) {
            roots.push(steamRoot);
            return roots;
        }
        string home = SemuPaths.home();
        for candidate in [".steam/steam", ".local/share/Steam", ".var/app/com.valvesoftware.Steam/.local/share/Steam"] {
            string root = PathTools.join(home, candidate);
            string real = FileSystem.realPath(root);
            if (!real.isEmpty() && FileSystem.isDir(PathTools.join(real, "userdata")) && !roots.contains(real)) { roots.push(real); }
        }
        return roots;
    }

    class Vector<string> files(string steamRoot) {  // one per Steam user profile
        Vector<string> files = [];
        for root in SemuShortcut.steamRoots(steamRoot) {
            for file in SteamShortcuts.files(root) { files.push(file); }
        }
        return files;
    }

    class bool steamRunning() {  // Steam rewrites shortcuts.vdf when it exits
        string pidFile = PathTools.join(SemuPaths.home(), ".steam/steam.pid");
        if (!FileSystem.isFile(pidFile)) { return false; }
        int pid = Strings.toInt(FileSystem.readText(pidFile).trim());
        return pid > 1 && FileSystem.isDir(f"/proc/{pid}");
    }

    class JSONValue definition(SemuPlan plan) { return SemuJson.get(plan.target.definition, "steam"); }

    class string name(SemuPlan plan) {
        string name = SemuJson.textAt(SemuShortcut.definition(plan), "name");
        return name.isEmpty() ? "Semu" : name;
    }

    class string launcher(SemuPlan plan) { return plan.tokens.resolve(SemuJson.textAt(SemuShortcut.definition(plan), "launcher")); }

    class string startDir(SemuPlan plan) {
        string directory = plan.tokens.resolve(SemuJson.textAt(SemuShortcut.definition(plan), "start_dir"));
        return directory.isEmpty() ? SemuPaths.home() : directory;
    }

    class int install(SemuPlan plan, string steamRoot, bool force) {
        string launcher = SemuShortcut.launcher(plan);
        if (launcher.isEmpty() || launcher.contains("${")) {
            Console.error("semu: target " + plan.target.id + " declares no steam.launcher");
            return 1;
        }
        Vector<string> files = SemuShortcut.files(steamRoot);
        if (files.isEmpty()) {
            Console.error("semu: no Steam user profile found (userdata/<id>/config); log into Steam once first");
            return 1;
        }
        if (steamRoot.isEmpty() && !force && SemuShortcut.steamRunning()) {
            Console.error("semu: Steam is running and would overwrite the shortcut on exit; quit Steam first or pass --force");
            return 1;
        }
        for file in files {
            try {  // an entry that is already right keeps its play time and tags
                SteamShortcuts shortcuts = SteamShortcuts.read(file);
                SteamShortcut entry = shortcuts.ensure(SemuShortcut.name(plan), launcher, SemuShortcut.startDir(plan), Platform.hostname());
                shortcuts.write(file);
                Console.log(f"{file}: {entry.name} -> {entry.executable} ({entry.launchUrl()})");
            } catch (string error) {
                Console.error(f"semu: {file}: {error}; not rewriting it");
                return 1;
            }
        }
        return 0;
    }

    class int status(SemuPlan plan, string steamRoot) {
        Vector<string> files = SemuShortcut.files(steamRoot);
        if (files.isEmpty()) {
            Console.log("no Steam user profile found");
            return 1;
        }
        int missing = 0;
        for file in files {
            try {
                SteamShortcuts shortcuts = SteamShortcuts.read(file);
                SteamShortcut? entry = shortcuts.find(SemuShortcut.name(plan));
                if (entry == null) {
                    for other in shortcuts.entries { if (other.runs(SemuShortcut.launcher(plan))) { entry = other; break; } }
                }
                if (entry == null) {
                    missing++;
                    Console.log(f"{file}: no Semu shortcut ({shortcuts.entries.size()} entries)");
                } else {
                    Console.log(f"{file}: {entry.name} -> {entry.executable} ({entry.launchUrl()})");
                }
            } catch (string error) {
                missing++;
                Console.log(f"{file}: unreadable ({error})");
            }
        }
        return missing == 0 ? 0 : 1;
    }
}
