import Library.Bytes;
import Library.Console;
import Library.FileSystem;
import Library.IO;
import Library.JSON;
import Library.Strings;
import Library.Vector;
import ../lib/json.btrc;
import ../lib/paths.btrc;
import ../model.btrc;
import ../resolve.btrc;
import ./shortcuts.btrc;
import ./configset.btrc;
import ./input_document.btrc;
import ./input_rules.btrc;
import ./input_vdf.btrc;

class SteamInputTemplates {  // templates, icons, user profiles and their configset entries
    class string source(SemuPlan plan) {  // the target's steam.input, one definition the Linux targets share
        string relative = SemuJson.textAt(plan.target.definition, "steam.input");
        return relative.isEmpty() ? "" : PathTools.join(plan.configRoot, relative);
    }

    class bool copyBytes(string source, string destination) {  // PNGs carry NUL bytes, so never through text
        Bytes content = SemuPaths.readBytes(source);
        if (content.isEmpty() || FileSystem.isSymlink(destination)) { return false; }
        File file = File(destination, "wb");
        if (!file.ok()) { return false; }
        bool wrote = file.writeBytes(content);
        return file.close() && wrote;
    }

    class JSONValue definition(SemuPlan plan) {  // null after saying why
        string source = SteamInputTemplates.source(plan);
        if (source.isEmpty() || !FileSystem.isFile(source)) {
            Console.error("semu: target " + plan.target.id + " has no Steam Input definition (steam.input: " + source + ")");
            return null;
        }
        JSONValue root = SemuJson.readFile(source);
        if (root.isError()) {
            Console.error("semu: cannot parse " + source);
            return null;
        }
        Vector<string> problems = SteamInputRules.problems(SteamInputDocument(root));
        for problem in problems { Console.error("semu: " + source + ": " + problem); }
        return problems.isEmpty() ? root : null;
    }

    class int publish(SemuPlan plan, string outputDirectory, string iconDirectory) {
        JSONValue root = SteamInputTemplates.definition(plan);
        if (root == null) { return 1; }
        SteamInputDocument document = SteamInputDocument(root);
        JSONValue templates = document.templates();
        SemuPaths.prepareDirectory(outputDirectory);
        for (int index = 0; index < templates.size(); index++) {
            JSONValue template = templates.at(index);
            string file = PathTools.join(outputDirectory, SemuJson.textAt(template, "output"));
            if (!SemuPaths.writeOwned(outputDirectory, file, SteamInputVdf.render(document, template))) {
                Console.error("semu: could not write " + file);
                return 1;
            }
            Console.log(file);
        }
        string icons = PathTools.join(PathTools.dirname(SteamInputTemplates.source(plan)), "icons");
        if (!iconDirectory.isEmpty() && FileSystem.isDir(icons)) {
            if (!SemuPaths.prepareDirectory(iconDirectory)) {
                Console.error("semu: refusing icon directory " + iconDirectory + " (a symlink or not creatable)");
                return 1;
            }
            for name in SemuModel.sortedEntries(icons) {
                if (!name.endsWith(".png")) { continue; }
                if (!SteamInputTemplates.copyBytes(PathTools.join(icons, name), PathTools.join(iconDirectory, name))) {
                    Console.error("semu: could not copy icon " + name);
                    return 1;
                }
            }
            Console.log(iconDirectory + " (icons)");
        }
        return 0;
    }

    class string place(string pattern, string steamRoot, string user, string application) {  // a declared Steam path under this Steam root
        string steamDefault = "${home}/.local/share/Steam";
        string placed = pattern.startsWith(steamDefault) ? steamRoot + pattern.substring(steamDefault.len(), pattern.len() - steamDefault.len()) : pattern;
        return SemuPaths.expandHome(placed.replace("${steam_user}", user).replace("${application_id}", application));
    }

    class int install(SemuPlan plan, string steamRoot, bool chosenRoot) {  // one Steam root; Steam's own only while stopped
        if (!chosenRoot && SteamShortcuts.steamRunning()) {
            Console.error("semu: Steam is running and rewrites its controller configsets when it exits; quit Steam first (or pass --steam-root DIR)");
            return 1;
        }
        JSONValue root = SteamInputTemplates.definition(plan);
        if (root == null) { return 1; }
        JSONValue platform = SemuJson.get(root, "platforms." + plan.platform);
        if (!platform.isObject()) { Console.error("semu: no Steam Input paths for " + plan.platform); return 1; }
        string templates = SteamInputTemplates.place(SemuJson.textAt(platform, "templates_dir"), steamRoot, "", "");
        string icons = SteamInputTemplates.place(SemuJson.textAt(platform, "binding_icons_dir"), steamRoot, "", "");
        if (!SemuPaths.inside(steamRoot, templates) || !SemuPaths.inside(steamRoot, icons)) { Console.error("semu: Steam Input paths must lie inside " + steamRoot); return 1; }
        int published = SteamInputTemplates.publish(plan, templates, icons);
        if (published != 0) { return published; }
        SteamInputDocument document = SteamInputDocument(root);
        JSONValue chosen = document.defaultTemplate();
        SteamInputController controller = SteamInputController(document, SemuJson.textAt(chosen, "controller"));
        string application = SemuJson.textAt(root, "application.config_id");
        string pattern = SemuJson.textAt(platform, "application_config_dir");
        for user in SemuModel.sortedEntries(PathTools.join(steamRoot, "userdata")) {
            if (user.equals("0") || user.equals("anonymous") || !FileSystem.isDir(PathTools.join(steamRoot, "userdata/" + user))) { continue; }
            string directory = SteamInputTemplates.place(pattern, steamRoot, user, application);
            string file = PathTools.join(directory, controller.file("controller_file"));
            if (!SemuPaths.inside(steamRoot, directory) || !SemuPaths.writeOwned(steamRoot, file, SteamInputVdf.render(document, chosen))) { Console.error("semu: could not write " + file); return 1; }
            Console.log(file);
            for retired in SemuJson.strings(SemuJson.get(root, "application.deprecated_config_ids")) {  // only Semu's own file, never the folder
                string stale = PathTools.join(SteamInputTemplates.place(pattern, steamRoot, user, retired), controller.file("controller_file"));
                if (FileSystem.isFile(stale) && !FileSystem.isSymlink(stale) && SemuPaths.removeFile(stale)) { Console.log(stale + " (removed)"); }
            }
            string configset = PathTools.join(SteamInputTemplates.place(SemuJson.textAt(platform, "configset_dir"), steamRoot, user, application), controller.file("configset_file"));
            string outcome = "";
            if (!SemuPaths.inside(steamRoot, configset) || SteamConfigset.write(steamRoot, configset, application, &outcome) < 0) { Console.error("semu: " + (outcome.isEmpty() ? "refusing " + configset : outcome)); return 1; }
            Console.log(outcome);
        }
        return 0;
    }
}
