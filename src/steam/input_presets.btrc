import Library.JSON;
import Library.Strings;
import Library.Vector;
import ../lib/json.btrc;
import ./input_document.btrc;

class SteamInputHold {  // held, it enters the preset; released, back to gamepad
    public string input;
    public string activator;

    public SteamInputHold(string input, string activator) {
        self.input = input;
        self.activator = activator.isEmpty() ? "Full_Press" : activator;
    }
}

class SteamInputPreset {  // one Steam preset: the group each source drives
    public int index;
    public string title;
    public JSONValue sources;  // source -> group kind, in declared order
    public bool hotkeys;
    public int layer;  // the system layer it shows, or -1
    public Vector<SteamInputHold> holds;

    public SteamInputPreset(int index, string title, JSONValue sources, bool hotkeys, int layer) {
        self.index = index;
        self.title = title;
        self.sources = sources;
        self.hotkeys = hotkeys;
        self.layer = layer;
        self.holds = [];
    }

    public string name() { return self.index == 0 ? "Default" : "Preset_" + Strings.fromInt(1000000 + self.index); }
    public string enter() { return "controller_action CHANGE_PRESET " + Strings.fromInt(self.index + 1) + " 0 0"; }

    public bool heldBy(string input) {
        for hold in self.holds { if (hold.input.equals(input)) { return true; } }
        return false;
    }

    public Vector<string> sourceNames() {
        Vector<string> names = [];
        if (self.sources != null && self.sources.isObject()) { names = self.sources.keys(); }
        return names;
    }

    public string kind(string source) { return SemuJson.textAt(self.sources, source); }
}

class SteamInputPresets {  // the layout's presets, then each layer its grips reach
    class Vector<SteamInputPreset> ordered(SteamInputDocument document, SteamInputController controller) {
        Vector<SteamInputPreset> presets = [];
        JSONValue declared = controller.layout.get("presets");
        for (int index = 0; declared != null && declared.isArray() && index < declared.size(); index++) {
            JSONValue row = declared.at(index);
            SteamInputPreset preset = SteamInputPreset(presets.size(), SemuJson.textAt(row, "title"), row.get("sources"), SemuJson.boolAt(row, "hotkeys", false), -1);
            JSONValue holds = row.get("held_by");
            for (int hold = 0; holds != null && holds.isArray() && hold < holds.size(); hold++) {
                preset.holds.push(SteamInputHold(SemuJson.textAt(holds.at(hold), "input"), SemuJson.textAt(holds.at(hold), "activator")));
            }
            presets.push(preset);
        }
        JSONValue layers = document.layers();
        for (int index = 0; layers.isArray() && index < layers.size(); index++) {
            Vector<string> activators = SemuJson.strings(layers.at(index).get("activators"));
            bool reachable = !activators.isEmpty();
            for activator in activators { if (controller.grip(activator).isEmpty()) { reachable = false; } }
            if (!reachable) { continue; }  // a controller without those grips gets no such layer
            SteamInputPreset preset = SteamInputPreset(presets.size(), SemuJson.textAt(layers.at(index), "name"), controller.layout.get("layer_sources"), false, index);
            for activator in activators { preset.holds.push(SteamInputHold(controller.grip(activator), "")); }
            presets.push(preset);
        }
        return presets;
    }
}
