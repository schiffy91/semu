import Library.CLI;
import Library.Console;
import Library.FileSystem;
import Library.JSON;
import Library.Platform;
import Library.Strings;
import Library.Vector;
import ./lib/json.btrc;
import ./lib/paths.btrc;
import ./lib/settings.btrc;
import ./model.btrc;
import ./resolve.btrc;
import ./check.btrc;
import ./emit/esde.btrc;
import ./emit/profiles.btrc;
import ./emit/settings_ui.btrc;
import ./launch/plan.btrc;
import ./emit/rendering.btrc;
import ./launch/process.btrc;
import ./launch/supervisor.btrc;
import ./sync/syncthing.btrc;
import ./steam/shortcuts.btrc;
import ./steam/input_template.btrc;
import ./bezel/editor.btrc;

class SemuCli {
    public CLIArgs args;
    public CLICommandLine line;

    public SemuCli(CLIArgs args) {
        self.args = args;
        self.line = CLICommandLine.parse(args);
    }

    class string version() { return "0.2.0"; }

    public int usage(int code) {
        var help = CLIHelp();
        help.line("Usage: semu <command> [options]");
        help.section("Commands");
        help.item("build configs --target T [--output DIR]", "Emit ES-DE documents and emulator profiles.");
        help.item("prepare --target T [--es-de-home DIR]", "Install ES-DE documents and settings into the ES-DE home.");
        help.item("launch EMULATOR --system S --rom PATH [--core C] [--print-plan]", "Launch a ROM; the configured quit chord ends it.");
        help.item("render-env --system S [--emulator E]", "Print the SEMU_RENDER_* environment the launcher would give the emulator (bezel package, shaders, screens).");
        help.item("doctor --target T", "Show resolved paths and what is missing.");
        help.item("path NAME --target T", "Print one resolved path (roms, bios, esde_home, state_root, ...).");
        help.item("settings get PATH | put PATH VALUE [--apply] | ui | reset", "Read, write, describe (ES-DE menu document) or reset $SEMU_HOME/semu.json.");
        help.item("sync start | stop | run | status | device-id | enabled", "Syncthing for saves: detach, run in the foreground, inspect, print this device's id.");
        help.item("steam shortcuts [--steam-root DIR] [--force] | status", "Add or refresh the Semu non-Steam shortcut in every Steam profile.");
        help.item("steam input [--steam-root DIR]", "Write the target's Steam Input templates (Deck trackpad radials), their icons and each Steam user's default Semu profile.");
        help.item("bezel resolve | emit | edit [--packages a,b] [--port N]", "Mega Bezel presets: print their resolved chains, write the packages' layers and screens, or serve the bezel editor.");
        help.item("version", "Print the Semu version.");
        help.section("Common options");
        help.item("--target T", "Target id (default: $SEMU_TARGET or linux-desktop).");
        help.item("--project DIR", "Config root (default: $SEMU_SOURCE_ROOT or ./config).");
        help.item("--asset-root DIR", "Bundle root with bin/ and lib/ (default: $SEMU_ASSET_ROOT).");
        help.item("--semu-home DIR", "User settings home (default: $SEMU_HOME or ~/.config/semu).");
        help.item("--settings-json JSON", "Highest-precedence settings overlay.");
        help.print();
        return code;
    }

    public string option(string name, string fallback) { return self.line.option("--" + name, fallback); }

    public string configRoot() {
        string declared = self.option("project", Environment.get("SEMU_SOURCE_ROOT", ""));
        if (declared.isEmpty()) { declared = PathTools.join(FileSystem.currentDirectory(), "config"); }
        if (PathTools.basename(declared).equals("config") || !FileSystem.isDir(PathTools.join(declared, "config"))) { return FileSystem.absolutePath(declared); }
        return PathTools.join(FileSystem.absolutePath(declared), "config");
    }

    public string targetId() { return self.option("target", Environment.get("SEMU_TARGET", "linux-desktop")); }

    public SemuPlan resolve(SemuModel model, SemuDiagnostics diagnostics) {
        return SemuResolver.plan(model, self.targetId(), self.option("semu-home", ""), self.option("asset-root", ""), self.option("settings-json", ""), diagnostics);
    }

    public int fail(SemuDiagnostics diagnostics) {
        Console.error(diagnostics.render());
        return 1;
    }

    public int buildConfigs() {
        SemuDiagnostics diagnostics = SemuDiagnostics();
        SemuModel model = SemuModel.load(self.configRoot(), diagnostics);
        SemuPlan plan = self.resolve(model, diagnostics);
        if (!SemuChecker.check(model, plan, diagnostics)) { return self.fail(diagnostics); }
        string output = FileSystem.absolutePath(self.option("output", PathTools.join(PathTools.dirname(model.configRoot), "build/targets/" + plan.target.id)));
        if (!SemuEsDeDocuments.emit(model, plan, output, diagnostics) || !SemuProfiles.emit(model, plan, output, diagnostics)) { return self.fail(diagnostics); }
        Console.log(f"wrote {output}");
        return 0;
    }

    public int prepare() {
        SemuDiagnostics diagnostics = SemuDiagnostics();
        SemuModel model = SemuModel.load(self.configRoot(), diagnostics);
        SemuPlan plan = self.resolve(model, diagnostics);
        if (!SemuChecker.check(model, plan, diagnostics)) { return self.fail(diagnostics); }
        string esDeHome = SemuPaths.expandHome(self.option("es-de-home", Environment.get("SEMU_ES_DE_HOME", PathTools.join(plan.path("esde_home"), "ES-DE"))));
        if (!SemuEsDeDocuments.install(model, plan, esDeHome, diagnostics)) { return self.fail(diagnostics); }
        for name in ["saves", "states", "screenshots"] { SemuPaths.prepareDirectory(PathTools.join(plan.path("content_root"), name)); }
        SemuPaths.prepareDirectory(plan.stateRoot());
        Console.log(f"prepared {esDeHome}");
        return 0;
    }

    public int renderEnv() {  // tooling hook: the compiled bezel package and shader selection without launching anything
        SemuDiagnostics diagnostics = SemuDiagnostics();
        SemuModel model = SemuModel.load(self.configRoot(), diagnostics);
        SemuPlan plan = self.resolve(model, diagnostics);
        if (!SemuChecker.check(model, plan, diagnostics)) { return self.fail(diagnostics); }
        SemuSystem system = model.system(self.option("system", ""));
        if (system == null) {
            Console.error("semu: unknown system " + self.option("system", ""));
            return 1;
        }
        string emulatorId = self.option("emulator", "retroarch");
        for entry in SemuRenderEnvironment.compile(plan, system, emulatorId, PathTools.join(plan.stateRoot(), emulatorId), diagnostics) { Console.log(entry); }
        return diagnostics.ok() ? 0 : self.fail(diagnostics);
    }

    public int launch() {
        if (self.line.operandCount() < 2) { return self.usage(64); }
        SemuDiagnostics diagnostics = SemuDiagnostics();
        SemuModel model = SemuModel.load(self.configRoot(), diagnostics);
        SemuPlan plan = self.resolve(model, diagnostics);
        if (!SemuChecker.check(model, plan, diagnostics)) { return self.fail(diagnostics); }
        SemuLaunchPlan launch = SemuLauncher.plan(model, plan, self.line.operand(1), self.option("system", ""), self.option("core", ""), self.option("rom", ""), diagnostics);
        if (self.line.has("--print-plan")) {
            Console.log(launch.json());
            return launch.ok() ? 0 : 1;
        }
        if (!launch.ok()) {
            Console.error("semu: " + launch.error);
            return 1;
        }
        int child = SemuProcessGroup.start(launch.argv, launch.environment);
        if (child < 0) {
            Console.error("semu: could not start " + launch.argv.get(0));
            return 1;
        }
        return SemuSupervisor.run(child, launch);
    }

    public int path() {  // print one resolved path token, for shell wrappers
        SemuDiagnostics diagnostics = SemuDiagnostics();
        SemuModel model = SemuModel.load(self.configRoot(), diagnostics);
        SemuPlan plan = self.resolve(model, diagnostics);
        if (plan == null) { return self.fail(diagnostics); }
        string value = plan.path(self.line.operand(1, ""));
        if (value.isEmpty()) {
            Console.error("semu: unknown path " + self.line.operand(1, ""));
            return 1;
        }
        Console.log(value);
        return 0;
    }

    class JSONValue withPath(JSONValue root, Vector<string> path, int index, JSONValue value) { return SemuSettingsStore.withPath(root, path, index, value); }

    public int settingsReset(SemuPlan plan) {  // drop the user file; defaults and target settings remain
        string file = PathTools.join(plan.semuHome, "semu.json");
        if (!SemuPaths.removeFile(file)) {
            Console.error("semu: could not remove " + file);
            return 1;
        }
        Console.log("Settings reset to defaults");
        return 0;
    }

    public int settings() {  // settings get PATH | put PATH JSON [--apply] | ui | reset
        string action = self.line.operand(1, "");
        string path = self.line.operand(2, "");
        SemuDiagnostics diagnostics = SemuDiagnostics();
        SemuModel model = SemuModel.load(self.configRoot(), diagnostics);
        SemuPlan plan = self.resolve(model, diagnostics);
        if (plan == null) { return self.fail(diagnostics); }
        if (action.equals("ui")) {
            Console.log(SemuSettingsUi.document(model, plan).stringify());
            return 0;
        }
        if (action.equals("reset")) { return self.settingsReset(plan); }
        if (path.isEmpty()) { return self.usage(64); }
        if (action.equals("get")) {
            JSONValue value = SemuJson.get(plan.settings, path);
            Console.log(value == null || value.isNull() ? "null" : value.stringify());
            return 0;
        }
        if (!action.equals("put")) { return self.usage(64); }
        string raw = self.line.operand(3, "");
        JSONValue value = JSONValue.parse(raw);
        if (raw.isEmpty() || value == null || value.isError()) { value = JSONValue.makeString(raw); }  // bare words are strings
        if (!SemuSettingsStore.readable(plan.semuHome)) {  // never replace the user's file with {}
            Console.error("semu: " + PathTools.join(plan.semuHome, "semu.json") + " is not a JSON object; fix it or run 'semu settings reset'");
            return 1;
        }
        if (!SemuSettingsStore.put(plan.semuHome, path, value)) {
            Console.error("semu: could not write " + PathTools.join(plan.semuHome, "semu.json"));
            return 1;
        }
        Console.log(f"{path} = {value.stringify()}");
        return self.line.has("--apply") ? self.prepare() : 0;  // --apply refreshes the ES-DE documents
    }

    public int sync() {
        string action = self.line.operand(1, "");
        SemuDiagnostics diagnostics = SemuDiagnostics();
        SemuModel model = SemuModel.load(self.configRoot(), diagnostics);
        SemuPlan plan = self.resolve(model, diagnostics);
        if (plan == null) { return self.fail(diagnostics); }
        if (action.equals("start")) { return SemuSync.start(plan); }
        if (action.equals("run")) { return SemuSync.run(plan); }
        if (action.equals("stop")) { return SemuSync.stop(plan); }
        if (action.equals("status")) { return SemuSync.status(plan); }
        if (action.equals("enabled")) { return SemuSync.enabled(plan) ? 0 : 1; }  // for ExecCondition
        if (action.equals("device-id")) {
            string ownDevice = SemuSync.deviceId(plan);
            if (ownDevice.isEmpty()) {
                Console.error("semu: could not determine the Syncthing device id");
                return 1;
            }
            Console.log(ownDevice);
            return 0;
        }
        return self.usage(64);
    }

    public int steam() {
        string action = self.line.operand(1, "");
        SemuDiagnostics diagnostics = SemuDiagnostics();
        SemuModel model = SemuModel.load(self.configRoot(), diagnostics);
        SemuPlan plan = self.resolve(model, diagnostics);
        if (plan == null) { return self.fail(diagnostics); }
        string root = self.option("steam-root", "");
        if (action.equals("shortcuts")) { return SteamShortcuts.install(plan, root, self.line.has("--force")); }
        if (action.equals("status")) { return SteamShortcuts.status(plan, root); }
        if (action.equals("input")) {
            string steamRoot = root.isEmpty() ? PathTools.join(SemuPaths.home(), ".local/share/Steam") : SemuPaths.expandHome(root);
            return SteamInputTemplates.install(plan, steamRoot);  // every destination derives from this one root
        }
        return self.usage(64);
    }

    public int bezel() {  // bezel resolve | emit [--packages a,b] | edit [--port 8765]
        string action = self.line.operand(1, "");
        string configRoot = self.configRoot();
        BezelRepository repository = BezelRepository(configRoot);
        MegaBezelTree tree = MegaBezelTree(configRoot, MegaBezelTree.locate(configRoot, self.option("asset-root", Environment.get("SEMU_ASSET_ROOT", ""))));
        if (!tree.ready) { Console.error("bezel: " + tree.failure); return 1; }
        Vector<string> wanted = self.option("packages", "").isEmpty() ? repository.upstreamIds() : Strings.split(self.option("packages", ""), ",");
        if (action.equals("edit")) { return BezelEditor(repository, tree).serve(Strings.toInt(self.option("port", "8765"))); }
        if (action.equals("resolve")) {
            for packageId in wanted {
                JSONValue package = repository.package(packageId);
                if (package == null) { Console.error(f"{packageId}: no such package"); continue; }
                MegaBezelPreset preset = MegaBezelPreset(tree.packagePreset(package));
                Console.log(f"{packageId}: {preset.chain.size()} files, {preset.values.size()} values, {preset.textures.size()} textures" + (preset.missing.size() > 0 ? ", MISSING " + Strings.join(preset.missing, ", ") : ""));
                for name in ["HSM_NON_INTEGER_SCALE", "HSM_ASPECT_RATIO_MODE", "HSM_SCREEN_POSITION_X", "HSM_SCREEN_POSITION_Y", "HSM_DUALSCREEN_MODE", "HSM_FLIP_VIEWPORT_VERTICAL", "HSM_BZL_WIDTH", "HSM_BZL_HEIGHT", "HSM_TUBE_BLACK_EDGE_THICKNESS", "HSM_DEVICE_SCALE", "HSM_DEVICE_POS_Y"] {
                    if (preset.has(name)) { Console.log(f"    {name} = {preset.value(name)}"); }
                }
                for texture in preset.textures.keys().sorted() { Console.log(f"    {texture}: {tree.reference(preset.texture(texture))}"); }
            }
            return 0;
        }
        if (action.equals("emit")) {
            BezelPackageWriter writer = BezelPackageWriter(repository, tree);
            int failures = 0;
            for packageId in wanted {
                string failure = writer.emit(packageId);
                if (failure.isEmpty()) { Console.log(f"{packageId}: written"); } else { Console.error(f"{packageId}: {failure}"); failures++; }
            }
            for packageId in repository.packageIds() {
                JSONValue package = repository.package(packageId);
                if (package == null) { continue; }
                if (!SemuJson.textAt(package, "geometry_from").isEmpty()) { string failure = writer.inherit(packageId); Console.log(failure.isEmpty() ? f"{packageId}: geometry inherited" : f"{packageId}: {failure}"); }
                else if (package.get("upstream") == null || !package.get("upstream").isObject()) { string failure = writer.plain(packageId); if (!failure.isEmpty()) { Console.error(f"{packageId}: {failure}"); failures++; } }
            }
            return failures == 0 ? 0 : 1;
        }
        return self.usage(64);
    }

    public int doctor() {
        SemuDiagnostics diagnostics = SemuDiagnostics();
        SemuModel model = SemuModel.load(self.configRoot(), diagnostics);
        SemuPlan plan = self.resolve(model, diagnostics);
        if (plan == null) { return self.fail(diagnostics); }
        SemuChecker.check(model, plan, diagnostics);
        Console.log(f"target: {plan.target.id} ({plan.platform})");
        Console.log(f"config: {model.configRoot}");
        Console.log(f"asset root: {plan.assetRoot}");
        Console.log(f"semu home: {plan.semuHome}");
        for name in plan.tokens.values.keys().sorted() {
            if (!name.startsWith("paths.")) { continue; }
            string value = plan.tokens.get(name);
            string state = FileSystem.isDir(value) ? "ok" : "missing";
            Console.log(f"  {name.substring(6, name.len() - 6)}: {value} [{state}]");
        }
        Console.log(f"systems: {plan.systems.join(" ")}");
        Console.log(f"emulators: {plan.emulators.join(" ")}");
        for emulatorId in plan.emulators {
            SemuEmulator emulator = model.emulator(emulatorId);
            string executable = plan.tokens.resolve(SemuJson.textAt(emulator.platform(plan.platform), "executable"));
            string state = FileSystem.isFile(executable) ? "ok" : "missing";
            Console.log(f"  {emulatorId}: {executable} [{state}]");
        }
        if (!diagnostics.ok()) { Console.log("problems:\n" + diagnostics.render()); }
        return diagnostics.ok() ? 0 : 1;
    }

    public bool helpRequested() {  // --help is an option; -h and help arrive as operands
        if (self.line.has("--help")) { return true; }
        for (int index = 0; index < self.line.operandCount(); index++) {
            string operand = self.line.operand(index, "");
            if (operand.equals("-h") || (index == 0 && operand.equals("help"))) { return true; }
        }
        return false;
    }

    public int run() {
        if (!self.line.ok()) {
            Console.error(self.line.errors.join("\n"));
            return self.usage(64);
        }
        string command = self.line.operand(0, "");
        if (self.helpRequested()) { return self.usage(0); }  // help on any command changes nothing
        if (command.equals("build") && self.line.operand(1, "").equals("configs")) { return self.buildConfigs(); }
        if (command.equals("prepare")) { return self.prepare(); }
        if (command.equals("launch")) { return self.launch(); }
        if (command.equals("render-env")) { return self.renderEnv(); }
        if (command.equals("doctor")) { return self.doctor(); }
        if (command.equals("path")) { return self.path(); }
        if (command.equals("settings")) { return self.settings(); }
        if (command.equals("sync")) { return self.sync(); }
        if (command.equals("steam")) { return self.steam(); }
        if (command.equals("bezel")) { return self.bezel(); }
        if (command.equals("version")) {
            Console.log(SemuCli.version());
            return 0;
        }
        return self.usage(command.isEmpty() || command.equals("help") ? 0 : 64);
    }
}
