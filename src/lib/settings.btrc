import Library.FileSystem;
import Library.JSON;
import Library.Strings;
import Library.Vector;
import ./json.btrc;
import ./paths.btrc;

class SemuSettingsStore {  // $SEMU_HOME/semu.json: the one user-owned settings file
    class JSONValue withPath(JSONValue root, Vector<string> path, int index, JSONValue value) {  // immutable deep set
        JSONValue result = JSONValue.makeObject();
        if (root != null && root.isObject()) { for key in root.keys() { result.set(key, root.get(key)); } }
        if (index == path.size() - 1) {
            result.set(path.get(index), value);
            return result;
        }
        JSONValue child = result.has(path.get(index)) ? result.get(path.get(index)) : JSONValue.makeObject();
        result.set(path.get(index), SemuSettingsStore.withPath(child.isObject() ? child : JSONValue.makeObject(), path, index + 1, value));
        return result;
    }

    class JSONValue withoutPath(JSONValue root, Vector<string> path, int index) {  // immutable deep delete: the named subtree goes, its siblings stay
        JSONValue result = JSONValue.makeObject();
        if (root == null || !root.isObject()) { return result; }
        string name = path.get(index);
        for key in root.keys() {
            if (!key.equals(name)) {
                result.set(key, root.get(key));
            } else if (index < path.size() - 1 && root.get(key).isObject()) {
                result.set(key, SemuSettingsStore.withoutPath(root.get(key), path, index + 1));
            }
        }
        return result;
    }

    class bool readable(string semuHome) {  // absent, or a JSON object; malformed files are never replaced
        string file = PathTools.join(semuHome, "semu.json");
        if (!FileSystem.exists(file)) { return true; }
        JSONValue current = FileSystem.isFile(file) ? SemuJson.readFile(file) : null;
        return current != null && !current.isError() && current.isObject();
    }

    class JSONValue current(string semuHome) {  // the file's object, or an empty one when there is none, brought to M16's Fit states so every save writes them (SemuSettingsMigration)
        string file = PathTools.join(semuHome, "semu.json");
        return SemuSettingsMigration.fitStates(FileSystem.isFile(file) ? SemuJson.readFile(file) : JSONValue.makeObject());
    }

    class bool put(string semuHome, string path, JSONValue value) {  // false, file untouched, when semu.json is malformed
        return SemuSettingsStore.putPath(semuHome, Strings.split(path, "."), value);
    }

    class bool putPath(string semuHome, Vector<string> path, JSONValue value) {  // the path's parts may hold dots, e.g. a game's file name
        if (path.isEmpty() || !SemuSettingsStore.readable(semuHome)) { return false; }
        JSONValue updated = SemuSettingsStore.withPath(SemuSettingsStore.current(semuHome), path, 0, value);
        return SemuPaths.writeOwned(semuHome, PathTools.join(semuHome, "semu.json"), updated.stringifyPretty(2) + "\n");
    }

    class bool remove(string semuHome, string path) {  // false, file untouched, when semu.json is malformed; nothing to remove is fine
        return SemuSettingsStore.removePath(semuHome, Strings.split(path, "."));
    }

    class bool removePath(string semuHome, Vector<string> path) {
        if (path.isEmpty() || !SemuSettingsStore.readable(semuHome)) { return false; }
        if (!FileSystem.isFile(PathTools.join(semuHome, "semu.json"))) { return true; }
        JSONValue updated = SemuSettingsStore.withoutPath(SemuSettingsStore.current(semuHome), path, 0);
        return SemuPaths.writeOwned(semuHome, PathTools.join(semuHome, "semu.json"), updated.stringifyPretty(2) + "\n");
    }
}

// A semu.json saved before M16's four Fit states (the review round of M16 item 7). Until M16 the four 480-line consoles
// (wii, gc, ps2 and dreamcast) carried display.scaling.game_fractional_below: 2, so a saved Fit: Screen ("game"), or
// the global placement "game" they inherited, filled the Deck's 800 rows (1067x800); M16 reads "game" as integer game,
// 1x there, a third smaller than what the owner chose. Once, a file without the marker visual.fit_states takes those
// systems' "game" as non-integer game and gains the marker with its next save (every save goes through
// SemuSettingsStore.current), so a "game" saved under M16 stays integer game. Docked at 1920x1080 the old "game" drew
// 2x (1280x960), the migrated state 1440x1080. Reversible: drop the two calls (SemuSettingsStore.current, SemuResolver.plan).
class SemuSettingsMigration {
    class Vector<string> fractionalGame() { return ["wii", "gc", "ps2", "dreamcast"]; }  // the systems that carried game_fractional_below until M16 (a frozen fact of the old builds, not a setting)

    class int fitStatesMarker() { return 4; }

    class JSONValue fitStates(JSONValue settings) {  // SETTINGS with the old Fit: Screen read as non-integer game and the marker set; anything else as it is
        if (settings == null || settings.isError() || !settings.isObject()) { return settings; }
        JSONValue visual = settings.get("visual");
        if (visual != null && visual.isObject() && visual.has("fit_states")) { return settings; }
        JSONValue result = settings;
        bool inherited = SemuJson.textAt(settings, "visual.placement").equals("game");
        for system in SemuSettingsMigration.fractionalGame() {
            string saved = SemuJson.textAt(settings, "visual.systems." + system + ".placement");
            if (saved.equals("game") || (saved.isEmpty() && inherited)) {
                result = SemuSettingsStore.withPath(result, ["visual", "systems", system, "placement"], 0, JSONValue.makeString("game_fractional"));
            }
        }
        return SemuSettingsStore.withPath(result, ["visual", "fit_states"], 0, JSONValue.makeInt(SemuSettingsMigration.fitStatesMarker()));
    }
}
