import Library.Bytes;
import Library.FileSystem;
import Library.Platform;
import Library.Strings;
import Library.Vector;

#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>

class SemuPaths {
    class string home() { return Environment.get("HOME", ""); }

    class string expandHome(string path) {
        if (path.startsWith("~/")) { return PathTools.join(SemuPaths.home(), path.substring(2, path.len() - 2)); }
        return path.replace("${home}", SemuPaths.home());
    }

    class string normalize(string path) {  // lexical: collapses . and .. without touching the disk
        Vector<string> kept = [];
        for part in Strings.split(path, "/") {
            if (part.isEmpty() || part.equals(".")) { continue; }
            if (part.equals("..")) { if (kept.size() > 0) { kept.pop(); } continue; }
            kept.push(part);
        }
        return (path.startsWith("/") ? "/" : "") + Strings.join(kept, "/");
    }

    class bool inside(string root, string path) {  // after normalizing both, so root/../x is outside
        string normalRoot = SemuPaths.normalize(root);
        string normalPath = SemuPaths.normalize(path);
        string base = normalRoot.endsWith("/") ? normalRoot : normalRoot + "/";
        return normalPath.equals(normalRoot) || normalPath.startsWith(base);
    }

    class bool fileInside(string root, string path) {  // a real file under root's real path
        string realRoot = UnixFileSystem.realPath(root);
        string realPath = UnixFileSystem.realPath(path);
        if (realRoot.isEmpty() || realPath.isEmpty() || !SemuPaths.inside(realRoot, realPath)) { return false; }
        return FileSystem.isFile(realPath);
    }

    class bool ancestorsAreRealDirectories(string root, string path) {  // no symlink may sit between root and path
        string current = PathTools.dirname(SemuPaths.normalize(path));
        string normalRoot = SemuPaths.normalize(root);
        while (current.len() > normalRoot.len() && SemuPaths.inside(normalRoot, current)) {
            if (FileSystem.isSymlink(current)) { return false; }
            current = PathTools.dirname(current);
        }
        return !FileSystem.isSymlink(normalRoot);
    }

    class bool inSourceTree(string path) {  // under src/ or config/ of a Semu checkout, which only a person edits
        string current = PathTools.dirname(SemuPaths.normalize(path));
        while (current.len() > 1) {
            string name = PathTools.basename(current);
            string parent = PathTools.dirname(current);
            if ((name.equals("src") || name.equals("config")) && FileSystem.isFile(PathTools.join(parent, "src/semu.btrc")) && FileSystem.isDir(PathTools.join(parent, "config/systems"))) { return true; }
            current = parent;
        }
        return false;
    }

    class bool prepareDirectory(string path) {
        if (FileSystem.isSymlink(path)) { return false; }
        if (FileSystem.isDir(path)) { return true; }
        return FileSystem.mkdirp(path) == 0 && FileSystem.isDir(path);
    }

    class bool replace(string path, string content) {  // write beside, then rename over: readers never see half a file
        string temporary = path + ".semu-tmp";
        if (!FileSystem.writeText(temporary, content)) { unlink(temporary); return false; }
        if (rename(temporary, path) != 0) { unlink(temporary); return false; }
        return true;
    }

    class bool writeOwned(string root, string path, string content) {  // refuse escapes, symlinked ancestors and the source tree
        if (root.isEmpty() || !PathTools.isAbsolute(root) || !SemuPaths.inside(root, path) || SemuPaths.inSourceTree(path)) { return false; }
        string target = SemuPaths.normalize(path);
        if (!SemuPaths.prepareDirectory(root) || !SemuPaths.ancestorsAreRealDirectories(root, target)) { return false; }
        if (FileSystem.isSymlink(target) || FileSystem.isDir(target)) { return false; }
        if (!SemuPaths.prepareDirectory(PathTools.dirname(target))) { return false; }
        return SemuPaths.replace(target, content);
    }

    class bool writeSource(string configRoot, string path, string content) {  // the one way into config/: a bezel package's own bezel.json
        string relative = SemuPaths.normalize(path);
        string root = SemuPaths.normalize(configRoot);
        if (!SemuPaths.inside(root + "/bezels", relative) || !relative.endsWith("/bezel.json")) { return false; }
        Vector<string> parts = Strings.split(relative.substring(root.len() + 1, relative.len() - root.len() - 1), "/");
        if (parts.size() != 3 || FileSystem.isSymlink(relative) || !SemuPaths.ancestorsAreRealDirectories(root, relative)) { return false; }
        return SemuPaths.replace(relative, content);
    }

    class bool removeFile(string path) { return !FileSystem.isFile(path) || unlink(path) == 0; }  // missing counts as removed

    class Bytes readBytes(string path) {  // the stdlib reads only regular files, and a Nix bundle links its files into the store
        string real = UnixFileSystem.realPath(path);
        return FileSystem.readBytes(real.isEmpty() ? path : real);
    }

    class bool ownedPlace(string root, string path) {  // strictly inside an absolute root, real folders all the way down
        if (root.isEmpty() || !PathTools.isAbsolute(root) || !SemuPaths.inside(root, path) || SemuPaths.inSourceTree(path)) { return false; }
        string normal = SemuPaths.normalize(path);
        return !normal.equals(SemuPaths.normalize(root)) && SemuPaths.ancestorsAreRealDirectories(root, normal);
    }

    class bool linkOwned(string root, string path, string target) {  // a symlink made beside, then renamed in; never over a real file or folder
        if (!SemuPaths.ownedPlace(root, path)) { return false; }
        string normal = SemuPaths.normalize(path);
        if (FileSystem.exists(normal) && !FileSystem.isSymlink(normal)) { return false; }
        string temporary = normal + ".semu-link";
        if (FileSystem.isSymlink(temporary)) { unlink(temporary); }
        if (FileSystem.exists(temporary) || FileSystem.symlink(target, temporary) != 0) { return false; }
        if (rename(temporary, normal) != 0) {
            unlink(temporary);
            return false;
        }
        return true;
    }

    class bool removeOwnedLink(string root, string path, string target) {  // only a symlink that still names TARGET
        string normal = SemuPaths.normalize(path);
        if (!SemuPaths.ownedPlace(root, normal) || !FileSystem.isSymlink(normal) || !FileSystem.readLink(normal).equals(target)) { return false; }
        return unlink(normal) == 0;
    }

    class bool removeEmptyDirectory(string root, string path) {  // rmdir refuses a folder that holds anything
        string normal = SemuPaths.normalize(path);
        if (!SemuPaths.ownedPlace(root, normal) || FileSystem.isSymlink(normal) || !FileSystem.isDir(normal)) { return false; }
        return rmdir(normal) == 0;
    }

    class bool removeOwnedFile(string root, string path) {  // a regular file Semu wrote, never a link or a folder
        string normal = SemuPaths.normalize(path);
        if (!SemuPaths.ownedPlace(root, normal) || FileSystem.isSymlink(normal) || !FileSystem.isFile(normal)) { return false; }
        return unlink(normal) == 0;
    }

    class Bytes readPrefix(string path, int count) {  // the first COUNT bytes at most: a header, never a whole pack
        Bytes result = Bytes();
        if (count < 1 || !FileSystem.isFile(path)) { return result; }
        FILE* file = fopen(path, "rb");
        if (file == null) { return result; }
        char* buffer = (char*)malloc((size_t)count);
        if (buffer != null) {
            size_t received = fread(buffer, 1, (size_t)count, file);
            result.appendRaw(buffer, (int)received);
            free(buffer);
        }
        fclose(file);
        return result;
    }
}
