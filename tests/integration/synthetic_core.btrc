// A content-free libretro core that draws a test card, so RetroArch can run headless without a ROM.
// It honors the Semu surface contract (SEMU_RENDER_SURFACE_COUNT and SURFACE_<n>_NATIVE): one
// card per declared screen, stacked top over bottom at native size, the way dual-screen cores do.

#include <libretro.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

__fn_ptr<bool, unsigned int, void*> SyntheticEnvironment;
__fn_ptr<void, const void*, unsigned int, unsigned int, size_t> SyntheticVideo;
__fn_ptr<void, int16_t, int16_t> SyntheticAudio;
__fn_ptr<size_t, const int16_t*, size_t> SyntheticAudioBatch;
__fn_ptr<void> SyntheticInputPoll;
__fn_ptr<int16_t, unsigned int, unsigned int, unsigned int, unsigned int> SyntheticInputState;
uint32_t SyntheticPixels[1024 * 1024];
unsigned long long SyntheticFrame;
int SyntheticScreens;
int SyntheticWidths[2];
int SyntheticHeights[2];
int SyntheticFrameWidth;
int SyntheticFrameHeight;
float SyntheticAspect;
int SyntheticFlat;

class SyntheticGeometry {
    class void load() {  // the launcher's surface contract, else the classic 256x240 card
        SyntheticScreens = 1;
        SyntheticWidths[0] = 256;
        SyntheticHeights[0] = 240;
        SyntheticWidths[1] = 0;
        SyntheticHeights[1] = 0;
        char* count = getenv("SEMU_RENDER_SURFACE_COUNT");
        int screens = count == null ? 1 : atoi(count);
        if (screens < 1 || screens > 2) { screens = 1; }
        for (int index = 0; index < screens; index++) {
            char name[64];
            snprintf(name, sizeof(name), "SEMU_RENDER_SURFACE_%d_NATIVE", index);
            char* native = getenv(name);
            int width = 0;
            int height = 0;
            if (native != null && sscanf(native, "%dx%d", &width, &height) == 2 && width > 0 && height > 0 && width <= 1024 && height <= 512) {
                SyntheticWidths[index] = width;
                SyntheticHeights[index] = height;
                SyntheticScreens = index + 1;
            }
        }
        SyntheticFrameWidth = SyntheticWidths[0] > SyntheticWidths[1] ? SyntheticWidths[0] : SyntheticWidths[1];
        SyntheticFrameHeight = SyntheticHeights[0] + SyntheticHeights[1];
        SyntheticAspect = (float)SyntheticFrameWidth / (float)SyntheticFrameHeight;
        int aspectWidth = 0;
        int aspectHeight = 0;
        char* aspect = getenv("SEMU_RENDER_ASPECT");  // single screens present at the system's display aspect, as the launcher declares it
        if (SyntheticScreens == 1 && aspect != null && sscanf(aspect, "%d:%d", &aspectWidth, &aspectHeight) == 2 && aspectWidth > 0 && aspectHeight > 0) {
            SyntheticAspect = (float)aspectWidth / (float)aspectHeight;
        }
        char* flat = getenv("SEMU_SYNTHETIC_FLAT");  // calibration: a bit per lit screen (1 = first, 2 = second), lit screens are one flat saturated color, the rest black
        SyntheticFlat = flat == null ? 0 : atoi(flat);
    }
}

class SyntheticPattern {
    class uint32_t color(int red, int green, int blue) {
        return 0xff000000u | ((uint32_t)red << 16) | ((uint32_t)green << 8) | (uint32_t)blue;
    }

    class void card(int screen, int originX, int originY, int width, int height) {  // border, checker corners, crosshair, a moving marker; hue differs per screen
        if (SyntheticFlat != 0) {
            bool lit = ((SyntheticFlat >> screen) & 1) != 0;
            uint32_t flat = !lit ? SyntheticPattern.color(16, 16, 16) : (screen == 0 ? SyntheticPattern.color(0, 255, 0) : SyntheticPattern.color(255, 0, 255));  // never fully black: Mega Bezel blanks on an all-black source
            for (int y = 0; y < height; y++) {
                for (int x = 0; x < width; x++) { SyntheticPixels[(originY + y) * SyntheticFrameWidth + originX + x] = flat; }
            }
            return;
        }
        uint32_t sky = screen == 0 ? SyntheticPattern.color(48, 96, 224) : SyntheticPattern.color(200, 72, 48);
        uint32_t ground = screen == 0 ? SyntheticPattern.color(48, 200, 64) : SyntheticPattern.color(232, 176, 40);
        uint32_t border = SyntheticPattern.color(255, 255, 255);
        uint32_t dark = SyntheticPattern.color(16, 16, 16);
        uint32_t marker = SyntheticPattern.color(240, 224, 24);
        int horizon = height * 2 / 3;
        int cell = width >= 320 ? 16 : 8;
        for (int y = 0; y < height; y++) {
            for (int x = 0; x < width; x++) {
                uint32_t value = y < horizon ? sky : ground;
                bool edge = x < 2 || y < 2 || x >= width - 2 || y >= height - 2;
                bool corner = (x < cell * 4 || x >= width - cell * 4) && (y < cell * 4 || y >= height - cell * 4);
                bool cross = x == width / 2 || y == height / 2;
                if (corner) { value = ((x / cell + y / cell) % 2 == 0) ? border : dark; }
                if (cross) { value = border; }
                if (edge) { value = border; }
                SyntheticPixels[(originY + y) * SyntheticFrameWidth + originX + x] = value;
            }
        }
        int tick = (int)(SyntheticFrame % (unsigned long long)(width > 40 ? width - 40 : 1));
        for (int y = height / 2 - 12; y < height / 2 + 12; y++) {
            for (int x = tick + 4; x < tick + 36 && x < width; x++) { SyntheticPixels[(originY + y) * SyntheticFrameWidth + originX + x] = marker; }
        }
    }

    class void fill() {
        for (int index = 0; index < SyntheticFrameWidth * SyntheticFrameHeight; index++) { SyntheticPixels[index] = 0xff000000u; }
        int originY = 0;
        for (int screen = 0; screen < SyntheticScreens; screen++) {  // narrower screens sit centered, as Azahar stacks 320 under 400
            int originX = (SyntheticFrameWidth - SyntheticWidths[screen]) / 2;
            SyntheticPattern.card(screen, originX, originY, SyntheticWidths[screen], SyntheticHeights[screen]);
            originY += SyntheticHeights[screen];
        }
    }
}

void retro_init() { SyntheticFrame = 0ULL; SyntheticGeometry.load(); }
void retro_deinit() {}
unsigned int retro_api_version() { return RETRO_API_VERSION; }
void retro_set_environment(__fn_ptr<bool, unsigned int, void*> callback) { SyntheticEnvironment = callback; }
void retro_set_video_refresh(__fn_ptr<void, const void*, unsigned int, unsigned int, size_t> callback) { SyntheticVideo = callback; }
void retro_set_audio_sample(__fn_ptr<void, int16_t, int16_t> callback) { SyntheticAudio = callback; }
void retro_set_audio_sample_batch(__fn_ptr<size_t, const int16_t*, size_t> callback) { SyntheticAudioBatch = callback; }
void retro_set_input_poll(__fn_ptr<void> callback) { SyntheticInputPoll = callback; }
void retro_set_input_state(__fn_ptr<int16_t, unsigned int, unsigned int, unsigned int, unsigned int> callback) { SyntheticInputState = callback; }

void retro_get_system_info(struct retro_system_info* info) {
    memset(info, 0, sizeof(*info));
    info->library_name = "Semu Synthetic";
    info->library_version = "1";
    info->valid_extensions = "semu";
    info->need_fullpath = false;
    info->block_extract = false;
}

void retro_get_system_av_info(struct retro_system_av_info* info) {
    memset(info, 0, sizeof(*info));
    SyntheticGeometry.load();
    info->geometry.base_width = (unsigned int)SyntheticFrameWidth;
    info->geometry.base_height = (unsigned int)SyntheticFrameHeight;
    info->geometry.max_width = 1024;
    info->geometry.max_height = 1024;
    info->geometry.aspect_ratio = SyntheticAspect;
    info->timing.fps = 60.0;
    info->timing.sample_rate = 48000.0;
}

void retro_set_controller_port_device(unsigned int port, unsigned int device) { (void)port; (void)device; }
void retro_reset() { SyntheticFrame = 0ULL; }

bool retro_load_game(const struct retro_game_info* game) {
    (void)game;
    enum retro_pixel_format format = RETRO_PIXEL_FORMAT_XRGB8888;
    unsigned int setFormat = RETRO_ENVIRONMENT_SET_PIXEL_FORMAT;
    if (SyntheticEnvironment == null || !SyntheticEnvironment(setFormat, &format)) { return false; }
    bool supportsNoGame = true;
    unsigned int setNoGame = RETRO_ENVIRONMENT_SET_SUPPORT_NO_GAME;
    SyntheticEnvironment(setNoGame, &supportsNoGame);
    return true;
}

void retro_unload_game() {}
unsigned int retro_get_region() { return RETRO_REGION_NTSC; }
size_t retro_serialize_size() { return sizeof(SyntheticFrame); }
bool retro_serialize(void* data, size_t size) {
    if (size < sizeof(SyntheticFrame)) { return false; }
    memcpy(data, &SyntheticFrame, sizeof(SyntheticFrame));
    return true;
}
bool retro_unserialize(const void* data, size_t size) {
    if (size < sizeof(SyntheticFrame)) { return false; }
    memcpy(&SyntheticFrame, data, sizeof(SyntheticFrame));
    return true;
}
void* retro_get_memory_data(unsigned int id) { (void)id; return null; }
size_t retro_get_memory_size(unsigned int id) { (void)id; return 0; }
void retro_cheat_reset() {}
void retro_cheat_set(unsigned int index, bool enabled, const char* code) { (void)index; (void)enabled; (void)code; }
bool retro_load_game_special(unsigned int type, const struct retro_game_info* info, size_t count) { (void)type; (void)info; (void)count; return false; }

void retro_run() {
    SyntheticFrame++;
    if (SyntheticInputPoll != null) { SyntheticInputPoll(); }
    SyntheticPattern.fill();
    size_t pitch = (size_t)SyntheticFrameWidth * sizeof(uint32_t);
    if (SyntheticVideo != null) { SyntheticVideo(SyntheticPixels, (unsigned int)SyntheticFrameWidth, (unsigned int)SyntheticFrameHeight, pitch); }
}
