import Library.FileSystem;
import Library.JSON;
import Library.Platform;
import Library.Strings;
import Library.Vector;
import ../../src/lib/json.btrc;
import ../../src/lib/paths.btrc;
import ../../src/model.btrc;
import ../../src/resolve.btrc;
import ../../src/check.btrc;
import ../../src/emit/esde.btrc;
import ../../src/emit/profiles.btrc;
import ../../src/launch/plan.btrc;
import ../../src/emit/rendering.btrc;
import ../../src/emit/settings_ui.btrc;
import ../../src/sync/syncthing.btrc;
import ../../src/steam/shortcuts.btrc;
import ../../src/cli.btrc;
import ../../src/launch/supervisor.btrc;
import ../../src/steam/input_template.btrc;
import ../../src/bezel/editor.btrc;

class Contract {
    public int failures;
    public int checks;

    public Contract() {
        self.failures = 0;
        self.checks = 0;
    }

    public void expect(bool condition, string message) {
        self.checks++;
        if (!condition) {
            self.failures++;
            Console.error("FAIL: " + message);
        }
    }

    public void skip(string label, string reason) {  // a skip fails unless SEMU_ALLOW_SKIP=1 says the host lacks it
        bool allowed = Environment.get("SEMU_ALLOW_SKIP", "").equals("1");
        Console.error((allowed ? "SKIP: " : "FAIL: ") + label + ": " + reason);
        self.checks++;
        if (!allowed) { self.failures++; }
    }

    public void contains(string haystack, string needle, string message) {
        self.expect(haystack.contains(needle), f"{message}: missing '{needle}'");
    }

    public void lacks(string haystack, string needle, string message) {
        self.expect(!haystack.contains(needle), f"{message}: unexpected '{needle}'");
    }
}

class Fixture {
    public string project;
    public string scratch;
    public SemuDiagnostics diagnostics;
    public SemuModel model;
    public SemuPlan plan;

    public Fixture(string target) {
        self.project = Environment.get("SEMU_PROJECT", Platform.currentDirectory());
        self.scratch = FileSystem.tempDir("semu-contract");
        self.diagnostics = SemuDiagnostics();
        self.model = SemuModel.load(PathTools.join(self.project, "config"), self.diagnostics);
        string assets = PathTools.join(self.scratch, "assets");
        FileSystem.mkdirp(PathTools.join(assets, "bin"));
        string home = PathTools.join(self.scratch, "semu-home");
        string overlay = "{\"paths\":{\"state_root\":\"" + PathTools.join(self.scratch, "state") + "\",\"content_root\":\"" + PathTools.join(self.scratch, "content") + "\",\"mods\":\"" + PathTools.join(self.scratch, "mods") + "\",\"bios\":\"" + PathTools.join(self.scratch, "bios") + "\",\"emulation_root\":\"" + PathTools.join(self.scratch, "emulation") + "\"}}";  // a scratch library: contracts never read the owner's mods, firmware or ROMs
        SemuPlan? resolved = SemuResolver.plan(self.model, target, home, assets, overlay, self.diagnostics);
        if (resolved == null) { Console.fatal("contracts: target " + target + " did not resolve:\n" + self.diagnostics.render()); }  // a broken fixture, not a failed contract
        self.plan = resolved;
    }

    class SemuPlan resolved(SemuModel model, string target, string home, string assets, string overlay, SemuDiagnostics diagnostics) {  // a contract's own plan: a target that does not resolve is a broken fixture
        SemuPlan? plan = SemuResolver.plan(model, target, home, assets, overlay, diagnostics);
        if (plan == null) { Console.fatal("contracts: target " + target + " did not resolve:\n" + diagnostics.render()); }
        return plan;
    }

    class JSONValue definitionOf(SemuPlan plan) {  // the plan's input definition; a contract reaching for it needs one
        SemuInput? input = plan.input;
        if (input == null) { Console.fatal("contracts: target " + plan.target.id + " declares no input definition"); }
        return input.definition;
    }

    class JSONValue padsOf(SemuPlan plan) {  // the roster a contract's bed took
        JSONValue? pads = plan.pads;
        if (pads == null) { Console.fatal("contracts: target " + plan.target.id + " took no pad roster"); }
        return pads;
    }

    public SemuSystem systemOf(string id) {  // a contract names systems this config declares
        SemuSystem? system = self.model.system(id);
        if (system == null) { Console.fatal("contracts: no system " + id); }
        return system;
    }

    public SemuEmulator emulatorOf(string id) {
        SemuEmulator? emulator = self.model.emulator(id);
        if (emulator == null) { Console.fatal("contracts: no emulator " + id); }
        return emulator;
    }

    public SemuInput inputOf(string id) {
        SemuInput? input = self.model.input(id);
        if (input == null) { Console.fatal("contracts: no input definition " + id); }
        return input;
    }

    public SemuInput input() {  // the target's own input definition
        SemuInput? input = self.plan.input;
        if (input == null) { Console.fatal("contracts: target " + self.plan.target.id + " declares no input definition"); }
        return input;
    }

    public string profile(string emulatorId, string relative) {
        SemuEmulator? emulator = self.model.emulator(emulatorId);
        if (emulator == null) { return ""; }
        for file in SemuProfiles.render(self.model, self.plan, emulator, self.diagnostics) {
            if (file.path.equals(relative)) { return file.content; }
        }
        return "";
    }
}

