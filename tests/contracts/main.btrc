class LaunchPlanContract {
    class void run(Contract contract) {
        Fixture fixture = Fixture("linux-desktop");
        string assets = fixture.plan.assetRoot;
        FileSystem.mkdirp(PathTools.join(assets, "lib/retroarch/cores"));
        FileSystem.writeText(PathTools.join(assets, "bin/retroarch"), "#!/bin/sh\n");
        FileSystem.writeText(PathTools.join(assets, "lib/retroarch/cores/gambatte_libretro.so"), "");
        string roms = PathTools.join(fixture.scratch, "roms");
        FileSystem.mkdirp(PathTools.join(roms, "gb"));
        FileSystem.writeText(PathTools.join(roms, "gb/Tetris.zip"), "");
        FileSystem.writeText(PathTools.join(fixture.scratch, "outside.zip"), "");
        fixture.plan.tokens.put("roms", roms);
        SemuLaunchPlan launch = SemuLauncher.plan(fixture.model, fixture.plan, "retroarch", "gb", "", "Tetris.zip", fixture.diagnostics);
        contract.expect(launch.ok(), "launch plan resolves: " + launch.error);
        contract.expect(launch.argv.size() > 0 && launch.argv.get(0).equals(PathTools.join(assets, "bin/retroarch")), "argv starts with the bundled retroarch");
        contract.expect(launch.argv.contains("-f"), "fullscreen flag");
        contract.expect(launch.argv.contains("--config"), "explicit config file");
        contract.expect(launch.argv.contains("-L"), "core loader flag");
        contract.expect(launch.argv.contains(PathTools.join(assets, "lib/retroarch/cores/gambatte_libretro.so")), "core path");
        contract.expect(launch.argv.last().equals(PathTools.join(roms, "gb/Tetris.zip")), "ROM is the last argument");
        contract.expect(launch.core.equals("gambatte"), "core comes from the system binding");
        contract.expect(launch.chordWindowMs == 250, "quit chord window is 250 ms");
        bool xdg = false;
        for entry in launch.environment { if (entry.startsWith("XDG_CONFIG_HOME=" + fixture.plan.stateRoot())) { xdg = true; } }
        contract.expect(xdg, "XDG config home lives under the state root");
        string cfg = PathTools.join(fixture.plan.stateRoot(), "retroarch/retroarch.cfg");
        contract.expect(FileSystem.isFile(cfg), "profile written into the state root before launch");
        contract.expect(FileSystem.isFile(PathTools.join(fixture.plan.stateRoot(), "retroarch/retroarch-core-options.cfg")), "core options written next to the config");
        FileSystem.writeText(PathTools.join(assets, "lib/retroarch/cores/ppsspp_libretro.so"), "");
        FileSystem.mkdirp(PathTools.join(roms, "dreamcast"));
        FileSystem.writeText(PathTools.join(roms, "dreamcast/Taxi.chd"), "");
        FileSystem.writeText(PathTools.join(assets, "bin/flycast"), "");
        SemuLaunchPlan flycast = SemuLauncher.plan(fixture.model, fixture.plan, "flycast", "dreamcast", "", "Taxi.chd", SemuDiagnostics());
        contract.expect(flycast.ok(), "flycast launch plan resolves: " + flycast.error);
        contract.expect(flycast.environment.contains("SEMU_RENDER_SYSTEM_ID=dreamcast") && flycast.environment.contains("SEMU_RENDER_ASPECT=4:3"), "render_preload emits the SEMU_RENDER_* environment for flycast");
        FileSystem.mkdirp(PathTools.join(roms, "psp"));
        FileSystem.writeText(PathTools.join(roms, "psp/Lumines.iso"), "");
        SemuLaunchPlan psp = SemuLauncher.plan(fixture.model, fixture.plan, "retroarch", "psp", "ppsspp", "Lumines.iso", SemuDiagnostics());
        contract.expect(psp.ok(), "psp fallback core launches: " + psp.error);
        contract.expect(psp.argv.contains("--appendconfig"), "per-core overrides are appended for ppsspp");
        string overrides = FileSystem.readText(PathTools.join(fixture.plan.stateRoot(), "retroarch/core-ppsspp.cfg"));
        contract.contains(overrides, "video_driver = \"vulkan\"", "ppsspp override selects vulkan");
        contract.expect(!launch.argv.contains("--appendconfig"), "gambatte has no overrides");
        string emulation = PathTools.join(fixture.scratch, "emulation");
        FileSystem.mkdirp(PathTools.join(emulation, "Dolphin/data/GC"));
        FileSystem.writeText(PathTools.join(emulation, "Dolphin/data/GC/MemoryCardA.USA.raw"), "card");
        FileSystem.mkdirp(PathTools.join(roms, "gc"));
        FileSystem.writeText(PathTools.join(roms, "gc/Monkey.rvz"), "");
        FileSystem.writeText(PathTools.join(assets, "bin/dolphin-emu"), "#!/bin/sh\n");
        fixture.plan.tokens.put("emulation_root", emulation);
        SemuLaunchPlan gc = SemuLauncher.plan(fixture.model, fixture.plan, "dolphin", "gc", "", "Monkey.rvz", SemuDiagnostics());
        contract.expect(gc.ok(), "dolphin launches: " + gc.error);
        contract.expect(FileSystem.isFile(PathTools.join(fixture.plan.stateRoot(), "dolphin/dolphin-user/GC/MemoryCardA.USA.raw")), "existing GameCube saves are seeded into the state root once");
        contract.expect(FileSystem.isFile(PathTools.join(fixture.plan.stateRoot(), "dolphin/dolphin-user/Config/Dolphin.ini")), "dolphin profile lands in its user directory");
        SemuLaunchPlan outside = SemuLauncher.plan(fixture.model, fixture.plan, "retroarch", "gb", "", PathTools.join(fixture.scratch, "outside.zip"), SemuDiagnostics());
        contract.expect(!outside.ok(), "ROM outside the system directory is rejected");
        SemuLaunchPlan wrongCore = SemuLauncher.plan(fixture.model, fixture.plan, "retroarch", "gb", "mgba", "Tetris.zip", SemuDiagnostics());
        contract.expect(!wrongCore.ok(), "core that the system does not bind is rejected");
        SemuLaunchPlan wrongEmulator = SemuLauncher.plan(fixture.model, fixture.plan, "dolphin", "gb", "", "Tetris.zip", SemuDiagnostics());
        contract.expect(!wrongEmulator.ok(), "emulator that the system does not bind is rejected");
    }
}

class RenderingContract {
    class void run(Contract contract) {
        Fixture fixture = Fixture("linux-desktop");
        string assets = fixture.plan.assetRoot;
        SemuSystem gb = fixture.model.system("gb");
        Vector<string> bare = SemuRenderEnvironment.compile(fixture.plan, gb, "retroarch", "/state/retroarch", fixture.diagnostics);
        contract.expect(bare.contains("SEMU_RENDER_SYSTEM_ID=gb"), "renderer knows the system");
        contract.expect(bare.contains("SEMU_RENDER_SURFACE_COUNT=1"), "gb has one surface");
        contract.expect(bare.contains("SEMU_RENDER_SURFACE_0_NATIVE=160x144"), "gb native size");
        contract.expect(bare.contains("SEMU_RENDER_ASPECT=10:9"), "gb aspect");
        contract.expect(bare.contains("SEMU_RENDER_SHADERS=0"), "without a bundled preset the shader passes through");
        FileSystem.mkdirp(PathTools.join(assets, "share/libretro/shaders/semu/gb"));
        FileSystem.writeText(PathTools.join(assets, "share/libretro/shaders/semu/gb/screen.slangp"), "#reference x\n");
        FileSystem.mkdirp(PathTools.join(assets, "share/semu/assets/bezels/gb"));
        FileSystem.mkdirp(PathTools.join(assets, "share/semu/assets/bezels/backgrounds"));
        FileSystem.writeText(PathTools.join(assets, "share/semu/assets/bezels/gb/dmg-shell.png"), "png");
        FileSystem.writeText(PathTools.join(assets, "share/semu/assets/bezels/gb/dmg-glass.png"), "png");
        FileSystem.writeText(PathTools.join(assets, "share/semu/assets/bezels/backgrounds/desk-night.png"), "png");
        SemuSystem nes = fixture.model.system("nes");
        Vector<string> nesBare = SemuRenderEnvironment.compile(fixture.plan, nes, "retroarch", "/state/retroarch", fixture.diagnostics);
        contract.expect(nesBare.contains("SEMU_RENDER_BEZELS=1") && nesBare.contains("SEMU_RENDER_ART=" + PathTools.join(fixture.plan.configRoot, "assets/bezels/tv/soqueroeu/nes.png")), "the repository's own plate serves when the asset root lacks it");
        FileSystem.mkdirp(PathTools.join(assets, "share/semu/assets/bezels/tv/soqueroeu"));
        FileSystem.writeText(PathTools.join(assets, "share/semu/assets/bezels/tv/soqueroeu/nes.png"), "png");
        FileSystem.writeText(PathTools.join(assets, "share/semu/assets/bezels/tv/tube-reflection.png"), "png");
        Vector<string> nesTv = SemuRenderEnvironment.compile(fixture.plan, nes, "retroarch", "/state/retroarch", fixture.diagnostics);
        contract.expect(nesTv.contains("SEMU_RENDER_BEZELS=1") && nesTv.contains("SEMU_RENDER_BEZEL_ID=tv-soqueroeu-nes") && nesTv.contains("SEMU_RENDER_LAYOUT=fixed"), "the NES default bezel is the living-room TV package");
        bool nesLook = false;
        bool nesTube = false;
        for entry in nesTv {
            if (entry.startsWith("SEMU_RENDER_SCREEN_0_LOOK=1,0.006")) { nesLook = true; }  // rounded tube, radius 8.9px of 1419
            if (entry.startsWith("SEMU_RENDER_SCREEN_0=0.242969,0.0939815,0.514323,0.656944")) { nesTube = true; }  // 933,203,1975,1419 of 3840x2160
        }
        contract.expect(nesLook && nesTube, "the measured NES tube and its look reach the compositor per screen");
        bool nesImage = false;
        bool nesRing = false;
        bool nesReflect = false;
        for entry in nesTv {
            if (entry.startsWith("SEMU_RENDER_SCREEN_0_REFLECT=1,0.95,1,")) { nesReflect = true; }  // GLOBAL_AMOUNT 50 x (DIRECT 150 + DIFFUSED 50) clamps to 1, BLUR_MAX 95, FADE_AMOUNT 100, then the frame reach
            if (entry.startsWith("SEMU_RENDER_SCREEN_0_IMAGE=0.275781,0.123148,0.448437,0.597685")) { nesImage = true; }  // 1059,266,1722,1291: HSM_NON_INTEGER_SCALE 59.77 at 4:3, POSITION_Y 78
            if (entry.startsWith("SEMU_RENDER_SCREEN_0_RING=0.273698,0.119444,0.452604,0.605093,0.246354,0.099537,0.507292,0.644907,") && entry.endsWith(",0.0901961,0.0941176,0.0980392,1")) { nesRing = true; }  // black edge to bezel edge, bezel color #171819
        }
        contract.expect(nesImage && nesRing, "the NES picture and bezel ring follow Soqueroeu's preset");
        contract.expect(nesReflect, "the NES ring reflection strength, blur and fade come from the preset");
        FileSystem.mkdirp(PathTools.join(assets, "share/libretro/shaders/semu/nes"));
        FileSystem.writeText(PathTools.join(assets, "share/libretro/shaders/semu/nes/screen.slangp"), "#reference x\n");
        Vector<string> nesFull = SemuRenderEnvironment.compile(fixture.plan, nes, "retroarch", "/state/retroarch", fixture.diagnostics);
        contract.expect(nesFull.contains("SEMU_RENDER_SHADERS=1") && nesFull.contains("SEMU_RENDER_SHADER_PRESET=" + assets + "/share/libretro/shaders/semu/nes/screen.slangp"), "a single-preset shader manifest selects its screen preset");
        Vector<string> full = SemuRenderEnvironment.compile(fixture.plan, gb, "retroarch", "/state/retroarch", fixture.diagnostics);
        contract.expect(full.contains("SEMU_RENDER_SHADERS=1") && full.contains("SEMU_RENDER_BEZELS=1"), "assets present enables shaders and bezels");
        contract.expect(full.contains("SEMU_RENDER_SHADER_PRESET=" + assets + "/share/libretro/shaders/semu/gb/screen.slangp"), "shader preset path");
        contract.expect(full.contains("SEMU_RENDER_ART=" + assets + "/share/semu/assets/bezels/gb/dmg-shell.png"), "bezel art path");
        contract.expect(full.contains("SEMU_RENDER_BACKGROUND=" + assets + "/share/semu/assets/bezels/backgrounds/desk-night.png"), "the package background plate");
        contract.expect(full.contains("SEMU_RENDER_SCREEN_0_GLASS=" + assets + "/share/semu/assets/bezels/gb/dmg-glass.png"), "the lens glass plate is per screen");
        bool hole = false;
        bool surround = false;
        for entry in full {
            if (entry.startsWith("SEMU_RENDER_SCREEN_0=0.1875,0.213737,0.625,0.268029")) { hole = true; }  // 645,1307,2150,1639 of 3440x6115
            if (entry.startsWith("SEMU_RENDER_SCREEN_0_SURROUND=0.227451,0.227451,0.25098")) { surround = true; }  // #3a3a40: the plate under Duimon's tinted lens
        }
        contract.expect(hole, "the measured lens rectangle");
        contract.expect(surround, "the DMG surround sampled under the lens");
        bool dmgImage = false;
        bool dmgRing = false;
        for entry in full {
            if (entry.startsWith("SEMU_RENDER_SCREEN_0_IMAGE=0.294186,0.247261,0.411628,0.208504")) { dmgImage = true; }  // 1012,1512,1416,1275 of 3440x6115: Duimon's 1.11 LCD placement
            if (entry.startsWith("SEMU_RENDER_SCREEN_0_RING=0.294186,0.247261,0.411628,0.208504,0.28314,0.240883,0.433721,0.221259,")) { dmgRing = true; }  // black edge 0: the ring starts at the picture
        }
        contract.expect(dmgImage && dmgRing, "the DMG picture and its drawn bezel come from the upstream preset");
        SemuDiagnostics diagnostics = SemuDiagnostics();
        SemuPlan off = SemuResolver.plan(fixture.model, "linux-desktop", fixture.plan.semuHome, assets, "{\"visual\":{\"crt_shaders\":false,\"bezels\":false}}", diagnostics);
        Vector<string> disabled = SemuRenderEnvironment.compile(off, gb, "retroarch", "/state/retroarch", diagnostics);
        contract.expect(disabled.contains("SEMU_RENDER_SHADERS=0") && disabled.contains("SEMU_RENDER_BEZELS=0"), "settings can disable shaders and bezels");
        SemuSystem nds = fixture.model.system("nds");
        Vector<string> dual = SemuRenderEnvironment.compile(fixture.plan, nds, "retroarch", "/state/retroarch", fixture.diagnostics);
        contract.expect(dual.contains("SEMU_RENDER_SURFACE_COUNT=2"), "nds has two surfaces");
        contract.expect(dual.contains("SEMU_RENDER_BEZELS=1") && dual.contains("SEMU_RENDER_LAYOUT=fixed") && dual.contains("SEMU_RENDER_BEZEL_ID=nds-shell"), "the DS default is the Duimon shell");
        bool shellRing = false;
        bool shellFrame = false;
        for entry in dual {
            if (entry.startsWith("SEMU_RENDER_SCREEN_0_RING=0.0333333,0.161111,0.442708,0.591667,0.0190104,0.137963,0.471354,0.637963,")) { shellRing = true; }  // Duimon's DS bezel around the left screen
            if (entry.startsWith("SEMU_RENDER_FRAME=")) { shellFrame = true; }
        }
        contract.expect(shellRing && !shellFrame, "the shell draws Duimon's bezel ring, not a frame");
        int layerCount = 0;
        bool deviceBelow = false;
        bool topAbove = false;
        bool coverBackground = false;
        for entry in dual {
            if (entry.startsWith("SEMU_RENDER_LAYER_COUNT=")) { layerCount = Strings.toInt(entry.substring(24, entry.len() - 24)); }
            if (entry.startsWith("SEMU_RENDER_LAYER_") && entry.contains("/NDS.png|0,0,1,1|0|0|")) { deviceBelow = true; }
            if (entry.startsWith("SEMU_RENDER_LAYER_") && entry.contains("/NDS_Top.png|0,0,1,1|1|0|")) { topAbove = true; }
            if (entry.startsWith("SEMU_RENDER_LAYER_") && entry.contains("/Canvas_Background.jpg|0,0,1,1|0|0|")) { coverBackground = true; }
        }
        if (layerCount > 0) { contract.expect(deviceBelow && topAbove && coverBackground, "the DS layer stack reaches the compositor: the canvas-sized background and face under the screens, the top plate over them"); }
        else { Console.log("layer stack: skipped, the upstream layers are not staged on this host"); }
        contract.expect(dual.contains("SEMU_RENDER_CANVAS=3840,2160") || layerCount == 0, "the layer canvas is the DS face's own pixel grid");
        SemuPlan computed = SemuResolver.plan(fixture.model, "linux-desktop", fixture.plan.semuHome, assets, "{\"visual\":{\"systems\":{\"nds\":{\"bezel_variant\":\"main_right\"}}}}", diagnostics);
        Vector<string> computedEnv = SemuRenderEnvironment.compile(computed, nds, "retroarch", "/state/retroarch", diagnostics);
        contract.expect(computedEnv.contains("SEMU_RENDER_BEZELS=1") && computedEnv.contains("SEMU_RENDER_LAYOUT=main_right") && computedEnv.contains("SEMU_RENDER_BEZEL_ID=dual-main-right"), "the computed main-right layout is an alternate that needs no plate");
        bool frame = false;
        for entry in computedEnv { if (entry.startsWith("SEMU_RENDER_FRAME=0.03,0.03,") && entry.endsWith(",0")) { frame = true; } }
        contract.expect(frame, "computed layouts draw a frame around each screen");
        SemuPlan shell = SemuResolver.plan(fixture.model, "linux-desktop", fixture.plan.semuHome, assets, "{\"visual\":{\"systems\":{\"nds\":{\"bezel_variant\":\"shell\"}}}}", diagnostics);
        Vector<string> shellEnv = SemuRenderEnvironment.compile(shell, nds, "retroarch", "/state/retroarch", diagnostics);
        contract.expect(shellEnv.contains("SEMU_RENDER_BEZEL_ID=nds-shell") && shellEnv.contains("SEMU_RENDER_LAYOUT=fixed") && shellEnv.contains("SEMU_RENDER_SCREEN_1=0.509635,0.137963,0.471354,0.637963"), "the DS shell alternate is a fixed package with two computed openings");  // 1957,298,1810,1378: the right screen's bezel edge
        contract.expect(fixture.diagnostics.ok(), "rendering emitter has no diagnostics: " + fixture.diagnostics.render());
    }
}

class BezelPackageContract {  // every calibrated package: the picture sits inside its opening at the system's aspect
    class double aspectOf(JSONValue rect) {
        double w = SemuJson.intAt(rect, "w", 0);
        double h = SemuJson.intAt(rect, "h", 0);
        return h > 0.0 ? w / h : 0.0;
    }

    class bool inside(JSONValue image, JSONValue tube) {
        int ix = SemuJson.intAt(image, "x", -1);
        int iy = SemuJson.intAt(image, "y", -1);
        int tx = SemuJson.intAt(tube, "x", 0);
        int ty = SemuJson.intAt(tube, "y", 0);
        return ix >= tx && iy >= ty && ix + SemuJson.intAt(image, "w", 0) <= tx + SemuJson.intAt(tube, "w", 0) && iy + SemuJson.intAt(image, "h", 0) <= ty + SemuJson.intAt(tube, "h", 0);
    }

    class void run(Contract contract) {
        Fixture fixture = Fixture("linux-desktop");
        int calibrated = 0;
        for id in fixture.model.systemIds() {
            SemuSystem system = fixture.model.system(id);
            JSONValue variants = system.bezels == null ? null : system.bezels.get("variants");
            if (variants == null || !variants.isArray()) { continue; }
            string widescreen = SemuJson.textAt(system.bezels, "widescreen_variant");
            JSONValue display = system.definition.get("display");
            JSONValue screens = display.get("screens");
            for (int index = 0; index < variants.size(); index++) {
                JSONValue variant = variants.at(index);
                JSONValue package = SemuBezelPackage.load(fixture.plan, SemuJson.textAt(variant, "bezel"));
                if (!package.isObject()) { continue; }
                for (int screenIndex = 0; screenIndex < screens.size(); screenIndex++) {
                    JSONValue native = screens.at(screenIndex).get("native");
                    JSONValue screen = SemuBezelPackage.screen(package, screens.size() == 1 ? "main" : SemuJson.textAt(screens.at(screenIndex), "id"));
                    JSONValue image = screen.isObject() ? screen.get("image") : null;
                    if (image == null || !image.isObject()) { continue; }
                    calibrated++;
                    string where = SemuJson.textAt(package, "id") + "/" + SemuJson.textAt(screen, "id");
                    contract.expect(BezelPackageContract.inside(screen.get("image"), screen.get("tube")), where + ": the picture sits inside the opening");
                    double declared = BezelPackageContract.aspectOf(native);
                    if (screens.size() == 1) {
                        JSONValue aspect = display.get("aspect");
                        if (aspect != null && aspect.isObject()) { declared = BezelPackageContract.aspectOf(aspect); }
                        if (!widescreen.isEmpty() && widescreen.equals(SemuJson.textAt(variant, "id"))) { declared = 16.0 / 9.0; }
                    }
                    double actual = BezelPackageContract.aspectOf(screen.get("image"));
                    double mismatch = declared > 0.0 && actual > 0.0 ? (actual > declared ? actual / declared : declared / actual) - 1.0 : 1.0;
                    contract.expect(mismatch <= 0.01, where + ": the picture aspect is within 1% of the system's");
                }
            }
        }
        contract.expect(calibrated == 25, f"every upstream package and recolor carries a picture rectangle: {calibrated} screens");
    }
}

class BezelPlacementContract {  // the Mega Bezel port against the last render-based captures (2026-09-19, 3840x2160): every edge within 2 px
    class void check(Contract contract, MegaBezelTree tree, string preset, int coreWidth, int coreHeight, double zoom, double x0, double y0, double x1, double y1, string label) {
        MegaBezelPlacement placement = MegaBezelPlacement(MegaBezelParams(MegaBezelPreset(tree.presetPath(preset)), tree.defaults), coreWidth, coreHeight, 3840, 2160);
        BezelRect shown = placement.toScreen(placement.screen(1).picture, zoom).scaled(3840.0, 2160.0);
        double worst = BezelNumber.absDouble(shown.x - x0);
        for delta in [BezelNumber.absDouble(shown.y - y0), BezelNumber.absDouble(shown.x + shown.w - x1), BezelNumber.absDouble(shown.y + shown.h - y1)] { if (delta > worst) { worst = delta; } }
        contract.expect(worst <= 2.0, label + ": the computed picture matches the capture within 2 px (worst " + SemuNumberText.text(worst) + ")");
    }

    class void run(Contract contract) {
        Fixture fixture = Fixture("linux-desktop");
        MegaBezelTree tree = MegaBezelTree(fixture.plan.configRoot, PathTools.join(fixture.scratch, "bezel"));
        if (!tree.ready) { Console.log("bezel placement: skipped, " + tree.failure); contract.expect(true, "bezel placement skipped without the pinned trees"); return; }
        BezelPlacementContract.check(contract, tree, "presets/TV-Console/Nintendo_NES.slangp", 256, 240, 1.0, 1059.0, 266.0, 2780.0, 1557.0, "nes");
        BezelPlacementContract.check(contract, tree, "presets/TV-Console/Sega_Genesis.slangp", 320, 224, 1.0, 1030.0, 279.0, 2809.0, 1613.0, "genesis");
        BezelPlacementContract.check(contract, tree, "presets/TV-Console/Nintendo_GameCube-[FLAT].slangp", 640, 480, 1.0, 993.0, 292.0, 2847.0, 1682.0, "gc");
        BezelPlacementContract.check(contract, tree, "presets/TV-Console/Sega_Dreamcast-[FLAT].slangp", 640, 480, 1.0, 993.0, 264.0, 2847.0, 1654.0, "dreamcast");
        BezelPlacementContract.check(contract, tree, "Presets/Standard/Nintendo_Game_Boy/Gameboy_DMG01-[STD]-[LCD-GRID].slangp", 160, 144, 0.4, 1638.0, 752.0, 2202.0, 1260.0, "gb");
        BezelPlacementContract.check(contract, tree, "Presets/Standard/Nintendo_Game_Boy_Color/GBC-[STD]-[LCD-GRID].slangp", 160, 144, 0.4, 1637.0, 715.0, 2202.0, 1224.0, "gbc");
        BezelPlacementContract.check(contract, tree, "Presets/Standard/Nintendo_GBA/GBA-[STD]-[LCD-GRID].slangp", 240, 160, 0.4, 1547.0, 832.0, 2293.0, 1328.0, "gba");
        MegaBezelPreset gamecube = MegaBezelPreset(tree.presetPath("presets/TV-Console/Nintendo_GameCube-[FLAT].slangp"));
        contract.expect(gamecube.value("HSM_NON_INTEGER_SCALE").equals("64.370285"), "a key assigned twice in one preset keeps its first value, as RetroArch's config_file does");
        MegaBezelPreset dmg = MegaBezelPreset(tree.presetPath("Presets/Standard/Nintendo_Game_Boy/Gameboy_DMG01-[STD]-[LCD-GRID].slangp"));
        contract.expect(dmg.value("HSM_ASPECT_RATIO_MODE").equals("1.000000") && dmg.value("HSM_ASPECT_RATIO_EXPLICIT").equals("1.110000"), "a referencing preset overrides the base it references");
        contract.expect(dmg.missing.size() == 0 && dmg.textures.has("DeviceImage") && dmg.textures.has("CabinetGlassImage"), "every texture the DMG preset draws resolves to a file");
        BezelRepository repository = BezelRepository(fixture.plan.configRoot);
        BezelGeometry geometry = BezelGeometry(tree, "gb-dmg-shell", repository.package("gb-dmg-shell"), repository.system("gb"));
        contract.expect(geometry.failure.isEmpty() && geometry.canvasLayer != null && geometry.canvasLayer.id.equals("device") && geometry.canvasLayer.width == 3440 && geometry.canvasLayer.height == 6115, "the DMG device layer is the canvas at its own 3440x6115");
        contract.expect(geometry.layers.size() == 7 && geometry.layer("cutouts") != null && geometry.layer("top").order > geometry.layer("cutouts").order, "the DMG stack has seven layers with the top plate above the cutouts");
        contract.expect(geometry.plateRect(geometry.screens[0].picture).rounded().stringify().equals("{\"x\":1012,\"y\":1512,\"w\":1416,\"h\":1275}"), "the DMG picture lands at Duimon's placement in device pixels");
    }
}

class SettingsWriteContract {
    class void run(Contract contract) {
        JSONValue current = JSONValue.parse("{\"visual\":{\"bezels\":true},\"ui\":{\"theme\":\"slate-es-de\"}}");
        JSONValue updated = SemuCli.withPath(current, ["visual", "systems", "gb", "bezel_variant"], 0, JSONValue.makeString("studio"));
        contract.expect(SemuJson.textAt(updated, "visual.systems.gb.bezel_variant").equals("studio"), "deep put creates intermediate objects");
        contract.expect(SemuJson.boolAt(updated, "visual.bezels", false), "deep put keeps sibling keys");
        contract.expect(SemuJson.textAt(updated, "ui.theme").equals("slate-es-de"), "deep put keeps unrelated sections");
        JSONValue replaced = SemuCli.withPath(updated, ["visual", "bezels"], 0, JSONValue.makeBool(false));
        contract.expect(!SemuJson.boolAt(replaced, "visual.bezels", true), "deep put overwrites a leaf");
    }
}

class SettingsUiContract {  // the document ES-DE's SEMU SETTINGS menu validates before rendering
    class bool validKey(string key) {
        if (key.isEmpty() || key.startsWith(".") || key.endsWith(".") || key.contains("..")) { return false; }
        for (int index = 0; index < key.len(); index++) {
            char character = key.charAt(index);
            bool ok = (character >= 'a' && character <= 'z') || (character >= '0' && character <= '9') || character == '_' || character == '.';
            if (!ok) { return false; }
        }
        return true;
    }

    class void page(Contract contract, JSONValue page, Vector<string> keys, Vector<string> commands) {
        contract.expect(page.get("fields").isArray() && page.get("fields").size() > 0, "page " + SemuJson.textAt(page, "id") + " has fields");
        contract.expect(page.size() == (page.has("commands") ? 5 : 4), "page " + SemuJson.textAt(page, "id") + " has exact members");
        JSONValue fields = page.get("fields");
        for (int index = 0; index < fields.size(); index++) {
            JSONValue field = fields.at(index);
            string key = SemuJson.textAt(field, "key");
            string type = SemuJson.textAt(field, "type");
            contract.expect(SettingsUiContract.validKey(key) && !keys.contains(key), "field key is valid and unique: " + key);
            keys.push(key);
            contract.expect(field.size() == (type.equals("choice") ? 5 : 4), "field has exact members: " + key);
            if (type.equals("boolean")) { contract.expect(field.get("value").isBool(), "boolean value: " + key); }
            if (type.equals("integer")) { contract.expect(field.get("value").isNumber(), "integer value: " + key); }
            if (type.equals("choice")) {
                contract.expect(SemuJson.strings(field.get("choices")).contains(SemuJson.text(field.get("value"))), "choice value is declared: " + key);
            }
        }
        if (!page.has("commands")) { return; }
        JSONValue declared = page.get("commands");
        for (int index = 0; index < declared.size(); index++) {
            string id = SemuJson.textAt(declared.at(index), "id");
            contract.expect(!commands.contains(id), "command placed once: " + id);
            commands.push(id);
        }
    }

    class void run(Contract contract) {
        Fixture fixture = Fixture("linux-desktop");
        JSONValue document = SemuSettingsUi.document(fixture.model, fixture.plan);
        contract.expect(document.size() == 7, "settings ui document has exactly seven members");
        contract.expect(SemuJson.textAt(document, "protocol").equals("semu-settings-v2"), "settings ui protocol");
        contract.expect(SemuJson.textAt(document, "title").equals(SemuSettingsUi.title()), "settings ui title matches the manifest label");
        contract.expect(SemuJson.textAt(document, "save.strategy").equals("apply_last_changed_write") && SemuJson.textAt(document, "save.apply_flag").equals("--apply"), "save protocol");
        Vector<string> keys = [];
        Vector<string> placed = [];
        JSONValue sections = document.get("sections");
        contract.expect(sections.isArray() && sections.size() >= 3, "settings ui has visuals, per-system and interface sections");
        for (int index = 0; index < sections.size(); index++) {
            JSONValue section = sections.at(index);
            if (SemuJson.textAt(section, "kind").equals("page")) {
                SettingsUiContract.page(contract, section, keys, placed);
                continue;
            }
            contract.expect(section.size() == 4 && section.get("sections").isArray() && section.get("sections").size() > 0, "menu " + SemuJson.textAt(section, "id") + " has pages");
            JSONValue pages = section.get("sections");
            for (int page = 0; page < pages.size(); page++) { SettingsUiContract.page(contract, pages.at(page), keys, placed); }
        }
        contract.expect(keys.contains("visual.bezels") && keys.contains("visual.systems.gb.bezel_variant") && keys.contains("ui.theme"), "settings ui exposes bezels, the gb variant and the theme");
        contract.expect(placed.size() == document.get("commands").size() && placed.contains("reset-settings"), "every declared command is placed exactly once");
        JSONValue manifest = SemuSettingsUi.manifest("/nix/store/x-semu/bin/semu");
        contract.expect(manifest.size() == 2 && manifest.get("entry").size() == 5 && manifest.get("entry").get("actions").size() == 3, "manifest has the exact member counts ES-DE checks");
        contract.expect(SemuJson.textAt(manifest, "entry.label").equals(SemuJson.textAt(document, "title")), "manifest label equals the document title");
        contract.expect(SemuSettingsUi.upper("Nintendo Game Boy").equals("NINTENDO GAME BOY"), "labels are uppercased");
    }
}

class SyncContract {  // the Syncthing config Semu owns: one folder for content_root, peers shared on it
    class void run(Contract contract) {
        string base = "<configuration version=\"37\">\n    <device id=\"OWN\" name=\"desk\"></device>\n    <gui enabled=\"true\"></gui>\n</configuration>\n";
        Vector<string> peers = ["PEER-ONE"];
        string once = SemuSync.configure(base, "/home/u/Games/Emulation/Semu", peers);
        contract.contains(once, "<folder id=\"semu-saves\" label=\"Semu saves\" path=\"/home/u/Games/Emulation/Semu\"", "sync folder targets content_root");
        contract.contains(once, "<device id=\"PEER-ONE\" name=\"PEER-ON\"", "peer device is declared");
        contract.contains(once, "    <device id=\"PEER-ONE\" introducedBy=\"\"></device>\n</folder>", "peer shares the folder");
        contract.expect(once.endsWith("</configuration>\n"), "configuration root is kept");
        contract.expect(SemuSync.configure(once, "/home/u/Games/Emulation/Semu", peers).equals(once), "configure is idempotent");
        Vector<string> more = ["PEER-ONE", "PEER-TWO"];
        string twice = SemuSync.configure(once, "/home/u/Games/Emulation/Semu", more);
        contract.contains(twice, "<device id=\"PEER-TWO\" name=", "a later peer is added");
        contract.contains(twice, "<device id=\"PEER-TWO\" introducedBy=\"\"></device>", "a later peer shares the existing folder");
        contract.expect(SemuSync.indexOf("abcabc", "ca", 0) == 2 && SemuSync.indexOf("abcabc", "ca", 3) == -1 && SemuSync.indexOf("abc", "zz", 0) == -1, "indexOf finds and misses");
        contract.expect(!SemuSync.listening("127.0.0.1:1"), "a closed port is not listening");
        Fixture fixture = Fixture("linux-desktop");
        contract.expect(!SemuSync.enabled(fixture.plan), "sync is off by default");
        contract.expect(SemuSync.guiAddress(fixture.plan).equals("127.0.0.1:8384"), "default gui address");
        contract.expect(SemuSync.home(fixture.plan).endsWith("/state/syncthing"), "sync home lives in the state root");
        JSONValue ui = SemuSettingsUi.document(fixture.model, fixture.plan);
        contract.contains(ui.stringify(), "\"key\":\"sync.enabled\"", "settings ui exposes sync");
    }
}

class SteamContract {  // the binary VDF Steam reads: our entry exact, everything else preserved
    class void run(Contract contract) {
        contract.expect(SteamShortcuts.appid("\"/x/semu-es-de\"", "Semu") == 4175107067L, "non-Steam appid matches Steam's crc32 seed");
        Fixture fixture = Fixture("linux-desktop");
        string root = PathTools.join(fixture.scratch, "steam");
        string file = PathTools.join(root, "userdata/1234/config/shortcuts.vdf");
        SemuPaths.removeFile(file);
        string error = "";
        SteamShortcut other = SteamShortcuts.upsert(file, "Other Game", "/opt/other/run", "/opt/other", &error);
        contract.expect(other != null && error.isEmpty(), "shortcut written into an absent file: " + error);
        SteamShortcut ours = SteamShortcuts.upsert(file, "Semu", "/run/current-system/sw/bin/semu-es-de", "/home/u", &error);
        contract.expect(ours != null && ours.launchUrl().startsWith("steam://rungameid/"), "semu shortcut appended");
        SteamShortcutsFile parsed = SteamShortcutsFile.read(file);
        contract.expect(parsed.valid && parsed.entries.size() == 2, f"two entries survive a rewrite ({parsed.entries.size()})");
        contract.expect(parsed.entries.get(0).appName.equals("Other Game") && parsed.entries.get(0).exe.equals("\"/opt/other/run\""), "foreign entry preserved byte for byte");
        contract.expect(parsed.entries.get(1).appName.equals("Semu") && parsed.entries.get(1).startDir.equals("\"/home/u\"") && parsed.entries.get(1).appid == ours.appid, "semu entry parsed back");
        SteamShortcuts.upsert(file, "Semu", "/run/current-system/sw/bin/semu-es-de", "/home/u", &error);
        SteamShortcutsFile again = SteamShortcutsFile.read(file);
        contract.expect(again.entries.size() == 2, "a second upsert replaces instead of duplicating");
        contract.expect(SteamShortcuts.shortcutFiles(root).size() == 1 && SteamShortcuts.shortcutFiles(root).get(0).equals(file), "profile discovery finds userdata/<id>/config");
        contract.expect(SteamShortcuts.launcher(fixture.plan).equals("/run/current-system/sw/bin/semu-es-de"), "desktop target names the stable launcher");
        Fixture deck = Fixture("steam-deck");
        contract.expect(SteamShortcuts.launcher(deck.plan).endsWith("/Applications/Semu/bin/semu-deck"), "deck target names the installed launcher");
    }
}

class UnifiedInputContract {  // one action vocabulary: chords parse, routes are explicit, the menu reaches both the renderer and the supervisor
    class void run(Contract contract) {
        Vector<int> save = SemuKeyNames.chord("Ctrl+S");
        contract.expect(save.size() == 2 && save.get(0) == KEY_LEFTCTRL && save.get(1) == KEY_S, "Ctrl+S parses to left control then S");
        Vector<int> wii = SemuKeyNames.chord("Ctrl+Shift+F9");
        contract.expect(wii.size() == 3 && wii.get(2) == KEY_F9, "Ctrl+Shift+F9 parses with two modifiers");
        contract.expect(SemuKeyNames.chord("Ctrl++").size() == 2 && SemuKeyNames.chord("Ctrl+Bogus").isEmpty(), "plus is a key and unknown keys reject the chord");
        contract.expect(SemuKeyNames.button("north") == BTN_NORTH && SemuKeyNames.button("select") == BTN_SELECT && SemuKeyNames.button("dpad_left") == BTN_DPAD_LEFT, "gamepad button names map to evdev codes");
        contract.expect(SemuActionRouter.route("state.save", true, true).equals("udp:SAVE_STATE"), "RetroArch actions go through the command port even from a keyboard chord");
        contract.expect(SemuActionRouter.route("state.save", false, false).equals("inject"), "native emulators get the chord typed for a gamepad chord");
        contract.expect(SemuActionRouter.route("state.save", false, true).equals("none"), "a keyboard chord already reached a native emulator");
        contract.expect(SemuActionRouter.route("ui.menu", false, false).equals("semu") && SemuActionRouter.route("visual.bezels.toggle", true, true).equals("semu"), "menu and visual toggles are Semu's own");
        contract.expect(SemuActions.code("visual.bezels.toggle") == SemuActions.bezelsToggle() && SemuActions.id(SemuActions.shadersToggle()).equals("visual.shaders.toggle"), "visual toggles have journal codes");
        Fixture fixture = Fixture("linux-desktop");
        string assets = fixture.plan.assetRoot;
        string roms = PathTools.join(fixture.scratch, "roms");
        FileSystem.mkdirp(PathTools.join(roms, "gb"));
        FileSystem.writeText(PathTools.join(roms, "gb/Tetris.zip"), "");
        FileSystem.mkdirp(PathTools.join(assets, "bin"));
        FileSystem.writeText(PathTools.join(assets, "bin/retroarch"), "#!/bin/sh\n");
        FileSystem.mkdirp(PathTools.join(assets, "lib/retroarch/cores"));
        FileSystem.writeText(PathTools.join(assets, "lib/retroarch/cores/gambatte_libretro.so"), "");
        fixture.plan.tokens.put("roms", roms);
        SemuLaunchPlan launch = SemuLauncher.plan(fixture.model, fixture.plan, "retroarch", "gb", "", "Tetris.zip", fixture.diagnostics);
        contract.expect(launch.ok(), "launch plan for the input contract resolves: " + launch.error);
        contract.expect(launch.menuLabels.size() == 7 && launch.menuActions.get(0).equals("ui.menu.back") && launch.menuActions.get(6).equals("app.quit"), "menu items reach the supervisor in order");
        contract.expect(launch.environment.contains("SEMU_MENU_ITEMS=" + launch.menuLabels.join("|")), "menu labels reach the renderer");
        contract.expect(launch.chordModifier.equals("select") && launch.chordButtons.contains("north") && launch.chordActions.get(launch.chordButtons.indexOf("north")).equals("ui.menu"), "Select+Y opens the Semu menu");
        contract.expect(launch.actionChords.contains("state.save=Ctrl+S") && launch.pauseAction.equals("ui.pause"), "action chords and the pause action are carried");
        contract.expect(launch.retroarchPort == 55355 && launch.stateDir.endsWith("/retroarch"), "RetroArch launches know the command port and the journal directory");
    }
}

class SteamInputContract {  // the Deck template Steam loads: radials carry the semantic icons and the action chords
    class void run(Contract contract) {
        Fixture fixture = Fixture("steam-deck");
        JSONValue root = SemuJson.readFile(SteamInputTemplates.source(fixture.plan));
        contract.expect(!root.isError(), "steam-deck target has a Steam Input definition");
        SteamInputDocument document = SteamInputDocument(root);
        JSONValue template = root.get("templates").at(1);
        string vdf = SteamInputVdf.render(document, template);
        contract.contains(vdf, "\"controller_type\"\t\t\"controller_neptune\"", "template targets the Deck controller");
        contract.contains(vdf, "\"mode\" \"radial_menu\"", "the left trackpad hosts a radial menu");
        contract.contains(vdf, "key_press LEFT_CONTROL, Save State, semu-save.png, #232323 #FFFFFF", "save state slot presses the Ctrl chord with its icon");
        contract.contains(vdf, "key_press S, Save State, semu-save.png, #232323 #FFFFFF", "save state chord ends in S");
        contract.contains(vdf, "key_press UP_ARROW, Menu Up", "menu radial navigates the native menu");
        contract.contains(vdf, "xinput_button START, Quit Emulator", "quit carries the Start+Select gamepad fallback");
        contract.contains(vdf, "\"touch_menu_show_labels\" \"0\"", "radials show icons, not labels");
        string out = PathTools.join(fixture.scratch, "steam-templates");
        contract.expect(SteamInputTemplates.publish(fixture.plan, out, PathTools.join(out, "icons")) == 0, "templates publish into a directory");
        contract.expect(FileSystem.isFile(PathTools.join(out, "neptune-full.vdf")) && FileSystem.isFile(PathTools.join(out, "icons/semu-save.png")), "the full template and its icons are written");
    }
}

int main() {
    Contract contract = Contract();
    SettingsWriteContract.run(contract);
    SettingsUiContract.run(contract);
    SyncContract.run(contract);
    SteamContract.run(contract);
    UnifiedInputContract.run(contract);
    SteamInputContract.run(contract);
    RenderingContract.run(contract);
    BezelPackageContract.run(contract);
    BezelPlacementContract.run(contract);
    ModelContract.run(contract);
    SettingsLadderContract.run(contract);
    EsDeContract.run(contract);
    RetroArchProfileContract.run(contract);
    NativeProfilesContract.run(contract);
    LaunchPlanContract.run(contract);
    if (contract.failures > 0) {
        Console.error(f"FAILED: {contract.failures} of {contract.checks} checks");
        return 1;
    }
    Console.log(f"PASS: {contract.checks} checks");
    return 0;
}
