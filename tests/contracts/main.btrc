class Contract {
    public int failures;
    public int checks;

    public Contract() {
        self.failures = 0;
        self.checks = 0;
    }

    public void expect(bool condition, string message) {
        self.checks++;
        if (!condition) {
            self.failures++;
            Console.error("FAIL: " + message);
        }
    }

    public void contains(string haystack, string needle, string message) {
        self.expect(haystack.contains(needle), f"{message}: missing '{needle}'");
    }

    public void lacks(string haystack, string needle, string message) {
        self.expect(!haystack.contains(needle), f"{message}: unexpected '{needle}'");
    }
}

class Fixture {
    public string project;
    public string scratch;
    public SemuDiagnostics diagnostics;
    public SemuModel model;
    public SemuPlan plan;

    public Fixture(string target) {
        self.project = Environment.get("SEMU_PROJECT", FileSystem.currentDirectory());
        self.scratch = FileSystem.tempDir("semu-contract");
        self.diagnostics = SemuDiagnostics();
        self.model = SemuModel.load(PathTools.join(self.project, "config"), self.diagnostics);
        string assets = PathTools.join(self.scratch, "assets");
        FileSystem.mkdirp(PathTools.join(assets, "bin"));
        string home = PathTools.join(self.scratch, "semu-home");
        string overlay = "{\"paths\":{\"state_root\":\"" + PathTools.join(self.scratch, "state") + "\",\"content_root\":\"" + PathTools.join(self.scratch, "content") + "\"}}";
        self.plan = SemuResolver.plan(self.model, target, home, assets, overlay, self.diagnostics);
    }

    public string profile(string emulatorId, string relative) {
        SemuEmulator emulator = self.model.emulator(emulatorId);
        for file in SemuProfiles.render(self.model, self.plan, emulator, self.diagnostics) {
            if (file.path.equals(relative)) { return file.content; }
        }
        return "";
    }
}

class ModelContract {
    class void run(Contract contract) {
        Fixture fixture = Fixture("linux-desktop");
        contract.expect(fixture.diagnostics.ok(), "model loads without diagnostics: " + fixture.diagnostics.render());
        contract.expect(fixture.model.systemIds().size() == 17, "seventeen systems are declared");
        contract.expect(fixture.model.target("steam-deck") != null, "steam-deck target exists");
        contract.expect(fixture.model.target("linux-desktop") != null, "linux-desktop target exists");
        contract.expect(SemuChecker.check(fixture.model, fixture.plan, fixture.diagnostics), "checker passes: " + fixture.diagnostics.render());
        contract.expect(fixture.plan.systems.size() == 17, "every system serves linux");
        contract.expect(fixture.plan.emulators.contains("retroarch"), "retroarch is selected");
        contract.expect(!fixture.plan.emulators.contains("ares"), "ares is macOS only and not selected");
        contract.lacks(fixture.plan.romsRoot(), "/run/media/deck", "desktop ROM root is not the Deck SD card");
        contract.contains(fixture.plan.romsRoot(), "Games/Emulation/ES-DE/ES-DE/ROMs", "desktop ROM root follows the Emulation layout");
        contract.contains(fixture.plan.path("esde_home"), "Games/Emulation/ES-DE", "ES-DE home is the existing data directory so gamelists and media carry over");
        Fixture deck = Fixture("steam-deck");
        contract.contains(deck.plan.romsRoot(), "/run/media/deck/SD/Emulation/ES-DE/ES-DE/ROMs", "deck ROM root is the SD card");
        contract.expect(deck.plan.input != null && deck.plan.input.id.equals("steam-deck"), "deck uses its own input definition");
    }
}

class SettingsLadderContract {
    class void run(Contract contract) {
        Fixture fixture = Fixture("linux-desktop");
        string home = fixture.plan.semuHome;
        FileSystem.mkdirp(PathTools.join(home, "overrides/visual"));
        FileSystem.writeText(PathTools.join(home, "semu.json"), "{\"ui\":{\"theme\":\"linear-es-de\"},\"visual\":{\"bezels\":false}}");
        FileSystem.writeText(PathTools.join(home, "overrides/visual/bezels.json"), "{\"visual\":{\"bezels\":true}}");
        SemuDiagnostics diagnostics = SemuDiagnostics();
        SemuPlan plan = SemuResolver.plan(fixture.model, "linux-desktop", home, fixture.plan.assetRoot, "{\"ui\":{\"display_index\":2}}", diagnostics);
        contract.expect(SemuJson.textAt(plan.settings, "ui.theme").equals("linear-es-de"), "semu.json overrides defaults");
        contract.expect(SemuJson.boolAt(plan.settings, "visual.bezels", false), "overrides beat semu.json");
        contract.expect(SemuJson.intAt(plan.settings, "ui.display_index", 0) == 2, "--settings-json beats everything");
        contract.expect(SemuJson.boolAt(plan.settings, "visual.integer_scaling", false), "untouched defaults survive");
    }
}

class EsDeContract {
    class void run(Contract contract) {
        Fixture fixture = Fixture("linux-desktop");
        string systems = SemuEsDeDocuments.systems(fixture.model, fixture.plan, fixture.diagnostics);
        contract.contains(systems, "<name>gb</name>", "es_systems declares gb");
        contract.contains(systems, "<extension>.bin .BIN .dmg .DMG .gb .GB .gbs .GBS .7z .7Z .zip .ZIP</extension>", "gb extensions in both cases");
        contract.contains(systems, "<command label=\"Gambatte\">%EMULATOR_RETROARCH% --system gb --core gambatte --rom %ROM%</command>", "gb launches through the retroarch shim");
        contract.contains(systems, "<command label=\"Dolphin\">%EMULATOR_DOLPHIN% --system gc --rom %ROM%</command>", "gc launches through the dolphin shim");
        contract.contains(systems, "<command label=\"Dolphin (Standalone)\">%EMULATOR_DOLPHIN% --system gc --rom %ROM%</command>", "gamelist alias labels get their own command entry");
        contract.contains(systems, "<platform>genesis, megadrive</platform>", "multiple ES-DE platforms are joined");
        contract.lacks(systems, "${", "no unresolved tokens in es_systems");
        contract.lacks(systems, "\n\n", "no blank lines between commands");
        string rules = SemuEsDeDocuments.findRules(fixture.plan, fixture.diagnostics);
        contract.contains(rules, "<emulator name=\"RETROARCH\">", "find rules name RETROARCH");
        contract.contains(rules, "<entry>semu-retroarch</entry>", "find rules point at the semu shim");
        contract.lacks(rules, "ARES", "no macOS-only emulator in linux find rules");
        string settings = SemuEsDeDocuments.settings("", fixture.plan);
        contract.contains(settings, "<string name=\"ROMDirectory\" value=\"" + fixture.plan.romsRoot() + "\" />", "es_settings ROM directory");
        contract.contains(settings, "<bool name=\"CreatePlaceholderSystemDirectories\" value=\"false\" />", "no placeholder directories");
        contract.contains(settings, "<string name=\"Theme\" value=\"slate-es-de\" />", "default theme");
        string merged = SemuEsDeDocuments.settings("<?xml version=\"1.0\"?>\n<string name=\"ROMDirectory\" value=\"/old\" />\n<bool name=\"ShowHiddenFiles\" value=\"true\" />\n", fixture.plan);
        contract.lacks(merged, "/old", "existing ROM directory is replaced");
        contract.contains(merged, "<bool name=\"ShowHiddenFiles\" value=\"true\" />", "unrelated settings survive a merge");
        contract.expect(fixture.diagnostics.ok(), "ES-DE emit has no diagnostics: " + fixture.diagnostics.render());
    }
}

class RetroArchProfileContract {
    class void run(Contract contract) {
        Fixture fixture = Fixture("linux-desktop");
        string cfg = fixture.profile("retroarch", "retroarch.cfg");
        contract.expect(!cfg.isEmpty(), "retroarch.cfg renders");
        contract.contains(cfg, "video_fullscreen = \"true\"", "fullscreen");
        contract.contains(cfg, "input_driver = \"sdl2\"", "sdl2 input driver");
        contract.contains(cfg, "input_joypad_driver = \"sdl2\"", "sdl2 joypad driver");
        contract.contains(cfg, "input_player1_joypad_index = \"0\"", "player one is joypad 0");
        contract.contains(cfg, "input_quit_gamepad_combo = \"0\"", "native quit combo disabled, semu owns Start+Select");
        contract.contains(cfg, "notification_show_autoconfig = \"false\"", "autoconfig toast suppressed");
        contract.contains(cfg, "network_cmd_enable = \"true\"", "network commands enabled");
        contract.contains(cfg, "network_cmd_port = \"55355\"", "network command port");
        contract.contains(cfg, "video_shader_enable = \"false\"", "native shaders disabled");
        contract.contains(cfg, "global_core_options = \"true\"", "core options come from the generated global file");
        contract.contains(cfg, "quit_press_twice = \"false\"", "a single QUIT command exits");
        contract.contains(cfg, "video_driver = \"glcore\"", "core-profile GL so hardware-rendered cores initialise");
        contract.contains(cfg, "system_directory = \"" + fixture.plan.path("emulation_root") + "/RetroArch/config/system\"", "BIOS and core assets come from the existing RetroArch system directory");
        contract.contains(cfg, "input_save_state = \"s\"", "save state hotkey");
        contract.contains(cfg, "input_enable_hotkey_btn = \"nul\"", "RetroArch gamepad hotkeys are unbound: the supervisor owns Select chords");
        contract.contains(cfg, "input_save_state_btn = \"nul\"", "save state is not a RetroArch pad hotkey");
        contract.contains(cfg, "input_load_state_btn = \"nul\"", "load state is not a RetroArch pad hotkey");
        contract.contains(cfg, "input_menu_toggle_btn = \"nul\"", "menu toggle is not a RetroArch pad hotkey");
        contract.contains(cfg, "input_load_state = \"a\"", "load state hotkey");
        contract.contains(cfg, "input_pause_toggle = \"p\"", "pause hotkey");
        contract.contains(cfg, "input_exit_emulator = \"escape\"", "escape hotkey");
        contract.contains(cfg, "savefile_directory = \"" + fixture.plan.path("content_root") + "/saves\"", "saves under the content root");
        contract.contains(cfg, "savestate_directory = \"" + fixture.plan.path("content_root") + "/states\"", "states under the content root");
        contract.contains(cfg, "joypad_autoconfig_dir = \"" + fixture.plan.assetRoot + "/share/libretro/autoconfig\"", "autoconfig from the bundle");
        contract.lacks(cfg, "${", "no unresolved tokens");
        contract.lacks(cfg, "/run/media/deck", "no Deck path on the desktop");
        contract.expect(fixture.diagnostics.ok(), "retroarch profile has no diagnostics: " + fixture.diagnostics.render());
    }
}

