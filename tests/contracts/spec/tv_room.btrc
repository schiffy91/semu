// TV room spec (M15 item 7): "ps2 screen isn't centered - it's very low on the table compared to ps1". On the Deck
// PCSX2 hands the render hook a 639x448 frame (seen in the podman VM: Def Jam - Fight for NY through `semu launch`)
// and Beetle PSX a 320x240 one. Fit, every TV's default, takes the nearest whole step whose opening stays on screen:
// 1x (448 lines) for the PS2 and 2x (480) for the PS1 at 1280x800, so the PS2's TV is drawn at 87% of the covered
// room and the PS1's at 93%. Both rooms stood their table on the screen's bottom edge, which put the smaller PS2
// TV's picture 23 px below the screen's middle and the PS1's 15 px above it. A TV room now centres its picture down
// the screen in fit and bezel (game always did), the wall and table carried on past the canvas; every picture lands on
// whole pixels. The editor's copy of the arithmetic matches the renderer's. Below the table's front the 38ed18a band
// (the last 32 rows averaged) showed coarse vertical streaks, each column one value all the way down; the wood there now
// carries on as the plate's own last rows mirrored with the depth, falling into the dark but never to black, and the
// sides carry on from past the art's bevelled table ends.

import Library.FileSystem;
import Library.JSON;
import Library.Strings;
import Library.Vector;
import ../support.btrc;
import ../../../src/lib/json.btrc;
import ../../../src/lib/paths.btrc;
import ../../../src/renderer/renderer_abi.btrc;
import ../../../src/renderer/renderer_config.btrc;
import ../../../src/renderer/renderer_placement.btrc;
import ./render_env.btrc;
import ./placement.btrc;

class TvRoomSpecChecks {
    class bool onGrid(struct RendererCanvasRect* picture) {  // the picture's bottom-left corner on a whole pixel
        return PlacementSpecGeometry.near(picture->x, (float)PlacementSpecGeometry.rounded(picture->x)) && PlacementSpecGeometry.near(picture->y, (float)PlacementSpecGeometry.rounded(picture->y));
    }

    class bool middle(struct RendererCanvasRect* picture, int areaWidth, int areaHeight) {  // centred both ways, to the half pixel that lands it on the grid
        return PlacementSpecGeometry.withinHalf(picture->x * 2.0f + picture->width, areaWidth) && PlacementSpecGeometry.withinHalf(picture->y * 2.0f + picture->height, areaHeight);
    }

    class void live(Contract contract, Fixture fixture) {  // the frames PCSX2 and Beetle PSX hand over, in fit, the TVs' default
        int widths[2] = {1280, 1920};
        int heights[2] = {800, 1080};
        int consoleSteps[2] = {1, 2};
        int originalSteps[2] = {2, 3};
        for (int size = 0; size < 2; size++) {
            struct RendererCanvasRect canvas;
            struct RendererCanvasRect console;
            struct RendererCanvasRect original;
            PlacementSpecGeometry.place(fixture, "ps2", 639, 448, 0, widths[size], heights[size], &canvas, &console);
            PlacementSpecGeometry.place(fixture, "psx", 320, 240, 0, widths[size], heights[size], &canvas, &original);
            float apart = (console.y * 2.0f + console.height) - (original.y * 2.0f + original.height);
            contract.expect(PlacementSpecGeometry.near(console.height, (float)(consoleSteps[size] * 448)) && TvRoomSpecChecks.middle(&console, widths[size], heights[size]) && TvRoomSpecChecks.onGrid(&console),
                f"PS2 639x448 (PCSX2's frame) at {widths[size]}x{heights[size]} in fit: {consoleSteps[size]}x, {consoleSteps[size] * 448} lines, centred on the screen on whole pixels: " + PlacementSpecGeometry.text(&console));
            contract.expect(PlacementSpecGeometry.near(original.height, (float)(originalSteps[size] * 240)) && TvRoomSpecChecks.middle(&original, widths[size], heights[size]) && TvRoomSpecChecks.onGrid(&original),
                f"PS1 320x240 at {widths[size]}x{heights[size]} in fit: {originalSteps[size]}x, {originalSteps[size] * 240} lines, centred on the screen on whole pixels: " + PlacementSpecGeometry.text(&original));
            contract.expect(apart <= 2.0f && apart >= -2.0f, f"at {widths[size]}x{heights[size]} the PS2's picture stands where the PS1's does, its middle within a pixel of it: PS2 " + PlacementSpecGeometry.text(&console) + ", PS1 " + PlacementSpecGeometry.text(&original));
        }
    }

    class void opening(Contract contract, Fixture fixture) {  // fit's step test follows the centred picture: a TV taller than the screen keeps its opening if the opening, centred with the picture, fits
        struct RendererVariantConfig variant;
        PlacementSpecGeometry.load(PlacementSpecEnvironment.compile(fixture, "ps2", ""), &variant);
        struct RendererCanvasRect canvas;
        canvas.x = -71.111f;  // the 16:9 room covering 1280x800, as coverKeepingTubes leaves it
        canvas.y = 0.0f;
        canvas.width = 1422.222f;
        canvas.height = 800.0f;
        struct RendererNormalizedHole* image = &variant.screens[0].image;
        bool tallerStays = RendererPlacement.tubeStays(&variant, image, &canvas, 1.4f, 1280, 800);  // the opening 764 px tall, centred with the picture; a canvas grown about its own middle would put its top 29 px above the screen
        bool tallestLeaves = !RendererPlacement.tubeStays(&variant, image, &canvas, 1.5f, 1280, 800);  // the opening 819 px tall: no anchor keeps it
        contract.expect(variant.screens[0].tube.set != 0 && image->set != 0 && tallerStays && tallestLeaves,
            "fit keeps a room's step while its opening, centred with the picture down the screen, stays on screen (1.4x the covered PS2 room at 1280x800 stays, 1.5x leaves)");
    }

    class void rooms(Contract contract, Fixture fixture) {  // every TV room and variant, in fit, game and bezel at both sizes: the picture centred down the screen on whole pixels, fit and bezel at whole steps
        int widths[2] = {1280, 1920};
        int heights[2] = {800, 1080};
        Vector<string> failures = [];
        int pictures = 0;
        for systemId in fixture.model.systemIds() {
            JSONValue screen = SemuJson.get(fixture.model.system(systemId).definition, "display.screens.0");
            int nativeWidth = SemuJson.intAt(screen, "native.w", 0);
            int nativeHeight = SemuJson.intAt(screen, "native.h", 0);
            int lines = nativeHeight - SemuJson.intAt(screen, "crop.top", 0) - SemuJson.intAt(screen, "crop.bottom", 0);
            Vector<string> variants = [""];
            JSONValue declared = fixture.model.system(systemId).bezels.get("variants");
            for (int index = 0; declared != null && declared.isArray() && index < declared.size(); index++) { variants.push(SemuJson.textAt(declared.at(index), "id")); }
            for variant in variants {
                Vector<string> room = PlacementSpecEnvironment.layers(PlacementSpecEnvironment.compile(fixture, systemId, variant), "/background.png");
                if (room.isEmpty() || !room[0].endsWith("|1") || lines < 1) { continue; }
                string label = systemId + (variant.isEmpty() ? "" : ":" + variant);
                for (int placement = 0; placement <= 2; placement++) {
                    for (int size = 0; size < 2; size++) {
                        struct RendererCanvasRect canvas;
                        struct RendererCanvasRect picture;
                        PlacementSpecGeometry.placeVariant(fixture, systemId, variant, nativeWidth, nativeHeight, placement, widths[size], heights[size], &canvas, &picture);
                        int steps = PlacementSpecGeometry.rounded(picture.height) / lines;
                        bool whole = placement == 1 || (steps >= 1 && PlacementSpecGeometry.near(picture.height, (float)(steps * lines)));
                        if (!whole || !TvRoomSpecChecks.middle(&picture, widths[size], heights[size]) || !TvRoomSpecChecks.onGrid(&picture)) { failures.push(label + f" placement {placement} at {widths[size]}x{heights[size]}: " + PlacementSpecGeometry.text(&picture) + f" for {lines} lines"); }
                        pictures++;
                    }
                }
            }
        }
        contract.expect(failures.isEmpty() && pictures >= 100, f"every TV room centres its picture on the screen on whole pixels in fit, game and bezel at 1280x800 and 1920x1080, fit and bezel at whole steps ({pictures} pictures): " + failures.join("; "));
    }

    class void band(Contract contract, Fixture fixture) {  // under a centred TV the wood below the table's front carries on as a surface: rows that change with depth, never one row's grain pulled into streaks
        string source = FileSystem.readText(PathTools.join(fixture.plan.configRoot, "render/compositor.frag"));
        int start = Strings.find(source, "vec4 roomPlate(", 0);
        int end = start < 0 ? -1 : Strings.find(source, "return c;}", start);
        string room = start < 0 || end < 0 ? "" : source.substring(start, end - start);
        contract.expect(room.contains("float depth=(q.y-1.0)*size.y;float span=0.0055*size.y;float fold=mod(depth,2.0*span);") && room.contains("textureGrad(t,vec2(x,1.0-min(fold,2.0*span-fold)/size.y),dx,dy)") && !room.contains("vec2(0.0,0.0))"),
            "below a room's plate each row mirrors one of the plate's last rows at the plate's own scale, back and forth with the depth, never a fixed row or a footprint stretched down (the renderer and the editor draw this file)");
        contract.expect(room.contains("if(uLayer.y<0.5)c.rgb*=0.4+0.6*exp(-depth/(0.1*size.y));"),
            "the carried wood falls into the dark with the depth, never below 40% of the plate's own light (never a black bar), and a multiply layer (the night plate) carries on as drawn");
        contract.expect(room.contains("float x=clamp(q.x,4.0/size.x,1.0-4.0/size.x);") && room.contains("if(q.y<=1.0)return textureGrad(t,vec2(x,max(q.y,0.0)),dx,dy);"),
            "to either side the room carries on from four texels in, past the dark bevel the art draws at each end of the table, so the table meets its carried part without a step");
    }

    class void editor(Contract contract, Fixture fixture) {  // the editor preview places a room exactly as the renderer does
        string source = FileSystem.readText(PathTools.join(fixture.plan.configRoot, "editor/bezel-renderer.js"));
        Vector<string> missing = [];
        for wanted in ["const anchorY = placement === \"game\" || carried ? float(areaHeight * 0.5)", "static tubeStays(screen, image, canvas, grow, areaWidth, areaHeight) {",
                       "const top = float(float(areaHeight * 0.5) - float(float(float(image.y + float(image.height * 0.5)) - tube.y) * height));",
                       "{  // RendererPlacement.wholeCorner: the picture's corner on a whole pixel, a device's or a TV's"] {
            if (!source.contains(wanted)) { missing.push(wanted); }
        }
        contract.expect(missing.isEmpty() && !source.contains("placed.y = float(placed.y + Geometry.wholePixels(float(0 - placed.y)))") && !source.contains("if (!carried) {  // a device"),
            "the editor's copy centres a room's picture down the screen, tests its opening the same way, lands every picture on whole pixels and no longer stands the table on the bottom edge: missing " + missing.join(" | "));
    }
}

class TvRoomSpecContract {
    class void run(Contract contract) {
        Fixture fixture = Fixture("steam-deck");
        RenderEnvSpecAssets.packages(fixture.plan.assetRoot, fixture.plan.configRoot);  // every layer file exists, so the stacks are the packages' own
        TvRoomSpecChecks.live(contract, fixture);
        TvRoomSpecChecks.opening(contract, fixture);
        TvRoomSpecChecks.rooms(contract, fixture);
        TvRoomSpecChecks.band(contract, fixture);
        TvRoomSpecChecks.editor(contract, fixture);
    }
}
