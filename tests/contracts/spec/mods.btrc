// Mods spec (M13 item 0): the declarations the checker holds to the kind vocabulary, one library folder and
// one target per kind inside the emulator's state, clear of its seeds, profile files and each other; a library
// that Syncthing, the state root or the ROM folders never hold; contracts that never reach the owner's library;
// a launch that links before it renders, so a settings group follows what is installed; and shared code that
// names no emulator and holds only classes.

import Library.FileSystem;
import Library.JSON;
import Library.Strings;
import Library.Vector;
import ../support.btrc;
import ../../../src/lib/json.btrc;
import ../../../src/lib/paths.btrc;
import ../../../src/model.btrc;
import ../../../src/resolve.btrc;
import ../../../src/check.btrc;
import ../../../src/emit/profiles.btrc;
import ../../../src/launch/plan.btrc;
import ./standalone.btrc;
import ./emulator_runtime.btrc;
import ./harness.btrc;
import ./mods_paths.btrc;
import ./mods_install.btrc;
import ./mods_launch.btrc;
import ./mods_cli.btrc;
import ./mods_migrate.btrc;

#include <stdio.h>

class ModsSpecDeclarations {
    class string kind(string overrides) {  // a valid kind with OVERRIDES laid over it, quotes written as '
        string valid = "{'id':'fixture','library':'fixture','target':'${state_root}/data/fixture/load','install':'link','levels':[{'length':16,'characters':'0123456789ABCDEF','link_case':'upper'}],'reads':['/'],'about':'fixture','doc':'fixture'}";
        JSONValue base = JSONValue.parse(valid.replace("'", "\""));
        JSONValue extra = JSONValue.parse(overrides.replace("'", "\""));
        for key in extra.keys() { base.set(key, extra.get(key)); }
        return base.stringify();
    }

    class string diagnose(Fixture fixture, string emulatorId, string field, string value) { return ModsSpecDeclarations.diagnoseValue(fixture, emulatorId, field, JSONValue.parse(value.replace("'", "\""))); }  // quotes written as '

    class string diagnoseValue(Fixture fixture, string emulatorId, string field, JSONValue value) {  // the checker's report with one state field of EMULATOR replaced
        fixture.model.emulator(emulatorId).platform("linux").get("state").set(field, value);
        SemuDiagnostics diagnostics = SemuDiagnostics();
        SemuChecker.check(fixture.model, fixture.plan, diagnostics);
        return diagnostics.render();
    }

    class string mods(string value) { return ModsSpecDeclarations.diagnose(Fixture("linux-desktop"), "azahar", "mods", value); }

    class string one(string overrides) { return ModsSpecDeclarations.mods("{\"kinds\":[" + ModsSpecDeclarations.kind(overrides) + "]}"); }

    class string two(string first, string second) { return ModsSpecDeclarations.mods("{\"kinds\":[" + ModsSpecDeclarations.kind(first) + "," + ModsSpecDeclarations.kind(second) + "]}"); }

    class void kinds(Contract contract) {
        string field = "platforms.linux.state.mods.kinds.";
        contract.expect(ModsSpecDeclarations.one("{}").isEmpty(), "the valid fixture kind checks clean: " + ModsSpecDeclarations.one("{}"));
        contract.expect(ModsSpecDeclarations.one("{'migrate_from':['${emulation_root}/Old/load']}").isEmpty(), "a migrate_from under the emulation root checks clean");
        Vector<string> overrides = ["{'target':'/tmp/x'}", "{'target':'${state_root}/../x'}", "{'install':'copy'}", "{'library':'Mods/x'}", "{'levels':[]}", "{'levels':[{},{},{},{}]}", "{'levels':[{'link_case':'title'}]}", "{'levels':[{'files':['a/b']}]}", "{'reads':[]}", "{'checks':[{'file':'code.ips','starts_with':'PATCH','size':5}]}", "{'checks':[{'file':'code.bps','format':'zip'}]}", "{'setting':'nothing'}", "{'doc':''}", "{'copy_from':'x'}", "{'title_settings':{'path':'${state_root}/custom.ini','lines':[]}}", "{'target':'${state_root}/data/azahar-emu/nand/x'}", "{'target':'${state_root}/config/azahar-emu'}", "{'migrate_from':['/abs/mods']}", "{'migrate_from':['${emulation_root}/../mods']}", "{'migrate_from':'${emulation_root}/x'}"];
        Vector<string> wanted = ["0.target: must be a path under", "0.target: must be a path under", "0.install: must be link", "0.library: must be one folder name", "0.levels: needs one to three", "0.levels: needs one to three", "0.levels.0.link_case: must be upper or lower", "0.levels.0.files: plain file names", "0.reads: names what the emulator reads", "0.checks.0: needs a relative file and exactly one of", "0.checks.0: needs a relative file and exactly one of", "0.setting: names no group", "0.doc: missing", "0.copy_from: is not a field Semu reads here", "0.title_settings: needs a path under", "0.target: ${state_root}/data/azahar-emu/nand/x overlaps a seed or profile file: ${state_root}/data/azahar-emu/nand", "0.target: ${state_root}/config/azahar-emu overlaps a seed or profile file: ${state_root}/config/azahar-emu/qt-config.ini", "0.migrate_from: the old trees to move entries out of", "0.migrate_from: the old trees to move entries out of", "0.migrate_from: the old trees to move entries out of"];
        for (int index = 0; index < overrides.size(); index++) { contract.contains(ModsSpecDeclarations.one(overrides.get(index)), field + wanted.get(index), "the checker refuses the kind " + overrides.get(index)); }
        contract.contains(ModsSpecDeclarations.two("{}", "{'library':'other','target':'${state_root}/data/other'}"), field + "1.id: is declared twice", "two kinds with one id are refused");
        contract.contains(ModsSpecDeclarations.two("{}", "{'id':'other','target':'${state_root}/data/other'}"), field + "1.library: two kinds share one library folder", "two kinds with one library folder are refused");
        contract.contains(ModsSpecDeclarations.two("{}", "{'id':'other','library':'other'}"), field + "1.target: ${state_root}/data/fixture/load overlaps another kind's target", "two kinds with one target are refused");
        contract.contains(ModsSpecDeclarations.two("{}", "{'id':'other','library':'other','target':'${state_root}/data/fixture/load/inner'}"), "overlaps another kind's target", "a target inside another kind's target is refused");
        contract.contains(ModsSpecDeclarations.mods("{'settings':{'fixture':{'on':'true','off':''}},'kinds':[" + ModsSpecDeclarations.kind("{'setting':'fixture'}") + "]}"), "platforms.linux.state.mods.settings.fixture: a lowercase group with non-empty on and off values", "a settings group needs both values");
        contract.contains(ModsSpecDeclarations.mods("{'kinds':[],'copy':true}"), "platforms.linux.state.mods.copy: is not a field Semu reads here", "an unknown field beside the kinds is refused");
        contract.contains(ModsSpecDeclarations.mods("[]"), "platforms.linux.state.mods: must be an object with a kinds array", "a mods block that is not an object is refused");
        Fixture profile = Fixture("linux-desktop");
        SemuJson.get(profile.model.emulator("azahar").profile, "files.0.lines").push(JSONValue.makeString("x=${mods.nothing}"));
        contract.contains(ModsSpecDeclarations.diagnose(profile, "azahar", "seeds", "[]"), "${mods.nothing} names no group", "a profile that binds an undeclared settings group is refused");
    }

    class string broken(string field, string value) {  // ryujinx's real updates declaration with one field replaced
        JSONValue declaration = SemuJson.get(Fixture("linux-desktop").model.emulator("ryujinx").platform("linux"), "state.updates");
        JSONValue changed = JSONValue.parse(declaration.stringify());
        if (field.contains(".")) { changed.get("title").set("base_suffix", JSONValue.parse(value)); } else { changed.set(field, JSONValue.parse(value)); }
        return ModsSpecDeclarations.diagnoseValue(Fixture("linux-desktop"), "ryujinx", "updates", changed);
    }

    class void updates(Contract contract) {
        Vector<string> fields = ["target", "title.base_suffix", "json", "copy"];
        Vector<string> values = ["\"${state_root}/config/Ryujinx/games/updates.json\"", "\"0000\"", "\"x\"", "\"x\""];
        Vector<string> wanted = ["state.updates.target: must be a path under ${state_root}/ naming ${title}", "state.updates.title: needs a length, update_suffix and base_suffix of one length", "state.updates.json: the choice file as a JSON object", "state.updates.copy: is not a field Semu reads here"];
        for (int index = 0; index < fields.size(); index++) { contract.contains(ModsSpecDeclarations.broken(fields.get(index), values.get(index)), wanted.get(index), "the checker refuses an updates declaration with a broken " + fields.get(index)); }
        contract.expect(ModsSpecDeclarations.broken("about", "\"Updates.\"").isEmpty(), "ryujinx's real updates declaration checks clean");
    }

    class void library(Contract contract) {
        Fixture fixture = Fixture("linux-desktop");
        string state = PathTools.join(fixture.scratch, "state");
        string content = PathTools.join(fixture.scratch, "content");
        Vector<string> places = [PathTools.join(content, "mods"), PathTools.join(state, "mods"), fixture.plan.romsRoot(), "Emulation/mods"];
        for place in places {
            SemuDiagnostics diagnostics = SemuDiagnostics();
            SemuPlan plan = SemuResolver.plan(fixture.model, "linux-desktop", fixture.plan.semuHome, fixture.plan.assetRoot, "{\"paths\":{\"state_root\":\"" + state + "\",\"content_root\":\"" + content + "\",\"mods\":\"" + place + "\"}}", diagnostics);
            SemuChecker.check(fixture.model, plan, diagnostics);
            contract.contains(diagnostics.render(), "settings.paths.mods", "a library at " + place + " is refused");
        }
        SemuDiagnostics off = SemuDiagnostics();
        SemuPlan empty = SemuResolver.plan(fixture.model, "linux-desktop", fixture.plan.semuHome, fixture.plan.assetRoot, "{\"paths\":{\"state_root\":\"" + state + "\",\"content_root\":\"" + content + "\",\"mods\":\"\"}}", off);
        contract.expect(SemuChecker.check(fixture.model, empty, off), "an empty paths.mods is allowed: it turns mods off: " + off.render());
        for target in ["linux-desktop", "steam-deck", "macos"] {
            Fixture real = Fixture(target);
            contract.expect(SemuChecker.check(real.model, real.plan, real.diagnostics), target + ": the real declarations check clean: " + real.diagnostics.render());
        }
    }
}

class ModsSpecGuard {  // decision M6: no contract reads or links the owner's library
    class void run(Contract contract) {
        for target in ["linux-desktop", "steam-deck", "macos"] {
            Fixture fixture = Fixture(target);
            SemuPlan unguarded = SemuResolver.plan(fixture.model, target, fixture.plan.semuHome, fixture.plan.assetRoot, "{}", SemuDiagnostics());
            contract.expect(SemuPaths.inside(fixture.scratch, fixture.plan.path("mods")) && !SemuPaths.inside(fixture.scratch, unguarded.path("mods")), target + ": the fixture's library is scratch, never the real " + unguarded.path("mods"));
            contract.expect(SemuPaths.inside(fixture.scratch, EmulatorRuntimeSpecTools.plan(fixture, target, "").path("mods")), target + ": the runtime spec's plans use the scratch library");
        }
        StandaloneSpecBed bed = StandaloneSpecBed();
        contract.expect(SemuPaths.inside(bed.fixture.scratch, bed.fixture.plan.path("mods")) && SemuPaths.inside(bed.fixture.scratch, bed.fixture.plan.tokens.resolve("${paths.mods}")), "the standalone bed's library is scratch");
    }
}

class ModsSpecProfile {  // the install runs before the render in one launch, so the group follows the library
    class void run(Contract contract) {
        ModsSpecBed bed = ModsSpecBed();
        SemuJson.get(bed.emulator.profile, "files.0.lines").push(JSONValue.makeString("fixture_switch=${mods.fixture}"));
        ModsSpecTree.write(bed.source("fixture-textures/0004000000033600/tex.png"), "png");
        SemuLaunchPlan launch = bed.bed.launch("azahar", "n3ds", "Zelda.3ds");
        string written = PathTools.join(bed.state, "config/azahar-emu/qt-config.ini");
        contract.expect(launch.ok() && FileSystem.readText(written).contains("fixture_switch=true\n"), "the launch links the pack and then writes the group on: " + launch.error);
        rename(bed.source("fixture-textures/0004000000033600"), PathTools.join(bed.bed.fixture.scratch, "taken-out"));
        bed.bed.launch("azahar", "n3ds", "Zelda.3ds");
        contract.expect(FileSystem.readText(written).contains("fixture_switch=false\n"), "with the library emptied the next launch writes it off");
        bed.bed.fixture.plan.tokens.put("state_root", bed.state);
        contract.expect(SemuProfileContext(bed.bed.fixture.model, bed.bed.fixture.plan, bed.emulator, SemuDiagnostics()).bindings().get("mods.fixture").equals("false"), "the profile binding reads the same state");
        string outside = PathTools.join(bed.bed.fixture.scratch, "outside");
        FileSystem.mkdirp(outside);
        string target = bed.textures("");
        rename(target, PathTools.join(bed.bed.fixture.scratch, "old-target"));
        FileSystem.symlink(outside, target);
        SemuLaunchPlan linked = bed.bed.launch("azahar", "n3ds", "Zelda.3ds");
        contract.expect(linked.ok() && linked.notice.contains("mods:") && FileSystem.listDir(outside).isEmpty(), "a target that is a link: the game still starts, the notice says why, nothing is written through it: " + linked.notice);
    }
}

class ModsSpecSource {  // shared mods code: classes only, and no emulator, system or title in it
    class Vector<string> files() {
        Vector<string> result = ["src/emit/composed_scale.btrc", "src/emit/esde_choice.btrc", "src/launch/seeds.btrc"];
        for name in ["kind", "library", "manifest", "report", "install", "title_settings", "updates", "declarations", "titles", "listing", "layout", "move", "migrate"] { result.push("src/mods/" + name + ".btrc"); }
        return result;
    }

    class void run(Contract contract, string project) {
        for name in ModsSpecSource.files() {
            string source = FileSystem.readText(PathTools.join(project, name));
            string lowered = source.toLower();
            contract.expect(!source.isEmpty(), name + " exists");
            for needle in ["azahar", "ryujinx", "citra", "cemu", "dolphin", "retroarch", "pcsx2", "ppsspp", "n3ds", "wiiu", "load/mods", "load/textures", "mods/contents", "0004000", "0100f2c"] { contract.lacks(lowered, needle, name + " stays emulator- and system-generic"); }
            int strays = 0;
            for line in Strings.split(source, "\n") {
                if (line.isEmpty() || line.startsWith(" ") || line.startsWith("}") || line.startsWith("import ") || line.startsWith("//") || line.startsWith("#include")) { continue; }
                if (!line.startsWith("class ")) { strays++; }
            }
            contract.expect(strays == 0, name + f" holds only classes at file scope: {strays} other declarations");
            contract.expect(HarnessSpecStyle.shortNames(source).isEmpty(), name + " binds no one- or two-letter name and no abbreviation: " + HarnessSpecStyle.shortNames(source).join(" "));
        }
    }
}

class ModsSpecContract {
    class void run(Contract contract) {
        ModsSpecDeclarations.kinds(contract);
        ModsSpecDeclarations.updates(contract);
        ModsSpecDeclarations.library(contract);
        ModsSpecGuard.run(contract);
        ModsSpecPaths.run(contract);
        ModsSpecInstall.run(contract);
        ModsSpecLaunch.run(contract);
        ModsSpecProfile.run(contract);
        ModsSpecReport.run(contract);
        ModsSpecMigrate.run(contract);
        ModsSpecSource.run(contract, Fixture("linux-desktop").project);
    }
}
