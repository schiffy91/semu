// Flycast 5aa091fd's -config grammar, ported so a contract can read Semu's argv the way Flycast does.

import Library.Vector;

class FlycastConfigGrammar {
    // parseConfigOption (core/cfg/cl.cpp:36-168): section:key=value pairs split on commas; a quote
    // opened in a value runs to the next same mark and ends that pair; an invalid pair stops parsing.
    class Vector<string> values(string option, string wanted) {  // every value set for section:key, in order
        Vector<string> result = [];
        string quote = "";
        string section = "";
        string key = "";
        string value = "";
        int step = 0;  // 0 section, 1 key, 2 value
        for (int index = 0; index < option.len(); index++) {
            string character = option.substring(index, 1);
            bool mark = character.equals("\"") || character.equals("'");
            if (!quote.isEmpty() && character.equals(quote)) {
                if ((section + ":" + key).equals(wanted)) { result.push(value); }
                quote = "";
                step = 0;
                section = "";
                key = "";
                value = "";
            } else if (character.equals(":") && step == 0) {
                if (section.isEmpty()) { return result; }
                step = 1;
            } else if (character.equals("=") && step < 2) {
                if (step == 0 || key.isEmpty()) { return result; }
                step = 2;
            } else if (mark && step == 2 && quote.isEmpty()) {
                quote = character;
                value = "";
            } else if (character.equals(",") && step == 0) {
                continue;
            } else if (character.equals(",") && step == 2 && quote.isEmpty()) {
                if ((section + ":" + key).equals(wanted)) { result.push(value); }
                step = 0;
                section = "";
                key = "";
                value = "";
            } else if (character.equals(" ") && step < 2) {
                continue;
            } else if (step == 0) {
                section = section + character;
            } else if (step == 1) {
                key = key + character;
            } else {
                value = value + character;
            }
        }
        if (step == 2 && (section + ":" + key).equals(wanted)) { result.push(value); }
        return result;
    }

    // The string-list loader (core/cfg/option.h:210-262): entries split on ';', and an entry that
    // starts with '"' runs to a '"' followed by ';' or the end, with "" for a literal quote.
    class Vector<string> paths(string stored) {
        Vector<string> result = [];
        int start = 0;
        while (start < stored.len()) {
            if (stored.charAt(start) == 34) {
                string entry = "";
                int index = start + 1;
                while (index < stored.len()) {
                    bool closing = stored.charAt(index) == 34 && (index + 1 >= stored.len() || stored.charAt(index + 1) == 59);
                    if (closing) { break; }
                    bool doubled = stored.charAt(index) == 34 && stored.charAt(index + 1) == 34;
                    entry = entry + stored.substring(index, 1);
                    index = index + (doubled ? 2 : 1);
                }
                result.push(entry);
                start = index + 2;
            } else {
                int end = start;
                while (end < stored.len() && stored.charAt(end) != 59) { end++; }
                if (end > start) { result.push(stored.substring(start, end - start)); }
                start = end + 1;
            }
        }
        return result;
    }

    class Vector<string> contentPath(Vector<string> argv) {  // what Dreamcast.ContentPath holds after every -config on argv
        Vector<string> folders = [];
        for (int index = 0; index + 1 < argv.size(); index++) {
            if (!argv.get(index).equals("-config")) { continue; }
            Vector<string> assigned = FlycastConfigGrammar.values(argv.get(index + 1), "config:Dreamcast.ContentPath");
            if (!assigned.isEmpty()) { folders = FlycastConfigGrammar.paths(assigned.last()); }
        }
        return folders;
    }
}
