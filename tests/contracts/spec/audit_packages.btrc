// Audit packages spec (M15 review): the render-host audits draw the package each variant declares. A variant that
// declares an "output" (the Wii's 16:9 TV, tv_wide) is not in the radial's bezel list, so `semu render-env` never
// selects it by name: asked for it, it compiles the default variant's 4:3 package. A launch reaches it through the
// variant that lists it under "outputs", on that output's picture, which the renderer answers with the _B keys.
// tests/visual/editor-sync.sh and tests/visual/reflection-audit.sh render it that way and fail a cell whose drawn
// package (the renderer's debug line) is not the variant's own; the committed reflection-audit.tsv names the package
// drawn on every row, every declared variant has its rows, and each row's package must be its variant's.

import Library.FileSystem;
import Library.JSON;
import Library.Strings;
import Library.Vector;
import ../support.btrc;
import ../../../src/lib/json.btrc;
import ../../../src/lib/paths.btrc;

class AuditPackagesSpecContract {
    class void need(Vector<string> missing, string name, string scope, string wanted) { if (!scope.contains(wanted)) { missing.push(name + ": " + wanted); } }

    class string declared(Fixture fixture, string systemId, string variantId) {  // the variant's own package, "" when the system declares no such variant
        JSONValue variants = fixture.model.system(systemId).bezels.get("variants");
        for (int index = 0; variants != null && variants.isArray() && index < variants.size(); index++) {
            if (SemuJson.textAt(variants.at(index), "id").equals(variantId)) { return SemuJson.textAt(variants.at(index), "bezel"); }
        }
        return "";
    }

    class int column(Vector<string> header, string name) {
        for (int index = 0; index < header.size(); index++) { if (header.get(index).equals(name)) { return index; } }
        return -1;
    }

    class void scripts(Contract contract, Fixture fixture) {  // both audits reach an output variant through its base and refuse another package
        Vector<string> missing = [];
        string compositor = FileSystem.readText(PathTools.join(fixture.project, "src/renderer/renderer_compositor.btrc"));
        AuditPackagesSpecContract.need(missing, "renderer_compositor.btrc", compositor, "\"semu-renderer: frame %llu bezel %s fb %dx%d lane0 out ");
        for name in ["tests/visual/editor-sync.sh", "tests/visual/reflection-audit.sh"] {
            string script = FileSystem.readText(PathTools.join(fixture.project, name));
            AuditPackagesSpecContract.need(missing, name, script, "jq -r --arg id \"$2\" '.variants[] | select((.outputs // {}) | to_entries | any(.value == $id)) | .id' \"$1\" | head -1");
            AuditPackagesSpecContract.need(missing, name, script, "chosen=\"$(chosen_variant \"$bezels\" \"$variant\")\"");
            AuditPackagesSpecContract.need(missing, name, script, "sed -n 's/^semu-renderer: frame [0-9]* bezel \\([^ ]*\\) fb .*/\\1/p'");
        }
        string editorSync = FileSystem.readText(PathTools.join(fixture.project, "tests/visual/editor-sync.sh"));
        AuditPackagesSpecContract.need(missing, "editor-sync.sh", editorSync, "if ! production \"$system\" \"$chosen\" \"$productionImage\" \"$wide\" \"$productionLog\"; then");
        AuditPackagesSpecContract.need(missing, "editor-sync.sh", editorSync, "if [ \"$drawn\" != \"$package\" ]; then");
        string audit = FileSystem.readText(PathTools.join(fixture.project, "tests/visual/reflection-audit.sh"));
        AuditPackagesSpecContract.need(missing, "reflection-audit.sh", audit, "{\\\"bezel_variant\\\":\\\"${chosen:-$variant}\\\",");
        AuditPackagesSpecContract.need(missing, "reflection-audit.sh", audit, "[ \"$drawnPackage\" = \"$package\" ] || drawn=PACKAGE");
        contract.expect(missing.isEmpty(), "editor-sync.sh and reflection-audit.sh render a variant that declares an output through the variant listing it under outputs (the Wii's tv_wide through tv, as a launch reaches it), and fail a cell whose drawn package is not the variant's own: missing " + missing.join(" | "));
    }

    class void table(Contract contract, Fixture fixture) {  // the committed audit measured each variant's own package
        Vector<string> lines = Strings.split(FileSystem.readText(PathTools.join(fixture.project, "tests/visual/reflection-audit.tsv")), "\n");
        Vector<string> header = [];
        Vector<string> wrong = [];
        Vector<string> seen = [];
        for line in lines {
            if (line.isEmpty() || line.startsWith("#")) { continue; }
            Vector<string> fields = Strings.split(line, "\t");
            if (header.isEmpty()) { header = fields; continue; }
            int systemColumn = AuditPackagesSpecContract.column(header, "system");
            int variantColumn = AuditPackagesSpecContract.column(header, "variant");
            int packageColumn = AuditPackagesSpecContract.column(header, "package");
            if (systemColumn < 0 || variantColumn < 0 || packageColumn < 0 || fields.size() != header.size()) { wrong.push("malformed row: " + line); continue; }
            if (fields.get(variantColumn).equals("-")) { continue; }
            string own = AuditPackagesSpecContract.declared(fixture, fields.get(systemColumn), fields.get(variantColumn));
            if (!fields.get(packageColumn).equals(own)) { wrong.push(f"{fields.get(systemColumn)}:{fields.get(variantColumn)} drew {fields.get(packageColumn)}, declares {own}"); }
            seen.push(fields.get(systemColumn) + ":" + fields.get(variantColumn));
        }
        Vector<string> absent = [];
        for systemId in fixture.model.systemIds() {
            JSONValue variants = fixture.model.system(systemId).bezels.get("variants");
            for (int index = 0; variants != null && variants.isArray() && index < variants.size(); index++) {
                string cell = systemId + ":" + SemuJson.textAt(variants.at(index), "id");
                int rows = 0;
                for name in seen { if (name.equals(cell)) { rows++; } }
                if (rows < 6) { absent.push(f"{cell} ({rows} of 6 rows)"); }
            }
        }
        contract.expect(!header.isEmpty() && wrong.isEmpty() && absent.isEmpty() && seen.size() >= 200,
            f"tests/visual/reflection-audit.tsv names the package drawn on each of its {seen.size()} bezel rows, each the variant's own, with every declared variant in all three placements at both sizes: " + wrong.join(" | ") + (absent.isEmpty() ? "" : " | absent " + absent.join(", ")));
    }

    class void run(Contract contract) {
        Fixture fixture = Fixture("steam-deck");
        AuditPackagesSpecContract.scripts(contract, fixture);
        AuditPackagesSpecContract.table(contract, fixture);
    }
}
