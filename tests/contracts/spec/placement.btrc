// Placement spec: the pictures the owner judged on the Deck (M13 items 1 and 5). The N64 TV's lip mirrors the
// picture at the TV strength, genesis's 0.4 (it had 0.2 and a thin lip, and angrylion's black overscan columns
// left nothing to mirror); every handheld and DS bezel stands on black (M15), no desk, no Duimon carbon plate;
// game placement centres a shell that fits the screen (the PSP at 1280x800, whose screen sits above the
// device's middle) and leaves one that does not alone, so gb, gbc and gba keep their picture centred; and the
// whole step follows the height the emulator reports less its declared crop: the N64 (GLideN64 at native factor 1,
// the black around its VI picture cropped, M15 item 3) at multiples of 237.

import Library.FileSystem;
import Library.JSON;
import Library.Strings;
import Library.Vector;
import ../support.btrc;
import ../../../src/lib/json.btrc;
import ../../../src/lib/paths.btrc;
import ../../../src/model.btrc;
import ../../../src/resolve.btrc;
import ../../../src/emit/rendering.btrc;
import ../../../src/renderer/renderer_abi.btrc;
import ../../../src/renderer/renderer_config.btrc;
import ../../../src/renderer/renderer_placement.btrc;
import ../../../src/renderer/renderer_surface_crop.btrc;
import ./render_env.btrc;

class PlacementSpecEnvironment {
    class string entry(Vector<string> environment, string name) {  // NAME's value, else ""
        string prefix = name + "=";
        for line in environment { if (line.startsWith(prefix)) { return line.substring(prefix.len(), line.len() - prefix.len()); } }
        return "";
    }

    class Vector<string> compile(Fixture fixture, string systemId, string variant) {  // the Deck's launch environment for a bezel variant ("" the default)
        string overlay = variant.isEmpty() ? "{}" : "{\"visual\":{\"systems\":{\"" + systemId + "\":{\"bezel_variant\":\"" + variant + "\"}}}}";
        SemuDiagnostics diagnostics = SemuDiagnostics();
        SemuPlan plan = SemuResolver.plan(fixture.model, "steam-deck", fixture.plan.semuHome, fixture.plan.assetRoot, overlay, diagnostics);
        return SemuRenderEnvironment.compile(plan, fixture.model.system(systemId), "retroarch", "/state/retroarch", diagnostics);
    }

    class Vector<string> layers(Vector<string> environment, string ending) {  // the package layers whose file ends in ENDING
        Vector<string> found = [];
        for line in environment {
            if (!line.startsWith("SEMU_RENDER_LAYER_") || line.startsWith("SEMU_RENDER_LAYER_COUNT")) { continue; }
            if (Strings.split(line, "|")[0].endsWith(ending)) { found.push(line); }
        }
        return found;
    }

    class Vector<string> backdrops(Vector<string> environment) {  // what the launch draws behind the art: a background plate, a backdrop or night layer, a room carried on
        Vector<string> found = [];
        string plate = PlacementSpecEnvironment.entry(environment, "SEMU_RENDER_BACKGROUND");
        if (!plate.isEmpty()) { found.push("SEMU_RENDER_BACKGROUND=" + plate); }
        for line in PlacementSpecEnvironment.layers(environment, "") {
            Vector<string> fields = Strings.split(line, "|");
            int slash = Strings.rfind(fields[0], "/");
            string name = fields[0].substring(slash + 1, fields[0].len() - slash - 1);
            bool carried = fields.size() == 8 && fields[7].equals("1");
            if (name.startsWith("background.") || name.startsWith("ambient.") || fields[0].contains("/_Backgrounds/") || carried) { found.push(line); }
        }
        return found;
    }

    class string strength(Vector<string> environment) { return Strings.split(PlacementSpecEnvironment.entry(environment, "SEMU_RENDER_SCREEN_0_REFLECT"), ",")[0]; }

    class void run(Contract contract, Fixture fixture) {
        string television = PlacementSpecEnvironment.strength(PlacementSpecEnvironment.compile(fixture, "n64", ""));
        string genesis = PlacementSpecEnvironment.strength(PlacementSpecEnvironment.compile(fixture, "genesis", ""));
        contract.expect(television.equals("0.4") && television.equals(genesis), "the N64 TV lip mirrors the picture at the TV strength, genesis's 0.4: n64 " + television + ", genesis " + genesis);
        for systemId in ["psp", "gb", "gbc", "gba", "nds", "n3ds"] {
            Vector<string> variants = [""];
            JSONValue declared = fixture.model.system(systemId).bezels.get("variants");
            for (int index = 0; declared != null && declared.isArray() && index < declared.size(); index++) { variants.push(SemuJson.textAt(declared.at(index), "id")); }
            for variant in variants {
                Vector<string> environment = PlacementSpecEnvironment.compile(fixture, systemId, variant);
                Vector<string> behind = PlacementSpecEnvironment.backdrops(environment);
                bool computed = !PlacementSpecEnvironment.entry(environment, "SEMU_RENDER_LAYOUT").equals("fixed");
                bool drawn = computed || PlacementSpecEnvironment.layers(environment, ".png").size() > 0 || !PlacementSpecEnvironment.entry(environment, "SEMU_RENDER_ART").isEmpty();
                contract.expect(drawn && behind.isEmpty(), systemId + (variant.isEmpty() ? "" : ":" + variant) + " stands on pure black, never the wood desk or Duimon's carbon or vignette plate: " + behind.join(" "));
            }
        }
        contract.expect(PlacementSpecEnvironment.backdrops(PlacementSpecEnvironment.compile(fixture, "nes", "")).size() >= 2, "a TV scene keeps its room and the night plate, so the scan sees a backdrop where one is drawn");
    }
}

class PlacementSpecGeometry {
    class int rounded(float value) { return value >= 0.0f ? (int)(value + 0.5f) : -(int)(0.5f - value); }

    class string text(struct RendererCanvasRect* rectangle) {
        return f"{PlacementSpecGeometry.rounded(rectangle->x)},{PlacementSpecGeometry.rounded(rectangle->y)} {PlacementSpecGeometry.rounded(rectangle->width)}x{PlacementSpecGeometry.rounded(rectangle->height)}";
    }

    class bool near(float value, float wanted) { return value - wanted < 0.05f && wanted - value < 0.05f; }

    class bool withinHalf(float twiceCentre, int size) { return twiceCentre - (float)size <= 1.05f && (float)size - twiceCentre <= 1.05f; }  // a centre (given doubled) within the half pixel a whole-pixel snap may move it

    class void load(Vector<string> environment, struct RendererVariantConfig* variant) {  // variant A as the renderer reads the launch's environment
        Vector<string> names = [];
        for line in environment {
            int equals = Strings.find(line, "=", 0);
            if (equals < 1) { continue; }
            string name = line.substring(0, equals);
            setenv(name, line.substring(equals + 1, line.len() - equals - 1), 1);
            names.push(name);
        }
        RendererConfiguration.loadVariant(variant, "");
        for name in names { unsetenv(name); }
    }

    class void crops(Vector<string> environment, struct RendererSurfaceCrop* crops) {  // SEMU_RENDER_SURFACE_<n>_CROP as RendererConfiguration.load reads them
        for (int index = 0; index < 2; index++) {
            string value = PlacementSpecEnvironment.entry(environment, f"SEMU_RENDER_SURFACE_{index}_CROP");
            if (value.isEmpty()) { unsetenv(f"SEMU_RENDER_SURFACE_{index}_CROP"); } else { setenv(f"SEMU_RENDER_SURFACE_{index}_CROP", value, 1); }
        }
        RendererSurfaceCropping.load(crops);
        unsetenv("SEMU_RENDER_SURFACE_0_CROP");
        unsetenv("SEMU_RENDER_SURFACE_1_CROP");
    }

    class float aspect(Vector<string> environment, int nativeWidth, int nativeHeight) {  // SEMU_RENDER_ASPECT=W:H, else the native shape, as the render host reads it
        Vector<string> parts = Strings.split(PlacementSpecEnvironment.entry(environment, "SEMU_RENDER_ASPECT"), ":");
        if (parts.size() == 2 && atof(parts[1]) > 0.0) { return (float)(atof(parts[0]) / atof(parts[1])); }
        return (float)nativeWidth / (float)nativeHeight;
    }

    class void place(Fixture fixture, string systemId, int nativeWidth, int nativeHeight, int placement, int areaWidth, int areaHeight, struct RendererCanvasRect* canvas, struct RendererCanvasRect* picture) {  // the default bezel variant
        PlacementSpecGeometry.placeVariant(fixture, systemId, "", nativeWidth, nativeHeight, placement, areaWidth, areaHeight, canvas, picture);
    }

    class void placeVariant(Fixture fixture, string systemId, string bezelVariant, int nativeWidth, int nativeHeight, int placement, int areaWidth, int areaHeight, struct RendererCanvasRect* canvas, struct RendererCanvasRect* picture) {  // the shell's canvas and the game in it, bottom-up as GL counts rows
        Vector<string> environment = PlacementSpecEnvironment.compile(fixture, systemId, bezelVariant);
        struct RendererVariantConfig variant;
        PlacementSpecGeometry.load(environment, &variant);
        struct SemuRenderFrameGl frame;
        memset(&frame, 0, sizeof(struct SemuRenderFrameGl));
        frame.surface_count = 1;
        frame.surfaces[0].native_width = nativeWidth;
        frame.surfaces[0].native_height = nativeHeight;
        frame.surfaces[0].width = nativeWidth;  // the frame at 1x: the crop works in its own pixels
        frame.surfaces[0].height = nativeHeight;
        struct RendererSurfaceCrop crops[2];
        memset(crops, 0, sizeof(crops));
        PlacementSpecGeometry.crops(environment, crops);
        frame.presentation_aspect = PlacementSpecGeometry.aspect(environment, nativeWidth, nativeHeight);
        RendererSurfaceCropping.apply(&frame, crops, frame.presentation_aspect);  // what the renderer does before it places: the picture only, its pixels square
        float shown = frame.presentation_aspect;
        int fractionalBelow = 0;  // SEMU_RENDER_GAME_FRACTIONAL_BELOW, as RendererConfiguration reads it
        for entry in environment { if (entry.startsWith("SEMU_RENDER_GAME_FRACTIONAL_BELOW=")) { fractionalBelow = atoi(entry.substring(34, entry.len() - 34)); } }
        RendererPlacement.canvas(&frame, &variant, placement, fractionalBelow, shown, areaWidth, areaHeight, variant.canvas_width, variant.canvas_height, canvas);
        struct RendererNormalizedHole* image = &variant.screens[0].image;
        float width = image->width * canvas->width;
        float height = image->height * canvas->height;
        if (width / height > shown) { width = height * shown; } else { height = width / shown; }
        picture->width = width;
        picture->height = height;
        picture->x = canvas->x + (image->x + image->width * 0.5f) * canvas->width - width * 0.5f;
        picture->y = canvas->y + (1.0f - image->y - image->height * 0.5f) * canvas->height - height * 0.5f;
    }

    class bool centred(struct RendererCanvasRect* picture, int areaWidth, int areaHeight) {
        return PlacementSpecGeometry.near(picture->x * 2.0f + picture->width, (float)areaWidth) && PlacementSpecGeometry.near(picture->y * 2.0f + picture->height, (float)areaHeight);
    }

    class void handheld(Contract contract, Fixture fixture) {
        struct RendererCanvasRect canvas;
        struct RendererCanvasRect picture;
        PlacementSpecGeometry.place(fixture, "psp", 480, 272, 1, 1280, 800, &canvas, &picture);
        float top = 800.0f - canvas.y - canvas.height;
        contract.expect(PlacementSpecGeometry.near(picture.height, 544.0f) && PlacementSpecGeometry.near(picture.x, 160.0f) && PlacementSpecGeometry.near(picture.y, (float)PlacementSpecGeometry.rounded(picture.y)),
            "PSP at 1280x800, game placement: the picture stays 2x, 960x544 at x=160, on whole pixels: " + PlacementSpecGeometry.text(&picture));
        contract.expect(canvas.y >= 0.0f && top >= 0.0f && canvas.y - top <= 1.0f && top - canvas.y <= 1.0f,
            "PSP at 1280x800: the whole shell fits, so it is centred, its top and bottom bands within a pixel: canvas " + PlacementSpecGeometry.text(&canvas) + f", bands {PlacementSpecGeometry.rounded(top)} and {PlacementSpecGeometry.rounded(canvas.y)}");
        PlacementSpecGeometry.place(fixture, "psp", 480, 272, 1, 1920, 1080, &canvas, &picture);
        contract.expect(canvas.height > 1080.0f && PlacementSpecGeometry.centred(&picture, 1920, 1080) && PlacementSpecGeometry.near(picture.height, 816.0f),
            "PSP at 1920x1080: the shell is taller than the screen, so the 3x picture stays centred: " + PlacementSpecGeometry.text(&picture));
        int widths[2] = {1280, 1920};
        int heights[2] = {800, 1080};
        for systemId in ["gb", "gbc", "gba"] {
            JSONValue native = SemuJson.get(fixture.model.system(systemId).definition, "display.screens.0.native");
            int nativeWidth = SemuJson.intAt(native, "w", 0);
            int nativeHeight = SemuJson.intAt(native, "h", 0);
            for (int size = 0; size < 2; size++) {
                PlacementSpecGeometry.place(fixture, systemId, nativeWidth, nativeHeight, 1, widths[size], heights[size], &canvas, &picture);
                int steps = nativeHeight < 1 ? 0 : PlacementSpecGeometry.rounded(picture.height) / nativeHeight;
                bool whole = steps >= 1 && PlacementSpecGeometry.near(picture.height, (float)(steps * nativeHeight)) && (steps + 1) * nativeHeight > heights[size];
                contract.expect(whole && PlacementSpecGeometry.centred(&picture, widths[size], heights[size]) && canvas.height > (float)heights[size],
                    systemId + f" at {widths[size]}x{heights[size]}, game placement: the largest whole step, centred, the shell cropped and left where the picture puts it: " + PlacementSpecGeometry.text(&picture) + ", canvas " + PlacementSpecGeometry.text(&canvas));
            }
        }
    }

    class void television(Contract contract, Fixture fixture) {  // GLideN64 at native factor 1 hands 320x240 (mupen64plus-libretro-nx f275caf4 libretro.c:1438-1446) with the VI's pass columns and unshown lines black; the renderer crops them, so the step is of 237, centred
        struct RendererCanvasRect canvas;
        struct RendererCanvasRect picture;
        int widths[2] = {1280, 1920};
        int heights[2] = {800, 1080};
        int lines[2] = {711, 948};
        for (int size = 0; size < 2; size++) {
            PlacementSpecGeometry.place(fixture, "n64", 320, 240, 1, widths[size], heights[size], &canvas, &picture);
            contract.expect(PlacementSpecGeometry.near(picture.height, (float)lines[size]) && PlacementSpecGeometry.near(picture.width, (float)lines[size] * 313.0f / 237.0f) && PlacementSpecGeometry.withinHalf(picture.x * 2.0f + picture.width, widths[size]) && PlacementSpecGeometry.withinHalf(picture.y * 2.0f + picture.height, heights[size]) && PlacementSpecGeometry.near(picture.y, (float)PlacementSpecGeometry.rounded(picture.y)),
                f"N64 320x240 cropped to 313x237 at {widths[size]}x{heights[size]}, game placement: the largest whole step of 237, {lines[size]} lines, square pixels, centred on the screen to the half pixel that lands it on whole pixels: " + PlacementSpecGeometry.text(&picture));
            PlacementSpecGeometry.place(fixture, "n64", 320, 240, 2, widths[size], heights[size], &canvas, &picture);
            int steps = PlacementSpecGeometry.rounded(picture.height) / 237;
            bool standing = PlacementSpecGeometry.withinHalf(picture.y * 2.0f + picture.height, heights[size]);  // the TV room centres its picture down the screen, within the half pixel that keeps it on the grid (tv_room.btrc)
            contract.expect(steps >= 1 && PlacementSpecGeometry.near(picture.height, (float)(steps * 237)) && PlacementSpecGeometry.withinHalf(canvas.x * 2.0f + canvas.width, widths[size]) && standing,
                f"N64 313x237 at {widths[size]}x{heights[size]}, bezel placement: a whole multiple of 237 in the TV, the TV centred across the screen, its picture centred down the screen: " + PlacementSpecGeometry.text(&picture) + ", canvas " + PlacementSpecGeometry.text(&canvas));
        }
        Vector<string> environment = PlacementSpecEnvironment.compile(fixture, "n64", "");
        string declared = PlacementSpecEnvironment.entry(environment, "SEMU_RENDER_SURFACE_0_CROP");
        struct RendererSurfaceCrop crops[2];
        memset(crops, 0, sizeof(crops));
        PlacementSpecGeometry.crops(environment, crops);
        struct SemuRenderFrameGl frame;
        memset(&frame, 0, sizeof(struct SemuRenderFrameGl));
        frame.surface_count = 1;
        frame.presentation_aspect = 4.0f / 3.0f;
        frame.surfaces[0].x = 160;  // RetroArch's integer viewport at 1280x800: an exact 3x, rows counted from the bottom
        frame.surfaces[0].y = 40;
        frame.surfaces[0].width = 960;
        frame.surfaces[0].height = 720;
        frame.surfaces[0].native_width = 320;
        frame.surfaces[0].native_height = 240;
        frame.surfaces[0].origin = SEMU_RENDER_ORIGIN_BOTTOM_LEFT;
        RendererSurfaceCropping.apply(&frame, crops, 4.0f / 3.0f);
        struct SemuRenderSurfaceGl* surface = &frame.surfaces[0];
        float square = frame.presentation_aspect - 313.0f / 237.0f;
        contract.expect(declared.equals("4,0,3,3") && surface->x == 172 && surface->y == 49 && surface->width == 939 && surface->height == 711 && surface->native_width == 313 && surface->native_height == 237 && square < 0.0005f && square > -0.0005f,
            f"the N64 crops what GLideN64 draws black around the VI picture (4 columns left, 3 right, the 3 lines under the 237 shown), so the lip mirrors the game: crop {declared}, RetroArch's 3x frame becomes {surface->x},{surface->y} {surface->width}x{surface->height} of native {surface->native_width}x{surface->native_height}, aspect {frame.presentation_aspect}");
        string entry = FileSystem.readText(PathTools.join(fixture.project, "src/renderer/libsemurenderer.btrc"));
        string configuration = FileSystem.readText(PathTools.join(fixture.project, "src/renderer/renderer_config.btrc"));
        int cropAt = Strings.find(entry, "RendererSurfaceCropping.apply(frame, SemuRenderer.config.surface_crops, SemuRenderer.config.display_aspect);", 0);
        int resolveAt = Strings.find(entry, "RendererGeometry.resolve(frame,", 0);
        contract.expect(cropAt >= 0 && resolveAt > cropAt && configuration.contains("RendererSurfaceCropping.load(config->surface_crops);"),
            "the renderer loads each screen's crop with the launch and takes it off the frame before it resolves any geometry, so placement, the extracted picture and its mirror all see the picture only");
        string editor = FileSystem.readText(PathTools.join(fixture.project, "src/bezel/editor.btrc"));
        string preview = FileSystem.readText(PathTools.join(fixture.plan.configRoot, "editor/bezel-renderer.js"));
        contract.expect(editor.contains("screen.set(\"w\", JSONValue.makeInt(cropped ? keptWidth : frameWidth));") && preview.contains("float(float(shown * float(float(first.w) / float(first.frame_w))) / float(float(first.h) / float(first.frame_h)))"),
            "the editor previews the cropped picture at the renderer's square-pixel aspect");
    }
}

class PlacementSpecContract {
    class void run(Contract contract) {
        Fixture fixture = Fixture("steam-deck");
        RenderEnvSpecAssets.packages(fixture.plan.assetRoot, fixture.plan.configRoot);  // every layer file exists, so a hidden layer is the only way to drop one
        PlacementSpecEnvironment.run(contract, fixture);
        PlacementSpecGeometry.handheld(contract, fixture);
        PlacementSpecGeometry.television(contract, fixture);
    }
}
