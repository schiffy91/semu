// Controller layouts and the players page, the supervisor's and the renderer's sides: the paced
// timeline (every press and gap at least 30 ms, the X keycode the evdev code plus eight), the
// presses Dolphin's shared profile index needs (one with Semu's file alone, a full cycle to reload),
// a live switch copying the player's own stored profile, GameCube's confirm and restart, Reset's
// way back, and the page's pads, RESTART GAME and BACK as the supervisor journals and the renderer
// draws them.

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "semu_evdev.h"

import Library.FileSystem;
import Library.JSON;
import Library.Strings;
import Library.Vector;
import ../support.btrc;
import ../../../src/lib/json.btrc;
import ../../../src/lib/paths.btrc;
import ../../../src/model.btrc;
import ../../../src/resolve.btrc;
import ../../../src/emit/profiles.btrc;
import ../../../src/emit/render_variants.btrc;
import ../../../src/launch/plan.btrc;
import ../../../src/launch/actions.btrc;
import ../../../src/launch/supervisor.btrc;
import ../../../src/launch/paced_keys.btrc;
import ../../../src/launch/player_set.btrc;
import ../../../src/launch/controller_layouts.btrc;
import ../../../src/launch/players_page.btrc;
import ../../../src/launch/system_reset.btrc;
import ../../../src/renderer/action_abi.btrc;
import ../../../src/renderer/renderer_config.btrc;
import ../../../src/renderer/renderer_menu.btrc;
import ../../../src/renderer/renderer_menu_raster.btrc;
import ./input_delivery.btrc;
import ./radial_choices.btrc;
import ./players.btrc;
import ./standalone.btrc;

class LayoutsBed {  // a Wii launch on Dolphin with PADS pads: profiles written to scratch state, the supervisor's view of it
    class SemuLaunchPlan launch(Fixture fixture, string name, string systemId, string emulatorId, int pads) {
        SemuPlan plan = PlayersBed.plan(fixture, "steam-deck", systemId, "", pads);
        string root = PathTools.join(fixture.scratch, "layouts/" + name);
        plan.stateRootPath = PathTools.join(root, "state");
        SemuEmulator emulator = fixture.model.emulator(emulatorId);
        string stateRoot = PathTools.join(plan.stateRoot(), emulatorId);
        plan.tokens.put("state_root", stateRoot);
        SemuDiagnostics diagnostics = SemuDiagnostics();
        SemuProfiles.write(stateRoot, SemuProfiles.render(fixture.model, plan, emulator, diagnostics), diagnostics);
        InputDeliveryTools.fresh();
        SemuLaunchPlan launch = InputDeliveryTools.launch(PathTools.join(root, "journal"), InputDeliveryTools.none(), InputDeliveryTools.none());
        launch.system = systemId;
        launch.emulator = emulatorId;
        launch.semuHome = PathTools.join(root, "home");
        FileSystem.mkdirp(launch.semuHome);
        launch.players = SemuPlayerSets.from(plan, fixture.model.system(systemId), emulator);
        launch.variants = SemuRenderVariants.choose(plan, fixture.model.system(systemId));
        SemuLauncher.inputContracts(launch, plan, emulator.platform(plan.platform), launch.stateDir, emulator);
        launch.stateDir = PathTools.join(root, "journal");
        launch.semuHome = PathTools.join(root, "home");
        SemuControllerLayouts.prepare(launch.players);  // as the supervisor does when it begins
        SemuTypedSteps.recording = 1;
        SemuTypedSteps.count = 0;
        return launch;
    }

    class int downs(int code) {  // presses of CODE the typer recorded
        int result = 0;
        for (int index = 0; index < SemuTypedSteps.count; index++) { if (SemuTypedSteps.code[index] == code && SemuTypedSteps.down[index] != 0) { result++; } }
        return result;
    }

    class string active(SemuLaunchPlan launch) { return FileSystem.readText(PathTools.join(launch.players.directory, launch.players.active)); }
}

class LayoutsTimingSpec {  // the paced timeline and the press count
    class void run(Contract contract) {
        Vector<int> chord = [KEY_LEFTALT, KEY_F5];
        Vector<SemuKeyStep> steps = SemuPacedTyper.steps(chord, 3, 40, 40);
        Vector<string> timeline = [];
        for step in steps { timeline.push(Strings.fromInt(step.offsetMs) + (step.down ? "+" : "-") + (step.code == KEY_F5 ? "F5" : "Alt")); }
        contract.expect(timeline.join(" ").equals("0+Alt 0+F5 40-F5 40-Alt 80+Alt 80+F5 120-F5 120-Alt 160+Alt 160+F5 200-F5 200-Alt"), "each press holds 40 ms and the next waits 40 ms, the modifier around each: " + timeline.join(" "));
        Vector<SemuKeyStep> fast = SemuPacedTyper.steps(chord, 2, 5, 0);
        contract.expect(fast.size() == 8 && fast.get(2).offsetMs == 30 && fast.get(4).offsetMs == 60, "a press or a gap under 30 ms is lengthened to 30: the emulator would miss it");
        contract.expect(SemuXTest.keycode(KEY_F5) == KEY_F5 + 8, "XTest types the X keycode, the evdev code plus eight");
        contract.expect(SemuControllerLayouts.presses(0, 0, 1) == 1 && SemuControllerLayouts.presses(1, 0, 2) == 1 && SemuControllerLayouts.presses(0, 2, 4) == 2 && SemuControllerLayouts.presses(3, 1, 4) == 2 && SemuControllerLayouts.presses(1, 1, 4) == 4, "presses from the shared index wrap the sorted listing; landing where it is takes a full cycle, never none");
    }
}

class LayoutsSwitchSpec {  // live switches, the stray, GameCube's restart, Reset
    class void run(Contract contract, Fixture fixture) {
        SemuLaunchPlan launch = LayoutsBed.launch(fixture, "switch", "wii", "dolphin", 2);
        SemuPlayerSet set = launch.players;
        string retired = PathTools.join(set.directory, "Semu Classic.ini");
        FileSystem.mkdirp(set.directory);
        FileSystem.writeText(retired, "[Profile]\nold\n");
        contract.expect(SemuControllerLayouts.prepare(set) && LayoutsBed.active(launch).equals(FileSystem.readText(set.storeFile(0, 1))), "at launch Semu's one file holds player 1's layout (Nunchuk)");
        contract.expect(!FileSystem.exists(retired) && FileSystem.readText(PathTools.join(set.retiredDirectory, "Semu Classic.ini")).equals("[Profile]\nold\n") && SemuControllerLayouts.listing(set.directory).size() == 1, "an older release's profile moves out of the cycled folder, kept whole");
        long long now = SemuClock.milliseconds();
        SemuControllerLayouts.select(launch, 0, 2, now);
        contract.expect(LayoutsBed.downs(KEY_F5) == 1 && LayoutsBed.downs(KEY_LEFTALT) == 1 && LayoutsBed.active(launch).equals(FileSystem.readText(set.storeFile(0, 2))), "Classic for player 1: its stored profile copied in, then one paced Alt+F5");
        contract.expect(RadialBed.record(launch, 0, SemuActions.layoutSelect(), 2, 0) && set.layouts.get(0) == 2 && SemuJson.textAt(RadialBed.saved(launch), "input.systems.wii.players.1.layout").equals("classic"), "it journals 83 slot 2 for player 1 and saves the layout for the system");
        FileSystem.writeText(PathTools.join(set.directory, "Aaa.ini"), "[Profile]\n");  // the owner's own profile sorts first
        SemuTypedSteps.count = 0;
        SemuControllerLayouts.select(launch, 1, 0, now);
        string second = LayoutsBed.active(launch);
        contract.expect(LayoutsBed.downs(KEY_F6) == 1 && second.contains("Device = SDL/0/Xbox Series X Controller\n") && !second.contains("Steam Deck"), "Wii Remote for player 2: Alt+F6 once from index 0 to Semu's file at 1, and the profile names only player 2's pad");
        SemuTypedSteps.count = 0;
        SemuControllerLayouts.select(launch, 1, 0, now);
        contract.expect(LayoutsBed.downs(KEY_F6) == 2 && set.sharedIndex == 1, "choosing it again cycles once around the two files: a lost press is redone");
        SemuTypedSteps.count = 0;
        SemuControllerLayouts.select(launch, 0, 3, now);
        contract.expect(SemuTypedSteps.count == 0 && RadialBed.record(launch, 3, SemuActions.layoutSelect(), 3, 16) && set.layouts.get(0) == 2 && SemuSupervisorRuntime.relaunch == 0, "GameCube asks for a second press: 83 reserved 16, nothing typed or saved");
        SemuControllerLayouts.select(launch, 0, 3, now + 1000LL);
        contract.expect(RadialBed.record(launch, 4, SemuActions.layoutSelect(), 3, 32) && SemuSupervisorRuntime.relaunch == 1 && SemuJson.textAt(RadialBed.saved(launch), "input.systems.wii.players.1.layout").equals("gamecube"), "the second press saves GameCube and restarts the game (83 reserved 32)");
        SemuSupervisorRuntime.relaunch = 0;
        SemuSupervisorRuntime.quit = 0;
        SemuRelaunch.disarm();
        SemuControllerLayouts.select(launch, 0, 1, now + 5000LL);
        contract.expect(RadialBed.record(launch, 5, SemuActions.layoutSelect(), 1, 16), "leaving GameCube asks again: Dolphin reads the Wii Remote's source at boot");
        SemuControllerLayouts.select(launch, 3, 1, now);
        contract.expect(RadialBed.record(launch, 6, SemuActions.layoutSelect(), -1, 3), "a player without a pad has nothing to choose (83 slot -1)");
        SemuRelaunch.disarm();
        set.layouts.set(0, 2);
        SemuTypedSteps.count = 0;
        SemuControllerLayouts.pick(launch, "wii.controller.wiimote", now);
        contract.expect(set.layouts.get(0) == 0 && LayoutsBed.downs(KEY_F5) > 0, "a Wii layer slot picks that layout for player 1");
        contract.expect(SemuControllerLayouts.stepped(set, 2, 1) == 3 && SemuControllerLayouts.stepped(set, 0, -1) == 3 && SemuControllerLayouts.stepped(set, 3, 1) == 0, "Controller Layout steps through the layouts and wraps");
        set.layouts.set(1, 2);
        SemuTypedSteps.count = 0;
        SemuControllerLayouts.reset(launch);
        contract.expect(set.layouts.get(0) == 1 && set.layouts.get(1) == 1 && LayoutsBed.downs(KEY_F5) > 0 && LayoutsBed.downs(KEY_F6) > 0 && !SemuControllerLayouts.resetRestarts(set), "Reset switches every player back to Nunchuk live");
        set.layouts.set(0, 3);
        contract.expect(SemuControllerLayouts.resetRestarts(set), "a player on GameCube returns only by restarting");
        SemuTypedSteps.recording = 0;
    }
}

class LayoutsPageSpec {  // the players page as the supervisor runs it
    class Vector<string> rows(SemuLaunchPlan launch) { return Strings.split(FileSystem.readText(PathTools.join(launch.stateDir, SemuPlayersPage.fileName())).trim(), "\n"); }

    class void run(Contract contract, Fixture fixture) {
        SemuLaunchPlan launch = LayoutsBed.launch(fixture, "page", "wii", "dolphin", 3);
        contract.expect(launch.menuActions.contains("controller.layout.next") && launch.menuActions.contains("ui.players"), "the Wii menu shows CONTROLLER and PLAYERS");
        SemuSupervisorRuntime.menu_visible = 1;
        long long now = SemuClock.milliseconds();
        SemuActionExecutor.dispatch(launch, "ui.players", SEMU_SOURCE_X11, SEMU_SOURCE_X11);
        contract.expect(launch.players.pageOpen && RadialBed.record(launch, 0, SemuActions.menuPage(), 1, 0) && LayoutsPageSpec.rows(launch).join("|").equals("P1  PAD 1  NUNCHUK|P2  PAD 2  NUNCHUK|P3  PAD 3  NUNCHUK|P4  NO PAD|RESTART GAME|BACK"), "Players opens the page: a row per player, then RESTART GAME and BACK");
        SemuSupervisorRuntime.menu_selected = 5;
        SemuActionExecutor.dispatch(launch, "ui.menu.down", SEMU_SOURCE_X11, 900);
        contract.expect(SemuSupervisorRuntime.menu_selected == 0, "down from BACK wraps to P1 over the page's six rows");
        SemuSupervisorRuntime.menu_selected = 1;
        SemuPlayersPage.confirm(launch, now);
        contract.expect(launch.players.pads.get(1) == -1 && RadialBed.record(launch, 2, SemuActions.playerAssign(), -1, 1) && LayoutsPageSpec.rows(launch).get(1).equals("P2  NO PAD"), "confirm on P2 skips the pads P1 and P3 hold and reaches none");
        SemuPlayersPage.confirm(launch, now);
        contract.expect(launch.players.pads.get(1) == 1 && JSONValue.parse(FileSystem.readText(PathTools.join(launch.semuHome, "semu.json"))) != null && SemuJson.intAt(RadialBed.saved(launch), "input.systems.wii.players.2.pad", -9) == 1, "again: back to pad 2, saved for the system");
        SemuSupervisorRuntime.menu_selected = 4;
        SemuPlayersPage.confirm(launch, now);
        contract.expect(RadialBed.record(launch, 4, SemuActions.menuPage(), 1, 2) && SemuSupervisorRuntime.relaunch == 0, "RESTART GAME with nothing changed says so and restarts nothing");
        SemuSupervisorRuntime.menu_selected = 2;
        SemuActionExecutor.dispatch(launch, "ui.menu.right", SEMU_SOURCE_X11, 901);
        contract.expect(launch.players.layouts.get(2) == 2 && LayoutsPageSpec.rows(launch).get(2).equals("P3  PAD 3  CLASSIC"), "right on P3 steps its layout live and rewrites the row");
        SemuSupervisorRuntime.menu_selected = 1;
        SemuPlayersPage.confirm(launch, now);
        SemuSupervisorRuntime.menu_selected = 4;
        SemuPlayersPage.confirm(launch, now);
        contract.expect(SemuSupervisorRuntime.relaunch == 1, "after a pad change RESTART GAME restarts the game");
        SemuSupervisorRuntime.relaunch = 0;
        SemuSupervisorRuntime.quit = 0;
        SemuSupervisorRuntime.menu_selected = 5;
        SemuActionExecutor.dispatch(launch, "ui.menu.confirm", SEMU_SOURCE_X11, 902);
        contract.expect(!launch.players.pageOpen && SemuSupervisorRuntime.menu_selected == launch.menuActions.indexOf("ui.players"), "BACK returns to the menu on its PLAYERS row");
        SemuLaunchPlan gba = LayoutsBed.launch(fixture, "page-gba", "gba", "retroarch", 3);
        contract.expect(!gba.menuActions.contains("ui.players") && !gba.menuActions.contains("controller.layout.next"), "a one-player system without layouts shows neither row");
        SemuSupervisorRuntime.menu_visible = 0;
        SemuActionExecutor.dispatch(gba, "ui.players", SEMU_SOURCE_X11, 903);
        contract.expect(RadialBed.record(gba, 0, SemuActions.menuPage(), -1, 0) && SemuSupervisorRuntime.menu_visible == 0, "Players on a one-player game says so (86 slot -1) and opens nothing");
        SemuLaunchPlan snes = LayoutsBed.launch(fixture, "page-snes", "snes", "retroarch", 2);
        contract.expect(snes.menuActions.contains("ui.players") && !snes.menuActions.contains("controller.layout.next"), "SNES shows PLAYERS, not CONTROLLER");
        SemuTypedSteps.recording = 0;
        memset(&SemuSupervisorRuntime, 0, sizeof(SemuSupervisorRuntime));
    }
}

class LayoutsRendererSpec {  // the renderer draws the page from the file and names the layouts
    class void apply(struct RendererPostUiState* postUi, int action, int slot, int reserved) {  // one fresh record through the post-UI state
        struct SemuActionRecord record;
        memset(&record, 0, sizeof(record));
        record.action = action;
        record.slot = slot;
        record.reserved = reserved;
        record.monotonic_ms = RendererClock.milliseconds();
        RendererMenuModel.apply(postUi, &record, RendererClock.milliseconds());
    }

    class void run(Contract contract, Fixture fixture) {
        string state = PathTools.join(fixture.scratch, "layouts/renderer");
        FileSystem.mkdirp(state);
        FileSystem.writeText(PathTools.join(state, "semu-render-players.txt"), "P1  PAD 1  NUNCHUK\nP2  NO PAD\nRESTART GAME\nBACK\n");
        setenv("SEMU_RENDER_STATE_DIR", state, 1);
        setenv("SEMU_MENU_ITEMS", fixture.plan.input.menuItems("label").join("|"), 1);
        setenv("SEMU_MENU_ACTIONS", fixture.plan.input.menuItems("action").join("|"), 1);
        setenv("SEMU_MENU_TOASTS", fixture.plan.input.toasts(), 1);
        setenv("SEMU_MENU_LAYOUTS", "WII REMOTE|NUNCHUK|CLASSIC|GAMECUBE", 1);
        setenv("SEMU_MENU_LAYOUT", "1", 1);
        struct RendererPostUiState ui;
        memset(&ui, 0, sizeof(struct RendererPostUiState));
        RendererMenuModel.initialize(&ui);
        int controller = RendererMenuModel.rowOf(&ui, "controller.layout.next");
        contract.expect(strcmp(RendererMenuRaster.rowValue(&ui, controller), "NUNCHUK") == 0, "the CONTROLLER row names player 1's layout from the launch");
        LayoutsRendererSpec.apply(&ui, SemuActions.menuPage(), 1, 0);
        contract.expect(ui.visible == 1 && ui.page == 1 && ui.item_count == 4 && strcmp(ui.labels, "P1  PAD 1  NUNCHUK") == 0 && strcmp(ui.labels + 3 * 24, "BACK") == 0, "86 slot 1 shows the page's rows as the supervisor wrote them");
        LayoutsRendererSpec.apply(&ui, SemuActions.layoutSelect(), 2, 0);
        contract.expect(ui.layout_shown == 2 && strcmp(ui.toast, "P1: CLASSIC") == 0, "83 for player 1 toasts P1: CLASSIC and the CONTROLLER row follows: ");
        LayoutsRendererSpec.apply(&ui, SemuActions.layoutSelect(), 3, 17);
        contract.expect(ui.layout_shown == 2 && strcmp(ui.toast, "P2 GAMECUBE: AGAIN TO REBOOT") == 0, "a prompt names the player and the layout and changes nothing yet: ");
        LayoutsRendererSpec.apply(&ui, SemuActions.menuPage(), 0, 0);
        contract.expect(ui.page == 0 && ui.item_count == 12 && ui.selected == RendererMenuModel.rowOf(&ui, "ui.players") && strcmp(RendererMenuRaster.rowValue(&ui, controller), "CLASSIC") == 0, "86 slot 0 brings the menu back on PLAYERS, CONTROLLER now CLASSIC");
        LayoutsRendererSpec.apply(&ui, SemuActions.menuPage(), -1, 0);
        contract.expect(strcmp(ui.toast, "PLAYERS: ONE PLAYER") == 0, "86 slot -1 says the game takes one player");
        for name in ["SEMU_RENDER_STATE_DIR", "SEMU_MENU_ITEMS", "SEMU_MENU_ACTIONS", "SEMU_MENU_TOASTS", "SEMU_MENU_LAYOUTS", "SEMU_MENU_LAYOUT"] { unsetenv(name); }
    }
}

class LayoutsLaunchSpec {  // a real launch plan deals the players and hands the supervisor and the renderer their rows
    class void run(Contract contract) {
        StandaloneSpecBed bed = StandaloneSpecBed();
        SemuLaunchPlan wii = bed.launch("dolphin", "wii", "Sports.rvz");
        string environment = wii.environment.join("\n");
        contract.expect(wii.ok() && wii.players.count == 4 && wii.players.pads.size() == 4 && wii.players.layoutsAvailable() && wii.players.layouts.get(0) == 1, "a Wii launch on Dolphin deals four players, player 1 on Nunchuk");
        contract.expect(wii.menuActions.contains("controller.layout.next") && wii.menuActions.contains("ui.players") && environment.contains("SEMU_MENU_LAYOUTS=WII REMOTE|NUNCHUK|CLASSIC|GAMECUBE\nSEMU_MENU_LAYOUT=1"), "its menu has CONTROLLER and PLAYERS and the renderer gets the layouts");
        contract.expect(FileSystem.isFile(PathTools.join(bed.stateRoot("dolphin"), "dolphin-user/Config/Semu Layouts/P1 Classic.ini")) && wii.players.directory.equals(PathTools.join(bed.stateRoot("dolphin"), "dolphin-user/Config/Profiles/Wiimote")), "the launch wrote player 1's stored layouts and names the folder Dolphin cycles");
        contract.contains(wii.json(), "\"players\": [\n    \"P1  PAD 1  NUNCHUK\",\n    \"P2  NO PAD\"", "--print-plan lists the players as dealt");
        SemuLaunchPlan cube = bed.launch("dolphin", "gc", "Melee.iso");
        contract.expect(cube.players.count == 4 && !cube.players.layoutsAvailable() && !cube.menuActions.contains("controller.layout.next") && cube.menuActions.contains("ui.players"), "a GameCube launch has players and no layouts");
        contract.expect(SemuPlayerSet().row(0).equals("P1  PAD 1") && SemuPlayerSet().count == 1, "an undealt set is one player on the default pad");
    }
}

class ControllerLayoutsSpecContract {
    class void run(Contract contract) {
        Fixture fixture = Fixture("steam-deck");
        LayoutsLaunchSpec.run(contract);
        contract.expect(SemuActions.layoutSelect() == 83 && SemuActions.playerAssign() == 84 && SemuActions.menuPage() == 86, "journal codes: layout select 83, player assign 84, players page 86");
        bool owned = true;
        for code in [83, 84, 86] { owned = owned && SemuActions.rendererOwned(code) && SemuActions.code(SemuActions.id(code)) == code; }
        contract.expect(owned, "each round-trips id and code and is the renderer's");
        LayoutsTimingSpec.run(contract);
        LayoutsSwitchSpec.run(contract, fixture);
        LayoutsPageSpec.run(contract, fixture);
        LayoutsRendererSpec.run(contract, fixture);
    }
}
