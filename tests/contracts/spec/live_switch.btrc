// Live switch spec: the GL-free core of the renderer's live bezel and shader switch, run against the
// launch's own nds variants file (the environment live_variants.btrc sets), and the toast mode.

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

import ../support.btrc;
import ../../../src/renderer/action_abi.btrc;
import ../../../src/renderer/renderer_layout.btrc;
import ../../../src/renderer/renderer_config.btrc;
import ../../../src/renderer/renderer_variants.btrc;
import ../../../src/renderer/renderer_menu.btrc;
import ../../../src/renderer/renderer_live_switch.btrc;

class LiveVariantSwitchSpec {  // the GL-free core of the renderer's live switch, against the launch's nds file
    class void select(struct RendererPostUiState* state, int action, int slot, unsigned long long sequence) {
        struct SemuActionRecord record;
        long long now = RendererClock.milliseconds();
        memset(&record, 0, sizeof(struct SemuActionRecord));  // as the supervisor appends it
        record.abi = (unsigned int)RendererActionJournal.abi();
        record.size = (unsigned int)sizeof(struct SemuActionRecord);
        record.sequence = sequence;
        record.monotonic_ms = now;
        record.action = action;
        record.slot = slot;
        RendererMenuModel.apply(state, &record, now);
    }

    class int frames(struct RendererPostUiState* state, struct RendererConfig* config, struct RendererLiveChoice* live, int* stale) {  // two game frames: the first waits, the second applies
        int first = RendererLiveSwitch.apply(state, config, live, stale);
        int second = RendererLiveSwitch.apply(state, config, live, stale);
        return first == SEMU_RENDER_SWITCH_NONE ? second : -9;
    }

    class void run(Contract contract) {
        struct RendererPostUiState state;
        memset(&state, 0, sizeof(struct RendererPostUiState));
        RendererMenuModel.initialize(&state);
        struct RendererConfig config;
        memset(&config, 0, sizeof(struct RendererConfig));
        struct RendererLiveChoice live;
        RendererLiveSwitch.reset(&live);
        int stale = 0;
        contract.expect(RendererLiveSwitch.apply(&state, &config, &live, &stale) == SEMU_RENDER_SWITCH_NONE && live.bezel == -1 && live.shader == -1, "switch: nothing requested, nothing applied");
        LiveVariantSwitchSpec.select(&state, SemuActions.bezelSelect(), 1, 1ULL);
        int applied = LiveVariantSwitchSpec.frames(&state, &config, &live, &stale);
        contract.expect(applied == SEMU_RENDER_SWITCH_APPLIED && config.variants[0].layout == SEMU_LAYOUT_MAIN_RIGHT && live.bezel == 1 && live.shader == 0 && stale == 0, "switch: a bezel select applies section [1,0] (main_right) and becomes the live choice; plain screens on black load no image");
        stale = 0;
        contract.expect(RendererLiveSwitch.apply(&state, &config, &live, &stale) == SEMU_RENDER_SWITCH_NONE && stale == 0 && live.bezel == 1, "switch: the next frame applies nothing again");
        LiveVariantSwitchSpec.select(&state, SemuActions.shaderSelect(), 1, 2ULL);
        applied = LiveVariantSwitchSpec.frames(&state, &config, &live, &stale);
        contract.expect(applied == SEMU_RENDER_SWITCH_APPLIED && live.bezel == 1 && live.shader == 1 && stale == 0, "switch: a shader-only change applies [1,1] and leaves the images alone");
        LiveVariantSwitchSpec.select(&state, SemuActions.bezelSelect(), 0, 3ULL);
        applied = LiveVariantSwitchSpec.frames(&state, &config, &live, &stale);
        unsigned long long images = RendererConfiguration.imageSignature(&config);
        contract.expect(applied == SEMU_RENDER_SWITCH_APPLIED && live.bezel == 0 && live.shader == 1 && stale == 1 && config.variants[0].art.value[0] != 0, "switch: back to the launch's bezel from a live one applies [0,1], measured against the live choice");
        memset(&config, 0, sizeof(struct RendererConfig));
        RendererLiveSwitch.reapply(&config, &live);
        contract.expect(RendererConfiguration.imageSignature(&config) == images && config.variants[0].art.value[0] != 0, "switch: a freshly loaded config (a context reset) starts on the live section");
        contract.expect(RendererLiveSwitch.imagesDue(1, 0, 0) && RendererLiveSwitch.imagesDue(1, 1, 1) && !RendererLiveSwitch.imagesDue(1, 1, 0) && !RendererLiveSwitch.imagesDue(0, 0, 1), "switch: images load on a ready context that has none yet or a stale set, never otherwise");
        state.visible = 0;
        snprintf(state.toast, sizeof(state.toast), "%s", "BEZEL: ARCTIC");
        long long now = RendererClock.milliseconds();
        state.toast_until_ms = now + 1000LL;
        bool toast = RendererToast.mode(&state, now) == SEMU_RENDER_POST_TOAST;
        state.toast_until_ms = now - 1LL;
        bool gone = RendererToast.mode(&state, now) == SEMU_RENDER_POST_NOTHING;
        state.visible = 1;
        contract.expect(toast && gone && RendererToast.mode(&state, now) == SEMU_RENDER_POST_MENU && RendererToast.mode(null, now) == SEMU_RENDER_POST_NOTHING, "toast: a closed menu draws a live toast alone, nothing once it expires, and the open menu draws the menu");
        RendererVariantFile.discard(&live.overlay);
        free(state.menu_pixels);
    }
}
