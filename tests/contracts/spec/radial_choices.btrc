// Radial v2 spec, the supervisor's side: Fit (codes 81) toggles the whole bezel and the screen
// placement live and saves it per system; Aspect (82) saves the output for that game only at one
// press and waits for Restart Game (87), the one action that restarts; Reset to Default (85) asks
// twice, removes the system's own choices and journals the defaults; the menu shows FIT, ASPECT and
// RESTART GAME only where they apply.

#include <stdio.h>
#include <string.h>

import Library.FileSystem;
import Library.JSON;
import Library.Strings;
import Library.Vector;
import ../support.btrc;
import ../../../src/lib/json.btrc;
import ../../../src/lib/paths.btrc;
import ../../../src/lib/settings.btrc;
import ../../../src/model.btrc;
import ../../../src/resolve.btrc;
import ../../../src/emit/render_variants.btrc;
import ../../../src/launch/plan.btrc;
import ../../../src/launch/actions.btrc;
import ../../../src/launch/relaunch.btrc;
import ../../../src/launch/system_reset.btrc;
import ../../../src/launch/game_restart.btrc;
import ../../../src/launch/supervisor.btrc;
import ../../../src/launch/visual_cycle.btrc;
import ../../../src/renderer/action_abi.btrc;
import ./input_delivery.btrc;
import ./render_variants.btrc;

class RadialBed {  // a scratch launch of SYSTEM with its own journal and semu.json, the real choices
    class SemuLaunchPlan launch(Fixture fixture, string systemId, string name, string settings, string rom) {
        string root = PathTools.join(fixture.scratch, "radial/" + name);
        InputDeliveryTools.fresh();
        SemuLaunchPlan launch = InputDeliveryTools.launch(PathTools.join(root, "state"), InputDeliveryTools.none(), InputDeliveryTools.none());
        launch.system = systemId;
        launch.rom = rom;
        launch.semuHome = PathTools.join(root, "home");
        FileSystem.mkdirp(launch.semuHome);
        if (!settings.isEmpty()) { FileSystem.writeText(PathTools.join(launch.semuHome, "semu.json"), settings); }
        SemuPlan plan = RenderVariantTools.plan(fixture, settings.isEmpty() ? "{}" : settings);
        plan.tokens.put("rom", rom);
        launch.variants = SemuRenderVariants.choose(plan, fixture.model.system(systemId));
        Vector<string> shown = launch.variants.shown();
        launch.players.show(shown);  // as the launch plan does: RESTART GAME where a second output waits for it
        launch.menuLabels = fixture.plan.input.menuItemsShown("label", shown);
        launch.menuActions = fixture.plan.input.menuItemsShown("action", shown);
        launch.menuDrawn = true;
        return launch;
    }

    class JSONValue saved(SemuLaunchPlan launch) { return SemuJson.readFile(PathTools.join(launch.semuHome, "semu.json")); }

    class bool record(SemuLaunchPlan launch, int index, int action, int slot, int reserved) {  // record INDEX carries ACTION, SLOT and RESERVED
        FILE* file = fopen(PathTools.join(launch.stateDir, RendererActionJournal.fileName()), "rb");
        if (file == null) { return false; }
        struct SemuActionRecord record;
        memset(&record, 0, sizeof(record));
        fseek(file, (long)((size_t)index * sizeof(struct SemuActionRecord)), SEEK_SET);
        bool read = fread(&record, sizeof(record), 1, file) == (size_t)1;
        fclose(file);
        return read && record.action == action && record.slot == slot && record.reserved == reserved;
    }
}

class RadialAbiSpec {  // the new codes after 80, their ids and toasts, and the settings store's remove
    class void run(Contract contract, Fixture fixture) {
        contract.expect(SemuActions.placementSelect() == 81 && SemuActions.outputSelect() == 82 && SemuActions.resetNotice() == 85 && SemuActions.restartNotice() == 87, "journal codes: placement select 81, output select 82, reset notice 85, restart notice 87 (83, 84 and 86 stay for the players page)");
        bool roundTrip = true;
        for code in [81, 82, 85, 87] { roundTrip = roundTrip && SemuActions.code(SemuActions.id(code)) == code && SemuActions.rendererOwned(code); }
        contract.expect(roundTrip && SemuActions.toastAction(81).equals("visual.placement.next") && SemuActions.toastAction(82).equals("visual.output.next") && SemuActions.toastAction(85).equals("system.reset") && SemuActions.toastAction(87).equals("system.restart"), "each new code round-trips id and code, is the renderer's, and shows its action's toasts");
        string toasts = fixture.plan.input.toasts();
        for entry in ["visual.placement.next=FIT: {label}", "visual.placement.next:unavailable=", "visual.bezel.next:unavailable=BEZEL: NONE HERE", "visual.output.next=ASPECT: {label}", "visual.output.next:pending=ASPECT {label}: RESTART TO APPLY", "system.reset:confirm=RESET: PRESS AGAIN", "system.reset:pending=RESET: RESTART TO APPLY", "system.reset:done=RESET TO DEFAULTS",
                      "system.restart:done=RESTARTING GAME", "system.restart:unchanged=RESTART: NOTHING TO APPLY", "controller.layout.next:pending={slot} {label}: RESTART TO APPLY"] {
            contract.contains(toasts, entry, "SEMU_MENU_TOASTS carries every NAME_toast as action:NAME: " + entry);
        }
        contract.lacks(toasts, "REBOOT", "no toast asks for a second press to reboot: only Restart Game restarts");
        string home = PathTools.join(fixture.scratch, "radial/settings");
        FileSystem.mkdirp(home);
        FileSystem.writeText(PathTools.join(home, "semu.json"), "{\"visual\":{\"bezels\":false,\"systems\":{\"gba\":{\"placement\":\"bezel\"},\"snes\":{\"placement\":\"game\"}}}}");
        contract.expect(SemuSettingsStore.remove(home, "visual.systems.gba") && SemuSettingsStore.putPath(home, ["visual", "games", "wii", "Mr. Driller (USA)", "output"], JSONValue.makeString("widescreen")), "remove and a path put with a dotted game name succeed");
        JSONValue after = SemuJson.readFile(PathTools.join(home, "semu.json"));
        contract.expect(SemuJson.get(after, "visual.systems.gba").isNull() && SemuJson.textAt(after, "visual.systems.snes.placement").equals("game") && !SemuJson.boolAt(after, "visual.bezels", true) && SemuJson.textAt(SemuJson.get(after, "visual.games.wii").get("Mr. Driller (USA)"), "output").equals("widescreen"), "remove takes only gba's subtree; snes and the global switch stay; the dotted name is one key");
        FileSystem.writeText(PathTools.join(home, "semu.json"), "{ not json");
        contract.expect(!SemuSettingsStore.remove(home, "visual.systems.snes") && FileSystem.readText(PathTools.join(home, "semu.json")).equals("{ not json"), "a malformed semu.json is never rewritten by remove");
    }
}

class RadialFitSpec {  // Fit: the four states in the owner's order, live, per system; with no bezel to place the two game states
    class void run(Contract contract, Fixture fixture) {
        SemuLaunchPlan gba = RadialBed.launch(fixture, "gba", "fit-gba", "", "Advance.gba");
        contract.expect(gba.variants.placement.ids.join("|").equals("game|bezel|game_fractional|bezel_fractional") && gba.variants.placement.labels.join("|").equals("INTEGER GAME|INTEGER BEZEL|NON-INTEGER GAME|NON-INTEGER BEZEL") && gba.variants.placement.cycled == 4 && gba.variants.placement.index == 0 && gba.variants.placement.defaultIndex == 0, "gba cycles integer game, integer bezel, non-integer game and non-integer bezel, and starts on its own default, integer game");
        Vector<string> saved = [];
        bool journaled = true;
        for (int press = 0; press < 4; press++) {
            SemuActionExecutor.execute(gba, "visual.placement.next", SEMU_SOURCE_X11);
            journaled = journaled && RadialBed.record(gba, press, SemuActions.placementSelect(), (press + 1) % 4, 0);
            saved.push(SemuJson.textAt(RadialBed.saved(gba), "visual.systems.gba.placement"));
        }
        contract.expect(journaled && saved.join("|").equals("bezel|game_fractional|bezel_fractional|game"), "four Fit presses on gba journal 81/1, 81/2, 81/3 and 81/0 and save each state, back round to integer game: " + saved.join("|"));
        SemuLaunchPlan wii = RadialBed.launch(fixture, "wii", "fit-wii", "", "Sports.rvz");
        contract.expect(wii.variants.placement.ids.join("|").equals("game|bezel|game_fractional|bezel_fractional") && wii.variants.placement.index == 1 && wii.variants.placement.defaultIndex == 1, "wii starts on integer bezel, the retired fit's nearest state");
        contract.expect(wii.variants.placement.next(-1) == 0 && wii.variants.placement.next(1) == 2, "from integer bezel, Left (the menu's FIT row) goes to INTEGER GAME and Right to NON-INTEGER GAME");
        SemuActionExecutor.execute(wii, "visual.placement.next", SEMU_SOURCE_X11);
        SemuActionExecutor.execute(wii, "visual.placement.next", SEMU_SOURCE_X11);
        SemuActionExecutor.execute(wii, "visual.placement.next", SEMU_SOURCE_X11);
        contract.expect(RadialBed.record(wii, 0, SemuActions.placementSelect(), 2, 0) && RadialBed.record(wii, 1, SemuActions.placementSelect(), 3, 0) && RadialBed.record(wii, 2, SemuActions.placementSelect(), 0, 0), "from integer bezel, Fit goes to non-integer game, non-integer bezel, integer game");
        SemuLaunchPlan wiiu = RadialBed.launch(fixture, "wiiu", "fit-wiiu", "", "Zelda.wux");
        SemuActionExecutor.execute(wiiu, "visual.placement.next", SEMU_SOURCE_X11);
        contract.expect(wiiu.variants.placement.ids.join("|").equals("game|game_fractional") && RadialBed.record(wiiu, 0, SemuActions.placementSelect(), 1, 0) && SemuJson.textAt(RadialBed.saved(wiiu), "visual.systems.wiiu.placement").equals("game_fractional"), "without a bezel to place (wiiu), Fit steps whole steps or not: integer game to non-integer game (81/1), saved");
        SemuLaunchPlan bare = RadialBed.launch(fixture, "gba", "fit-bezel-off", "{\"visual\":{\"systems\":{\"gba\":{\"placement\":\"bezel\"}}}}", "Advance.gba");
        SemuActionExecutor.execute(bare, "visual.bezels.toggle", SEMU_SOURCE_X11);
        SemuActionExecutor.execute(bare, "visual.placement.next", SEMU_SOURCE_X11);
        bool fractional = RadialBed.record(bare, 1, SemuActions.placementSelect(), 2, 0) && SemuJson.textAt(RadialBed.saved(bare), "visual.systems.gba.placement").equals("game_fractional");
        SemuActionExecutor.execute(bare, "visual.placement.next", SEMU_SOURCE_X11);
        bool integer = RadialBed.record(bare, 2, SemuActions.placementSelect(), 0, 0) && SemuJson.textAt(RadialBed.saved(bare), "visual.systems.gba.placement").equals("game");
        contract.expect(!bare.bezelsOn && fractional && integer, "with the bezel switched off, Fit steps the two game states: integer bezel to non-integer game (81/2), then integer game (81/0), so the picture keeps its size when the bezel goes");
        SemuLaunchPlan nds = RadialBed.launch(fixture, "nds", "fit-nds", "", "Mario.nds");
        SemuActionExecutor.execute(nds, "visual.placement.next", SEMU_SOURCE_X11);
        contract.expect(RadialBed.record(nds, 0, SemuActions.placementSelect(), 2, 0) && SemuJson.textAt(RadialBed.saved(nds), "visual.systems.nds.placement").equals("game_fractional"), "the DS starts on integer bezel (the whole shell) and Fit moves it on to non-integer game, the shell kept (dual_fit.btrc)");
        memset(&SemuSupervisorRuntime, 0, sizeof(SemuSupervisorRuntime));
    }
}

class RadialAspectSpec {  // Aspect: one press saves it for this game and waits; Restart Game applies it
    class void run(Contract contract, Fixture fixture) {
        SemuLaunchPlan wii = RadialBed.launch(fixture, "wii", "aspect", "", "Sports.rvz");
        SemuVariantChoice output = wii.variants.output;
        contract.expect(output.ids.join("|").equals("standard|widescreen") && output.labels.join("|").equals("4:3|16:9") && output.index == 0 && output.launched == 0, "wii offers 4:3 and 16:9 and runs 4:3");
        SemuActionExecutor.execute(wii, "visual.output.next", SEMU_SOURCE_X11);
        JSONValue games = SemuJson.get(RadialBed.saved(wii), "visual.games.wii");
        contract.expect(RadialBed.record(wii, 0, SemuActions.outputSelect(), 1, 1) && SemuJson.textAt(games.get("Sports"), "output").equals("widescreen") && games.keys().size() == 1 && output.index == 1, "one Aspect press saves visual.games.wii.Sports.output=widescreen, for that game only, and journals it waiting for Restart Game (82, reserved 1)");
        contract.expect(SemuSupervisorRuntime.relaunch == 0 && SemuSupervisorRuntime.quit == 0 && SemuGameRestart.waiting(wii), "and never restarts the game by itself: 16:9 waits");
        SemuActionExecutor.execute(wii, "visual.output.next", SEMU_SOURCE_X11);
        contract.expect(RadialBed.record(wii, 1, SemuActions.outputSelect(), 0, 0) && SemuJson.textAt(SemuJson.get(RadialBed.saved(wii), "visual.games.wii.Sports"), "output").equals("standard") && !SemuGameRestart.waiting(wii) && SemuSupervisorRuntime.relaunch == 0, "a second press steps on to 4:3, the output running: nothing waits (82, reserved 0) and nothing restarts, so the owner can cycle freely");
        SemuActionExecutor.execute(wii, "visual.output.next", SEMU_SOURCE_X11);
        SemuActionExecutor.execute(wii, "system.restart", SEMU_SOURCE_X11);
        contract.expect(RadialBed.record(wii, 2, SemuActions.outputSelect(), 1, 1) && RadialBed.record(wii, 3, SemuActions.restartNotice(), 1, 0), "16:9 again waits, and Restart Game journals 87/1 (RESTARTING GAME)");
        contract.expect(SemuSupervisorRuntime.relaunch == 1 && SemuSupervisorRuntime.quit == 1 && SemuSupervisor.relaunching(), "and asks the supervisor to stop the game and start it again, once, on the saved 16:9");
        memset(&SemuSupervisorRuntime, 0, sizeof(SemuSupervisorRuntime));
        SemuLaunchPlan snes = RadialBed.launch(fixture, "snes", "aspect-snes", "", "Mario.sfc");
        SemuActionExecutor.execute(snes, "visual.output.next", SEMU_SOURCE_X11);
        contract.expect(RadialBed.record(snes, 0, SemuActions.outputSelect(), -1, 0) && SemuSupervisorRuntime.relaunch == 0, "a system with one output journals 82/-1 (ASPECT: ONE ONLY) and never restarts");
        SemuActionExecutor.execute(snes, "system.restart", SEMU_SOURCE_X11);
        contract.expect(RadialBed.record(snes, 1, SemuActions.restartNotice(), 0, 0) && SemuSupervisorRuntime.relaunch == 0 && SemuSupervisorRuntime.quit == 0, "Restart Game with nothing to apply says so (87/0, RESTART: NOTHING TO APPLY) and restarts nothing");
        memset(&SemuSupervisorRuntime, 0, sizeof(SemuSupervisorRuntime));
    }
}

class RadialResetSpec {  // Reset to Default: ask, then remove this system's own choices and journal the defaults
    class void run(Contract contract, Fixture fixture) {
        string settings = "{\"visual\":{\"systems\":{\"gba\":{\"bezel_variant\":\"arctic\",\"shader_variant\":\"agb001\",\"placement\":\"bezel\"},\"snes\":{\"placement\":\"game\"}}},\"input\":{\"systems\":{\"gba\":{\"play_mode\":\"docked\",\"players\":{\"1\":{\"pad\":1,\"layout\":\"classic\"}}}}}}";
        SemuLaunchPlan gba = RadialBed.launch(fixture, "gba", "reset", settings, "Advance.gba");
        contract.expect(gba.variants.bezel.index == 1 && gba.variants.shader.index == 1 && gba.variants.placement.index == 1, "gba starts on its saved arctic shell, AGB-001 shader and integer bezel");
        SemuSystemReset.execute(gba, 20000LL);
        contract.expect(InputDeliveryTools.records(gba.stateDir) == 1 && RadialBed.record(gba, 0, SemuActions.resetNotice(), 0, 1) && FileSystem.readText(PathTools.join(gba.semuHome, "semu.json")).equals(settings), "the first Reset press asks for a second (85/0, reserved 1) and changes no setting");
        SemuSystemReset.execute(gba, 22000LL);
        JSONValue saved = RadialBed.saved(gba);
        contract.expect(SemuJson.get(saved, "visual.systems.gba").isNull() && SemuJson.get(saved, "input.systems.gba.players").isNull() && SemuJson.textAt(saved, "visual.systems.snes.placement").equals("game"), "the confirming press removes gba's own choices (its players' pads and layouts), and only gba's");
        contract.expect(SemuJson.textAt(saved, "input.systems.gba.play_mode").equals("docked"), "a setting the radial does not own (a Switch-style play_mode) survives Reset");
        contract.expect(RadialBed.record(gba, 1, SemuActions.bezelSelect(), 0, 0) && RadialBed.record(gba, 2, SemuActions.shaderSelect(), 0, 0) && RadialBed.record(gba, 3, SemuActions.placementSelect(), 0, 0) && RadialBed.record(gba, 4, SemuActions.resetNotice(), 1, 0), "then journals the defaults (the shell, the GBA LCD, integer game) and 85/1");
        contract.expect(gba.variants.bezel.index == 0 && gba.variants.placement.index == 0 && SemuSupervisorRuntime.relaunch == 0, "the launch follows the defaults, live, without a restart");
        SemuSystemReset.execute(gba, 30000LL);
        contract.expect(RadialBed.record(gba, 5, SemuActions.resetNotice(), 0, 1), "a later press asks again");
        string wide = "{\"visual\":{\"games\":{\"wii\":{\"Sports\":{\"output\":\"widescreen\"}}}}}";
        SemuLaunchPlan wii = RadialBed.launch(fixture, "wii", "reset-wii", wide, "Sports.rvz");
        SemuSystemReset.execute(wii, 40000LL);
        SemuSystemReset.execute(wii, 41000LL);
        int last = InputDeliveryTools.records(wii.stateDir) - 1;
        contract.expect(RadialBed.record(wii, 0, SemuActions.resetNotice(), 0, 1) && SemuJson.get(RadialBed.saved(wii), "visual.games.wii").isNull() && SemuSupervisorRuntime.relaunch == 0 && SemuSupervisorRuntime.quit == 0, "a Wii game on 16:9: Reset asks as anywhere else (85/0, reserved 1), clears the games' outputs and never restarts the game by itself");
        contract.expect(RadialBed.record(wii, last - 1, SemuActions.outputSelect(), 0, 1) && RadialBed.record(wii, last, SemuActions.resetNotice(), 1, 1) && wii.variants.output.index == 0, "it chooses 4:3 waiting for Restart Game (82/0, reserved 1) and says so (85/1, reserved 1: RESET: RESTART TO APPLY)");
        SemuActionExecutor.execute(wii, "system.restart", SEMU_SOURCE_X11);
        contract.expect(RadialBed.record(wii, last + 1, SemuActions.restartNotice(), 1, 0) && SemuSupervisorRuntime.relaunch == 1, "Restart Game then boots it on 4:3");
        memset(&SemuSupervisorRuntime, 0, sizeof(SemuSupervisorRuntime));
    }
}

class RadialMenuSpec {  // FIT and ASPECT rows where they apply, stepped from the menu like BEZEL
    class void run(Contract contract, Fixture fixture) {
        SemuLaunchPlan wii = RadialBed.launch(fixture, "wii", "menu-wii", "", "Sports.rvz");
        SemuLaunchPlan snes = RadialBed.launch(fixture, "snes", "menu-snes", "", "Mario.sfc");
        SemuLaunchPlan wiiu = RadialBed.launch(fixture, "wiiu", "menu-wiiu", "", "Zelda.wux");
        contract.expect(wii.menuLabels.join("|").equals("RESUME|SAVE STATE|LOAD STATE|SCREENSHOT|BEZEL|SHADER|FIT|ASPECT|RESTART GAME|RESET TO DEFAULT|QUIT GAME"), "the wii menu shows FIT, ASPECT and RESTART GAME: " + wii.menuLabels.join("|"));
        contract.expect(snes.menuActions.contains("visual.placement.next") && !snes.menuActions.contains("visual.output.next") && wiiu.menuActions.contains("visual.placement.next") && !wiiu.menuActions.contains("visual.output.next") && wiiu.menuActions.contains("system.reset"), "snes shows FIT but no ASPECT; wiiu, with no bezel to place, FIT (whole steps or not) and no ASPECT");
        contract.expect(!snes.menuActions.contains("system.restart") && !wiiu.menuActions.contains("system.restart"), "without a second output, layouts or a second player nothing waits for a restart: no RESTART GAME row");
        SemuActionExecutor.execute(wii, "ui.menu", SEMU_SOURCE_GAMEPAD);
        for (int row = 0; row < 6; row++) { SemuActionExecutor.execute(wii, "ui.menu.down", SEMU_SOURCE_GAMEPAD); }
        int before = InputDeliveryTools.records(wii.stateDir);
        SemuActionExecutor.execute(wii, "ui.menu.right", SEMU_SOURCE_GAMEPAD);
        contract.expect(RadialBed.record(wii, before, SemuActions.placementSelect(), 2, 0) && SemuSupervisorRuntime.menu_visible == 1, "right on FIT journals 81 (integer bezel to non-integer game) and keeps the menu open");
        SemuActionExecutor.execute(wii, "ui.menu.down", SEMU_SOURCE_GAMEPAD);
        SemuActionExecutor.execute(wii, "ui.menu.right", SEMU_SOURCE_GAMEPAD);
        contract.expect(RadialBed.record(wii, before + 2, SemuActions.outputSelect(), 1, 1) && SemuSupervisorRuntime.relaunch == 0, "right on ASPECT saves 16:9 waiting for Restart Game (82, reserved 1) and restarts nothing");
        SemuActionExecutor.execute(wii, "ui.menu.down", SEMU_SOURCE_GAMEPAD);
        SemuActionExecutor.execute(wii, "ui.menu.confirm", SEMU_SOURCE_GAMEPAD);
        contract.expect(RadialBed.record(wii, before + 4, SemuActions.restartNotice(), 1, 0) && SemuSupervisorRuntime.relaunch == 1, "confirm on RESTART GAME, the next row, restarts the game once to apply it (87/1)");
        SemuSupervisorRuntime.relaunch = 0;
        SemuSupervisorRuntime.quit = 0;
        SemuActionExecutor.execute(wii, "ui.menu.down", SEMU_SOURCE_GAMEPAD);
        SemuActionExecutor.execute(wii, "ui.menu.confirm", SEMU_SOURCE_GAMEPAD);
        contract.expect(RadialBed.record(wii, before + 6, SemuActions.resetNotice(), 0, 1) && SemuSupervisorRuntime.menu_visible == 1, "confirm on RESET TO DEFAULT asks for a second press and keeps the menu open");
        memset(&SemuSupervisorRuntime, 0, sizeof(SemuSupervisorRuntime));
    }
}

class RadialChoicesSpecContract {
    class void run(Contract contract) {
        Fixture fixture = Fixture("linux-desktop");
        RadialAbiSpec.run(contract, fixture);
        RadialFitSpec.run(contract, fixture);
        RadialAspectSpec.run(contract, fixture);
        RadialResetSpec.run(contract, fixture);
        RadialMenuSpec.run(contract, fixture);
    }
}
