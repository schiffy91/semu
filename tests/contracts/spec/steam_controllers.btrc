// Steam Controller spec: the quick ring from button 1 with an empty centre, the menu radial's centre,
// the Deck layout on the new Steam Controller, the 2015 controller's own layout (left pad = the quick
// radial, d-pad and right stick behind its grips), every emitted name in its controller's vocabulary,
// the icons and their recipe, and one definition shared by both Linux targets.

import Library.FileSystem;
import Library.JSON;
import Library.Strings;
import Library.Vector;
import ../support.btrc;
import ../../../src/lib/json.btrc;
import ../../../src/lib/paths.btrc;
import ../../../src/steam/input_document.btrc;
import ../../../src/steam/input_rules.btrc;
import ../../../src/steam/input_template.btrc;
import ../../../src/steam/input_vdf.btrc;

class SteamControllerSpecText {  // pieces of a rendered template
    class string group(string vdf, string identifier) {  // one group's text, found by its id
        for piece in Strings.split(vdf, "\n\t\"group\"") {
            string body = Strings.split(piece, "\n\t\"preset\"").get(0);  // preset lines carry ids too
            if (body.contains("\"id\" \"" + identifier + "\"")) { return body; }
        }
        return "";
    }

    class string preset(string vdf, int index) {
        for line in Strings.split(vdf, "\n") { if (line.contains("\"preset\" { \"id\" \"" + Strings.fromInt(index) + "\"")) { return line; } }
        return "";
    }

    class Vector<string> icons(string group) {  // the icon each radial button shows, in ring order
        Vector<string> icons = [];
        for line in Strings.split(group, "\n") {
            if (!line.contains("\"touch_menu_button_")) { continue; }
            for part in Strings.split(line, ", ") { if (part.endsWith(".png")) { icons.push(part); break; } }
        }
        return icons;
    }

    class bool distinct(Vector<string> values) {
        for (int index = 0; index < values.size(); index++) { for (int other = index + 1; other < values.size(); other++) { if (values.get(index).equals(values.get(other))) { return false; } } }
        return true;
    }

    class JSONValue template(SteamInputDocument document, string identifier) {
        JSONValue templates = document.templates();
        for (int index = 0; index < templates.size(); index++) { if (SemuJson.textAt(templates.at(index), "id").equals(identifier)) { return templates.at(index); } }
        return JSONValue.makeObject();
    }
}

class SteamControllerSpecRadial {  // the quick ring, the menu radial and how a slot fires
    class string head(int button) { return "\"touch_menu_button_" + Strings.fromInt(button) + "\" { \"activators\" { \"Full_Press\" { \"bindings\" { \"binding\" \""; }

    class void ring(Contract contract, SteamInputDocument document, string radial, Vector<string> slots, int first) {  // each slot types its chord, from button FIRST
        for (int index = 0; index < slots.size(); index++) {
            string action = slots.get(index);
            contract.contains(radial, SteamControllerSpecRadial.head(index + first) + "key_press LEFT_CONTROL, " + document.label(action) + ", " + document.icon(action), "ring slot " + Strings.fromInt(index + first) + " sends " + action);
        }
    }

    class void run(Contract contract, SteamInputDocument document) {
        string vdf = SteamInputVdf.render(document, SteamControllerSpecText.template(document, "neptune_full"));
        Vector<string> ring = ["state.save", "state.load", "state.prev", "state.next", "visual.bezel.next", "visual.shader.next", "radial.settings", "ui.menu", "ui.screenshot", "app.quit"];
        contract.expect(document.slots("quick_slots").join(",").equals(ring.join(",")), "the quick ring is save, load, previous and next slot, bezel, shader, settings, menu, screenshot, quit");
        string quick = SteamControllerSpecText.group(vdf, "20");
        SteamControllerSpecRadial.ring(contract, document, quick, ["state.save", "state.load", "state.prev", "state.next", "visual.bezel.next", "visual.shader.next"], 1);
        SteamControllerSpecRadial.ring(contract, document, quick, ["ui.menu", "ui.screenshot", "app.quit"], 8);
        contract.contains(quick, SteamControllerSpecRadial.head(7) + "controller_action CHANGE_PRESET 3 0 0, Settings, semu-settings.png, #232323 #FFFFFF\" } \"settings\"", "slot 7 switches to the settings preset (preset 2) and types nothing");
        contract.lacks(quick, "touch_menu_button_0", "the quick radial's centre is empty, so a click released there fires nothing");
        contract.lacks(quick, "touch_menu_button_11", "the quick ring has exactly ten slots");
        string menu = SteamControllerSpecText.group(vdf, "21");
        contract.contains(menu, SteamControllerSpecRadial.head(0) + "key_press LEFT_CONTROL, Open Menu, semu-menu.png", "the menu radial's centre opens and closes the menu");
        SteamControllerSpecRadial.ring(contract, document, menu, ["ui.menu.up", "ui.menu.down", "ui.menu.confirm", "ui.menu.back", "visual.bezels.toggle", "visual.shaders.toggle", "system.reset", "ui.players"], 1);
        contract.lacks(menu, "touch_menu_button_9", "the held menu ring has exactly eight slots");
        for identifier in ["20", "21", "22", "40"] {
            string radial = SteamControllerSpecText.group(vdf, identifier);
            contract.contains(radial, "\"touchmenu_button_fire_type\" \"1\"", "a slot fires when the pad click on its icon is released (Steam's button release)");
            contract.contains(radial, "\"settings\" { \"haptic_intensity\" \"2\" }", "each radial button ticks as Steam's own radials do");
            contract.expect(SteamControllerSpecText.icons(radial).size() >= 4 && SteamControllerSpecText.distinct(SteamControllerSpecText.icons(radial)), "radial " + identifier + " shows a different icon on every button: " + SteamControllerSpecText.icons(radial).join(" "));
        }
        for needle in ["key_press LEFT_SHIFT, Next Bezel, semu-bezel.png", "key_press B, Next Bezel, semu-bezel.png", "key_press LEFT_SHIFT, Next Shader, semu-shader.png", "key_press V, Next Shader, semu-shader.png"] { contract.contains(quick, needle, "Next Bezel and Next Shader press Ctrl+Shift+B and Ctrl+Shift+V"); }
        contract.contains(menu, "key_press R, Reset to Default, semu-reset.png", "Reset to Default presses Ctrl+Shift+R");
        JSONValue templates = document.templates();
        for (int index = 0; index < templates.size(); index++) { contract.lacks(SteamInputVdf.render(document, templates.at(index)), "key_press ESCAPE", "no template presses Esc, which exits RetroArch"); }
    }
}

class SteamControllerSpecSettings {  // the settings radial: a page the quick ring switches to, every radial-v2 slot, Close in the centre
    class void run(Contract contract, SteamInputDocument document) {
        string vdf = SteamInputVdf.render(document, SteamControllerSpecText.template(document, "neptune_full"));
        Vector<string> slots = ["visual.bezel.next", "visual.bezels.toggle", "visual.shader.next", "visual.shaders.toggle", "visual.placement.next", "visual.output.next", "controller.layout.next", "ui.players", "system.reset"];
        contract.expect(document.slots("settings_slots").join(",").equals(slots.join(",")), "the settings ring is next bezel, bezel on/off, next shader, shader on/off, fit, aspect, controller layout, players, reset");
        string settings = SteamControllerSpecText.group(vdf, "40");
        contract.contains(settings, "\"name\" \"Semu Settings\"", "the settings radial carries its template name");
        SteamControllerSpecRadial.ring(contract, document, settings, slots, 1);
        contract.lacks(settings, "touch_menu_button_10", "the settings ring has exactly nine slots");
        contract.contains(settings, SteamControllerSpecRadial.head(0) + "controller_action CHANGE_PRESET 1 0 0, Close Settings, semu-close.png, #232323 #FFFFFF\" } \"settings\"", "its centre returns to the gamepad preset and the quick radial");
        for needle in ["key_press F, Fit (Bezel/Screen), semu-fit.png", "key_press G, Aspect (4:3/16:9), semu-aspect.png", "key_press C, Controller Layout, semu-controller.png", "key_press U, Players, semu-players.png", "key_press R, Reset to Default, semu-reset.png", "key_press B, Bezel On/Off, semu-bezel-toggle.png", "key_press H, Shader On/Off, semu-shader-toggle.png"] {
            contract.contains(settings, needle, "the settings ring presses each slot's Ctrl+Shift chord: " + needle);
        }
        string page = SteamControllerSpecText.preset(vdf, 2);
        string gamepad = SteamControllerSpecText.preset(vdf, 0);
        contract.contains(page, "\"name\" \"Preset_1000002\"", "the settings page is preset 2, after the gamepad and the held hotkeys");
        contract.contains(page, "\"40\" \"left_trackpad active\"", "on the settings page the left pad is the settings radial");
        contract.expect(page.replace("\"40\" \"left_trackpad active\"", "Q").replace("\"32\" \"switch active\"", "S").replace("\"id\" \"2\" \"name\" \"Preset_1000002\"", "P")
            .equals(gamepad.replace("\"20\" \"left_trackpad active\"", "Q").replace("\"7\" \"switch active\"", "S").replace("\"id\" \"0\" \"name\" \"Default\"", "P")), "everything but the left pad stays the gamepad there: buttons, sticks, triggers, the pointer");
        string pageSwitches = SteamControllerSpecText.group(vdf, "32");
        contract.contains(pageSwitches, "\"button_menu\" { \"activators\" { \"Full_Press\" { \"bindings\" { \"binding\" \"xinput_button SELECT, , \" } } \"Long_Press\" { \"bindings\" { \"binding\" \"controller_action CHANGE_PRESET 2 0 0, Hotkeys", "on the settings page View still passes Select and a long press still holds the hotkeys");
        contract.contains(pageSwitches, "\"button_back_left\" { \"activators\" { \"Full_Press\" { \"bindings\" { \"binding\" \"controller_action CHANGE_PRESET 4 0 0, Wii Controller Mode", "and a lower grip still holds the Wii layer, now preset 3");
        contract.contains(pageSwitches, "\"button_back_left_upper\" { \"activators\" { \"Full_Press\" { \"bindings\" { \"binding\" \"controller_action CHANGE_PRESET 2 0 0, Hotkeys", "and an upper grip the hotkeys");
        string gordon = SteamInputVdf.render(document, SteamControllerSpecText.template(document, "gordon_full"));
        contract.contains(SteamControllerSpecText.group(gordon, "20"), SteamControllerSpecRadial.head(7) + "controller_action CHANGE_PRESET 5 0 0, Settings, semu-settings.png", "the 2015 controller's Settings slot finds its own settings preset by id (preset 4, after its grip presets)");
        contract.contains(SteamControllerSpecText.preset(gordon, 4), "\"40\" \"left_trackpad active\"", "the 2015 settings page puts the settings radial on its left pad");
        contract.contains(SteamControllerSpecText.group(gordon, "34"), "\"button_back_left\" { \"activators\" { \"Full_Press\" { \"bindings\" { \"binding\" \"controller_action CHANGE_PRESET 3 0 0, D-Pad", "and its grips still enter the d-pad there");
        contract.contains(SteamControllerSpecText.group(gordon, "40"), SteamControllerSpecRadial.head(0) + "controller_action CHANGE_PRESET 1 0 0, Close Settings, semu-close.png", "the 2015 Close returns to its gamepad");
    }
}

class SteamControllerSpecLayouts {  // the new controller carries the Deck layout; the 2015 one its own
    class void run(Contract contract, SteamInputDocument document) {
        string neptune = SteamInputVdf.render(document, SteamControllerSpecText.template(document, "neptune_full"));
        string triton = SteamInputVdf.render(document, SteamControllerSpecText.template(document, "triton_full"));
        string gordon = SteamInputVdf.render(document, SteamControllerSpecText.template(document, "gordon_full"));
        contract.contains(triton, "\"controller_type\"\t\t\"controller_triton\"", "the new Steam Controller template names controller_triton");
        contract.expect(triton.replace("controller_triton", "X").replace("Semu: Steam Controller - FULL", "T").equals(neptune.replace("controller_neptune", "X").replace("Semu: Steam Deck - Neptune FULL", "T")), "the new Steam Controller gets exactly the Deck layout");
        contract.contains(gordon, "\"controller_type\"\t\t\"controller_steamcontroller_gordon\"", "the 2015 template names controller_steamcontroller_gordon");
        for missing in ["dpad active", "right_joystick active", "Wii Controller Mode", "_upper"] { contract.lacks(gordon, missing, "the 2015 controller has no d-pad, right stick or upper grips"); }
        contract.contains(SteamControllerSpecText.preset(gordon, 0), "\"20\" \"left_trackpad active\"", "the 2015 left pad is the quick radial");
        contract.contains(SteamControllerSpecText.preset(gordon, 0), "\"6\" \"right_trackpad active\"", "the 2015 right pad is the pointer");
        contract.contains(SteamControllerSpecText.group(gordon, "6"), "\"absolute_mouse\" \"inputs\" { \"click\" { \"activators\" { \"Soft_Press\" { \"bindings\" { \"binding\" \"mouse_button LEFT", "clicking the right pad taps");
        string gamepadSwitches = SteamControllerSpecText.group(gordon, "7");
        contract.contains(gamepadSwitches, "\"button_back_left\" { \"activators\" { \"Full_Press\" { \"bindings\" { \"binding\" \"controller_action CHANGE_PRESET 3 0 0, D-Pad", "holding the left grip enters the d-pad preset");
        contract.contains(SteamControllerSpecText.preset(gordon, 2), "\"1\" \"left_trackpad active\"", "in it the left pad is the d-pad");
        contract.contains(SteamControllerSpecText.group(gordon, "32"), "\"button_back_left\" { \"activators\" { \"release\"", "letting go of the left grip returns to the radial");
        contract.contains(gamepadSwitches, "\"button_back_right\" { \"activators\" { \"Full_Press\" { \"bindings\" { \"binding\" \"controller_action CHANGE_PRESET 4 0 0, Right Stick", "holding the right grip enters the right-stick preset");
        contract.contains(SteamControllerSpecText.preset(gordon, 3), "\"8\" \"right_trackpad active\"", "in it the right pad drives group 8");
        contract.contains(SteamControllerSpecText.group(gordon, "8"), "JOYSTICK_RIGHT, , \" } } } } } \"settings\" { \"output_joystick\" \"1\" }", "group 8 is the right stick, as in Valve's gordon template");
        contract.contains(SteamControllerSpecText.group(gordon, "33"), "\"button_back_right\" { \"activators\" { \"release\"", "letting go of the right grip returns to the pointer");
        contract.contains(SteamControllerSpecText.preset(gordon, 1), "\"21\" \"left_trackpad active\"", "holding View makes the left pad the menu radial");
        for vdf in [neptune, gordon] {
            contract.contains(SteamControllerSpecText.group(vdf, "4"), "TRIGGER_LEFT, , \" } } } } } \"settings\" { \"output_trigger\" \"1\" }", "the left trigger stays analog, as in Valve's templates");
            contract.contains(SteamControllerSpecText.group(vdf, "5"), "TRIGGER_RIGHT, , \" } } } } } \"settings\" { \"output_trigger\" \"2\" }", "the right trigger stays analog, as in Valve's templates");
        }
        JSONValue templates = document.templates();
        for (int index = 0; index < templates.size(); index++) {
            SteamInputController controller = SteamInputController(document, SemuJson.textAt(templates.at(index), "controller"));
            Vector<string> problems = SteamInputVocabulary.problems(controller, SteamInputVdf.render(document, templates.at(index)), "");
            contract.expect(problems.isEmpty() && !SteamInputVocabulary.inputs(gordon).isEmpty(), "every input and source " + SemuJson.textAt(templates.at(index), "id") + " emits is in its controller's vocabulary: " + problems.join("; "));
        }
    }
}

class SteamControllerSpecRules {  // definitions the rules refuse before any VDF is written
    class bool rejected(Fixture fixture, string parent, string key, JSONValue value, string fragment) {
        JSONValue root = SemuJson.readFile(SteamInputTemplates.source(fixture.plan));
        SemuJson.get(root, parent).set(key, value);
        for problem in SteamInputRules.problems(SteamInputDocument(root)) { if (problem.contains(fragment)) { return true; } }
        return false;
    }

    class JSONValue strings(Vector<string> values) {
        JSONValue array = JSONValue.makeArray();
        for value in values { array.push(JSONValue.makeString(value)); }
        return array;
    }

    class void run(Contract contract, Fixture fixture) {
        Vector<string> crowded = [];
        for (int index = 0; index < 21; index++) { crowded.push(index % 2 == 0 ? "state.save" : "state.load"); }
        contract.expect(SteamControllerSpecRules.rejected(fixture, "radial", "quick_slots", SteamControllerSpecRules.strings(crowded), "1 to 20 ring slots"), "a ring of 21 slots is refused");
        contract.expect(SteamControllerSpecRules.rejected(fixture, "radial", "quick_slots", SteamControllerSpecRules.strings(["state.save", "state.load", "state.save"]), "twice"), "an icon shown twice in one radial is refused");
        contract.expect(SteamControllerSpecRules.rejected(fixture, "radial", "menu_center", JSONValue.makeString("ui.escape"), "without a modifier"), "a centre that would send bare Esc is refused");
        contract.expect(SteamControllerSpecRules.rejected(fixture, "hotkey_bindings.12", "action", JSONValue.makeString("ui.escape"), "without a modifier"), "a hotkey that would send bare Esc is refused");
        contract.expect(SteamControllerSpecRules.rejected(fixture, "radial", "menu_center", JSONValue.makeString("state.nothing"), "undeclared action"), "a centre naming no action is refused");
        contract.expect(SteamControllerSpecRules.rejected(fixture, "radial", "fire_type", JSONValue.makeInt(5), "0..3"), "a fire type Steam does not have is refused");
        contract.expect(SteamControllerSpecRules.rejected(fixture, "templates.2", "controller", JSONValue.makeString("unknown"), "names controller unknown"), "a template on an undeclared controller is refused");
        contract.expect(SteamControllerSpecRules.rejected(fixture, "templates.2", "default", JSONValue.makeBool(true), "exactly one template"), "a second default is refused");
        contract.expect(SteamControllerSpecRules.rejected(fixture, "layouts.gordon.presets.0.sources", "dpad", JSONValue.makeString("dpad"), "drives source dpad, which controller_steamcontroller_gordon does not have"), "a 2015 preset driving a d-pad it lacks is refused");
        contract.expect(SteamControllerSpecRules.rejected(fixture, "layouts.gordon.presets.2.held_by.0", "input", JSONValue.makeString("button_back_left_upper"), "binds input button_back_left_upper"), "a 2015 hold on an upper grip it lacks is refused");
        contract.expect(SteamControllerSpecRules.rejected(fixture, "layouts.deck.presets.0.sources", "left_trackpad", JSONValue.makeString("wheel"), "unknown group wheel"), "a group kind the renderer does not draw is refused");
        contract.expect(SteamControllerSpecRules.rejected(fixture, "layouts.gordon.presets.4", "id", JSONValue.makeString("elsewhere"), "gordon_full has no preset settings for radial page radial.settings"), "a radial page whose preset a controller lacks is refused");
        contract.expect(SteamControllerSpecRules.rejected(fixture, "layouts.gordon.presets.4", "id", JSONValue.makeString("elsewhere"), "preset Settings is held by nothing and no radial page switches to it"), "a page preset nothing reaches is refused");
        JSONValue page = JSONValue.makeObject();
        page.set("label", JSONValue.makeString("Save Page"));
        page.set("icon", JSONValue.makeString("semu-save.png"));
        contract.expect(SteamControllerSpecRules.rejected(fixture, "radial.pages", "radial.nowhere", page, "radial.pages.radial.nowhere names no preset"), "a radial page that names no preset is refused");
        page.set("preset", JSONValue.makeString("settings"));
        contract.expect(SteamControllerSpecRules.rejected(fixture, "radial.pages", "state.save", page, "is also an action"), "a radial page that shadows an action is refused");
    }
}

class SteamControllerSpecIcons {  // every icon has a provenance row, and the rows are what the recipe renders
    class void run(Contract contract, Fixture fixture, SteamInputDocument document) {
        string directory = PathTools.join(PathTools.dirname(SteamInputTemplates.source(fixture.plan)), "icons");
        string provenance = FileSystem.readText(PathTools.join(directory, "PROVENANCE.md"));
        Vector<string> declared = SemuJson.strings(SemuJson.get(document.root, "binding_icons.files"));
        for name in declared { contract.contains(provenance, "| `" + name + "` |", "every binding icon has a provenance row"); }
        for line in Strings.split(provenance, "\n") {
            if (!line.startsWith("| `semu-")) { continue; }
            string name = Strings.split(line.substring(3, line.len() - 3), "`").get(0);
            contract.expect(declared.contains(name) && FileSystem.isFile(PathTools.join(directory, name)), "every provenance row is a shipped, declared icon: " + name);
        }
        contract.contains(provenance, "| `semu-bezel.png` | `picture-in-picture-2` |", "Next Bezel's icon is Lucide picture-in-picture-2");
        contract.contains(provenance, "| `semu-shader.png` | `sparkles` |", "Next Shader's icon is Lucide sparkles");
        Vector<string> icons = [];
        for action in document.root.get("actions").keys() { if (!action.equals("ui.escape")) { icons.push(document.icon(action)); } }
        for page in document.pageNames() { icons.push(document.icon(page)); }
        contract.expect(SteamControllerSpecText.distinct(icons), "every action a binding may send and every radial page has its own icon (the toggles no longer borrow the menu's)");
        string script = FileSystem.readText(PathTools.join(fixture.project, "packaging/steam/render-icons.sh"));
        contract.contains(script, "PROVENANCE.md", "the icon script reads the provenance table");
        contract.contains(script, "magick -background none -density 384 - -filter Mitchell -resize 192x192 -gravity center -extent 256x256 -strip", "the icon script is the recipe that reproduces the committed icons");
        contract.contains(script, "-metric RMSE", "the icon script checks re-renders at RMSE 0");
    }
}

class SteamControllerSpecShared {  // one Steam Input definition for both Linux targets, none for macOS
    class void run(Contract contract) {
        Fixture desktop = Fixture("linux-desktop");
        Fixture deck = Fixture("steam-deck");
        Fixture mac = Fixture("macos");
        string shared = SteamInputTemplates.source(desktop.plan);
        contract.expect(shared.endsWith("config/input/steam/steam_input.json") && FileSystem.isFile(shared) && shared.equals(SteamInputTemplates.source(deck.plan)), "linux-desktop and steam-deck share config/input/steam/steam_input.json");
        string output = PathTools.join(desktop.scratch, "desktop-steam-templates");
        contract.expect(SteamInputTemplates.publish(desktop.plan, output, "") == 0 && FileSystem.isFile(PathTools.join(output, "gordon-full.vdf")), "the desktop publishes the Steam Controller templates too");
        contract.expect(SteamInputTemplates.source(mac.plan).isEmpty() && SteamInputTemplates.publish(mac.plan, PathTools.join(mac.scratch, "mac-templates"), "") != 0, "macOS declares no Steam Input definition and publishes none");
    }
}

class SteamControllerSpecContract {
    class void run(Contract contract) {
        Fixture fixture = Fixture("steam-deck");
        SteamInputDocument document = SteamInputDocument(SemuJson.readFile(SteamInputTemplates.source(fixture.plan)));
        SteamControllerSpecRadial.run(contract, document);
        SteamControllerSpecSettings.run(contract, document);
        SteamControllerSpecLayouts.run(contract, document);
        SteamControllerSpecRules.run(contract, fixture);
        SteamControllerSpecIcons.run(contract, fixture, document);
        SteamControllerSpecShared.run(contract);
    }
}
