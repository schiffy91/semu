// A virtual gamepad for headless input tests, over /dev/uinput (Linux).
// usage: virtual_pad [--steam-virtual-pad | --steam-virtual-pad-slot N] SECONDS_BEFORE_FIRST token...
//        tokens press:NAME hold:NAME release:NAME sleep:SECONDS listen:PATH (more tokens, a line each, until PATH closes)
// By default it is the truthfully named "Semu Test Gamepad". With --steam-virtual-pad it is a
// replica of the pad Steam gives games in Game Mode, the only one a game sees there: the same
// name, bus and ids (so the same SDL GUID, SDL mapping and emulator device identities) and the
// same evdev buttons, sticks, triggers and hat. A Deck test hides Steam's own pad from the game
// while it runs, so the replica is the first pad, as Steam's is in Game Mode.
// --steam-virtual-pad-slot N names it as Steam names the pad of slot N, "Microsoft X-Box 360 pad N", so
// two replicas are two players (the slot file Steam names in SteamVirtualGamepadInfo gives SDL their names).
#include <fcntl.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ioctl.h>
#include <unistd.h>
#include "semu_evdev.h"

import Library.Console;
import Library.Vector;

class VirtualPadButtons {  // the names the tests use, as evdev codes of the plain test pad
    class int code(char* name) {
        if (strcmp(name, "south") == 0) { return BTN_SOUTH; }
        if (strcmp(name, "east") == 0) { return BTN_EAST; }
        if (strcmp(name, "north") == 0) { return BTN_NORTH; }
        if (strcmp(name, "west") == 0) { return BTN_WEST; }
        if (strcmp(name, "tl") == 0) { return BTN_TL; }
        if (strcmp(name, "tr") == 0) { return BTN_TR; }
        if (strcmp(name, "select") == 0) { return BTN_SELECT; }
        if (strcmp(name, "start") == 0) { return BTN_START; }
        if (strcmp(name, "dpad_up") == 0) { return BTN_DPAD_UP; }
        if (strcmp(name, "dpad_down") == 0) { return BTN_DPAD_DOWN; }
        if (strcmp(name, "dpad_left") == 0) { return BTN_DPAD_LEFT; }
        if (strcmp(name, "dpad_right") == 0) { return BTN_DPAD_RIGHT; }
        return -1;
    }

    class Vector<int> all() {
        return [BTN_SOUTH, BTN_EAST, BTN_NORTH, BTN_WEST, BTN_TL, BTN_TR, BTN_SELECT, BTN_START, BTN_DPAD_UP, BTN_DPAD_DOWN, BTN_DPAD_LEFT, BTN_DPAD_RIGHT];
    }
}

class SteamPadControls {  // Steam's virtual pad as Linux sees it: xpad's buttons, two sticks, two triggers, one hat
    class int button(char* name) {  // by position: SDL's mapping for this pad reads b2 as X (west) and b3 as Y (north)
        if (strcmp(name, "south") == 0) { return BTN_SOUTH; }
        if (strcmp(name, "east") == 0) { return BTN_EAST; }
        if (strcmp(name, "west") == 0) { return BTN_NORTH; }
        if (strcmp(name, "north") == 0) { return BTN_WEST; }
        if (strcmp(name, "tl") == 0) { return BTN_TL; }
        if (strcmp(name, "tr") == 0) { return BTN_TR; }
        if (strcmp(name, "select") == 0) { return BTN_SELECT; }
        if (strcmp(name, "start") == 0) { return BTN_START; }
        if (strcmp(name, "mode") == 0) { return BTN_MODE; }
        if (strcmp(name, "thumbl") == 0) { return BTN_THUMBL; }
        if (strcmp(name, "thumbr") == 0) { return BTN_THUMBR; }
        return -1;
    }

    class Vector<int> buttons() {
        return [BTN_SOUTH, BTN_EAST, BTN_NORTH, BTN_WEST, BTN_TL, BTN_TR, BTN_SELECT, BTN_START, BTN_MODE, BTN_THUMBL, BTN_THUMBR];
    }

    class int axis(char* name) {  // the d-pad is the hat, the triggers are Z and RZ
        if (strcmp(name, "dpad_up") == 0 || strcmp(name, "dpad_down") == 0) { return ABS_HAT0Y; }
        if (strcmp(name, "dpad_left") == 0 || strcmp(name, "dpad_right") == 0) { return ABS_HAT0X; }
        if (strcmp(name, "tl2") == 0) { return ABS_Z; }
        if (strcmp(name, "tr2") == 0) { return ABS_RZ; }
        return -1;
    }

    class int pressed(char* name) {  // the axis value while NAME is held
        if (strcmp(name, "dpad_up") == 0 || strcmp(name, "dpad_left") == 0) { return -1; }
        if (strcmp(name, "dpad_down") == 0 || strcmp(name, "dpad_right") == 0) { return 1; }
        return 255;
    }
}

class VirtualPad {
    public int device;
    public bool steam;
    public int slot;

    public VirtualPad(bool steam, int slot) {
        self.device = -1;
        self.steam = steam;
        self.slot = slot;
    }

    public void axis(int code, int minimum, int maximum, int flat) {
        struct uinput_abs_setup setup;
        memset(&setup, 0, sizeof(setup));
        setup.code = (unsigned short)code;
        setup.absinfo.minimum = minimum;
        setup.absinfo.maximum = maximum;
        setup.absinfo.flat = flat;
        unsigned long absoluteSetup = (unsigned long)UI_ABS_SETUP;
        ioctl(self.device, absoluteSetup, &setup);
    }

    public bool create() {  // the supervisor sees south and start, so either one is a pad
        int flags = (int)O_WRONLY | (int)O_NONBLOCK;
        self.device = open("/dev/uinput", flags);
        if (self.device < 0) { return false; }
        unsigned long setEvent = (unsigned long)UI_SET_EVBIT;
        unsigned long setKey = (unsigned long)UI_SET_KEYBIT;
        unsigned long setAbsolute = (unsigned long)UI_SET_ABSBIT;
        int keyType = EV_KEY;
        int synType = EV_SYN;
        int absoluteType = EV_ABS;
        ioctl(self.device, setEvent, keyType);
        ioctl(self.device, setEvent, synType);
        struct uinput_setup setup;
        memset(&setup, 0, sizeof(setup));
        int nameCapacity = UINPUT_MAX_NAME_SIZE;
        if (self.steam) {
            ioctl(self.device, setEvent, absoluteType);
            for code in SteamPadControls.buttons() { ioctl(self.device, setKey, code); }
            Vector<int> sticks = [ABS_X, ABS_Y, ABS_RX, ABS_RY];
            for code in sticks { ioctl(self.device, setAbsolute, code); self.axis(code, -32768, 32767, 128); }
            Vector<int> triggers = [ABS_Z, ABS_RZ];
            for code in triggers { ioctl(self.device, setAbsolute, code); self.axis(code, 0, 255, 0); }
            Vector<int> hat = [ABS_HAT0X, ABS_HAT0Y];
            for code in hat { ioctl(self.device, setAbsolute, code); self.axis(code, -1, 1, 0); }
            setup.id.bustype = BUS_USB;
            setup.id.vendor = 0x28de;
            setup.id.product = 0x11ff;
            setup.id.version = 0x0001;
            snprintf(setup.name, (size_t)nameCapacity, "Microsoft X-Box 360 pad %d", self.slot);
        } else {
            for code in VirtualPadButtons.all() { ioctl(self.device, setKey, code); }
            setup.id.bustype = BUS_VIRTUAL;
            setup.id.vendor = 0x5345;
            setup.id.product = 0x4d55;
            snprintf(setup.name, (size_t)nameCapacity, "%s", "Semu Test Gamepad");
        }
        unsigned long deviceSetup = (unsigned long)UI_DEV_SETUP;
        unsigned long deviceCreate = (unsigned long)UI_DEV_CREATE;
        return ioctl(self.device, deviceSetup, &setup) >= 0 && ioctl(self.device, deviceCreate) >= 0;
    }

    public void send(int type, int code, int value) {
        struct input_event event;
        memset(&event, 0, sizeof(event));
        event.type = (unsigned short)type;
        event.code = (unsigned short)code;
        event.value = value;
        ssize_t wrote = write(self.device, &event, sizeof(event));
        memset(&event, 0, sizeof(event));
        event.type = (unsigned short)EV_SYN;
        event.code = (unsigned short)SYN_REPORT;
        wrote = write(self.device, &event, sizeof(event));
        (void)wrote;
    }

    public bool knows(char* name) {
        if (self.steam) { return SteamPadControls.button(name) >= 0 || SteamPadControls.axis(name) >= 0; }
        return VirtualPadButtons.code(name) >= 0;
    }

    public void set(char* name, bool down) {  // NAME held down or let go
        if (!self.steam) { self.send(EV_KEY, VirtualPadButtons.code(name), down ? 1 : 0); return; }
        int button = SteamPadControls.button(name);
        if (button >= 0) { self.send(EV_KEY, button, down ? 1 : 0); return; }
        self.send(EV_ABS, SteamPadControls.axis(name), down ? SteamPadControls.pressed(name) : 0);
    }

    public void remove() {
        if (self.device < 0) { return; }
        unsigned long deviceDestroy = (unsigned long)UI_DEV_DESTROY;
        ioctl(self.device, deviceDestroy);
        close(self.device);
        self.device = -1;
    }
}

class VirtualPadScript {  // the tokens: from the command line, then any a listen:PATH file (a FIFO a harness writes) hands over, one a line
    class int apply(VirtualPad pad, char* token) {  // 0 done, 64 an unknown button
        char* colon = strchr(token, (int)':');
        if (colon == null) { return 0; }
        *colon = 0;
        char* name = colon + 1;
        if (strcmp(token, "sleep") == 0) { usleep((unsigned int)(atof(name) * 1000000.0)); return 0; }
        if (strcmp(token, "listen") == 0) { return VirtualPadScript.listen(pad, name); }
        if (!pad.knows(name)) { Console.error(f"virtual_pad: unknown button {name}"); return 64; }
        if (strcmp(token, "press") == 0 || strcmp(token, "hold") == 0) { pad.set(name, true); usleep(80000); }
        if (strcmp(token, "press") == 0 || strcmp(token, "release") == 0) { pad.set(name, false); usleep(120000); }
        return 0;
    }

    class int listen(VirtualPad pad, char* path) {  // every line of PATH until its writer closes it
        FILE* input = fopen(path, "r");
        if (input == null) { Console.error(f"virtual_pad: cannot read {path}"); return 64; }
        char line[256];
        int status = 0;
        while (status == 0 && fgets(line, 256, input) != null) {
            line[strcspn(line, "\r\n")] = 0;
            status = VirtualPadScript.apply(pad, line);
        }
        fclose(input);
        return status;
    }
}

int main(int argc, char** argv) {
    int first = 1;
    bool steam = argc > 1 && strcmp(argv[1], "--steam-virtual-pad") == 0;
    int slot = 0;
    if (steam) { first = 2; }
    if (argc > 2 && strcmp(argv[1], "--steam-virtual-pad-slot") == 0) {
        steam = true;
        slot = atoi(argv[2]);
        first = 3;
    }
    if (argc <= first) { Console.error("usage: virtual_pad [--steam-virtual-pad | --steam-virtual-pad-slot N] SECONDS_BEFORE_FIRST press:NAME|hold:NAME|release:NAME|sleep:SECONDS|listen:PATH ..."); return 64; }
    VirtualPad pad = VirtualPad(steam, slot);
    if (!pad.create()) { Console.error("virtual_pad: cannot create a device on /dev/uinput"); return 1; }
    usleep((unsigned int)(atof(argv[first]) * 1000000.0));
    for (int index = first + 1; index < argc; index++) {
        if (VirtualPadScript.apply(pad, argv[index]) != 0) { pad.remove(); return 64; }
    }
    usleep(300000);
    pad.remove();
    return 0;
}
