+void InputManager::addMissingControllers(Window* window)
+{
+    // On macOS a controller can connect while controller events are disabled during loading,
+    // and its added event is then dropped, so add any connected controller not yet known.
+    for (int i {0}; i < SDL_NumJoysticks(); ++i) {
+        if (SDL_IsGameController(i) && mJoysticks.find(SDL_JoystickGetDeviceInstanceID(i)) == mJoysticks.end())
+            addControllerByDeviceIndex(window, i);
+    }
+}
